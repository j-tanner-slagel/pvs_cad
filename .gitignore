# PVS typecheck cache (regenerated automatically)
**/pvsbin/
# PVS context and orphaned-proof caches (regenerated by PVS)
**/.pvscontext
**/orphaned-proofs.prf
# PVS generated and run products: datatype theories, proveit logs and summaries, backups
*_adt.pvs
*.log
*.summary
*.summary-tc
*.prf~

# editor backups, autosaves and lock files; OS files
*~
\#*\#
.#*
.DS_Store
# macOS AppleDouble files on exFAT
._*

# Python bytecode; the per-machine venv (tools/setup.sh)
__pycache__/
*.pyc
.venv/

# LaTeX build products of the paper draft
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc

# local assistant settings
.claude/
