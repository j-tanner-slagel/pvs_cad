tarski_pair: THEORY
%----------------------------------------------------------------------------
% Two sign conditions at the roots of a polynomial (Phase 3).
%
% The Tarski query TQ(p, q) counts the roots of p where q is positive minus
% those where it is negative, and one query pair decides one sign condition
% (tarski_dec).  A Boolean combination needs several polynomials at once, and
% the identity that gives them is
%     4 #{p = 0, q1 > 0, q2 > 0} =
%       TQ(p, q1 q2) + TQ(p, q1 q2^2) + TQ(p, q1^2 q2) + TQ(p, q1^2 q2^2),
% because each query is a difference of counts of the four sign patterns and
% the four combinations add up to four times the all-positive one.  NASALib
% has this for a family of polynomials in Tarski@poly_families, but only for
% integer coefficient arrays; the symbolic construction produces real ones at
% a valuation, so it is proved here over the reals, for two polynomials, from
% the cardinality of the four root sets.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING Tarski@sturmtarski, mpoly_prod

  a, g, h: VAR [nat -> real]
  m, k, j, i: VAR nat
  r, x, y: VAR real

  PN: TYPE = {i: int | i = 1 OR i = -1}
  s1, s2, t1, t2: VAR PN

  okp(x, s1): bool = IF s1 = 1 THEN x > 0 ELSE x < 0 ENDIF

  %% the constant one as a coefficient array, and the full root set
  one(i): real = IF i = 0 THEN 1 ELSE 0 ENDIF
  one_val: LEMMA polynomial(one, 0)(x) = 1
  Rts(a, (m | a(m) /= 0)): finite_set[real] = Sol(a, m, one, 0, >)
  Rts_mem: LEMMA a(m) /= 0 IMPLIES (Rts(a, m)(r) IFF polynomial(a, m)(r) = 0)

  %% the roots at which g and h have prescribed nonzero signs
  SS(a, (m | a(m) /= 0), g, k, h, j, s1, s2): finite_set[real] =
    {r: real | polynomial(a, m)(r) = 0 AND
               okp(polynomial(g, k)(r), s1) AND okp(polynomial(h, j)(r), s2)}
  SS_disj: LEMMA a(m) /= 0 AND (s1 /= t1 OR s2 /= t2) IMPLIES
    disjoint?(SS(a, m, g, k, h, j, s1, s2), SS(a, m, g, k, h, j, t1, t2))

  %% the four query polynomials and their values
  q11(g, k, h, j): [nat -> real] = polynomial_prod(g, k, h, j)
  q12(g, k, h, j): [nat -> real] = polynomial_prod(g, k, polynomial_prod(h, j, h, j), 2 * j)
  q21(g, k, h, j): [nat -> real] = polynomial_prod(polynomial_prod(g, k, g, k), 2 * k, h, j)
  q22(g, k, h, j): [nat -> real] =
    polynomial_prod(polynomial_prod(g, k, g, k), 2 * k, polynomial_prod(h, j, h, j), 2 * j)

  q11_val: LEMMA polynomial(q11(g, k, h, j), k + j)(r) =
    polynomial(g, k)(r) * polynomial(h, j)(r)
  q12_val: LEMMA polynomial(q12(g, k, h, j), k + 2 * j)(r) =
    polynomial(g, k)(r) * (polynomial(h, j)(r) * polynomial(h, j)(r))
  q21_val: LEMMA polynomial(q21(g, k, h, j), 2 * k + j)(r) =
    (polynomial(g, k)(r) * polynomial(g, k)(r)) * polynomial(h, j)(r)
  q22_val: LEMMA polynomial(q22(g, k, h, j), 2 * k + 2 * j)(r) =
    (polynomial(g, k)(r) * polynomial(g, k)(r)) *
    (polynomial(h, j)(r) * polynomial(h, j)(r))
  %% a square is positive exactly off the zero set, and never negative
  sqpos: LEMMA x * x > 0 IFF x /= 0
  sqnneg: LEMMA NOT (x * x < 0)

  %% the same for the product of two squares, which PVS prints flat
  sq2pos: LEMMA x * x * y * y > 0 IFF (x /= 0 AND y /= 0)

  %% the solution set of each query, as a union of sign patterns
  Sol_11p: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q11(g, k, h, j), k + j, >) =
    union(SS(a, m, g, k, h, j, 1, 1), SS(a, m, g, k, h, j, -1, -1))
  Sol_11n: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q11(g, k, h, j), k + j, <) =
    union(SS(a, m, g, k, h, j, 1, -1), SS(a, m, g, k, h, j, -1, 1))
  Sol_12p: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q12(g, k, h, j), k + 2 * j, >) =
    union(SS(a, m, g, k, h, j, 1, 1), SS(a, m, g, k, h, j, 1, -1))
  Sol_12n: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q12(g, k, h, j), k + 2 * j, <) =
    union(SS(a, m, g, k, h, j, -1, 1), SS(a, m, g, k, h, j, -1, -1))
  Sol_21p: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q21(g, k, h, j), 2 * k + j, >) =
    union(SS(a, m, g, k, h, j, 1, 1), SS(a, m, g, k, h, j, -1, 1))
  Sol_21n: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q21(g, k, h, j), 2 * k + j, <) =
    union(SS(a, m, g, k, h, j, 1, -1), SS(a, m, g, k, h, j, -1, -1))
  Sol_22p: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q22(g, k, h, j), 2 * k + 2 * j, >) =
    union(union(SS(a, m, g, k, h, j, 1, 1), SS(a, m, g, k, h, j, 1, -1)),
          union(SS(a, m, g, k, h, j, -1, 1), SS(a, m, g, k, h, j, -1, -1)))
  Sol_22n: LEMMA a(m) /= 0 IMPLIES
    Sol(a, m, q22(g, k, h, j), 2 * k + 2 * j, <) = emptyset[real]
  %% cardinality: each count is the sum of the counts of its sign patterns
  A, B, C, D: VAR finite_set[real]
  S: VAR finite_set[real]
  disj_union: LEMMA disjoint?(A, C) AND disjoint?(A, D) AND
                    disjoint?(B, C) AND disjoint?(B, D)
    IMPLIES disjoint?(union(A, B), union(C, D))
  card4: LEMMA disjoint?(A, B) AND disjoint?(A, C) AND disjoint?(A, D) AND
                disjoint?(B, C) AND disjoint?(B, D) AND disjoint?(C, D)
    IMPLIES card(union(union(A, B), union(C, D))) =
            card(A) + card(B) + card(C) + card(D)
  card_pos: LEMMA card(S) > 0 IFF (EXISTS (r: real): S(r))

  N_11p: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q11(g, k, h, j), k + j, >) =
    card(SS(a, m, g, k, h, j, 1, 1)) + card(SS(a, m, g, k, h, j, -1, -1))
  N_11n: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q11(g, k, h, j), k + j, <) =
    card(SS(a, m, g, k, h, j, 1, -1)) + card(SS(a, m, g, k, h, j, -1, 1))
  N_12p: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q12(g, k, h, j), k + 2 * j, >) =
    card(SS(a, m, g, k, h, j, 1, 1)) + card(SS(a, m, g, k, h, j, 1, -1))
  N_12n: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q12(g, k, h, j), k + 2 * j, <) =
    card(SS(a, m, g, k, h, j, -1, 1)) + card(SS(a, m, g, k, h, j, -1, -1))
  N_21p: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q21(g, k, h, j), 2 * k + j, >) =
    card(SS(a, m, g, k, h, j, 1, 1)) + card(SS(a, m, g, k, h, j, -1, 1))
  N_21n: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q21(g, k, h, j), 2 * k + j, <) =
    card(SS(a, m, g, k, h, j, 1, -1)) + card(SS(a, m, g, k, h, j, -1, -1))
  N_22p: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, >) =
    card(SS(a, m, g, k, h, j, 1, 1)) + card(SS(a, m, g, k, h, j, 1, -1)) +
    card(SS(a, m, g, k, h, j, -1, 1)) + card(SS(a, m, g, k, h, j, -1, -1))
  N_22n: LEMMA a(m) /= 0 IMPLIES NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, <) = 0

  %% the identity: four queries count the roots where both are positive
  pair_count: THEOREM a(m) /= 0 IMPLIES
    4 * card(SS(a, m, g, k, h, j, 1, 1)) =
      (NSol(a, m, q11(g, k, h, j), k + j, >) -
       NSol(a, m, q11(g, k, h, j), k + j, <)) +
      (NSol(a, m, q12(g, k, h, j), k + 2 * j, >) -
       NSol(a, m, q12(g, k, h, j), k + 2 * j, <)) +
      (NSol(a, m, q21(g, k, h, j), 2 * k + j, >) -
       NSol(a, m, q21(g, k, h, j), 2 * k + j, <)) +
      (NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, >) -
       NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, <))

  %% and so the two sign conditions are decided by the four queries
  pair_exists: THEOREM a(m) /= 0 IMPLIES
    ((EXISTS (r: real): polynomial(a, m)(r) = 0 AND
                        polynomial(g, k)(r) > 0 AND polynomial(h, j)(r) > 0)
     IFF
     (NSol(a, m, q11(g, k, h, j), k + j, >) -
      NSol(a, m, q11(g, k, h, j), k + j, <)) +
     (NSol(a, m, q12(g, k, h, j), k + 2 * j, >) -
      NSol(a, m, q12(g, k, h, j), k + 2 * j, <)) +
     (NSol(a, m, q21(g, k, h, j), 2 * k + j, >) -
      NSol(a, m, q21(g, k, h, j), 2 * k + j, <)) +
     (NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, >) -
      NSol(a, m, q22(g, k, h, j), 2 * k + 2 * j, <)) > 0)
END tarski_pair
