quad_det: THEORY
%----------------------------------------------------------------------------
% psc_det? at degree <= 2: the realized sign SET is a function of the sign
% data.  This is what makes the four worked examples' fast decision proved,
% since every member of all four has degree <= 2 in the main variable.
%
% NASALib's discr is declared on nonzero_real, but the hypothesis has to
% cover a = 0 as well -- that is exactly the case where a = b = 0 gives the
% same discriminant sign as a genuine double root but a completely different
% set.  So this theory uses a TOTAL discriminant dsc, agreeing with discr
% wherever discr is defined (dsc_discr).
%
% Each membership is an explicit condition on sign3 of (a, b, c, dsc), so
% equal signs give equal sets.  The negative case goes through qset_flip,
% using that dsc is invariant under negating all three coefficients.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING quad_set

  a, b, c, a2, b2, c2, y: VAR real
  s: VAR Sign3

  %% total discriminant: defined for a = 0 too
  dsc(a, b, c): real = sq(b) - 4 * a * c
  dsc_discr: LEMMA a /= 0 IMPLIES dsc(a, b, c) = discr(a, b, c)
  dsc_neg:   LEMMA dsc(-a, -b, -c) = dsc(a, b, c)

  %% equal signs give equal comparisons.  Proving this ONCE and using it four
  %% times (for a, b, c and dsc) is what keeps qset_det tractable: expanding
  %% sign3 inside the six IFF characterisations instead makes `ground` blow up
  %% combinatorially -- it ran past ten minutes before being interrupted.
  sign3_iff: LEMMA FORALL (x, z: real): sign3(x) = sign3(z) IMPLIES
    ((x > 0 IFF z > 0) AND (x < 0 IFF z < 0) AND (x = 0 IFF z = 0))

  %% the three memberships, each as a condition on the sign data
  qset_pos_iff: LEMMA qset(a, b, c)(1) IFF
    (a > 0 OR (a < 0 AND dsc(a, b, c) > 0)
     OR (a = 0 AND b /= 0) OR (a = 0 AND b = 0 AND c > 0))

  qset_neg_iff: LEMMA qset(a, b, c)(-1) IFF
    (a < 0 OR (a > 0 AND dsc(a, b, c) > 0)
     OR (a = 0 AND b /= 0) OR (a = 0 AND b = 0 AND c < 0))

  qset_zero_iff: LEMMA qset(a, b, c)(0) IFF
    ((a /= 0 AND dsc(a, b, c) >= 0)
     OR (a = 0 AND b /= 0) OR (a = 0 AND b = 0 AND c = 0))

  %% THE DEGREE <= 2 CASE OF psc_det?
  qset_det: LEMMA sign3(a) = sign3(a2) AND sign3(b) = sign3(b2)
    AND sign3(c) = sign3(c2) AND sign3(dsc(a, b, c)) = sign3(dsc(a2, b2, c2))
    IMPLIES (FORALL s: qset(a, b, c)(s) IFF qset(a2, b2, c2)(s))
END quad_det
