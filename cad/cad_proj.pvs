cad_proj: THEORY
%----------------------------------------------------------------------------
% A McCallum-shaped projection operator (Phase 6, the standard route).
% [Corrected 2026-09-29: proj below is McCALLUM-shaped (coefficients,
% discriminants, pairwise resultants), not Collins'; the Collins-style
% operator, psc chains without reducta, is cad_projc.]
%
% clos1 of cad_lift derives the level-below family by iterating "which
% polynomials did the decision procedure read" to a fixpoint.  Answering that
% question is svs_srd, the 3^|F| sign-condition enumeration: measured on
% ex_three's level-2 family (10 members) one sector alone costs 190411 reads
% and 39.8 s, and the closure of that family costs 57.9 s.  The read closure is
% a SUBSTITUTE for CAD's projection phase.
%
% Collins computes the projection once instead:
%
%   proj(A) = { the coefficients of f, disc(f) : f in A, deg f > 0 }
%             U { res(f, g)    : f, g in A distinct, both of degree > 0 }
%
% res and disc are sylvester's - ground-evaluable determinants carrying the
% specialization theorems res_eval and disc_eval over ring_det's det_eval - so
% the projection of the evaluated family is the evaluated projection, which is
% what the lifting argument needs.  Lifting is then svs_pt: specialize at the
% sample point and isolate roots, in time polynomial in the family.
%
% This theory is the OPERATOR ONLY: the delineability argument that makes
% projection+lifting a correct CAD is not claimed here.  [2026-10-01: the
% n-level engine's read closures start from proj (towern_def's tw0, walk_rd,
% cad_fast_def); their answers rest on the run-time certificate (decide5's ok
% flag), not on delineability.  Collins' own projection, proved delineating,
% is cad_projn (col_stack's collins_stack).]
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sylvester, cad_lift

  f, g: VAR list[mpoly]
  F, G: VAR list[list[mpoly]]

  %% a member contributes nothing unless it actually has the main variable
  live?(f): bool = length(f) > 1

  %% ALL coefficients and the discriminant of one member.  Taking only the
  %% leading coefficient is NOT enough: McCallum's projection is
  %% coeffs(f) U disc(f) U res(f, g), and Collins's is larger still (reducta
  %% and principal subresultant coefficients).  A projection that is too small
  %% gives an INVALID decomposition, not merely a coarse one.
  cofs(f): RECURSIVE list[list[mpoly]] =
    IF null?(f) THEN null[list[mpoly]]
    ELSE cons(as_list(car(f)), cofs(cdr(f)))
    ENDIF
  MEASURE length(f)

  proj1(f): list[list[mpoly]] =
    IF live?(f) THEN append(cofs(f), (: as_list(disc(f)) :))
    ELSE null[list[mpoly]] ENDIF

  %% the resultants of f against each later member
  projr(f, G): RECURSIVE list[list[mpoly]] =
    IF null?(G) THEN null[list[mpoly]]
    ELSIF live?(f) AND live?(car(G)) THEN cons(as_list(res(f, car(G))), projr(f, cdr(G)))
    ELSE projr(f, cdr(G))
    ENDIF
  MEASURE length(G)

  %% the projection of a whole family
  proj(F): RECURSIVE list[list[mpoly]] =
    IF null?(F) THEN null[list[mpoly]]
    ELSE append(proj1(car(F)), append(projr(car(F), cdr(F)), proj(cdr(F))))
    ENDIF
  MEASURE length(F)

  proj_null: LEMMA proj(null[list[mpoly]]) = null[list[mpoly]]

END cad_proj
