alg_meas: THEORY
%----------------------------------------------------------------------------
% Measuring alg_lift before proving anything about it (item A, step A4).
%
% The standing rule on this project is: get something working that is right,
% then prove it.  These are cases whose answers are known by hand, and two of
% them test the claim the whole design rests on -- that the SUPERSET of
% candidate roots is harmless.
%
% All at alpha = 1/sqrt(2), the root of x^2 - 1/2 in [1/2, 1].
%
%   cir   y^2 + x^2 - 1 specializes to y^2 - 1/2: signs +, 0, -, 0, + over
%         the five sectors.  Both candidates are genuine roots.
%
%   lin   y - x specializes to y - 1/sqrt(2), with ONE root.  But
%         Res_x(x^2 - 1/2, y - x) = y^2 - 1/2, so -1/sqrt(2) comes back as a
%         candidate although the member does not vanish there.  THE SPURIOUS
%         SECTION CARRIES THE SAME VECTOR AS ITS NEIGHBOURS -- the decision is
%         refined, not corrupted, and the SET of realized vectors is right.
%         This is the measurement that justifies avoiding Q(alpha).
%
%   both  the two together, whose roots COINCIDE at +1/sqrt(2): the section
%         there reads (0, 0), and the one at -1/sqrt(2) reads (0, -1).  A
%         design assuming "exactly one member vanishes at a section" would be
%         wrong here; the sign-change rule is per-member and is not.
%
%   deg   x*y at alpha = 0, where the leading coefficient vanishes and the
%         specialized degree drops.  aok? must REFUSE it rather than guess.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_lift

  u, v: VAR SV
  us, vs: VAR SVL

  %% evaluable equality: the ground evaluator does not do generic list =
  sveq(u, v): RECURSIVE bool =
    IF null?(u) THEN null?(v)
    ELSIF null?(v) THEN FALSE
    ELSE car(u) = car(v) AND sveq(cdr(u), cdr(v))
    ENDIF
  MEASURE length(u)

  svleq(us, vs): RECURSIVE bool =
    IF null?(us) THEN null?(vs)
    ELSIF null?(vs) THEN FALSE
    ELSE sveq(car(us), car(vs)) AND svleq(cdr(us), cdr(vs))
    ENDIF
  MEASURE length(us)

  %% ---- the data ------------------------------------------------------
  xsq1: mpoly = mpol((: mconst(-1), mconst(0), mconst(1) :))   % x^2 - 1
  negx: mpoly = mpol((: mconst(0), mconst(-1) :))              % -x
  fcir: list[mpoly] = (: xsq1, mconst(0), mconst(1) :)         % y^2 + x^2 - 1
  flin: list[mpoly] = (: negx, mconst(1) :)                    % y - x
  fdeg: list[mpoly] = (: mconst(0), mpol((: mconst(0), mconst(1) :)) :)  % x*y

  Fcir:  list[list[mpoly]] = (: fcir :)
  Flin:  list[list[mpoly]] = (: flin :)
  Fboth: list[list[mpoly]] = (: fcir, flin :)
  Fdeg:  list[list[mpoly]] = (: fdeg :)

  alp: Alg = (# p := (: -1/2, 0, 1 :), lb := 1/2, ub := 1 #)   % 1/sqrt(2)
  zer: Alg = (# p := (: 0, 1 :), lb := -1, ub := 1 #)          % 0

  %% ---- WHAT WAS MEASURED ---------------------------------------------
  cir_cand: LEMMA cand(alp, fcir) = (: 1/4, 0, -1, 0, 1, 0, 0 :)
  lin_cand: LEMMA cand(alp, flin) = (: -1/2, 0, 1, 0, 0 :)

  cir_lift: LEMMA svleq(svs_alg(Fcir, alp),
    (: (: 1 :), (: 0 :), (: -1 :), (: 0 :), (: 1 :) :))

  %% the spurious candidate carries its neighbours' vector
  lin_lift: LEMMA svleq(svs_alg(Flin, alp),
    (: (: -1 :), (: -1 :), (: -1 :), (: 0 :), (: 1 :) :))

  %% coinciding roots, read off per member
  both_lift: LEMMA svleq(svs_alg(Fboth, alp),
    (: (: 1, -1 :), (: 0, -1 :), (: -1, -1 :), (: 0, 0 :), (: 1, 1 :) :))

  checks: LEMMA aok?(alp, Fcir) AND aok?(alp, Flin) AND aok?(alp, Fboth)
              AND NOT aok?(zer, Fdeg)
END alg_meas
