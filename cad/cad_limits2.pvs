cad_limits2: THEORY
%----------------------------------------------------------------------------
% (cad) on high degrees and rich Boolean matrices with few quantifiers.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  %% Wilkinson (x-1)...(x-12), degree 12: positive left of 1 -- TRUE
  %% [proved 1.7 s]
  h_wilk12: LEMMA FORALL (x: real): x < 1 IMPLIES x^12 - 78*x^11 + 2717*x^10 - 55770*x^9 + 749463*x^8 - 6926634*x^7 + 44990231*x^6 - 206070150*x^5 + 657206836*x^4 - 1414014888*x^3 + 1931559552*x^2 - 1486442880*x + 479001600 > 0

  %% ... no root strictly between 3/2 and 2 -- TRUE
  %% [proved 2.2 s]
  h_wilk12_gap: LEMMA FORALL (x: real): 3/2 < x AND x < 2 IMPLIES x^12 - 78*x^11 + 2717*x^10 - 55770*x^9 + 749463*x^8 - 6926634*x^7 + 44990231*x^6 - 206070150*x^5 + 657206836*x^4 - 1414014888*x^3 + 1931559552*x^2 - 1486442880*x + 479001600 /= 0

  %% Wilkinson (x-1)...(x-16), degree 16: positive left of 1 -- TRUE
  %% [proved 2.2 s]
  h_wilk16: LEMMA FORALL (x: real): x < 1 IMPLIES x^16 - 136*x^15 + 8500*x^14 - 323680*x^13 + 8394022*x^12 - 156952432*x^11 + 2185031420*x^10 - 23057159840*x^9 + 185953177553*x^8 - 1146901283528*x^7 + 5374523477960*x^6 - 18861567058880*x^5 + 48366009233424*x^4 - 87077748875904*x^3 + 102992244837120*x^2 - 70734282393600*x + 20922789888000 > 0

  %% ... no root strictly between 3/2 and 2 -- TRUE
  %% [proved 2.8 s]
  h_wilk16_gap: LEMMA FORALL (x: real): 3/2 < x AND x < 2 IMPLIES x^16 - 136*x^15 + 8500*x^14 - 323680*x^13 + 8394022*x^12 - 156952432*x^11 + 2185031420*x^10 - 23057159840*x^9 + 185953177553*x^8 - 1146901283528*x^7 + 5374523477960*x^6 - 18861567058880*x^5 + 48366009233424*x^4 - 87077748875904*x^3 + 102992244837120*x^2 - 70734282393600*x + 20922789888000 /= 0

  %% Wilkinson (x-1)...(x-20), degree 20: positive left of 1 -- TRUE
  %% [proved 3.2 s]
  h_wilk20: LEMMA FORALL (x: real): x < 1 IMPLIES x^20 - 210*x^19 + 20615*x^18 - 1256850*x^17 + 53327946*x^16 - 1672280820*x^15 + 40171771630*x^14 - 756111184500*x^13 + 11310276995381*x^12 - 135585182899530*x^11 + 1307535010540395*x^10 - 10142299865511450*x^9 + 63030812099294896*x^8 - 311333643161390640*x^7 + 1206647803780373360*x^6 - 3599979517947607200*x^5 + 8037811822645051776*x^4 - 12870931245150988800*x^3 + 13803759753640704000*x^2 - 8752948036761600000*x + 2432902008176640000 > 0

  %% ... no root strictly between 3/2 and 2 -- TRUE
  %% [proved 4.2 s]
  h_wilk20_gap: LEMMA FORALL (x: real): 3/2 < x AND x < 2 IMPLIES x^20 - 210*x^19 + 20615*x^18 - 1256850*x^17 + 53327946*x^16 - 1672280820*x^15 + 40171771630*x^14 - 756111184500*x^13 + 11310276995381*x^12 - 135585182899530*x^11 + 1307535010540395*x^10 - 10142299865511450*x^9 + 63030812099294896*x^8 - 311333643161390640*x^7 + 1206647803780373360*x^6 - 3599979517947607200*x^5 + 8037811822645051776*x^4 - 12870931245150988800*x^3 + 13803759753640704000*x^2 - 8752948036761600000*x + 2432902008176640000 /= 0

  %% Chebyshev T10, degree 10: between -1 and 1 on [-1, 1] -- TRUE
  %% [proved 2.4 s]
  h_cheb10: LEMMA FORALL (x: real): -1 <= x AND x <= 1 IMPLIES (512*x^10 - 1280*x^8 + 1120*x^6 - 400*x^4 + 50*x^2 - 1 <= 1 AND 512*x^10 - 1280*x^8 + 1120*x^6 - 400*x^4 + 50*x^2 - 1 >= -1)

  %% Chebyshev T20, degree 20: between -1 and 1 on [-1, 1] -- TRUE
  %% [proved 4.8 s]
  h_cheb20: LEMMA FORALL (x: real): -1 <= x AND x <= 1 IMPLIES (524288*x^20 - 2621440*x^18 + 5570560*x^16 - 6553600*x^14 + 4659200*x^12 - 2050048*x^10 + 549120*x^8 - 84480*x^6 + 6600*x^4 - 200*x^2 + 1 <= 1 AND 524288*x^20 - 2621440*x^18 + 5570560*x^16 - 6553600*x^14 + 4659200*x^12 - 2050048*x^10 + 549120*x^8 - 84480*x^6 + 6600*x^4 - 200*x^2 + 1 >= -1)

  %% Chebyshev T30, degree 30: between -1 and 1 on [-1, 1] -- TRUE
  %% [proved 12 s]
  h_cheb30: LEMMA FORALL (x: real): -1 <= x AND x <= 1 IMPLIES (536870912*x^30 - 4026531840*x^28 + 13589544960*x^26 - 27262976000*x^24 + 36175872000*x^22 - 33426505728*x^20 + 22052208640*x^18 - 10478223360*x^16 + 3572121600*x^14 - 859955200*x^12 + 141892608*x^10 - 15275520*x^8 + 990080*x^6 - 33600*x^4 + 450*x^2 - 1 <= 1 AND 536870912*x^30 - 4026531840*x^28 + 13589544960*x^26 - 27262976000*x^24 + 36175872000*x^22 - 33426505728*x^20 + 22052208640*x^18 - 10478223360*x^16 + 3572121600*x^14 - 859955200*x^12 + 141892608*x^10 - 15275520*x^8 + 990080*x^6 - 33600*x^4 + 450*x^2 - 1 >= -1)

  %% x^30 + 1 >= 2 x^15, i.e. (x^15 - 1)^2 >= 0 -- TRUE
  %% [proved 1.0 s]
  h_pow30: LEMMA FORALL (x: real): x^30 + 1 >= 2*x^15

  %% x^40 - x^20 + 1 > 0 (t^2 - t + 1 > 0) -- TRUE
  %% [proved 1.1 s]
  h_pow40: LEMMA FORALL (x: real): x^40 - x^20 + 1 > 0

  %% x^10 = 2 (100 x - 1)^2 has TWO roots within 10^-5 of 1/100 -- TRUE
  %% [not done in 120 s]
  h_mignotte: LEMMA EXISTS (x: real): EXISTS (y: real): x < y AND 999/100000 < x AND y < 1001/100000 AND x^10 = 2*(100*x - 1)^2 AND y^10 = 2*(100*y - 1)^2

  %% the sign of x^2 - 5x + 6 in three clauses -- TRUE
  %% [proved 2.0 s]
  m_quad_signs: LEMMA FORALL (x: real): (x^2 - 5*x + 6 < 0 IMPLIES (2 < x AND x < 3)) AND (x^2 - 5*x + 6 > 0 IMPLIES (x < 2 OR x > 3)) AND (x^2 - 5*x + 6 = 0 IFF (x = 2 OR x = 3))

  %% a chain of implications and an IFF -- TRUE
  %% [proved 2.8 s]
  m_chain: LEMMA FORALL (x: real): (x > 1 IMPLIES x^2 > 1) AND (x^2 > 1 IMPLIES (x > 1 OR x < -1)) AND (x^4 > 1 IFF x^2 > 1) AND (x^3 > 8 IFF x > 2)

  %% sign of odd powers, three exclusive cases -- TRUE
  %% [proved 2.2 s]
  m_trichotomy: LEMMA FORALL (x: real): (x < 0 AND x^3 < 0 AND x^5 < 0) OR (x = 0 AND x^7 = 0) OR (x > 0 AND x^3 > 0 AND x^9 > 0)

  %% x^3 - x > 0, x^2 < 1 and x > 0 cannot hold together -- TRUE
  %% [proved 1.4 s]
  m_impossible: LEMMA FORALL (x: real): NOT (x^3 - x > 0 AND x^2 < 1 AND x > 0)

  %% 10 unit intervals and two rays cover the line (22 atoms) -- TRUE
  %% [proved 32 s (the proof, not the decision)]
  m_cover10: LEMMA FORALL (x: real): x < 0 OR x >= 10 OR (0 <= x AND x < 1) OR (1 <= x AND x < 2) OR (2 <= x AND x < 3) OR (3 <= x AND x < 4) OR (4 <= x AND x < 5) OR (5 <= x AND x < 6) OR (6 <= x AND x < 7) OR (7 <= x AND x < 8) OR (8 <= x AND x < 9) OR (9 <= x AND x < 10)

  %% 20 unit intervals and two rays cover the line (42 atoms) -- TRUE
  %% [not done in 120 s (the decision takes 0.3 s; building the proof is the cost)]
  m_cover20: LEMMA FORALL (x: real): x < 0 OR x >= 20 OR (0 <= x AND x < 1) OR (1 <= x AND x < 2) OR (2 <= x AND x < 3) OR (3 <= x AND x < 4) OR (4 <= x AND x < 5) OR (5 <= x AND x < 6) OR (6 <= x AND x < 7) OR (7 <= x AND x < 8) OR (8 <= x AND x < 9) OR (9 <= x AND x < 10) OR (10 <= x AND x < 11) OR (11 <= x AND x < 12) OR (12 <= x AND x < 13) OR (13 <= x AND x < 14) OR (14 <= x AND x < 15) OR (15 <= x AND x < 16) OR (16 <= x AND x < 17) OR (17 <= x AND x < 18) OR (18 <= x AND x < 19) OR (19 <= x AND x < 20)

  %% x^k > k x for k = 2..6 at once, for large x (5 polynomials) -- TRUE
  %% [proved 0.5 s]
  m_powers6: LEMMA EXISTS (x: real): x^2 > 2*x AND x^3 > 3*x AND x^4 > 4*x AND x^5 > 5*x AND x^6 > 6*x

  %% x^k > k x for k = 2..10 at once, for large x (9 polynomials) -- TRUE
  %% [proved 0.6 s]
  m_powers10: LEMMA EXISTS (x: real): x^2 > 2*x AND x^3 > 3*x AND x^4 > 4*x AND x^5 > 5*x AND x^6 > 6*x AND x^7 > 7*x AND x^8 > 8*x AND x^9 > 9*x AND x^10 > 10*x

  %% a point avoiding the 16 roots +-1..+-8, between 8 and 9 -- TRUE
  %% [proved 0.5 s]
  m_avoid8: LEMMA EXISTS (x: real): 8 < x AND x < 9 AND (x - 1)*(x + 1) /= 0 AND (x - 2)*(x + 2) /= 0 AND (x - 3)*(x + 3) /= 0 AND (x - 4)*(x + 4) /= 0 AND (x - 5)*(x + 5) /= 0 AND (x - 6)*(x + 6) /= 0 AND (x - 7)*(x + 7) /= 0 AND (x - 8)*(x + 8) /= 0

  %% x^10 + y^10 >= 2 x^5 y^5 -- TRUE
  %% [not done in 120 s]
  b10_amgm: LEMMA FORALL (x: real): FORALL (y: real): x^10 + y^10 >= 2*x^5*y^5

  %% x^8 + y^8 = 1 meets x^3 = y^5 -- TRUE
  %% [not done in 120 s]
  b8_meet: LEMMA EXISTS (x: real): EXISTS (y: real): x^8 + y^8 = 1 AND x^3 = y^5

  %% an odd degree 7 polynomial in y always has a root -- TRUE
  %% [not done in 120 s]
  b7_root: LEMMA FORALL (x: real): EXISTS (y: real): y^7 - x*y^3 + x^5 = 0

  %% the heart curve (x^2 + y^2 - 1)^3 <= x^2 y^3 lies in x^2 + y^2 <= 2 -- FALSE: at
  %% (x, y) = (9/10, 11/10) the hypothesis holds (1.061208 <= 1.07811) and x^2 + y^2 = 101/50 > 2
  %% (the comment said TRUE until 2026-10-01)
  %% [not done in 120 s]
  b6_heart: LEMMA FORALL (x: real): FORALL (y: real): (x^2 + y^2 - 1)^3 <= x^2*y^3 IMPLIES x^2 + y^2 <= 2

  %% a square root, or 0 for negatives -- TRUE
  %% [proved 1.7 s]
  b_sqrt_cases: LEMMA FORALL (x: real): EXISTS (y: real): (y^2 = x AND y >= 0) OR (x < 0 AND y = 0)

  %% every x^3 + y^2 has a fifth root -- TRUE
  %% [not done in 120 s]
  t5_root: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z^5 = x^3 + y^2

  %% for every x a y with z^4 + y z^2 + y >= x for all z -- TRUE
  %% [proved 23 s]
  t_forall_exists_forall: LEMMA FORALL (x: real): EXISTS (y: real): FORALL (z: real): z^4 + y*z^2 + y >= x

  %% (x^2 + y^2 + z^2)^2 >= x^4 + y^4 + z^4 -- TRUE
  %% [proved 85 s]
  t_squares4: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real): (x^2 + y^2 + z^2)^2 >= x^4 + y^4 + z^4
END cad_limits2
