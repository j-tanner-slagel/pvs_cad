tarski_dec: THEORY
%----------------------------------------------------------------------------
% Deciding a sign condition at the roots (Phase 3).
%
% Two Tarski queries determine the number of roots of p at which q is
% positive: TQ(p, q) is the difference of the counts where q is positive and
% where q is negative, and TQ(p, q^2) is their sum, since q^2 is positive
% exactly where q is nonzero.  So twice the number of roots where q is
% positive is TQ(p, q) + TQ(p, q^2), and the existence of such a root is
% decided by the sign of that sum.  This is the step that takes the branching
% construction beyond equations, to arbitrary sign conditions.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_count, root_dec

  l0, q: VAR list[mpoly]
  ys: VAR list[real]
  k, i: VAR nat
  x: VAR real

  %% the square of a coefficient list, normalized at the valuation
  gsq(q, ys): list[mpoly] = select(snorm(lmul(q, q)), ys)
  qok(q, ys): bool = cons?(q) AND meval(llast(q))(ys) /= 0

  sq_top: LEMMA qok(q, ys) IMPLIES earr(lmul(q, q), ys)(2 * dg(q)) /= 0
  sq_zero: LEMMA i > 2 * dg(q) IMPLIES earr(lmul(q, q), ys)(i) = 0
  gsq_cons: LEMMA qok(q, ys) IMPLIES cons?(gsq(q, ys))
  gsq_dg: LEMMA qok(q, ys) IMPLIES dg(gsq(q, ys)) = 2 * dg(q)
  gsq_lc: LEMMA qok(q, ys) IMPLIES meval(llast(gsq(q, ys)))(ys) /= 0
  gsq_arr: LEMMA qok(q, ys) IMPLIES
    earr(gsq(q, ys), ys) = polynomial_prod(earr(q, ys), dg(q), earr(q, ys), dg(q))

  %% the two queries count the roots where q is positive
  tok2(k, l0, q, ys): bool = tok(k, l0, q, ys) AND tok(k, l0, gsq(q, ys), ys)
  nsol_pos: LEMMA tok2(k, l0, q, ys) IMPLIES
    2 * NSol(earr(l0, ys), dg(l0), earr(q, ys), dg(q), >) =
      tq(k, l0, q, ys) + tq(k, l0, gsq(q, ys), ys)
  sign_exists: THEOREM tok2(k, l0, q, ys) IMPLIES
    ((EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0 AND meval(mpol(q))(cons(x, ys)) > 0)
     IFF tq(k, l0, q, ys) + tq(k, l0, gsq(q, ys), ys) > 0)
END tarski_dec
