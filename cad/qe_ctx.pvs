qe_ctx: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination with symbolic parameters, with the conditions of
% the path (Phase 3).
%
% ctreec and qtreec are ctree of conj_tree and qtree of qe_tree built with
% the context-aware trees, so the tree of a formula never branches on a sign
% the conditions above it decide, and for one parameter it never branches on
% a sign that has no case at all.  qtreec_sound is qtree_sound under the
% path's conditions, qdecidec is the tree from the empty path, and
% qe_branchc is what the strategy uses.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING ineq_ctx, qe_tree, branch_ctx[bool, bool]

  E, Q: VAR list[list[mpoly]]
  C: VAR Conj
  F: VAR list[Conj]
  ys: VAR list[real]
  k: VAR nat
  x: VAR real
  cx: VAR snorm_ctx.Cx_snorm

  cjtreec(k, E, Q, cx): btree[bool] =
    bbindc(snormc(sqsum(E), cx), cx, LAMBDA (p0: SL, cx1: snorm_ctx.Cx_snorm):
      IF null?(p0`slist) THEN itreec(k, Q, cx1)
      ELSIF length(p0`slist) = 1 THEN bleaf(FALSE)
      ELSE mcorec(k, p0, Q, cx1)
      ENDIF)
  cjtreec_sound: THEOREM branch_tree[bool].conds_hold(cx, ys) AND
    length(sqsum(E)) + 2 * mlen(Q) + 1 <= k IMPLIES
    (select(cjtreec(k, E, Q, cx), ys) IFF
     (EXISTS (x: real): eqs_at(E, ys, x) AND allgt(Q, ys, x)))

  qtreec(k, F, cx): RECURSIVE btree[bool] =
    IF null?(F) THEN bleaf(FALSE)
    ELSE bbindc(cjtreec(k, car(F)`ceqs, car(F)`cgts, cx), cx, LAMBDA (b: bool, cx1: snorm_ctx.Cx_snorm):
           IF b THEN bleaf(TRUE) ELSE qtreec(k, cdr(F), cx1) ENDIF)
    ENDIF
  MEASURE length(F)
  qtreec_null: LEMMA qtreec(k, null[Conj], cx) = bleaf(FALSE)
  qtreec_cons: LEMMA qtreec(k, cons(C, F), cx) =
    bbindc(cjtreec(k, C`ceqs, C`cgts, cx), cx, LAMBDA (b: bool, cx1: snorm_ctx.Cx_snorm):
      IF b THEN bleaf(TRUE) ELSE qtreec(k, F, cx1) ENDIF)

  qtreec_sound: THEOREM FORALL (F: list[Conj]): FORALL (k: nat, cx: snorm_ctx.Cx_snorm, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) AND tfuel(F) <= k IMPLIES
    (select(qtreec(k, F, cx), ys) IFF (EXISTS (x: real): feval(F, ys, x)))

  %% the tree from the empty path, and what the strategy uses
  qdecidec(k, F): btree[bool] = qtreec(k, F, null[branch_tree[bool].SignCond])
  qdecidec_sound: THEOREM tfuel(F) <= k IMPLIES
    (select(qdecidec(k, F), ys) IFF (EXISTS (x: real): feval(F, ys, x)))
  b: VAR branch_tree[bool].Branch
  qe_branchc: THEOREM tfuel(F) <= k AND member(b, branches(qdecidec(k, F))) AND
    branch_tree[bool].conds_hold(b`bconds, ys)
    IMPLIES (b`bres IFF (EXISTS (x: real): feval(F, ys, x)))
END qe_ctx
