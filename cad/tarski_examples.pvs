tarski_examples: THEORY
%----------------------------------------------------------------------------
% Tarski queries, run (Phase 3).
%
% For p = x^2 - 1 and q = x the two queries are TQ(p, q) = 0 (the roots 1 and
% -1 contribute +1 and -1) and TQ(p, q^2) = 2 (q is nonzero at both), so twice
% the number of roots where q is positive is 2 and there is exactly one.  The
% decision of sign_exists then proves the statement about the reals.  For
% q = -x^2 the sum is zero and there is no such root.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_dec, mpoly_embed

  x: VAR real

  P1: list[mpoly] = (: mconst(-1), mconst(0), mconst(1) :)     % x^2 - 1
  Q1: list[mpoly] = (: mconst(0), mconst(1) :)                 % x
  Q2: list[mpoly] = (: mconst(0), mconst(0), mconst(-1) :)     % -x^2

  e1: LEMMA tq(6, P1, Q1, null[real]) = 0
  e2: LEMMA tq(6, P1, gsq(Q1, null[real]), null[real]) = 2
  e3: LEMMA tok2(6, P1, Q1, null[real])
  e4: LEMMA meval(mpol(P1))(cons(x, null)) = x^2 - 1
  e5: LEMMA meval(mpol(Q1))(cons(x, null)) = x
  e6: LEMMA EXISTS (x: real): x^2 - 1 = 0 AND x > 0

  e7: LEMMA meval(mpol(Q2))(cons(x, null)) = -x^2
  e8: LEMMA NOT (EXISTS (x: real): x^2 - 1 = 0 AND -x^2 > 0)
END tarski_examples
