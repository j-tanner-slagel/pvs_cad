psc_det_quad: THEORY
%----------------------------------------------------------------------------
% psc_det? HOLDS OUTRIGHT for a single-member family of degree <= 2.
%
% This discharges dec2_sem's hypothesis rather than carrying it, so for these
% families the two-quantifier projection decision is correct UNCONDITIONALLY
% -- no delineability assumption, no ok flag standing in for an argument.
%
% Everything it uses is already proved:
%   cofs_projc / disc_projc   the coefficients and the discriminant are in projc
%   svec_eq_sign              equal sign vectors give equal signs member by member
%   disc_quad_eval            sign(disc) = -sign(c2)*sign(dsc)
%   fib1_det                  equal coefficient and dsc signs give equal fibre sets
%
% The one piece of reasoning left is recovering sign(dsc) from sign(disc):
% divide by sign(c2) when c2 /= 0, and when c2 = 0 note dsc = c1^2, whose
% sign is fixed by sign(c1) alone.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING disc_quad

  u0, u1, u2: VAR mpoly
  P: VAR list[list[mpoly]]
  c: VAR list[mpoly]
  x, y: VAR real
  v: VAR SV

  %% membership form of svec_eq_sign
  svec_eq_mem: LEMMA svec(P, (: x :)) = svec(P, (: y :)) AND member(c, P)
    IMPLIES sign3(meval(mpol(c))((: x :))) = sign3(meval(mpol(c))((: y :)))

  %% sign(dsc) from sign(disc) and the leading coefficient
  dsc_sign: LEMMA sign3(meval(u2)((: x :))) = sign3(meval(u2)((: y :)))
    AND sign3(meval(u1)((: x :))) = sign3(meval(u1)((: y :)))
    AND sign3(meval(disc((: u0, u1, u2 :)))((: x :)))
      = sign3(meval(disc((: u0, u1, u2 :)))((: y :)))
    IMPLIES
      sign3(dsc(meval(u2)((: x :)), meval(u1)((: x :)), meval(u0)((: x :))))
    = sign3(dsc(meval(u2)((: y :)), meval(u1)((: y :)), meval(u0)((: y :))))

  %% a member of the projection has determined sign, stated on the mpoly
  %% rather than on its coefficient list
  p: VAR mpoly
  F: VAR list[list[mpoly]]
  mem_sign: LEMMA svec(projc(F), (: x :)) = svec(projc(F), (: y :))
    AND member(as_list(p), projc(F))
    IMPLIES sign3(meval(p)((: x :))) = sign3(meval(p)((: y :)))

  %% the four things the projection of a single quadratic member contains
  quad_mem0: LEMMA member(as_list(u0), projc((: (: u0, u1, u2 :) :)))
  quad_mem1: LEMMA member(as_list(u1), projc((: (: u0, u1, u2 :) :)))
  quad_mem2: LEMMA member(as_list(u2), projc((: (: u0, u1, u2 :) :)))
  quad_memd: LEMMA member(as_list(disc((: u0, u1, u2 :))),
                          projc((: (: u0, u1, u2 :) :)))

  %% THE UNCONDITIONAL RESULT
  psc_det_quad1: THEOREM psc_det?((: (: u0, u1, u2 :) :))

  %%-------------------------------------------------------------------------
  %% What that buys: delineability and then dec2_sem with NO assumption about
  %% the family left in the hypotheses.  Everything still required is a
  %% property of the COMPUTATION -- the isolated roots come out sorted, the
  %% gaps really separate them, the samples are rational and land inside their
  %% sectors, root isolation converged -- and the executable code checks each
  %% one.  Nothing here is a promise about mathematics that is not proved.
  %%-------------------------------------------------------------------------
  s: VAR Sect
  q1, q2: VAR bool
  Psi: VAR [SV -> bool]

  quad_delin: COROLLARY
        incr?(rts(projc((: (: u0, u1, u2 :) :))))
    AND gaps_ok(rts(projc((: (: u0, u1, u2 :) :))))
    AND member(s, sects(rts(projc((: (: u0, u1, u2 :) :)))))
    IMPLIES delin?((: (: u0, u1, u2 :) :), s)

  quad_dec2: COROLLARY
        incr?(rts(projc((: (: u0, u1, u2 :) :))))
    AND gaps_ok(rts(projc((: (: u0, u1, u2 :) :))))
    AND (FORALL s: member(s, sects(rts(projc((: (: u0, u1, u2 :) :)))))
           IMPLIES ratsamp?(s) AND in?(s, rsv(s))
                   AND svs_ptok((: (: u0, u1, u2 :) :), (: rsv(s) :)))
    IMPLIES
    (qfoldS(q1, sects(rts(projc((: (: u0, u1, u2 :) :)))),
            LAMBDA s: qfold(q2, svs_pt((: (: u0, u1, u2 :) :), (: rsv(s) :)), Psi))
     IFF sem((: q1, q2 :), (: (: u0, u1, u2 :) :), Psi, null[real]))
END psc_det_quad
