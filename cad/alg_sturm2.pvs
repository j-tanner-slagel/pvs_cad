alg_sturm2: THEORY
%----------------------------------------------------------------------------
% The counts at +-infinity, so that root isolation has a starting interval
% and a termination test (item A, continued).
%
% acount counts the roots of f(., value(a)) in a BOUNDED interval.  Isolation
% also needs to know when an interval has caught them all, and a Cauchy bound
% is not available: it needs MAGNITUDES of the coefficients at alpha, where
% alg_sign2 gives only signs.
%
% Sturm's unbounded theorems need no magnitudes either.  At +-infinity the
% sign sequence is read off the chain's LEADING COEFFICIENTS alone --
% p(i)(n(i)) and (-1)^n(i) * p(i)(n(i)) -- and those are meval(llast(.)) at
% the valuation (chain_sturm's arr_lc), so alg_sign2 computes them.  So the
% total root count is computable, and
%
%     atotal = aleft + acount + aright
%
% splits it across (-inf, y0], (y0, y1] and (y1, inf).  Each part is >= 0, so
% acount = atotal forces the other two to zero, and aleft_zero/aright_zero
% then say there is nothing outside.  That is acaptures: the termination test
% for widening, with no bound on the coefficients anywhere.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_sturm

  a: VAR Alg
  f: VAR list[mpoly]
  k, i: VAR nat
  y0, y1: VAR rat

  %% the leading-coefficient signs Sturm reads at +-infinity
  ahif(k, a, f): [nat -> real] =
    LAMBDA (i: nat): algsg(a)(llast(nthl(achain(k, a, f), i)))
  alof(k, a, f): [nat -> real] =
    LAMBDA (i: nat): (-1)^(dg(nthl(achain(k, a, f), i)))
                     * algsg(a)(llast(nthl(achain(k, a, f), i)))

  ahi(k, a, f): nat = number_sign_changes(ahif(k, a, f), alen(k, a, f))`num
  alo(k, a, f): nat = number_sign_changes(alof(k, a, f), alen(k, a, f))`num

  atotal(k, a, f): int = alo(k, a, f) - ahi(k, a, f)
  aleft(k, a, f, y0): int = alo(k, a, f) - avar(k, a, f, y0)
  aright(k, a, f, y1): int = avar(k, a, f, y1) - ahi(k, a, f)

  %% the two counts, read as Sturm reads them: arr_lc turns a chain entry's
  %% leading array value into meval(llast(.)), which is what algsg computes
  ahi_nsc: LEMMA alc?(k, a, f) IMPLIES ahi(k, a, f) =
    number_sign_changes(LAMBDA (i: nat):
        carr(fchain(k, f, (: value(a) :)), (: value(a) :))(i)
            (cdeg(fchain(k, f, (: value(a) :)))(i)),
      length(fchain(k, f, (: value(a) :))) - 2)`num

  alo_nsc: LEMMA alc?(k, a, f) IMPLIES alo(k, a, f) =
    number_sign_changes(LAMBDA (i: nat):
        (-1)^(cdeg(fchain(k, f, (: value(a) :)))(i))
        * carr(fchain(k, f, (: value(a) :)), (: value(a) :))(i)
              (cdeg(fchain(k, f, (: value(a) :)))(i)),
      length(fchain(k, f, (: value(a) :))) - 2)`num

  %% the three parts add up, by construction
  asplit: LEMMA atotal(k, a, f)
    = aleft(k, a, f, y0) + acount(k, a, f, y0, y1) + aright(k, a, f, y1)

  %% each part counts something, so none is negative
  aleft_nneg:  THEOREM alc?(k, a, f)
    AND meval(mpol(f))((: y0, value(a) :)) /= 0
    IMPLIES aleft(k, a, f, y0) >= 0
  aright_nneg: THEOREM alc?(k, a, f)
    AND meval(mpol(f))((: y1, value(a) :)) /= 0
    IMPLIES aright(k, a, f, y1) >= 0

  %% and zero means empty
  aleft_zero:  THEOREM alc?(k, a, f)
    AND meval(mpol(f))((: y0, value(a) :)) /= 0
    AND aleft(k, a, f, y0) = 0
    IMPLIES FORALL (z: real): z <= y0
      IMPLIES meval(mpol(f))((: z, value(a) :)) /= 0
  aright_zero: THEOREM alc?(k, a, f)
    AND meval(mpol(f))((: y1, value(a) :)) /= 0
    AND aright(k, a, f, y1) = 0
    IMPLIES FORALL (z: real): z > y1
      IMPLIES meval(mpol(f))((: z, value(a) :)) /= 0

  %% THE TERMINATION TEST for widening
  acaptures: THEOREM alc?(k, a, f) AND aends?(a, f, y0, y1)
    AND acount(k, a, f, y0, y1) = atotal(k, a, f)
    IMPLIES FORALL (z: real): meval(mpol(f))((: z, value(a) :)) = 0
      IMPLIES (y0 < z AND z <= y1)
END alg_sturm2
