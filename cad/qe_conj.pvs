qe_conj: THEORY
%----------------------------------------------------------------------------
% One conjunction of sign conditions (Phase 3).
%
% A conjunct of a quantifier-elimination problem in one variable is a list of
% equations and a list of strict inequalities.  Several equations collapse into
% one: a sum of squares of reals vanishes exactly when every term does, so
% sqsum(E) = 0 is the conjunction of the equations of E.  With that, the
% conjunct is decided by the two theorems of the phase --- many_exists when
% there is an equation, ineq_exists when there is none --- and cdec is the
% decision, executable through the chains.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING poly_rolle

  l, l1, l2, g: VAR list[mpoly]
  E, Q: VAR list[list[mpoly]]
  ys, xs: VAR list[real]
  k: VAR nat
  x: VAR real

  %% the sum of two coefficient lists
  ladd(l1, l2): list[mpoly] = as_list(madd(mpol(l1), mpol(l2)))
  meval_ladd: LEMMA meval(mpol(ladd(l1, l2)))(xs) =
    meval(mpol(l1))(xs) + meval(mpol(l2))(xs)

  %% the sum of the squares of a list of coefficient lists
  sqsum(E): RECURSIVE list[mpoly] =
    IF null?(E) THEN null[mpoly]
    ELSE ladd(lmul(car(E), car(E)), sqsum(cdr(E)))
    ENDIF
  MEASURE length(E)
  sqsum_null: LEMMA sqsum(null[list[mpoly]]) = null[mpoly]
  sqsum_cons: LEMMA sqsum(cons(l, E)) = ladd(lmul(l, l), sqsum(E))

  %% it is nonnegative, and it vanishes exactly where every equation holds
  sqsum_nneg: LEMMA meval(mpol(sqsum(E)))(cons(x, ys)) >= 0
  sqsum_zero: LEMMA meval(mpol(sqsum(E)))(cons(x, ys)) = 0 IFF
    every(LAMBDA (u: list[mpoly]): meval(mpol(u))(cons(x, ys)) = 0)(E)

  %% the strict inequalities of the conjunct, in the two forms
  allgt(Q, ys, x): bool =
    every(LAMBDA (u: list[mpoly]): meval(mpol(u))(cons(x, ys)) > 0)(Q)
  allgt_allpf: LEMMA allgt(Q, ys, x) IFF allpf(Q, ys, x)

  %% the same existentials in the two forms the two theorems use
  ex_allgt: LEMMA (EXISTS (x: real): allgt(Q, ys, x)) IFF
                  (EXISTS (x: real): allpf(Q, ys, x))
  ex_crit: LEMMA
    (EXISTS (c: real): pf(lderiv(qprod(Q, ys)), ys)(c) = 0 AND allpf(Q, ys, c))
    IFF
    (EXISTS (x: real): meval(mpol(lderiv(qprod(Q, ys))))(cons(x, ys)) = 0 AND
                       allgt(Q, ys, x))

  %% the equation of the conjunct, normalized at the valuation
  ceq(E, ys): list[mpoly] = select(snorm(sqsum(E)), ys)
  ceq_ex: LEMMA
    (EXISTS (x: real): meval(mpol(ceq(E, ys)))(cons(x, ys)) = 0 AND allgt(Q, ys, x))
    IFF
    (EXISTS (x: real):
       every(LAMBDA (u: list[mpoly]): meval(mpol(u))(cons(x, ys)) = 0)(E) AND
       allgt(Q, ys, x))

  %% the decision, and what it needs
  cdec(k, E, Q, ys): bool =
    IF null?(E)
      THEN posinf(Q, ys) OR neginf(Q, ys) OR
           mts(k, lderiv(qprod(Q, ys)), Q, one_list, ys) > 0
      ELSE mts(k, ceq(E, ys), Q, one_list, ys) > 0
    ENDIF
  cok(k, E, Q, ys): bool =
    allok(Q, ys) AND
    IF null?(E)
      THEN lok(lderiv(qprod(Q, ys)), ys) AND
           mok(k, lderiv(qprod(Q, ys)), Q, one_list, ys)
      ELSE lok(ceq(E, ys), ys) AND mok(k, ceq(E, ys), Q, one_list, ys)
    ENDIF

  cdec_sound: THEOREM cok(k, E, Q, ys) IMPLIES
    (cdec(k, E, Q, ys) IFF
     (EXISTS (x: real):
        every(LAMBDA (u: list[mpoly]): meval(mpol(u))(cons(x, ys)) = 0)(E) AND
        allgt(Q, ys, x)))
END qe_conj
