alg_dec_ex: THEORY
%----------------------------------------------------------------------------
% What the algebraic-sample decision answers, and WHERE IT STOPS (item A).
%
% The four textbook examples pass on the rational route only because their
% section coordinates happen to be rational.  These two families say exactly
% how much of that gap alg_lift closes.
%
%   f_meet   y - x and y^2 - 2.  They meet at x = +-sqrt(2), and those are
%            sections of the projection -- IRRATIONAL ones, so the rational
%            route cannot vouch (old_refuses).  Neither leading coefficient
%            nor either discriminant vanishes there, so aok? holds at every
%            sector and the decision is certified: meet_ok.  THIS IS WHAT
%            ITEM A BUYS.
%
%   f_rad2   x^2 + y^2 - 2.  Its sections are at +-sqrt(2) too, but there
%            they are roots of the DISCRIMINANT: the fibre has a repeated
%            root (the circle's vertical tangent), so f does not change sign
%            at it and the sign-change rule is not valid.  aok? refuses
%            exactly those two sectors and passes the three open ones --
%            rad2_limit records it.  THIS IS WHAT ITEM A DOES NOT BUY.
%
% A discriminant root is a section of every CAD, so the residual case is not
% exotic.  Deciding it needs the sign of a polynomial at a point with two
% algebraic coordinates, which is the same primitive Sturm-Habicht supplies
% for delineability -- see PROGRESS.md.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_dec, cad_meas, cad_pdec

  v: VAR SV

  negx2: mpoly = mpol((: mconst(0), mconst(-1) :))              % -x
  x2m2:  mpoly = mpol((: mconst(-2), mconst(0), mconst(1) :))   % x^2 - 2

  %% y - x  and  y^2 - 2 : they meet at x = +-sqrt(2)
  f_meet: list[list[mpoly]] =
    (: (: negx2, mconst(1) :),                       % y - x
       (: mconst(-2), mconst(0), mconst(1) :)        % y^2 - 2
     :)
  psi_meet(v): bool = sgn(v, 0) = 0 AND sgn(v, 1) = 0

  %% x^2 + y^2 - 2, whose sections ARE discriminant roots
  f_rad2: list[list[mpoly]] =
    (: (: x2m2, mconst(0), mconst(1) :),             % (x^2-2) + y^2
       (: x2m2 :)                                    % x^2-2, no y
     :)

  %% ---- WHAT ITEM A BUYS -----------------------------------------------
  %% the rational route cannot vouch: the sections are irrational
  old_refuses: LEMMA cad_pdec.allrat(sects(rts(proj(f_meet)))) = FALSE
  %% this one can, at every sector, sections included
  meet_ok:     LEMMA ok2a(f_meet)
  %% EXISTS x: EXISTS y: y = x AND y^2 = 2   is TRUE
  meet_val:    LEMMA dec2a(FALSE, FALSE, f_meet, psi_meet)
  %% FORALL x: EXISTS y: y = x AND y^2 = 2   is FALSE
  meet_ctl:    LEMMA dec2a(TRUE, FALSE, f_meet, psi_meet) = FALSE

  %% ---- WHAT IT DOES NOT ------------------------------------------------
  %% open sectors pass, the two discriminant-root sections do not
  rad2_limit: LEMMA NOT ok2a(f_rad2)
    AND aok?(sample(nth(sects(rts(proj(f_rad2))), 0)), f_rad2)
    AND NOT aok?(sample(nth(sects(rts(proj(f_rad2))), 1)), f_rad2)
    AND aok?(sample(nth(sects(rts(proj(f_rad2))), 2)), f_rad2)
END alg_dec_ex
