ev_nat[T: TYPE+]: THEORY
%----------------------------------------------------------------------------
% "Eventually" over the escalation parameter u, per type (COMPLETENESS_PLAN
% C8).  ev_pred's ev? over a finite list (take the largest threshold), which
% is how one u serves a whole finite cell tree; evc?(f): f is constant from
% some u on; lim(f) is the value an eventually constant f settles on.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING ev_pred

  u, N, M: VAR nat
  p, q: VAR pred[nat]
  f, g: VAR [nat -> T]
  t: VAR T
  L: VAR list[T]
  P: VAR [T -> pred[nat]]

  ev_list: LEMMA FORALL L: (FORALL t: member(t, L) IMPLIES ev?(P(t)))
    IMPLIES ev?(LAMBDA u: FORALL t: member(t, L) IMPLIES P(t)(u))

  evc?(f): bool = EXISTS N: FORALL u: u >= N IMPLIES f(u) = f(N)
  evc_const: LEMMA evc?(LAMBDA u: t)
  evc_ev: LEMMA evc?(f) IMPLIES EXISTS t: ev?(LAMBDA u: f(u) = t)
  ev_evc: LEMMA ev?(LAMBDA u: f(u) = t) IMPLIES evc?(f)
  evc_same: LEMMA evc?(f) AND ev?(LAMBDA u: g(u) = f(u)) IMPLIES evc?(g)
  %% the value an eventually constant function settles on
  lim(f): T = epsilon(LAMBDA t: ev?(LAMBDA u: f(u) = t))
  evc_lim: LEMMA evc?(f) IMPLIES ev?(LAMBDA u: f(u) = lim(f))
END ev_nat
