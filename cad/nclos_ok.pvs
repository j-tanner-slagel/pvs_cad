nclos_ok: THEORY
%----------------------------------------------------------------------------
% The outer closure ends with every sector's reads sign-invariant on the
% sector (COMPLETENESS_PLAN C7, part 5).
%
% A read that is already a member of the outer family Q passes inv_chk on
% every sector of Q's roots: it has no root strictly inside one
% (allroots_complete, sect_noroot) and the test is complete
% (inv_chk_complete) -- memb_inv.  So every bad read nclos_o finds is new
% (nbads_new), and a round that finds one grows Q.  The bad reads are reads
% of the top family of a closed tower, which with u >= tbnd(T0) lies in
% tower_univ's universe, so they lie in rwall(tul(T0)) (nbads_in); Q is the
% initial family followed by new members of that list (qinv?), its length is
% bounded, and with enough fuel nclos_o returns a family with no bad reads
% at all (nclos_fix).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING clos_ok, sect_svec

  u, fuel: VAR nat
  T0, TW: VAR Tower
  Q, Q0, A, B: VAR list[list[mpoly]]
  b: VAR list[mpoly]
  c: VAR mpoly
  s: VAR Sect
  ss: VAR list[Sect]
  Rm: VAR list[mpoly]
  od: VAR OD

  %% ---- a member's reads pass the sector test ------------------------------------------------
  memb_inv: LEMMA member(as_list(c), Q) AND member(s, sects(rts(Q))) IMPLIES inv_chk(cpl(c), s)

  %% ---- the bad reads ----------------------------------------------------------------------------
  badl_mem: LEMMA FORALL Rm: member(b, badl(s, Rm)) IMPLIES
    EXISTS c: member(c, Rm) AND b = as_list(c) AND NOT inv_chk(cpl(c), s)
  nbads_bad: LEMMA FORALL ss: member(b, nbads_o(u, T0, ss)) IMPLIES
    EXISTS s, c: member(s, ss) AND b = as_list(c) AND NOT inv_chk(cpl(c), s)
  nbads_new: LEMMA member(b, nbads_o(u, T0, sects(rts(Q)))) IMPLIES NOT member(b, Q)
  topreads_in: LEMMA tinv?(T0, TW) AND member(c, topreads(TW, od)) IMPLIES
    member(as_list(c), rwall(tul(T0)))
  nbads_in: LEMMA FORALL ss: u >= tbnd(T0) AND member(b, nbads_o(u, T0, ss)) IMPLIES
    member(b, rwall(tul(T0)))

  %% ---- the closure grows within a bound ---------------------------------------------------------
  qinv?(T0, Q0, Q): bool = EXISTS A: Q = append(Q0, A) AND nd?(A) AND sub?(A, rwall(tul(T0)))
  nclos_fix: LEMMA FORALL fuel: FORALL Q: u >= tbnd(T0) AND qinv?(T0, Q0, Q)
    AND length(Q) + fuel > length(Q0) + length(rwall(tul(T0)))
    IMPLIES null?(nbads_o(u, T0, sects(rts(nclos_o(u, fuel, T0, Q)))))
END nclos_ok
