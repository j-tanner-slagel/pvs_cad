cad_fast: THEORY
%----------------------------------------------------------------------------
% The fast two-quantifier decision is correct (FINISH_PLAN stage S4).
%
%   decw_correct   decw(q1, q, F, Psi)`ok IMPLIES
%                    (decw(q1, q, F, Psi)`val IFF sem((: q1, q :), F, Psi, null))
%
% unconditional in the same sense as decide2_correct: every hypothesis is a
% boolean the code computes.  The argument per sector:
%
%   sect_walk    at the sample the walk's list IS the fibre set      (walk_fib)
%   sect_delin   the fibre set does not vary along the sector: trivially at
%                a root sector, and on an open one by the transfer theorem
%                fib_const, whose hypothesis inv? is what icert1? checks
%                (inv_chk_sound) and whose convexity is that of an interval
%   sect_sem     so the inner fold at the sample is the inner quantifier at
%                every point of the sector
%
% and the sectors cover the line (sects_cover), so the outer fold is the
% outer quantifier.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_fast_def, walk_transfer

  F, P: VAR list[list[mpoly]]
  s: VAR Sect
  ss: VAR list[Sect]
  sg: VAR SG
  x, y: VAR real
  v: VAR SV
  q, q1: VAR bool
  Psi: VAR [SV -> bool]

  insec(s): [real -> bool] = LAMBDA x: in?(s, x)
  sok2?(s): bool = sect_ok(s) AND (mid?(s) IMPLIES value(lo(s)) < value(hi(s)))

  in_conv: LEMMA conv?(insec(s))
  cert_w: LEMMA wok_w(F, sg) IMPLIES cert?(F, sg)

  inv_sect: LEMMA sok2?(s) AND NOT at?(s)
    AND every(LAMBDA (c: mpoly): inv_chk(cpl(c), s))(ireads(F, s))
    IMPLIES inv?(F, insec(s), value(sample(s)), null[real])

  sect_delin: LEMMA sok2?(s) AND icert1?(F, s) IMPLIES delin?(F, s)

  sect_walk: LEMMA icert1?(F, s) IMPLIES
    (member(v, svs_w(F, asgS(s))) IFF fib(F, (: value(sample(s)) :))(v))

  sect_sem: LEMMA sok2?(s) AND icert1?(F, s) AND in?(s, x) IMPLIES
    (qfold(q, svs_w(F, asgS(s)), Psi) IFF sem((: q :), F, Psi, (: x :)))

  mem_ok: LEMMA gaps_ok(rts(P)) AND icert?(F, sects(rts(P))) AND member(s, sects(rts(P)))
    IMPLIES sok2?(s) AND icert1?(F, s) AND in?(s, value(sample(s)))

  foldw_sem: LEMMA gaps_ok(rts(P)) AND icert?(F, sects(rts(P))) IMPLIES
    (qfoldS(q1, sects(rts(P)), LAMBDA s: qfold(q, svs_w(F, asgS(s)), Psi)) IFF
     sem((: q1, q :), F, Psi, null))

  decw_correct: THEOREM decw(q1, q, F, Psi)`ok IMPLIES
    (decw(q1, q, F, Psi)`val IFF sem((: q1, q :), F, Psi, null))
END cad_fast
