alg_count2: THEORY
%----------------------------------------------------------------------------
% Forward bounds on the root count (Phase 6, for the corrected sector test).
%
% alg_count gives nroots_pos_intro (a root in the closed interval forces a
% count of at least one) and nroots_one_unique (a count of one forces the
% roots to coincide), but no bound from several distinct roots. The corrected
% between_free of sect_inv subtracts a root sitting exactly on a gap endpoint
% (bdry), so its soundness needs the case of a root at each endpoint plus one
% strictly inside: three distinct roots must force the count to be at least
% three. These are the forward bounds, read off the bijection nroots_a_bij
% through the cardinality of the root set. Kept out of alg_count, which is
% already gated.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_count

  pl: VAR Polylist
  lb, ub: VAR rat
  z1, z2, z3: VAR real
  n: VAR nat

  nroots_ge2: LEMMA deg(pl) > 0 AND lb < ub AND
    roots_in(pl, lb, ub)(z1) AND roots_in(pl, lb, ub)(z2) AND z1 /= z2
    IMPLIES nroots(pl, lb, ub) >= 2

  %% three distinct elements of a finite set force a cardinality of three
  three_card: LEMMA FORALL (S: finite_set[real]):
    S(z1) AND S(z2) AND S(z3) AND z1 /= z2 AND z1 /= z3 AND z2 /= z3
    IMPLIES card(S) >= 3

  %% the root set of a closed interval is finite (from the bijection)
  roots_finite: LEMMA deg(pl) > 0 AND lb < ub IMPLIES
    is_finite[real](roots_in_a(ipoly(pl), deg(pl), lb, ub))

  %% three distinct roots force a count of at least three
  nroots_ge3: LEMMA deg(pl) > 0 AND lb < ub AND
    roots_in(pl, lb, ub)(z1) AND roots_in(pl, lb, ub)(z2) AND roots_in(pl, lb, ub)(z3) AND
    z1 /= z2 AND z1 /= z3 AND z2 /= z3
    IMPLIES nroots(pl, lb, ub) >= 3
END alg_count2
