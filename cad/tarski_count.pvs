tarski_count: THEORY
%----------------------------------------------------------------------------
% The Tarski query of a symbolic pair, at a valuation (Phase 3).
%
% Tarski@sturmtarski computes the query
%     TQ(p, g) = #{roots of p where g > 0} - #{roots of p where g < 0}
% as the difference of the sign changes of the chain at minus and at plus
% infinity, and those are the signs of the leading coefficients, which the
% leaf of the symbolic construction carries.  tq_val is that difference for
% the chain of tarski_chain, written with the counts of sgn_count.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_chain, sgn_count

  cs: VAR list[list[mpoly]]
  l0, g: VAR list[mpoly]
  sl: VAR list[SL]
  ys: VAR list[real]
  i, k, n: VAR nat

  %% the two counts up to an explicit index
  nsc_hi_n(sl, n): nat = number_sign_changes(LAMBDA (i: nat): lsgn(sl, i), n)`num
  nsc_lo_n(sl, n): nat = number_sign_changes(LAMBDA (i: nat): lsgnlo(sl, i), n)`num

  %% for a chain whose elements up to n are nonempty, the counts of the real
  %% sequence are the counts of the signs the leaf carries
  ch_ok(cs, n): bool = n + 1 <= length(cs) AND
    (FORALL (i: nat): i <= n IMPLIES cons?(nthl(cs, i)))

  hi_eq_n: LEMMA ch_ok(cs, n) IMPLIES
    number_sign_changes(LAMBDA (i: nat): carr(cs, ys)(i)(cdeg(cs)(i)), n)`num =
    nsc_hi_n(slof(cs, ys), n)
  lo_eq_n: LEMMA ch_ok(cs, n) IMPLIES
    number_sign_changes(LAMBDA (i: nat):
      (IF even?(cdeg(cs)(i)) THEN 1 ELSE -1 ENDIF) * carr(cs, ys)(i)(cdeg(cs)(i)), n)`num =
    nsc_lo_n(slof(cs, ys), n)

  %% the chain of tarski_chain satisfies the hypothesis
  tch_ok: LEMMA tok(k, l0, g, ys) IMPLIES ch_ok(tchain(k, l0, g, ys), length(tchain(k, l0, g, ys)) - 2)

  %% the Tarski query
  tq(k, l0, g, ys): int =
    LET s = slof(tchain(k, l0, g, ys), ys) IN nsc_lo_n(s, mm(s)) - nsc_hi_n(s, mm(s))

  tq_val: THEOREM tok(k, l0, g, ys) IMPLIES
    tq(k, l0, g, ys) = NSol(earr(l0, ys), dg(l0), earr(g, ys), dg(g), >) -
                       NSol(earr(l0, ys), dg(l0), earr(g, ys), dg(g), <)
END tarski_count
