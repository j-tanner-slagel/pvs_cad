%----------------------------------------------------------------------------
% Recursive multivariate polynomials (design decision D1 of CAD_PLAN.md).
% A polynomial of level k is a polynomial in its main variable whose
% coefficients are polynomials of lower level; mconst is level 0.
%----------------------------------------------------------------------------
mpoly: DATATYPE
BEGIN
  mconst(mc: rat): mconst?
  mpol(coeffs: list[mpoly]): mpol?
END mpoly
