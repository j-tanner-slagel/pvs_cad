decide_u_def: THEORY
%----------------------------------------------------------------------------
% The complete n-level decision, executable part (COMPLETENESS_PLAN C8,
% part 5): decn_o with the escalation parameter raised from u until its
% certificate holds.  It stops because the certificate holds for every
% large enough u (decn_complete's decn_ev); that bound is never computed,
% it appears only in the termination measure.  Each failed attempt costs
% about one run of decn_o: the searches return their first success, so a
% larger u only spends fuel where the smaller one ran out.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decn_complete

  u, N: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  %% some u from which on the certificate holds (not computed)
  ubound(qs, F, Psi): nat =
    epsilon(LAMBDA (N: nat): FORALL u: u >= N IMPLIES decn_o(u, qs, F, Psi)`ok)
  umeas(qs, F, Psi, u): nat = IF u < ubound(qs, F, Psi) THEN ubound(qs, F, Psi) - u ELSE 0 ENDIF

  decn_u(qs, F, Psi, u): RECURSIVE [# ok: bool, val: bool #] =
    LET d = decn_o(u, qs, F, Psi) IN
    IF d`ok OR null?(qs) OR null?(cdr(qs)) THEN d ELSE decn_u(qs, F, Psi, u + 1) ENDIF
  MEASURE umeas(qs, F, Psi, u)
END decide_u_def
