decn_complete: THEORY
%----------------------------------------------------------------------------
% The n-level decision is complete (COMPLETENESS_PLAN C8, part 4).
%
% For every family and at least two quantifiers, decn_o(u, ...)`ok holds
% for every large enough u (decn_ev), so for some u (decn_complete).  From
% some u on the outer family is fixed (clos_ev's nclos_evc_fuel), hence so
% are its sectors; at each of the finitely many sectors the closed tower
% passes okn_o (okn_ev); the outer closure has left no bad read (nclos_ok's
% nclos_fix), so the top reads pass inv_chk (nbads_null); and the gaps of
% the sorted roots always pass (gaps_ok_incr).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING clos_ev, ev_nat[Sect]

  u, k: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  s: VAR Sect
  ss: VAR list[Sect]
  T0: VAR Tower
  R: VAR list[mpoly]

  badl_null: LEMMA FORALL R: null?(badl(s, R)) IMPLIES every(LAMBDA (c: mpoly): inv_chk(cpl(c), s))(R)
  nbads_null: LEMMA FORALL ss: null?(nbads_o(u, T0, ss)) AND member(s, ss) AND NOT at?(s) IMPLIES
    every(LAMBDA (c: mpoly): inv_chk(cpl(c), s))(topreads(lvln_o(u, T0, s), odS(s)))
  tw0_cons: LEMMA cons?(tw0(k, F))

  decn_ev: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES ev?(LAMBDA u: decn_o(u, qs, F, Psi)`ok)
  decn_complete: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES EXISTS u: decn_o(u, qs, F, Psi)`ok
END decn_complete
