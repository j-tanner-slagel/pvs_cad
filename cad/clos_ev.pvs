clos_ev: THEORY
%----------------------------------------------------------------------------
% The closures settle for large u (COMPLETENESS_PLAN C8, part 3).
%
% A closure round of a fixed tower is eventually constant (step_evc, from
% tower_ev and tables_evc), so K rounds are, for every fixed K (tclos_evc).
% tclos_o stops within the bound of tower_univ, after which more fuel
% changes nothing (tclos_stop); so lvln_o, whose fuel cfuel + u grows with
% u, is eventually constant too (lvln_evc), and its tower passes okn_o for
% every large u (okn_ev: the walk half from tower_ev, the closure half from
% clos_ok's fixp_clk).  The same for the outer closure: its bad reads at a
% fixed family are eventually constant (nbads_evc), it stops within
% nclos_ok's bound (nclos_stop), and so the outer family is eventually
% constant (nclos_evc_fuel).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tower_ev, ev_nat[list[list[mpoly]]]

  u, v, K, fuel: VAR nat
  T0, TW: VAR Tower
  Q, Q0: VAR list[list[mpoly]]
  od: VAR OD
  s: VAR Sect
  ss: VAR list[Sect]

  %% ---- the tower closure ------------------------------------------------------------------
  step_o(u, TW, od): Tower = zipadd(TW, treads_o(u, TW, tables(u, TW, od), od))
  step_evc: LEMMA cons?(TW) AND wf?(od) IMPLIES evc?(LAMBDA u: step_o(u, TW, od))
  tclos_unf: LEMMA tclos_o(u, fuel + 1, TW, od) =
    IF tsize(step_o(u, TW, od)) = tsize(TW) THEN TW ELSE tclos_o(u, fuel, step_o(u, TW, od), od) ENDIF
  tclos_evc: LEMMA FORALL K: FORALL TW: cons?(TW) AND wf?(od) IMPLIES evc?(LAMBDA u: tclos_o(u, K, TW, od))
  tclos_stop: LEMMA FORALL K: FORALL fuel, TW: tinv?(T0, TW) AND fuel >= K AND tsize(TW) + K > tbnd(T0)
    IMPLIES tclos_o(u, fuel, TW, od) = tclos_o(u, K, TW, od)
  lvln_evc: LEMMA cons?(T0) IMPLIES evc?(LAMBDA u: lvln_o(u, T0, s))
  okn_ev: LEMMA cons?(T0) IMPLIES
    ev?(LAMBDA u: okn_o(u, lvln_o(u, T0, s), tables(u, lvln_o(u, T0, s), odS(s)), odS(s)))

  %% ---- the outer closure ----------------------------------------------------------------------
  nclos_unf: LEMMA nclos_o(u, fuel + 1, T0, Q) =
    IF null?(nbads_o(u, T0, sects(rts(Q)))) THEN Q
    ELSIF length(addnew(Q, nbads_o(u, T0, sects(rts(Q))))) = length(Q) THEN Q
    ELSE nclos_o(u, fuel, T0, addnew(Q, nbads_o(u, T0, sects(rts(Q))))) ENDIF
  nbads_evc: LEMMA FORALL ss: cons?(T0) IMPLIES evc?(LAMBDA u: nbads_o(u, T0, ss))
  nclos_evc: LEMMA FORALL K: FORALL Q: cons?(T0) IMPLIES evc?(LAMBDA u: nclos_o(u, K, T0, Q))
  qinv_step: LEMMA u >= tbnd(T0) AND qinv?(T0, Q0, Q) IMPLIES
    qinv?(T0, Q0, addnew(Q, nbads_o(u, T0, sects(rts(Q)))))
  nclos_stop: LEMMA FORALL K: FORALL fuel, Q: u >= tbnd(T0) AND qinv?(T0, Q0, Q) AND fuel >= K
    AND length(Q) + K > length(Q0) + length(rwall(tul(T0)))
    IMPLIES nclos_o(u, fuel, T0, Q) = nclos_o(u, K, T0, Q)
  nclos_evc_fuel: LEMMA cons?(T0) IMPLIES evc?(LAMBDA u: nclos_o(u, cfuel + u, T0, Q0))
END clos_ev
