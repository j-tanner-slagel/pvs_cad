decide_u: THEORY
%----------------------------------------------------------------------------
% The escalating n-level decision is correct and complete (COMPLETENESS_PLAN
% C8, part 5).  decn_u returns the first decn_o record whose certificate
% holds, so its answer is decn_correct's; with at least two quantifiers some
% u from its start on certifies (decn_ev), so its certificate always holds.
% Both by induction on the termination measure.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decide_u_def

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  decn_u_correct: THEOREM decn_u(qs, F, Psi, u)`ok IMPLIES
    (decn_u(qs, F, Psi, u)`val IFF sem(qs, F, Psi, null[real]))
  decn_u_complete: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES decn_u(qs, F, Psi, u)`ok
END decide_u
