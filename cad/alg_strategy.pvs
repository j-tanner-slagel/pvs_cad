alg_strategy: THEORY
%----------------------------------------------------------------------------
% Support lemmas for the alg-roots strategy (Phase 2).
%
% alg-roots takes a univariate polynomial expression P in a variable X and
% adds to the sequent (1) the isolating intervals of all real roots of P:
%   P = 0 IMPLIES (lb_1 <= X AND X <= ub_1) OR ... OR (lb_k <= X AND X <= ub_k)
% and (2) for each root and each requested polynomial Q the sign of Q there:
%   lb_i <= X AND X <= ub_i AND P = 0 IMPLIES Q > 0   (or = 0, or < 0).
% Everything the strategy asserts is proved from these lemmas, ground
% evaluation (roots, alg_sign, alg?) and the reflection of Phase 1.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_isolate, alg_sign, mpoly_univ, mpoly_embed

  e: VAR PolyExpr
  x: VAR real
  pl, ql: VAR Polylist
  a: VAR Alg

  %% the Polylist of a univariate expression (variable 1 at position 0)
  upoly(e): Polylist = partial_eval(pto(e), null[rat])
  upoly_eval: LEMMA polylist(upoly(e))(x) = peval(e)(cons(x, null[rat]))

  %% every root lies in one of the isolating intervals
  root_interval: LEMMA deg(pl) > 0 AND polylist(pl)(x) = 0 IMPLIES
    EXISTS a: member(a, roots(pl)) AND a`lb <= x AND x <= a`ub

  %% the sign of q at the root isolated by a
  sign_at_root: LEMMA FORALL (b: alg): alg?(b) AND b`lb <= x AND x <= b`ub AND polylist(b`p)(x) = 0 IMPLIES
    sign3(polylist(ql)(x)) = alg_sign(b, ql)
END alg_strategy
