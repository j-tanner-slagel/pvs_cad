tarski_multi: THEORY
%----------------------------------------------------------------------------
% Any number of sign conditions at the roots of a polynomial (Phase 3).
%
% tarski_pair decides two conditions with four queries.  For m conditions the
% identity is 2^m N = sum over a in {1,2}^m of TQ(p, prod q_i^{a_i}), and the
% way to get it without indexing the 2^m exponent vectors is a recursion.
% Write T(p, P, f) for the number of roots of p at which every function in the
% list P is positive and f is positive, minus those at which every P is
% positive and f is negative --- the Tarski query restricted to the part of the
% root set that P cuts out.  Then
%     2 T(p, cons(q, P), f) = T(p, P, q f) + T(p, P, q^2 f),
% because at a root where q is positive the two terms agree and elsewhere they
% cancel.  Unrolling the recursion gives the 2^m queries, and T(p, P, 1) is
% the count that decides the conjunction.
%
% The step is pure finite-set cardinality and holds for arbitrary functions;
% only the base case (no conditions) needs the polynomials, where it is
% NASALib's Tarski query.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_pair

  a, g: VAR [nat -> real]
  m, k, i: VAR nat
  r, x: VAR real
  f, q: VAR [real -> real]
  P: VAR list[[real -> real]]
  rel: VAR [[real, real] -> bool]
  s1, s2: VAR PN

  %% the product of two functions, named so that no lambda has to be matched
  mulf(q, f): [real -> real] = LAMBDA (r: real): q(r) * f(r)
  mulf_val: LEMMA mulf(q, f)(r) = q(r) * f(r)

  %% every function of the list is positive at r
  allpos(P, r): bool = every(LAMBDA (u: [real -> real]): u(r) > 0)(P)
  allpos_null: LEMMA allpos(null[[real -> real]], r)
  allpos_cons: LEMMA allpos(cons(q, P), r) IFF (q(r) > 0 AND allpos(P, r))

  %% the roots cut out by P, with a sign condition on f
  RS(a, (m | a(m) /= 0), P, f, rel): finite_set[real] =
    {r: real | polynomial(a, m)(r) = 0 AND allpos(P, r) AND rel(f(r), 0)}
  T(a, (m | a(m) /= 0), P, f): int =
    card(RS(a, m, P, f, >)) - card(RS(a, m, P, f, <))

  %% the four parts of the root set by the signs of q and of f
  RS2(a, (m | a(m) /= 0), P, q, s1, f, s2): finite_set[real] =
    {r: real | polynomial(a, m)(r) = 0 AND allpos(P, r) AND
               okp(q(r), s1) AND okp(f(r), s2)}
  RS2_disj: LEMMA a(m) /= 0 AND (s1 /= 1 OR s2 /= 1) IMPLIES
    disjoint?(RS2(a, m, P, q, 1, f, 1), RS2(a, m, P, q, s1, f, s2))
  RS2_disj2: LEMMA a(m) /= 0 IMPLIES
    disjoint?(RS2(a, m, P, q, 1, f, -1), RS2(a, m, P, q, -1, f, 1)) AND
    disjoint?(RS2(a, m, P, q, 1, f, -1), RS2(a, m, P, q, -1, f, -1)) AND
    disjoint?(RS2(a, m, P, q, -1, f, 1), RS2(a, m, P, q, -1, f, -1))

  %% the six sets the step needs
  RS_qp: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, cons(q, P), f, >) = RS2(a, m, P, q, 1, f, 1)
  RS_qn: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, cons(q, P), f, <) = RS2(a, m, P, q, 1, f, -1)
  RS_1p: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, P, mulf(q, f), >) =
    union(RS2(a, m, P, q, 1, f, 1), RS2(a, m, P, q, -1, f, -1))
  RS_1n: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, P, mulf(q, f), <) =
    union(RS2(a, m, P, q, 1, f, -1), RS2(a, m, P, q, -1, f, 1))
  RS_2p: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, P, mulf(q, mulf(q, f)), >) =
    union(RS2(a, m, P, q, 1, f, 1), RS2(a, m, P, q, -1, f, 1))
  RS_2n: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, P, mulf(q, mulf(q, f)), <) =
    union(RS2(a, m, P, q, 1, f, -1), RS2(a, m, P, q, -1, f, -1))

  %% with no conditions the set is NASALib's, and the constant one never
  %% takes a negative value
  RS_null: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, null[[real -> real]], polynomial(g, k), rel) = Sol(a, m, g, k, rel)
  RS_one_lt: LEMMA a(m) /= 0 IMPLIES
    RS(a, m, P, LAMBDA (r: real): 1, <) = emptyset[real]

  %% the recursion
  T_step: THEOREM a(m) /= 0 IMPLIES
    2 * T(a, m, cons(q, P), f) =
    T(a, m, P, mulf(q, f)) + T(a, m, P, mulf(q, mulf(q, f)))

  %% the base case is NASALib's Tarski query
  T_base: LEMMA a(m) /= 0 IMPLIES
    T(a, m, null[[real -> real]], polynomial(g, k)) =
    NSol(a, m, g, k, >) - NSol(a, m, g, k, <)

  %% and the count with the constant one decides the conjunction
  T_one: LEMMA a(m) /= 0 IMPLIES
    T(a, m, P, LAMBDA (r: real): 1) = card(RS(a, m, P, LAMBDA (r: real): 1, >))
  T_exists: THEOREM a(m) /= 0 IMPLIES
    ((EXISTS (r: real): polynomial(a, m)(r) = 0 AND allpos(P, r))
     IFF T(a, m, P, LAMBDA (r: real): 1) > 0)
END tarski_multi
