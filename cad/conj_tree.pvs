conj_tree: THEORY
%----------------------------------------------------------------------------
% One conjunct of sign conditions, decided on a tree (Phase 3).
%
% A conjunct is a list E of equations and a list Q of strict inequalities.
% The equations collapse into one, sqsum(E) = 0 (qe_conj), and ctree branches
% on the degree of that polynomial: if it normalizes to nothing every x
% satisfies every equation and the question is ineq_tree's; if it is a
% nonzero constant there is no root; and otherwise it has positive degree
% with a known nonvanishing leading coefficient, which is what many_tree's
% mcore needs.  ctree_sound needs only the syntactic fuel bound
%     length(sqsum(E)) + 2 mlen(Q) + 1 <= k,
% a function of the conjunct that a strategy computes by evaluation.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING ineq_tree

  l: VAR list[mpoly]
  E, Q: VAR list[list[mpoly]]
  ys: VAR list[real]
  k: VAR nat
  x: VAR real

  %% the equations hold at x exactly when the normalized sum of squares
  %% vanishes there
  eqs_at(E, ys, x): bool =
    every(LAMBDA (u: list[mpoly]): meval(mpol(u))(cons(x, ys)) = 0)(E)
  ceq_val: LEMMA meval(mpol(select(snorm(sqsum(E)), ys)))(cons(x, ys)) = 0 IFF eqs_at(E, ys, x)

  %% the three cases of the normalized sum of squares
  ceq_null: LEMMA null?(select(snorm(sqsum(E)), ys)) IMPLIES eqs_at(E, ys, x)
  ceq_const: LEMMA length(select(snorm(sqsum(E)), ys)) = 1 IMPLIES NOT eqs_at(E, ys, x)
  ceq_lok: LEMMA cons?(select(snorm(sqsum(E)), ys)) IMPLIES lok(select(snorm(sqsum(E)), ys), ys)

  %% the decision
  ctree(k, E, Q): btree[bool] =
    bbind(snormp(sqsum(E)), LAMBDA (p0: SL):
      IF null?(p0`slist) THEN itree(k, Q)
      ELSIF length(p0`slist) = 1 THEN bleaf(FALSE)
      ELSE mcore(k, p0, Q)
      ENDIF)

  ctree_sound: THEOREM length(sqsum(E)) + 2 * mlen(Q) + 1 <= k IMPLIES
    (select(ctree(k, E, Q), ys) IFF
     (EXISTS (x: real): eqs_at(E, ys, x) AND allgt(Q, ys, x)))
END conj_tree
