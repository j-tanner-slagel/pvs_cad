level_ok: THEORY
%----------------------------------------------------------------------------
% Two inner quantifiers at a FIXED point (FINISH_PLAN stage S5d, claim A).
%
%   inner2_sem   in2ok?(F, msg(ys)) IMPLIES
%                  (inner2(q2, q3, F, Psi, msg(ys)) IFF sem((: q2, q3 :), F, Psi, ys))
%
% at ANY real valuation ys of the outer variables.  The level's walk over P
% gives rational separators; its cells are the separators and the sections of
% the gaps that hold a root.  cell_ok reads the inner quantifier's truth at
% each cell.  What is left is that the cells COVER the line:
%
%   T_same   on an interval where the product of P has no root, the truth of
%            the inner sentence is that at the separator inside it.  This is
%            the transfer theorem fib_const in the y-direction with ys held
%            fixed: the inner walk's intrinsic reads are MEMBERS of P (clok?),
%            so they keep their signs where P's product has no root
%            (mem_same), which is fib_const's hypothesis.
%
% The rest mirrors walk_ok one level up, with the truth value T(y) in the
% place of the sign vector.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cell_ok, cad_fast

  ys, ys1, ys2: VAR list[real]
  F, P: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  q, q2, q3, b0: VAR bool
  bs: VAR list[bool]
  R: VAR list[mpoly]
  r: VAR mpoly
  Y: VAR list[rat]
  y0, lo, hi: VAR rat
  y, a, b, z, beta: VAR real
  v: VAR SV

  %% the truth of the inner sentence over the point (y, ys)
  T(q3, F, Psi, ys)(y): bool = sem((: q3 :), F, Psi, cons(y, ys))

  sem1_fibs: LEMMA (FORALL v: fib(F, ys1)(v) IFF fib(F, ys2)(v)) IMPLIES
    (sem((: q :), F, Psi, ys1) IFF sem((: q :), F, Psi, ys2))

  %% ---- no root of the level's product between two points ---------------------------
  rootfree?(P, ys, a, b): bool =
    FORALL z: min(a, b) <= z AND z <= max(a, b) IMPLIES P(P, ys)(z) /= 0
  Srf(P, ys, y0): [real -> bool] = LAMBDA y: rootfree?(P, ys, y0, y)

  rf_conv: LEMMA conv?(Srf(P, ys, y0))
  rf_refl: LEMMA P(P, ys)(y0) /= 0 IMPLIES Srf(P, ys, y0)(y0)
  clok_mem: LEMMA FORALL R: clok?(P, R) AND member(r, R) IMPLIES member(as_list(r), P)
  rf_inv: LEMMA clok?(P, wi_rd(F, msg(cons(y0, ys)))) IMPLIES
    inv?(F, Srf(P, ys, y0), y0, ys)

  T_same: LEMMA ptok?(F, msg(ys), P, y0) AND P(P, ys)(y0) /= 0 AND rootfree?(P, ys, y0, y)
    IMPLIES (T(q3, F, Psi, ys)(y) IFF T(q3, F, Psi, ys)(y0))

  %% ---- the value read at a cell ------------------------------------------------------
  T_pt: LEMMA ptok?(F, msg(ys), P, y0) IMPLIES
    (qfold(q3, svs_w(F, sg_pt(msg(ys), y0)), Psi) IFF T(q3, F, Psi, ys)(y0))
  T_sec: LEMMA lvl?(P, ys, lo, hi, beta) AND secok?(F, msg(ys), P, lo, hi) IMPLIES
    (qfold(q3, svs_w(F, sg_sec(msg(ys), P, lo, hi)), Psi) IFF T(q3, F, Psi, ys)(beta))

  %% ---- the list of cell values --------------------------------------------------------
  cv(q3, F, Psi, P, ys, Y): list[bool] = cellvals(q3, F, Psi, P, msg(ys), Y)

  cv_hd: LEMMA cons?(Y) AND cellok?(F, P, msg(ys), Y) IMPLIES
    member(T(q3, F, Psi, ys)(car(Y)), cv(q3, F, Psi, P, ys, Y))
  cv_tl: LEMMA cons?(Y) AND cons?(cdr(Y)) AND member(b0, cv(q3, F, Psi, P, ys, cdr(Y)))
    IMPLIES member(b0, cv(q3, F, Psi, P, ys, Y))
  cv_sec: LEMMA cons?(Y) AND cons?(cdr(Y)) AND gap?(P, msg(ys), car(Y), car(cdr(Y)))
    IMPLIES member(qfold(q3, svs_w(F, sg_sec(msg(ys), P, car(Y), car(cdr(Y)))), Psi),
                   cv(q3, F, Psi, P, ys, Y))
  cellok_cdr: LEMMA cons?(Y) AND cons?(cdr(Y)) AND cellok?(F, P, msg(ys), Y)
    IMPLIES cellok?(F, P, msg(ys), cdr(Y)) AND ptok?(F, msg(ys), P, car(Y))
      AND (gap?(P, msg(ys), car(Y), car(cdr(Y))) IMPLIES secok?(F, msg(ys), P, car(Y), car(cdr(Y))))

  %% one gap: every y in it is read by one of its at most three cells
  cv_gap: LEMMA cons?(Y) AND cons?(cdr(Y)) AND yok?(P, ys, Y) AND cons?(lives(P))
    AND slc?(bk(P), msg(ys), bprod(P)) AND cellok?(F, P, msg(ys), Y) AND car(Y) <= y AND y <= car(cdr(Y))
    IMPLIES member(T(q3, F, Psi, ys)(y), cv(q3, F, Psi, P, ys, Y))

  cv_mid: LEMMA FORALL Y: cons?(Y) AND yok?(P, ys, Y) AND cons?(lives(P))
    AND slc?(bk(P), msg(ys), bprod(P)) AND cellok?(F, P, msg(ys), Y) AND car(Y) <= y AND y <= rlast(Y)
    IMPLIES member(T(q3, F, Psi, ys)(y), cv(q3, F, Psi, P, ys, Y))

  cv_last: LEMMA FORALL Y: cons?(Y) AND cellok?(F, P, msg(ys), Y) IMPLIES
    member(T(q3, F, Psi, ys)(rlast(Y)), cv(q3, F, Psi, P, ys, Y))

  cv_sound: LEMMA FORALL Y: yok?(P, ys, Y) AND (null?(lives(P)) OR slc?(bk(P), msg(ys), bprod(P)))
    AND cellok?(F, P, msg(ys), Y)
    AND member(b0, cv(q3, F, Psi, P, ys, Y))
    IMPLIES EXISTS y: b0 = T(q3, F, Psi, ys)(y)

  cellok_hd: LEMMA cons?(Y) AND cellok?(F, P, msg(ys), Y) IMPLIES ptok?(F, msg(ys), P, car(Y))
  cellok_last: LEMMA FORALL Y: cons?(Y) AND cellok?(F, P, msg(ys), Y)
    IMPLIES ptok?(F, msg(ys), P, rlast(Y))

  %% the whole line
  cv_all: THEOREM wok?(P, msg(ys), Y) AND cellok?(F, P, msg(ys), Y) IMPLIES
    (member(b0, cv(q3, F, Psi, P, ys, Y)) IFF EXISTS y: b0 = T(q3, F, Psi, ys)(y))

  bfold_mem: LEMMA FORALL bs: bfold(q, bs) IFF
    IF q THEN (FORALL b0: member(b0, bs) IMPLIES b0) ELSE (EXISTS b0: member(b0, bs) AND b0) ENDIF

  inner2_sem: THEOREM in2ok?(F, msg(ys)) IMPLIES
    (inner2(q2, q3, F, Psi, msg(ys)) IFF sem((: q2, q3 :), F, Psi, ys))
END level_ok
