cad_found_ok: THEORY
%----------------------------------------------------------------------------
% cad_found always returns a CAD (GAP_PLAN.md Tier 1, the complete CAD
% algorithm).
%
% cadu_ok: the u that cad_outu returns passes the run's certificate (the
% measure induction of decn_u_complete, with decn_u's termination lemma).
% cadu_recs: its records are cad_out at that u.  cad_found_cad: for two or
% more variables cad_found returns a CAD adapted to F (cad_of?, from
% cad_verified), and cad_found_decides: its records decide every sentence
% over F in the same variables, in the same order (from cad_decides).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_found_def, cad_verified, decide_u

  u: VAR nat
  qs, qs2: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi2: VAR [SV -> bool]

  cadu_ok: LEMMA cons?(qs) AND cons?(cdr(qs)) IMPLIES decn_o(cad_outu(qs, F, u)`fu, qs, F, psi_any)`ok
  cadu_recs: LEMMA cad_outu(qs, F, u)`frecs = cad_out(cad_outu(qs, F, u)`fu, qs, F)

  cad_found_cad: THEOREM length(qs) >= 2 IMPLIES
    cad_of?(cad_found(qs, F)`fu, qs, F) AND cad_found(qs, F)`frecs = cad_out(cad_found(qs, F)`fu, qs, F)
  cad_found_decides: THEOREM length(qs) >= 2 AND length(qs2) = length(qs) IMPLIES
    (cfold(qs2, Psi2, cad_found(qs, F)`frecs) IFF sem(qs2, F, Psi2, null[real]))
END cad_found_ok
