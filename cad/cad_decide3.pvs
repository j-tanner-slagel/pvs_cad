cad_decide3: THEORY
%----------------------------------------------------------------------------
% The decision behind (cad) is correct (FINISH_PLAN stage S4).
%
%   decide3_correct   decide3(reverse(os), F, phi)`ok IMPLIES
%                       (decide3(reverse(os), F, phi)`val IFF fsem(os, F, phi, null))
%
% the same statement as decide2_correct, so the strategy cites it in the same
% place.  The fast branch is decw_correct, the other branches decq2_correct.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide3_def, cad_fast

  qs, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  rev2: LEMMA length(qs) = 2 IMPLIES reverse(qs) = (: car(cdr(qs)), car(qs) :)

  decq3_correct: THEOREM decq3(qs, F, Psi)`ok IMPLIES
    (decq3(qs, F, Psi)`val IFF sem(reverse(qs), F, Psi, null))

  decide3_correct: THEOREM decide3(reverse(os), F, phi)`ok IMPLIES
    (decide3(reverse(os), F, phi)`val IFF fsem(os, F, phi, null))
END cad_decide3
