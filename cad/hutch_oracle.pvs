hutch_oracle: THEORY
%----------------------------------------------------------------------------
% The sign of a coefficient under the conditions on its path, decided by
% NASALib's hutch (Phase 3).
%
% sign_oracle decides the sign with the library's own one-variable QE, which
% rebuilds Sturm chains of products of the conditions at every node and has
% no content stripping.  Tarski@hutch decides the same question --- is there
% a value of the parameter at which every condition of the path holds and c
% is not positive --- by a sign-invariant interval decomposition on integer
% chains, which is what a one-variable CAD is.  forced2(c, cx) asks it three
% times, once per sign, and forced2_sound is the same statement as
% forced_sound: a decided sign is the sign at every valuation the conditions
% admit.  The bridge is qarr, the rational coefficient array of a univariate
% list, and qarr_poly, which reads NASALib's polynomial of it as meval.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sign_oracle, Tarski@hutch

  L: VAR list[mpoly]
  c: VAR mpoly
  l: VAR list[list[mpoly]]
  cd: VAR branch_tree[bool].SignCond
  cx: VAR list[branch_tree[bool].SignCond]
  i, j, k: VAR nat
  x: VAR real
  ys: VAR list[real]
  r: VAR subrange(0, 5)

  %% the rational coefficient array of a univariate list
  qarr(L)(i): rat = IF i < length(L) AND mconst?(nth(L, i)) THEN mc(nth(L, i)) ELSE 0 ENDIF
  qarr_earr: LEMMA ulist?(L) IMPLIES qarr(L)(i) = earr(L, null[real])(i)
  qarr_fun: LEMMA ulist?(L) IMPLIES qarr(L) = earr(L, null[real])
  qarr_poly: LEMMA ulist?(L) AND cons?(L) IMPLIES
    polynomial(qarr(L), dg(L))(x) = meval(mpol(L))(cons(x, null[real]))

  %% a list hutch accepts: univariate, of positive degree, with a nonzero
  %% leading coefficient
  good?(L): bool = ulist?(L) AND length(L) >= 2 AND qarr(L)(dg(L)) /= 0
  allgood?(l): bool = every(good?)(l)
  allgood_nth: LEMMA allgood?(l) AND j < length(l) IMPLIES good?(nth(l, j))

  %% the system: the conditions' lists, then c, with their relations
  %% (rel5: 0 is =, 1 is >, 2 is <, 3 is /=, 4 is >=, 5 is <=)
  plist(c, cx): list[list[mpoly]] =
    append(map(LAMBDA (d: branch_tree[bool].SignCond): as_list(d`cpol))(cx), (: as_list(c) :))
  code(cd): subrange(0, 5) = IF cd`csign = 0 THEN 0 ELSIF cd`csign = 1 THEN 1 ELSE 2 ENDIF
  rels(cx): list[subrange(0, 5)] = map(code)(cx)
  plist_length: LEMMA length(plist(c, cx)) = length(cx) + 1
  plist_nth: LEMMA j < length(cx) IMPLIES nth(plist(c, cx), j) = as_list(nth(cx, j)`cpol)
  plist_last: LEMMA nth(plist(c, cx), length(cx)) = as_list(c)
  rels_nth: LEMMA j < length(cx) IMPLIES nth(rels(cx), j) = code(nth(cx, j))

  %% the arrays hutch takes
  pq(l)(j)(i): rat = IF j < length(l) THEN qarr(nth(l, j))(i) ELSE 0 ENDIF
  degs(l)(j): nat = IF j < length(l) THEN dg(nth(l, j)) ELSE 1 ENDIF
  relf(rs: list[subrange(0, 5)], r)(i): subrange(0, 5) = IF i < length(rs) THEN nth(rs, i) ELSE r ENDIF
  degs_ok: LEMMA allgood?(l) AND j < length(l) IMPLIES pq(l)(j)(degs(l)(j)) /= 0 AND degs(l)(j) > 0
  conj_be(k): BoolExpr(k) = LAMBDA (bt: BoolTuple(k)): FORALL (i: upto(k)): bt(i)

  %% is there a value the conditions admit at which c stands in relation r
  %% to zero; TRUE when hutch cannot be asked, so that nothing is forced
  sat(c, cx, r): bool =
    IF NOT allgood?(plist(c, cx)) THEN TRUE
    ELSE hutch(FALSE, length(cx), length(cx), conj_be(length(cx)), relf(rels(cx), r),
               LAMBDA (i: upto(length(cx))): i, pq(plist(c, cx)), degs(plist(c, cx)))
    ENDIF

  %% a condition of the path is the relation of its code at the head
  cond_rel: LEMMA good?(as_list(cd`cpol)) IMPLIES
    (branch_tree[bool].cond_holds(cd, ys) IFF
     rel5(code(cd))(polynomial(qarr(as_list(cd`cpol)), dg(as_list(cd`cpol)))(hd(ys)), 0))
  conds_hold_nth: LEMMA FORALL (cx: list[branch_tree[bool].SignCond]): FORALL (j: nat, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) AND j < length(cx) IMPLIES
    branch_tree[bool].cond_holds(nth(cx, j), ys)
  sat_sound: LEMMA NOT sat(c, cx, r) AND branch_tree[bool].conds_hold(cx, ys) IMPLIES
    NOT rel5(r)(meval(c)(ys), 0)

  forced2(c, cx): int =
    IF NOT sat(c, cx, 5) THEN 1
    ELSIF NOT sat(c, cx, 4) THEN -1
    ELSIF NOT sat(c, cx, 3) THEN 0
    ELSE 2
    ENDIF
  forced2_range: LEMMA forced2(c, cx) = -1 OR forced2(c, cx) = 0 OR forced2(c, cx) = 1 OR forced2(c, cx) = 2
  forced2_sound: THEOREM forced2(c, cx) /= 2 AND branch_tree[bool].conds_hold(cx, ys)
    IMPLIES branch_tree[bool].msign(c, ys) = forced2(c, cx)
END hutch_oracle
