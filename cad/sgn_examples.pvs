sgn_examples: THEORY
%----------------------------------------------------------------------------
% The sign-condition decision run by the strategies (Phase 3).
%
% poly-sign reads the branches of sdecide (sgn_prune) and adds, for every branch on which the
% polynomial has a root where the query is positive, the implication from that
% branch's sign conditions to the statement about the reals.  poly-nosign does
% the same for the branches on which it has none.  The facts are proved from
% psign_branch / pnosign_branch (sgn_prune's sdecide), the ground evaluation of the tree and the
% reflection of Phase 1, so nothing is trusted.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sgn_prune, mpoly_embed

  a, b: VAR real

  %% a root of x^2 - 1 where x is positive
  g1: LEMMA EXISTS (x: real): x^2 - 1 = 0 AND x > 0

  %% no root of x^2 + 1 at all, so none where x is positive
  g2: LEMMA NOT (EXISTS (x: real): x^2 + 1 = 0 AND x > 0)

  %% a parameter: x - a has a positive root exactly when a is positive, and
  %% the tree says so on both sides
  g3: LEMMA a > 0 IMPLIES (EXISTS (x: real): x - a = 0 AND x > 0)
  g4: LEMMA a <= 0 IMPLIES NOT (EXISTS (x: real): x - a = 0 AND x > 0)

  %% a positive number has a positive square root, decided by the tree
  g5: LEMMA a > 0 IMPLIES (EXISTS (x: real): x^2 - a = 0 AND x > 0)

  %% a parameter with no positive root on the branch the hypothesis selects: the
  %% contradiction needs poly-nosign's fact (assert alone does not see x^2 + a /= 0); g4
  %% above is linear, so assert closes it without the tree
  g6: LEMMA a > 0 IMPLIES NOT (EXISTS (x: real): x^2 + a = 0 AND x > 0)
END sgn_examples
