mpoly_swap: THEORY
%----------------------------------------------------------------------------
% Exchanging the two variables of a bivariate mpoly (item A, step A1).
%
% mpoly's res eliminates the MAIN variable.  Lifting at an algebraic sample
% has to eliminate the SECOND one: for a member f(y, x) and a coordinate alpha
% that is a root of a rational p(x), Res_x(p, f) is a polynomial in y with
% RATIONAL coefficients whose roots include every y with f(y, alpha) = 0.  So
% the candidate roots stay over Q and the existing root isolation applies.
% That is the whole reason Q(alpha) can be avoided -- and it needs the swap.
%
% The swap is a transpose of the rational coefficient MATRIX
%
%     m[i][j] = coefficient of y^i x^j,
%
% and keeping it at that level is deliberate: over a matrix of rationals the
% correctness proof is an interchange of two finite sums, where over the mpoly
% datatype it would be a double induction.  pev is a total Horner evaluation
% on list[rat] (Sturm's Polylist is nonempty, and columns get built up from
% nothing), bridged to polylist once, at the end.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_univ

  a: VAR rat
  l, r, t: VAR list[rat]
  x, y: VAR real
  f: VAR list[mpoly]
  u: VAR mpoly
  m, cols: VAR list[list[rat]]
  w: VAR nat

  %% ---- a cons law for Sturm's polylist, which it does not carry ------
  rpl(l): mpoly = mpol(map(mconst)(l))
  pl_mconst:   LEMMA FORALL l: partial_list(map(mconst)(l), null[rat]) = l
  rpl_partial: LEMMA cons?(l) IMPLIES partial_eval(rpl(l), null[rat]) = l
  polylist_cons: LEMMA cons?(t)
    IMPLIES polylist(cons(a, t))(x) = a + x * polylist(t)(x)

  %% total Horner evaluation, so the empty column is not a special case
  pev(l, x): RECURSIVE real =
    IF null?(l) THEN 0 ELSE car(l) + x * pev(cdr(l), x) ENDIF
  MEASURE length(l)

  pev_polylist: LEMMA cons?(l) IMPLIES pev(l, x) = polylist(l)(x)

  %% Horner in the padded form mcons uses, so the recursion step never has to
  %% case-split pev by hand.  Blanket (expand "pev") in the middle of the
  %% induction buries the ring identity under nested IFs; this keeps it out.
  pev_hdtl: LEMMA pev(l, x) = (IF null?(l) THEN 0 ELSE car(l) ENDIF)
    + x * pev(IF null?(l) THEN null[rat] ELSE cdr(l) ENDIF, x)

  %% ---- the coefficient matrix ----------------------------------------
  prow(u): list[rat] = partial_eval(u, null[rat])
  pmat(f): list[list[rat]] = map(prow)(f)

  prow_eval: LEMMA pev(prow(u), x) = meval(u)((: x :))

  %% bev(m, x, y) = sum_i pev(m_i, x) * y^i
  bev(m, x, y): RECURSIVE real =
    IF null?(m) THEN 0 ELSE pev(car(m), x) + y * bev(cdr(m), x, y) ENDIF
  MEASURE length(m)

  mpol_bev: LEMMA meval(mpol(f))(cons(y, (: x :))) = bev(pmat(f), x, y)

  %% ---- the transpose --------------------------------------------------
  zcols(w): RECURSIVE list[list[rat]] =
    IF w = 0 THEN null[list[rat]] ELSE cons((: 0 :), zcols(w - 1)) ENDIF
  MEASURE w

  %% prepend one row to a list of columns, padding the row with zeros
  mcons(r, cols): RECURSIVE list[list[rat]] =
    IF null?(cols) THEN null[list[rat]]
    ELSE cons(cons(IF null?(r) THEN 0 ELSE car(r) ENDIF, car(cols)),
              mcons(IF null?(r) THEN null[rat] ELSE cdr(r) ENDIF, cdr(cols)))
    ENDIF
  MEASURE length(cols)

  transp(m, w): RECURSIVE list[list[rat]] =
    IF null?(m) THEN zcols(w) ELSE mcons(car(m), transp(cdr(m), w)) ENDIF
  MEASURE length(m)

  %% every row fits in w columns
  fits?(m, w): RECURSIVE bool =
    IF null?(m) THEN TRUE ELSE length(car(m)) <= w AND fits?(cdr(m), w) ENDIF
  MEASURE length(m)

  fits_mono: LEMMA FORALL m, w: FORALL (v: nat): fits?(m, w) AND w <= v
    IMPLIES fits?(m, v)
  zcols_length: LEMMA length(zcols(w)) = w
  zcols_bev:    LEMMA bev(zcols(w), y, x) = 0
  zcols_cons:   LEMMA FORALL w: every(LAMBDA l: cons?(l))(zcols(w))
  mcons_length: LEMMA length(mcons(r, cols)) = length(cols)
  mcons_cons:   LEMMA every(LAMBDA l: cons?(l))(mcons(r, cols))
  transp_length: LEMMA FORALL m, w: length(transp(m, w)) = w
  transp_cons:   LEMMA FORALL m, w: every(LAMBDA l: cons?(l))(transp(m, w))

  %% THE INTERCHANGE, one row at a time
  mcons_bev: LEMMA FORALL cols, r: length(r) <= length(cols)
    IMPLIES bev(mcons(r, cols), y, x) = pev(r, x) + y * bev(cols, y, x)

  transp_bev: LEMMA FORALL m, w: fits?(m, w)
    IMPLIES bev(transp(m, w), y, x) = bev(m, x, y)

  %% ---- the swap --------------------------------------------------------
  wid(m): RECURSIVE nat =
    IF null?(m) THEN 0 ELSE max(length(car(m)), wid(cdr(m))) ENDIF
  MEASURE length(m)

  wid_fits: LEMMA FORALL m: fits?(m, wid(m))

  mswap(f): list[mpoly] = map(rpl)(transp(pmat(f), wid(pmat(f))))

  map_prow_rpl: LEMMA FORALL m: every(LAMBDA l: cons?(l))(m)
    IMPLIES map(prow)(map(rpl)(m)) = m

  pmat_mswap: LEMMA pmat(mswap(f)) = transp(pmat(f), wid(pmat(f)))

  %% THE THEOREM
  mswap_eval: THEOREM meval(mpol(mswap(f)))(cons(x, (: y :)))
                    = meval(mpol(f))(cons(y, (: x :)))
END mpoly_swap
