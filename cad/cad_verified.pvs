cad_verified: THEORY
%----------------------------------------------------------------------------
% THE RUN COMPUTES A CYLINDRICAL ALGEBRAIC DECOMPOSITION ADAPTED TO F
% (GAP_PLAN.md Tier 1; Basu-Pollack-Roy, Def. 5.1), returned as data.
%
% cad_of?(u, qs, F) collects what decn_o's run at u provides for the family
% F in k + 1 = length(qs) variables.  Its cells of R^(j+1), j <= k, are
% rcell(s, A), for s among the run's sectors of the line and A a list of j
% stack indices (most A name empty cells):
%   - the cells of R^(k+1) cover it and two of them meet only if they are the
%     same;
%   - every cell, at every level, is connected and definable by a
%     first-order formula over the reals with rational polynomial sign atoms
%     (so also without quantifiers, by qelim_ok's fod_qfd, the
%     Tarski-Seidenberg theorem; cad_sa's cad_cells_sa states it for these
%     cells: semi-algebraic, indeed defined over Q);
%   - over each sector the tower is a CAD (cad_over?): every level is
%     delineable over every cell below it (delin_cl?: the roots of the
%     members not identically zero on the fibre are a constant number of
%     continuous, strictly ordered functions, and every member has one sign
%     on each section and band), and its cells are those sections and bands;
%   - the graph of every such root function over a cell of the level below
%     is definable too;
%   - every polynomial of F has one sign on every cell of R^(k+1);
%   - cad_out returns at least one record for each nonempty cell of R^(k+1)
%     (a band holding several separators gets several) and none for any
%     other, each with a sample point in its cell and F's sign vector there
%     -- so the nonempty cells are finitely many.
% cad_verified: this holds whenever decn_o's certificate does.  cad_exists:
% for every F and prefix of at least two quantifiers some u makes it hold.
% Def. 5.1 asks for a partition at every level; cad_of? states cover and
% disjointness for the cells of R^(k+1), and at the lower levels they
% follow from the stack construction (cad_tower's tcell_cover, tcell_disj)
% without being restated here.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING rcf_cells, cad_sample

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  s, s1, s2: VAR Sect
  A, A1, A2: VAR list[nat]
  p, p1, p2, q: VAR list[real]
  r: VAR ORec

  cad_of?(u, qs, F): bool = cons?(qs) AND
    LET k = length(cdr(qs)), ss = runsects(u, k, F) IN
        (FORALL p: length(p) = k + 1 IMPLIES
           EXISTS s, A: member(s, ss) AND length(A) = k AND rcell(u, k, F)(s, A)(p))
    AND (FORALL p, s1, s2, A1, A2: member(s1, ss) AND member(s2, ss)
           AND length(A1) = k AND length(A2) = k
           AND rcell(u, k, F)(s1, A1)(p) AND rcell(u, k, F)(s2, A2)(p)
           IMPLIES s1 = s2 AND A1 = A2)
    AND (FORALL s, A: member(s, ss) AND length(A) <= k IMPLIES
           conn?(rcell(u, k, F)(s, A)) AND fod?(1 + length(A))(rcell(u, k, F)(s, A)))
    AND (FORALL s: member(s, ss) IMPLIES cad_over?(runtw(u, k, F)(s), scell(s)))
    AND (FORALL s, A, (i: nat): member(s, ss) AND length(A) < k
           AND (FORALL q: rcell(u, k, F)(s, A)(q) IMPLIES i < nroot(nth(runtw(u, k, F)(s), length(A)), q))
           IMPLIES fod?(2 + length(A))
             (LAMBDA p: cons?(p) AND rcell(u, k, F)(s, A)(cdr(p))
                        AND car(p) = rt(nth(runtw(u, k, F)(s), length(A)), cdr(p), i)))
    AND (FORALL s, A, p1, p2: member(s, ss) AND length(A) = k
           AND rcell(u, k, F)(s, A)(p1) AND rcell(u, k, F)(s, A)(p2)
           IMPLIES svec(F, p1) = svec(F, p2))
    AND (FORALL r: member(r, cad_out(u, qs, F)) IMPLIES
           member(r`rsec, ss) AND length(r`radr) = k
           AND rcell(u, k, F)(r`rsec, r`radr)(den(r`rsod))
           AND r`rsv = svec(F, den(r`rsod)))
    AND (FORALL s, A: member(s, ss) AND length(A) = k AND (EXISTS q: rcell(u, k, F)(s, A)(q))
           IMPLIES EXISTS r: member(r, cad_out(u, qs, F)) AND r`rsec = s AND r`radr = A)

  cad_verified: THEOREM decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 IMPLIES cad_of?(u, qs, F)
  cad_exists: THEOREM length(qs) >= 2 IMPLIES EXISTS u: cad_of?(u, qs, F)
END cad_verified
