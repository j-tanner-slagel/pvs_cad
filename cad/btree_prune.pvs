btree_prune[T: TYPE]: THEORY
%----------------------------------------------------------------------------
% Removing the decided branches of a tree (Phase 3).
%
% Almost every node of a symbolic Sturm-Tarski tree asks for the sign of a
% coefficient that does not depend on the parameters at all: the construction
% produces numbers, and only a few of the coefficients keep a parameter.  The
% sign of a number is decided, so the node can be replaced by the child that
% sign selects.  prune does that everywhere and select_prune says the branch
% the parameters take is unchanged, so every soundness theorem about select
% carries over to the pruned tree, and the list of branches a strategy has to
% consider becomes short: for a polynomial with no parameters it is one.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING branch_tree[T], mpoly_cst

  t: VAR btree[T]
  ys: VAR list[real]
  c: VAR mpoly
  v: VAR T

  prune(t): RECURSIVE btree[T] =
    CASES t OF
      bleaf(v): bleaf(v),
      bnode(c, n, z, p):
        IF mcst?(c)
          THEN IF cst_val(c) = 0 THEN prune(z)
               ELSIF cst_val(c) > 0 THEN prune(p)
               ELSE prune(n)
               ENDIF
        ELSE bnode(c, prune(n), prune(z), prune(p))
        ENDIF
    ENDCASES
  MEASURE t BY <<

  select_prune: THEOREM select(prune(t), ys) = select(t, ys)
END btree_prune
