cad_meas4: THEORY
%----------------------------------------------------------------------------
% SCRATCH: is the HYBRID affordable?  The Bath problems have an algebraic
% coordinate at the OUTERMOST level (cad-bench: outer-level-rational=FALSE),
% and svs_pt is typed on list[rat] -- it cannot represent one.  The existing
% PROVED machinery handles algebraic points a different way: by sign FUNCTION
% (asgS at level 1 via alg_sign2, sgv at deeper levels) rather than by
% coordinates, which is what cad_lift's lv/over do.
%
% So mirror lv on the PROJECTION family instead of the read closure, keeping
% svsec's dispatch: svs_pt at a rational sector, svs_sg at a root sector.
% svs_sg is 3^|F|, but on the PROJECTION family, not the closure's -- measured
% 20132 reads against the closure family's 190411.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_pdec, cad_meas

  F, P: VAR list[list[mpoly]]
  ss: VAR list[Sect]
  m: VAR nat

  %% cad_lift's over1, but with svsec's hybrid lifting in place of svs_sg
  over1s(F, ss): RECURSIVE SVL =
    IF null?(ss) THEN null[SV] ELSE append(svsec(F, car(ss)), over1s(F, cdr(ss))) ENDIF
  MEASURE length(ss)

  %% cad_lift's lv, but recursing on proj instead of clos1
  plv(m): RECURSIVE [list[list[mpoly]] -> SVL] =
    IF m = 0 THEN LAMBDA P: (: svec(P, null[real]) :)
    ELSIF m = 1 THEN LAMBDA P: svs1(P)
    ELSIF m = 2 THEN LAMBDA P: LET Q = proj(P) IN over1s(P, sects(rts(Q)))
    ELSE LAMBDA P: LET Q = proj(P) IN over(P, Q, plv(m - 1)(Q))
    ENDIF
  MEASURE m

  n_plv2_line:   nat = length(plv(2)(f_line))
  n_plv2_circle: nat = length(plv(2)(f_circle))
  n_plv3_three:  nat = length(plv(3)(f_three))

  %% pdecq now lives in cad_pdec; measured here

  %% qs innermost-first: "FORALL x: EXISTS y" is (: FALSE, TRUE :)
  h_line:     bool = pdecq((: FALSE, TRUE :),       f_line,   psi_line)
  h_circle:   bool = pdecq((: FALSE, TRUE :),       f_circle, psi_circle)
  h_disc:     bool = pdecq((: TRUE, TRUE :),        f_disc,   psi_disc)
  h_three:    bool = pdecq((: FALSE, TRUE, TRUE :), f_three,  psi_three)
  h_three_f:  bool = pdecq((: FALSE, TRUE, TRUE :), f_three,  psi_three_f)
  h_circle_f: bool = pdecq((: FALSE, TRUE :),       f_circle, psi_circle_f)

  %%-------------------------------------------------------------------------
  %% RESULT.  The hybrid is correct and fast on the four examples and needs NO
  %% rational samples -- algebraic coordinates go through the proved
  %% svs_sg/asgS route, so there is no silent fallback and no ok flag:
  %%
  %%   ex_line 0.85 s, ex_circle 0.24 s, ex_disc 0.30 s, ex_three 0.33 s,
  %%   both controls FALSE.
  %%
  %% But on the Bath problems it TIMES OUT past 280 s, where the
  %% rational-sample route answered in 2.6-6.5 s with ok = FALSE (i.e. with
  %% untrustworthy answers).  So the fast route cannot vouch for real
  %% problems and the sound route is too slow for them.
  %%
  %% The cause is structural, not a tuning matter: svs_pt is polynomial but
  %% TYPED on list[rat], so it cannot represent an algebraic coordinate, while
  %% svs_sg handles algebraic coordinates at 3^|F|.  Real problems have an
  %% algebraic coordinate at the OUTERMOST level (cad-bench reports
  %% outer-level-rational = FALSE), so they enter the exponential branch
  %% immediately.  The four examples pass only because their coordinates
  %% happen to be rational.
  %%
  %% Conclusion: exact arithmetic in an algebraic extension is REQUIRED --
  %% root isolation has to work AT an algebraic sample point.  The hybrid was
  %% an attempt to dodge that and the benchmarks refuse it.
  %%-------------------------------------------------------------------------
  hybrid_examples: LEMMA h_line AND h_circle AND h_disc AND h_three
  hybrid_controls: LEMMA NOT h_three_f AND NOT h_circle_f
END cad_meas4
