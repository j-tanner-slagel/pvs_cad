snorm_ctx: THEORY
%----------------------------------------------------------------------------
% The degree branching that consults the path (Phase 3).
%
% snormc is snormp of branch_sgn with one more case: before it branches on
% the sign of a leading coefficient it asks the oracle (forced2 of
% hutch_oracle) whether the conditions on the path decide that sign, and if
% they do it takes the child they select.  When it does branch, the zero child gets the new condition in
% its context.  snormc_sel is snormp_sel under the path's conditions.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING hutch_oracle

  Cx_snorm: TYPE = list[branch_tree[bool].SignCond]
  l: VAR list[mpoly]
  ys: VAR list[real]
  cx: VAR Cx_snorm
  c: VAR mpoly

  snormc(l, cx): RECURSIVE btree[SL] =
    IF null?(l) THEN bleaf((# slist := null[mpoly], ssign := 0 #))
    ELSIF mcst?(mnorm(llast(l)))
    THEN IF cst_val(mnorm(llast(l))) = 0 THEN snormc(lbut(l), cx)
         ELSIF cst_val(mnorm(llast(l))) > 0 THEN bleaf((# slist := l, ssign := 1 #))
         ELSE bleaf((# slist := l, ssign := -1 #))
         ENDIF
    ELSIF forced2(mnorm(llast(l)), cx) = 0 THEN snormc(lbut(l), cx)
    ELSIF forced2(mnorm(llast(l)), cx) = 1 THEN bleaf((# slist := l, ssign := 1 #))
    ELSIF forced2(mnorm(llast(l)), cx) = -1 THEN bleaf((# slist := l, ssign := -1 #))
    ELSE bnode(mnorm(llast(l)), bleaf((# slist := l, ssign := -1 #)),
               snormc(lbut(l), cons(branch_tree[bool].zer(mnorm(llast(l))), cx)),
               bleaf((# slist := l, ssign := 1 #)))
    ENDIF
  MEASURE length(l)

  snormc_null: LEMMA null?(l) IMPLIES snormc(l, cx) = bleaf((# slist := null[mpoly], ssign := 0 #))
  snormc_cst: LEMMA cons?(l) AND mcst?(mnorm(llast(l))) IMPLIES snormc(l, cx) =
    IF cst_val(mnorm(llast(l))) = 0 THEN snormc(lbut(l), cx)
    ELSIF cst_val(mnorm(llast(l))) > 0 THEN bleaf((# slist := l, ssign := 1 #))
    ELSE bleaf((# slist := l, ssign := -1 #))
    ENDIF
  snormc_forced: LEMMA cons?(l) AND NOT mcst?(mnorm(llast(l))) AND forced2(mnorm(llast(l)), cx) /= 2
    IMPLIES snormc(l, cx) =
    IF forced2(mnorm(llast(l)), cx) = 0 THEN snormc(lbut(l), cx)
    ELSIF forced2(mnorm(llast(l)), cx) = 1 THEN bleaf((# slist := l, ssign := 1 #))
    ELSE bleaf((# slist := l, ssign := -1 #))
    ENDIF
  snormc_node: LEMMA cons?(l) AND NOT mcst?(mnorm(llast(l))) AND forced2(mnorm(llast(l)), cx) = 2
    IMPLIES snormc(l, cx) =
    bnode(mnorm(llast(l)), bleaf((# slist := l, ssign := -1 #)),
          snormc(lbut(l), cons(branch_tree[bool].zer(mnorm(llast(l))), cx)),
          bleaf((# slist := l, ssign := 1 #)))

  %% the two readings of a sign
  msign_sl: LEMMA branch_tree[SL].msign(c, ys) = branch_tree[bool].msign(c, ys)

  snormc_sel: THEOREM FORALL (l: list[mpoly]): FORALL (cx: Cx_snorm, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) IMPLIES
    select(snormc(l, cx), ys) = sl_of(select(snorm(l), ys), ys)
END snorm_ctx
