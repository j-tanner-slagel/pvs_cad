cad3: THEORY
%----------------------------------------------------------------------------
% The fast three-quantifier decision is correct (FINISH_PLAN stage S5d).
%
%   decw3_correct   decw3(q1, q2, q3, F, Psi)`ok IMPLIES
%                   (decw3(q1, q2, q3, F, Psi)`val IFF
%                    sem((: q1, q2, q3 :), F, Psi, null))
%
% Per sector s of the outer closure: claim A (inner2_sem) reads the two inner
% quantifiers correctly AT THE SAMPLE through the oracle asgS(s); claim B
% (G_const) says their truth does not vary ALONG the sector, from
%   conv?   in_conv
%   inv?    inv_sect over the level's family lvl2(F, s)  (the icert1? half)
%   cert?   cert_w from the level's own walk passing
%   CL?     cl_cells from the inner certificate in2ok?
% A root sector is a point.  The fold over sectors is foldw_sem's.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad3_def, inner_const

  F, Q: VAR list[list[mpoly]]
  s: VAR Sect
  ss: VAR list[Sect]
  x, y: VAR real
  q1, q2, q3: VAR bool
  Psi: VAR [SV -> bool]

  sect3_const: LEMMA sok2?(s) AND xcert1?(F, s) AND in?(s, x) AND in?(s, y) IMPLIES
    (sem((: q2, q3 :), F, Psi, (: x :)) IFF sem((: q2, q3 :), F, Psi, (: y :)))

  sect3_sem: LEMMA sok2?(s) AND xcert1?(F, s) AND in?(s, x) IMPLIES
    (inner2(q2, q3, F, Psi, asgS(s)) IFF sem((: q2, q3 :), F, Psi, (: x :)))

  xcert_mem: LEMMA FORALL ss: xcert?(F, ss) AND member(s, ss) IMPLIES xcert1?(F, s)

  mem3_ok: LEMMA gaps_ok(rts(Q)) AND xcert?(F, sects(rts(Q))) AND member(s, sects(rts(Q)))
    IMPLIES sok2?(s) AND xcert1?(F, s) AND in?(s, value(sample(s)))

  fold3_sem: LEMMA gaps_ok(rts(Q)) AND xcert?(F, sects(rts(Q))) IMPLIES
    (qfoldS(q1, sects(rts(Q)), LAMBDA s: inner2(q2, q3, F, Psi, asgS(s))) IFF
     sem((: q1, q2, q3 :), F, Psi, null))

  decw3_correct: THEOREM decw3(q1, q2, q3, F, Psi)`ok IMPLIES
    (decw3(q1, q2, q3, F, Psi)`val IFF sem((: q1, q2, q3 :), F, Psi, null))
END cad3
