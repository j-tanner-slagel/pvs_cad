pos_examples: THEORY
%----------------------------------------------------------------------------
% The poly-pos strategy (Phase 3).
%
% Each example is a statement about a polynomial in one variable whose
% coefficients contain other free variables.  The strategy evaluates the
% verified decision tree of pos_dec, adds one proved fact per branch on which
% the polynomial is everywhere positive, and the sequent closes by ordinary
% arithmetic.  The branch conditions are what quantifier elimination produces:
% for x^2 + b*x + c they are exactly the discriminant condition.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING pos_dec, mpoly_embed

  a, b, c, x, y: VAR real

  s1: LEMMA b^2 < 4*c IMPLIES x^2 + b*x + c > 0
  s2: LEMMA x^2 + 1 > 0
  s3: LEMMA (x + y)^2 + 1 > 0
  s4: LEMMA c > 0 IMPLIES x^2 + c > 0
  s5: LEMMA b < 0 IMPLIES x^4 - b > 0
  %% a symbolic leading coefficient: the degree branching is part of the answer
  s6: LEMMA a > 0 AND b^2 < 4*a*c IMPLIES a*x^2 + b*x + c > 0
  %% two variables: the branch condition is itself a polynomial in y
  s7: LEMMA x^2 + x*y + y^2 + 1 > 0

  %% a quartic: (x^2 - 1)^2 + 1
  s8: LEMMA x^4 - 2*x^2 + 2 > 0

  %% the same tree read for the absence of roots
  n1: LEMMA b^2 < 4*c IMPLIES x^2 + b*x + c /= 0
  n2: LEMMA c > 0 IMPLIES x^2 + c /= 0
END pos_examples
