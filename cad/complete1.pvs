complete1: THEORY
%----------------------------------------------------------------------------
% The one-quantifier decision is complete (COMPLETENESS_PLAN C3).  At one
% quantifier the certificate of decq2 is gaps_ok on the sorted roots of the
% family, and gaps_ok holds on every strictly increasing list of algebraic
% numbers (gaps_ok_incr): separating two consecutive roots no longer runs out
% of fuel (cell1's gapw).  So decq5 and decide5 answer every closed formula
% with at most one quantifier, and by decq5_correct the answer is the truth.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5

  qs, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  svs1ok_complete: LEMMA svs1ok(F)
  decq2_complete1: THEOREM length(qs) <= 1 IMPLIES decq2(qs, F, Psi)`ok
  decq5_complete1: THEOREM length(qs) <= 1 IMPLIES decq5(qs, F, Psi)`ok
  decide5_complete1: THEOREM length(os) <= 1 IMPLIES decide5(reverse(os), F, phi)`ok
END complete1
