mpoly_examples: THEORY
%----------------------------------------------------------------------------
% Tests of the mpoly-eq strategy (Phase 1).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_embed, reals@sq

  x, y, z, a, b, c: VAR real
  f(x: real): real = x^5 + 50*x - 2
  g: [real -> real] = LAMBDA (x: real): x^4 - 3*x^2 + 1

  ex1: LEMMA (x + y)^2 = x^2 + 2*x*y + y^2
  ex2: LEMMA (x + y + z)^3 = x^3 + y^3 + z^3 + 3*x^2*y + 3*x^2*z + 3*y^2*x + 3*y^2*z + 3*z^2*x + 3*z^2*y + 6*x*y*z
  ex3: LEMMA (a*b - c)*(a*b + c) = a^2*b^2 - c^2
  ex4: LEMMA (x - 1/2)^2 = x^2 - x + 1/4
  ex5: LEMMA sq(x + y) - sq(x - y) = 4*x*y
  ex6: LEMMA (f(x) + 2)^2 = f(x)^2 + 4*f(x) + 4          % f(x) is an atom
  ex7: LEMMA (x^2 + y^2)*(z^2 + a^2) = (x*z - y*a)^2 + (x*a + y*z)^2
  ex8: LEMMA (x + y)^6 - (x - y)^6 = 12*x^5*y + 40*x^3*y^3 + 12*x*y^5
  ex9: LEMMA -(x - y) = y - x
  ex10: LEMMA 3 * (x/3) = x
  % definitions are unfolded by the strategy
  ex11: LEMMA (f(x) + 2)^2 = x^10 + 100*x^6 + 2500*x^2
  ex12: LEMMA g(x) + 3*x^2 = x^4 + 1
  h(a, b: real)(x: real): real = a*x^2 + b
  ex13: LEMMA h(a, b)(x) - h(b, a)(x) = (a - b)*(x^2 - 1)
END mpoly_examples
