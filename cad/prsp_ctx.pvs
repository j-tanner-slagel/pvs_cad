prsp_ctx: THEORY
%----------------------------------------------------------------------------
% The symbolic chains with the conditions of the path (Phase 3).
%
% prspc and ctreec are prsp of branch_sgn and ctree of sign_tree built with
% snormc and bbindc, so that no step branches on a sign its path has already
% decided.  The select theorems are those of the originals under the path's
% conditions: the chain a valuation selects is rchain, and the Tarski chain is
% tchain with its signs.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING snorm_ctx, branch_ctx[SL, list[SL]]

  l0, g: VAR list[mpoly]
  ys: VAR list[real]
  k: VAR nat
  p0, p1, p2: VAR SL
  cx: VAR snorm_ctx.Cx_snorm

  prspc(k, p1, p2, cx): RECURSIVE btree[list[SL]] =
    IF cons?(p2`slist) AND k > 0
    THEN bbindc(snormc(sstep(p1`slist, p2`slist), cx), cx,
                LAMBDA (p3: SL, cx2: snorm_ctx.Cx_snorm):
                  bmap(LAMBDA (cs: list[SL]): cons(p2, cs), prspc(k - 1, p2, p3, cx2)))
    ELSE bleaf((: (# slist := null[mpoly], ssign := 0 #) :))
    ENDIF
  MEASURE k

  select_prspc: THEOREM FORALL (k: nat): FORALL (p1, p2: SL, cx: snorm_ctx.Cx_snorm, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) AND p2 = sl_of(p2`slist, ys) IMPLIES
    select(prspc(k, p1, p2, cx), ys) =
      map(LAMBDA (l: list[mpoly]): sl_of(l, ys), rchain(k, p1`slist, p2`slist, ys))

  %% the Tarski chain: the second element branches, the rest is prspc
  ctreec(k, p0, g, cx): btree[list[SL]] =
    bbindc(snormc(lmul(g, lderiv(p0`slist)), cx), cx,
           LAMBDA (p1: SL, cx2: snorm_ctx.Cx_snorm):
             bmap(LAMBDA (cs: list[SL]): cons(p0, cs), prspc(k, p0, p1, cx2)))

  select_ctreec: LEMMA branch_tree[bool].conds_hold(cx, ys) AND p0 = sl_of(p0`slist, ys) IMPLIES
    select(ctreec(k, p0, g, cx), ys) = slof(tchain(k, p0`slist, g, ys), ys)
  select_ctreec_at: LEMMA branch_tree[bool].conds_hold(cx, ys) IMPLIES
    select(ctreec(k, sl_of(l0, ys), g, cx), ys) = slof(tchain(k, l0, g, ys), ys)
END prsp_ctx
