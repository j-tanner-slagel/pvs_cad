sgn_count: THEORY
%----------------------------------------------------------------------------
% Counting the sign changes of the chain from the signs alone (Phase 3).
%
% Sturm@sturm counts the real roots of a polynomial as the difference of the
% number of sign changes of the Sturm chain at minus and at plus infinity, and
% at infinity the chain takes the signs of its leading coefficients (with the
% parity of the degree at minus infinity).  On a branch of the symbolic
% construction those signs are the data the leaf carries, so both counts are
% functions of the leaf and no further branching is needed.
%
% nsc_hi and nsc_lo are the two counts computed from the leaf.  nsc_sign_eq is
% what lets them stand in for NASALib's counts of the real sequence: the count
% depends only on the signs of the entries.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING branch_sgn, more_map_props[list[mpoly], SL]

  sl: VAR list[SL]
  cs: VAR list[list[mpoly]]
  ys: VAR list[real]
  i, k, n: VAR nat
  l, l0: VAR list[mpoly]
  a: VAR [nat -> real]

  %% the signs of the chain at plus and at minus infinity
  lsgn(sl, i): Sign3 = IF i < length(sl) THEN nth(sl, i)`ssign ELSE 0 ENDIF
  lsgnlo(sl, i): Sign3 =
    IF i < length(sl) THEN (IF even?(dg(nth(sl, i)`slist)) THEN 1 ELSE -1 ENDIF) * nth(sl, i)`ssign
    ELSE 0 ENDIF
  mm(sl): nat = IF length(sl) >= 2 THEN length(sl) - 2 ELSE 0 ENDIF
  nsc_hi(sl): nat = number_sign_changes(LAMBDA (i: nat): lsgn(sl, i), mm(sl))`num
  nsc_lo(sl): nat = number_sign_changes(LAMBDA (i: nat): lsgnlo(sl, i), mm(sl))`num

  %% the count depends only on the signs
  nsc_sign_eq: LEMMA FORALL (b: [nat -> Sign3]):
    (FORALL (i: nat): i <= n IMPLIES sign3(a(i)) = b(i)) IMPLIES
    number_sign_changes(a, n)`num = number_sign_changes(b, n)`num

  neg1_expt: LEMMA (-1)^n = IF even?(n) THEN 1 ELSE -1 ENDIF
  sign3_scal: LEMMA FORALL (c: Sign3, x: real): c /= 0 IMPLIES sign3(c * x) = c * sign3(x)

  %% the signs of a chain of coefficient lists
  slof(cs, ys): list[SL] = map(LAMBDA (l: list[mpoly]): sl_of(l, ys), cs)
  slof_length: LEMMA length(slof(cs, ys)) = length(cs)
  lsgn_chain: LEMMA i < length(cs) IMPLIES
    lsgn(slof(cs, ys), i) = sign3(meval(llast(nth(cs, i)))(ys))
  lsgnlo_chain: LEMMA i < length(cs) IMPLIES
    lsgnlo(slof(cs, ys), i) =
      (IF even?(dg(nth(cs, i))) THEN 1 ELSE -1 ENDIF) * sign3(meval(llast(nth(cs, i)))(ys))

  %% the sign of the leading term at minus infinity
  lo_sign: LEMMA cons?(l) IMPLIES
    sign3((-1)^(dg(l)) * earr(l, ys)(dg(l))) =
      (IF even?(dg(l)) THEN 1 ELSE -1 ENDIF) * sign3(meval(llast(l))(ys))

  %% the two counts of the Sturm chain of chain_sturm
  hi_eq: LEMMA fok(k, l0, ys) IMPLIES
    number_sign_changes(LAMBDA (i: nat): carr(fchain(k, l0, ys), ys)(i)(cdeg(fchain(k, l0, ys))(i)),
                        length(fchain(k, l0, ys)) - 2)`num
    = nsc_hi(slof(fchain(k, l0, ys), ys))
  lo_eq: LEMMA fok(k, l0, ys) IMPLIES
    number_sign_changes(LAMBDA (i: nat): (-1)^(cdeg(fchain(k, l0, ys))(i)) *
                                          carr(fchain(k, l0, ys), ys)(i)(cdeg(fchain(k, l0, ys))(i)),
                        length(fchain(k, l0, ys)) - 2)`num
    = nsc_lo(slof(fchain(k, l0, ys), ys))
END sgn_count
