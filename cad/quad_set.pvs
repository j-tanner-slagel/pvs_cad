quad_set: THEORY
%----------------------------------------------------------------------------
% Which signs a quadratic realizes, hence psc_det? at degree <= 2.
%
% Built as ONE SMALL DIRECTIONAL LEMMA PER CASE rather than one ten-branch
% IFF.  The first attempt at the IFF form ground badly: every branch needed a
% different witness and a different division-vs-multiplication step, and a
% tactic covering all of them dug rather than closed.  Stage B taught the same
% lesson (an inequality plus antisymmetry beat the direct equality).
%
% The negative case is free.  qv(-a,-b,-c)(y) = -qv(a,b,c)(y) so the realized
% signs simply flip, and discr is INVARIANT under negating all three
% coefficients (sq(-b) - 4(-a)(-c) = sq(b) - 4ac), so the characterisation
% transports without redoing any case analysis.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING quad_sign

  a, b, c, y: VAR real

  %% PVS will not chain products of positives on its own, and nearly every
  %% stall in this file and in quad_sign came back to that. One helper fixes
  %% all of them.
  pos_prod: LEMMA FORALL (u, v: real): u > 0 AND v > 0 IMPLIES u * v > 0

  %% ---- sufficiency, one witness per case -----------------------------
  %% a > 0: beyond both roots when discr >= 0, the vertex value otherwise
  qset_pos_apos: LEMMA a > 0 IMPLIES qset(a, b, c)(1)

  %% a < 0 with discr > 0: the vertex, where qv = -discr/(4a) > 0
  qset_pos_aneg: LEMMA a < 0 AND discr(a, b, c) > 0 IMPLIES qset(a, b, c)(1)

  %% linear: (1-c)/b sends qv to exactly 1
  qset_pos_lin: LEMMA a = 0 AND b /= 0 IMPLIES qset(a, b, c)(1)

  %% constant: any point
  qset_pos_cst: LEMMA a = 0 AND b = 0 AND c > 0 IMPLIES qset(a, b, c)(1)

  %% ---- necessity ------------------------------------------------------
  %% via qv_sq_ge, the MULTIPLICATIVE form: a < 0 and qv > 0 somewhere give
  %% -4a*qv > 0 and hence discr > 0, with no division anywhere
  qset_pos_nec: LEMMA qset(a, b, c)(1) IMPLIES
    (a > 0 OR (a < 0 AND discr(a, b, c) > 0)
     OR (a = 0 AND b /= 0) OR (a = 0 AND b = 0 AND c > 0))

  %% ---- negating the coefficients flips the realized signs -------------
  qv_neg: LEMMA qv(-a, -b, -c)(y) = -qv(a, b, c)(y)
  discr_neg: LEMMA a /= 0 IMPLIES discr(-a, -b, -c) = discr(a, b, c)
  qset_flip: LEMMA qset(a, b, c)(-1) IFF qset(-a, -b, -c)(1)
END quad_set
