cad_decide6: THEORY
%----------------------------------------------------------------------------
% decide6 decides every closed prenex formula (COMPLETENESS_PLAN C1): no
% flag, no hypothesis, any number of quantifiers.  From decide5_correct when
% the fast certificate passes and decide_correct_os otherwise.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide6_def, cad_decide5

  os: VAR list[bool]
  F: VAR list[list[mpoly]]
  phi: VAR BF

  decide6_correct: THEOREM decide6(reverse(os), F, phi) IFF fsem(os, F, phi, null)
END cad_decide6
