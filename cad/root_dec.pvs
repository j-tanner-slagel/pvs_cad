root_dec: THEORY
%----------------------------------------------------------------------------
% Deciding whether a symbolic polynomial has a real root (Phase 3).
%
% qdec(k, l0) is a tree of sign conditions on the parameters whose leaves are
% TRUE or FALSE, and qdec_sound says the leaf the parameters select answers
% the question EXISTS x: p(x, ys) = 0 for the polynomial p whose coefficient
% list is l0.  Reading the tree through branches (branch_tree) turns it into a
% quantifier-free formula in the parameters, so this is quantifier elimination
% for one equation and one quantifier, by branching Sturm.
%
% Three kinds of leaf: the polynomial may be identically zero at ys (every x
% is a root), a nonzero constant (no root), or of degree at least one, and
% then the number of roots is the difference of the sign changes of the chain
% at minus and at plus infinity, both read off the leaf by sgn_count.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sgn_count, branch_tree[bool], branch_map[SL, bool], branch_map[list[SL], bool]

  l, l0: VAR list[mpoly]
  ys: VAR list[real]
  k: VAR nat
  x, c: VAR real

  %% the derivative keeps the sign of the leading coefficient
  lderiv_lc: LEMMA length(l) >= 2 IMPLIES
    meval(llast(lderiv(l)))(ys) = (length(l) - 1) * meval(llast(l))(ys)
  sign3_pos_scal: LEMMA c > 0 IMPLIES sign3(c * x) = sign3(x)
  dsl(p: SL): SL = (# slist := lderiv(p`slist), ssign := p`ssign #)
  dsl_ok: LEMMA length(l) >= 2 IMPLIES dsl(sl_of(l, ys)) = sl_of(lderiv(l), ys)

  %% a polynomial of degree zero in the eliminated variable
  llast_one: LEMMA cons?(l) AND null?(cdr(l)) IMPLIES llast(l) = car(l)
  pval_one: LEMMA length(l) = 1 IMPLIES meval(mpol(l))(cons(x, ys)) = meval(llast(l))(ys)

  %% a set enumerated by below(N) is nonempty exactly when N is positive
  roots_iff: LEMMA FORALL (N: nat, S: set[real], bij: [below(N) -> (S)]):
    bijective?(bij) IMPLIES ((EXISTS (x: real): S(x)) IFF N > 0)

  %% two predicates that agree have the same existential
  ex_iff: LEMMA FORALL (P, Q: [real -> bool]):
    (FORALL (z: real): P(z) IFF Q(z)) IMPLIES
    ((EXISTS (x: real): P(x)) IFF (EXISTS (x: real): Q(x)))

  %% the first element of the chain denotes the polynomial itself
  root_poly: LEMMA fok(k, l0, ys) IMPLIES
    ((polynomial(carr(fchain(k, l0, ys), ys)(0), cdeg(fchain(k, l0, ys))(0))(x) = 0)
     IFF (meval(mpol(l0))(cons(x, ys)) = 0))

  %% for a polynomial of degree at least one with a nonzero leading coefficient
  %% at ys, a root exists exactly when the count at minus infinity exceeds the
  %% count at plus infinity
  main_count: LEMMA fok(k, l0, ys) IMPLIES
    ((EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0)
     IFF nsc_lo(slof(fchain(k, l0, ys), ys)) > nsc_hi(slof(fchain(k, l0, ys), ys)))

  %% the sign list of the full chain, peeled
  slof_cons: LEMMA slof(fchain(k, l0, ys), ys) =
    cons(sl_of(l0, ys), map(LAMBDA (l: list[mpoly]): sl_of(l, ys), rchain(k, l0, lderiv(l0), ys)))

  %% normalizing does not change which x are roots
  snorm_ex: LEMMA (EXISTS (x: real): meval(mpol(select(snorm(l0), ys)))(cons(x, ys)) = 0)
                  IFF (EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0)

  %% the decision tree
  qdec(k, l0): btree[bool] =
    bbind(snormp(l0),
          LAMBDA (p: SL):
            IF null?(p`slist) THEN bleaf(TRUE)
            ELSIF length(p`slist) = 1 THEN bleaf(FALSE)
            ELSE bmap(LAMBDA (cs: list[SL]): nsc_lo(cons(p, cs)) > nsc_hi(cons(p, cs)),
                      prsp(k, p, dsl(p)))
            ENDIF)

  qdec_sound: THEOREM length(l0) <= k IMPLIES
    (select(qdec(k, l0), ys) IFF (EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0))
  %% what the strategies use: a branch whose conditions hold at the parameters
  %% carries the verdict there
  b: VAR branch_tree[bool].Branch
  root_branch: THEOREM length(l0) <= k AND member(b, branches(qdec(k, l0))) AND
    b`bres AND branch_tree[bool].conds_hold(b`bconds, ys)
    IMPLIES EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0
  noroot_branch: THEOREM length(l0) <= k AND member(b, branches(qdec(k, l0))) AND
    NOT b`bres AND branch_tree[bool].conds_hold(b`bconds, ys)
    IMPLIES FORALL (x: real): meval(mpol(l0))(cons(x, ys)) /= 0

END root_dec
