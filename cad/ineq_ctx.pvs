ineq_ctx: THEORY
%----------------------------------------------------------------------------
% The no-equation conjunction with the conditions of the path (Phase 3).
%
% wtreec and itreec are wtree and itree of ineq_tree built with snormc,
% snormpsc, bbindc and mcountc.  itreec_sound is itree_sound under the path's
% conditions.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_ctx, ineq_tree, branch_ctx[SL, SL], branch_ctx[SL, bool]

  Q: VAR list[list[mpoly]]
  ys: VAR list[real]
  k: VAR nat
  x: VAR real
  ps: VAR list[SL]
  cx: VAR snorm_ctx.Cx

  wtreec(ps, cx): RECURSIVE btree[SL] =
    IF null?(ps) THEN bleaf(one_sl)
    ELSE bbindc(wtreec(cdr(ps), cx), cx, LAMBDA (w: SL, cx1: snorm_ctx.Cx):
           snormc(lmul(car(ps)`slist, w`slist), cx1))
    ENDIF
  MEASURE length(ps)
  wtreec_null: LEMMA wtreec(null[SL], cx) = bleaf(one_sl)
  wtreec_cons: LEMMA FORALL (p: SL): wtreec(cons(p, ps), cx) =
    bbindc(wtreec(ps, cx), cx, LAMBDA (w: SL, cx1: snorm_ctx.Cx):
      snormc(lmul(p`slist, w`slist), cx1))
  select_wtreec: THEOREM FORALL (ps: list[SL]): FORALL (cx: snorm_ctx.Cx, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) IMPLIES
    select(wtreec(ps, cx), ys) = sl_of(qprod(slists(ps), ys), ys)

  itreec(k, Q, cx): btree[bool] =
    bbindc(snormpsc(Q, cx), cx, LAMBDA (ps: list[SL], cx1: snorm_ctx.Cx):
      IF NOT allcons(slists(ps)) THEN bleaf(FALSE)
      ELSIF posinfp(ps) OR neginfp(ps) THEN bleaf(TRUE)
      ELSE bbindc(wtreec(ps, cx1), cx1, LAMBDA (w: SL, cx2: snorm_ctx.Cx):
             IF length(w`slist) <= 2 THEN bleaf(FALSE)
             ELSE mcountc(k, dsl(w), ps, cx2)
             ENDIF)
      ENDIF)

  itreec_sound: THEOREM branch_tree[bool].conds_hold(cx, ys) AND 2 * mlen(Q) + 1 <= k IMPLIES
    (select(itreec(k, Q, cx), ys) IFF (EXISTS (x: real): allgt(Q, ys, x)))
END ineq_ctx
