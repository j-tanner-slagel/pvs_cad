mpoly_showcase: THEORY
%----------------------------------------------------------------------------
% What mpoly-eq and mpoly-simp can do (Phase 1).  Every lemma below is
% closed by the strategies alone, or by the strategies plus a line of
% ordinary prover commands; the saved proofs show the usage patterns.
%
%   (mpoly-eq)              proves an identity of polynomial expressions,
%                           universally quantified or not, over arbitrary
%                           real atoms, unfolding user definitions
%   (mpoly-simp "e" fnums)  replaces e by its normal form in fnums
%   (case "lhs = rhs") then (mpoly-eq 1) on the second branch
%                           uses an identity as a stepping stone
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_embed, reals@sq

  a, b, c, d, e, f, g, h, x, y, z, w, t: VAR real
  n: VAR nat

  %% 1. Classical identities (pure mpoly-eq)

  % Brahmagupta-Fibonacci: a product of two sums of two squares is one
  two_squares: LEMMA (a^2 + b^2)*(c^2 + d^2) = (a*c - b*d)^2 + (a*d + b*c)^2

  % Euler's four-square identity: 8 variables, degree 4, 24 monomials a side
  four_squares: LEMMA (a^2 + b^2 + c^2 + d^2)*(e^2 + f^2 + g^2 + h^2) =
    (a*e - b*f - c*g - d*h)^2 + (a*f + b*e + c*h - d*g)^2 +
    (a*g - b*h + c*e + d*f)^2 + (a*h + b*g - c*f + d*e)^2

  % Lagrange's identity in dimension 3
  lagrange3: LEMMA (a^2 + b^2 + c^2)*(x^2 + y^2 + z^2) - (a*x + b*y + c*z)^2 =
    (a*y - b*x)^2 + (a*z - c*x)^2 + (b*z - c*y)^2

  % Sophie Germain
  sophie_germain: LEMMA a^4 + 4*b^4 = (a^2 + 2*b^2 + 2*a*b)*(a^2 + 2*b^2 - 2*a*b)

  % the Vandermonde determinant of order 3, expanded along the first row, factors
  vandermonde3: LEMMA
    1*(y*z^2 - z*y^2) - x*(1*z^2 - 1*y^2) + x^2*(1*z - 1*y) = (y - x)*(z - x)*(z - y)

  % difference of fifth powers
  diff5: LEMMA x^5 - y^5 = (x - y)*(x^4 + x^3*y + x^2*y^2 + x*y^3 + y^4)

  % binomial expansion of degree 7
  binom7: LEMMA (x + y)^7 = x^7 + 7*x^6*y + 21*x^5*y^2 + 35*x^4*y^3 + 35*x^3*y^4 + 21*x^2*y^5 + 7*x*y^6 + y^7

  % Candido's identity
  candido: LEMMA (x^2 + y^2 + (x + y)^2)^2 = 2*(x^4 + y^4 + (x + y)^4)

  %% 2. Definitions are unfolded: Chebyshev and Legendre polynomials

  T2(x: real): real = 2*x^2 - 1
  T3(x: real): real = 4*x^3 - 3*x
  T6(x: real): real = 32*x^6 - 48*x^4 + 18*x^2 - 1

  % composition of Chebyshev polynomials commutes: T2 o T3 = T3 o T2 = T6
  chebyshev_compose: LEMMA T2(T3(x)) = T6(x) AND T3(T2(x)) = T6(x)

  P2(x: real): real = (3*x^2 - 1)/2
  P3(x: real): real = (5*x^3 - 3*x)/2
  P4(x: real): real = (35*x^4 - 30*x^2 + 3)/8

  % Bonnet's recursion at n = 3: 4 P4 = 7 x P3 - 3 P2
  bonnet3: LEMMA 4*P4(x) = 7*x*P3(x) - 3*P2(x)

  %% 3. Matrices as tuples of atoms: determinant of a 2x2 product,
  %%    and the Cayley-Hamilton identity entrywise

  det2(a, b, c, d: real): real = a*d - b*c

  det2_mult: LEMMA det2(a*e + b*g, a*f + b*h, c*e + d*g, c*f + d*h) = det2(a, b, c, d)*det2(e, f, g, h)

  cayley_hamilton_2x2: LEMMA
    (a*a + b*c) - (a + d)*a + det2(a, b, c, d) = 0 AND
    (a*b + b*d) - (a + d)*b = 0 AND
    (c*a + d*c) - (a + d)*c = 0 AND
    (c*b + d*d) - (a + d)*d + det2(a, b, c, d) = 0

  %% 4. Atoms need not be variables: uninterpreted functions and sq

  phi: [real -> real]
  atoms_are_opaque: LEMMA (phi(x) + phi(y))^2 - (phi(x) - phi(y))^2 = 4*phi(x)*phi(y)
  sq_atoms: LEMMA sq(sq(x) + 1) = x^4 + 2*sq(x) + 1

  %% 5. Identities as stepping stones inside ordinary proofs
  %%    (see the saved proofs: a case with the identity, closed by mpoly-eq)

  am_gm2: LEMMA a^2 + b^2 >= 2*a*b
  cauchy_schwarz2: LEMMA (a*c + b*d)^2 <= (a^2 + b^2)*(c^2 + d^2)
  sum_of_squares_nonneg: LEMMA x^4 - 4*x^3 + 6*x^2 - 4*x + 1 >= 0

  %% 6. mpoly-simp: normalizing in place

  simp_hyp: LEMMA (x + y)^2 - (x - y)^2 > 0 IMPLIES x*y > 0
  simp_goal: LEMMA (t + 1)^3 - (t - 1)^3 = 6*t^2 + 2

END mpoly_showcase
