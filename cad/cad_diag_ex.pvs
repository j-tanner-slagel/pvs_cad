cad_diag_ex: THEORY
%----------------------------------------------------------------------------
% The measuring and inspection commands, each run once as a step that
% changes nothing, before (cad) or (cad-qe) closes the goal: cad-showf,
% cad-bench, cad-mn, cad-mx and cad-time on dg_circle, cad-m3 on dg_three,
% cad-qeshow on dg_root.  They print measurements, not proofs; a text one of
% them evaluates that no longer typechecks (as when decn_o gained an
% argument) stops the replay.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING pvs_cad, cad3_def, cad_pdec

  a: VAR real

  dg_circle: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + y^2 = 1 OR x^2 > 1
  dg_three: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z > x AND z > y
  dg_root: LEMMA (EXISTS (t: real): t^2 = a) IFF a >= 0
END cad_diag_ex
