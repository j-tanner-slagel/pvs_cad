qe2c_u_def: THEORY
%----------------------------------------------------------------------------
% QE for m >= 2 free variables from the derivative-closed run, with the
% escalation parameter raised until it succeeds (QE_PLAN.md section 11, 2C).
% Executable.
%
% It stops because qe2c_o succeeds for every large enough u (aug_ev's
% qe2c_ev); that bound is never computed, it appears only in the
% termination measure, as in decide_u_def.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING aug_ev

  u, N: VAR nat
  m: VAR posnat
  qb: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  bphi: VAR BF

  %% some u from which on the derivative-closed run succeeds (not computed)
  qbound(m, qb, F, Psi): nat =
    epsilon(LAMBDA (N: nat): FORALL u: u >= N IMPLIES qe2c_o(u, m, qb, F, Psi)`ok)
  qmeas(m, qb, F, Psi, u): nat = IF u < qbound(m, qb, F, Psi) THEN qbound(m, qb, F, Psi) - u ELSE 0 ENDIF

  qe2c_u(m, qb, F, Psi, u): RECURSIVE QER =
    LET dd = qe2c_o(u, m, qb, F, Psi) IN
    IF dd`ok OR m < 2 OR null?(qb) THEN dd ELSE qe2c_u(m, qb, F, Psi, u + 1) ENDIF
  MEASURE qmeas(m, qb, F, Psi, u)

  qe2c(m, qb, F, bphi): QER = qe2c_u(m, qb, F, LAMBDA (v: SV): bfsv(bphi, v), 0)
END qe2c_u_def
