cad_pdec_ex: THEORY
%----------------------------------------------------------------------------
% The n-level projection decision on the worked examples (Phase 6, item D).
%
% cad_pdec generalizes cad_meas's hand-built three-level route3; this checks
% the general form reproduces it.  Families and formulas come from cad_meas
% (gated) so both routes are compared on literally the same input.
%
% qs is OUTERMOST-FIRST: "FORALL x: EXISTS y" is (: TRUE, FALSE :).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_pdec, cad_meas

  d_line:   [# ok: bool, val: bool #] = pdecide(f_line,   (: TRUE, FALSE :),       psi_line)
  d_circle: [# ok: bool, val: bool #] = pdecide(f_circle, (: TRUE, FALSE :),       psi_circle)
  d_disc:   [# ok: bool, val: bool #] = pdecide(f_disc,   (: TRUE, TRUE :),        psi_disc)
  d_three:  [# ok: bool, val: bool #] = pdecide(f_three,  (: TRUE, TRUE, FALSE :), psi_three)

  %% negative controls, same families, false formulas
  d_three_f:  [# ok: bool, val: bool #] = pdecide(f_three,  (: TRUE, TRUE, FALSE :), psi_three_f)
  d_circle_f: [# ok: bool, val: bool #] = pdecide(f_circle, (: TRUE, FALSE :),       psi_circle_f)

  %% Every example decided correctly, and ok = TRUE on all four: every sample
  %% point the fold visited was exactly rational (rsv_exact), so no
  %% approximation entered anywhere.  Measured 0.20-0.34 s each, against
  %% 46.94 s for (cad) on ex_line and "does not finish" for ex_three.
  pdec_examples: LEMMA d_line`ok   AND d_line`val   AND
                       d_circle`ok AND d_circle`val AND
                       d_disc`ok   AND d_disc`val   AND
                       d_three`ok  AND d_three`val

  %% and FALSE on false formulas over the same families
  pdec_controls: LEMMA NOT d_three_f`val AND NOT d_circle_f`val
END cad_pdec_ex
