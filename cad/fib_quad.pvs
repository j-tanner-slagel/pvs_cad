fib_quad: THEORY
%----------------------------------------------------------------------------
% psc_det? for a SINGLE-member family of degree <= 2 (Stage E, first case).
%
% quad_det proved the realized sign SET of a quadratic is a function of the
% signs of (a, b, c, dsc).  This connects that to the fibre set the decision
% actually consumes: for a one-member family the sign vector is a 1-vector
% (svec_cons), and specializing the member at the parameter turns
% meval(mpol(u))((: z, x :)) into an ordinary quadratic in z whose
% coefficients are the member's coefficients evaluated at x (meval3).
%
% Chaining with delin_from_psc and dec2_sem, this closes the whole chain for
% the first time: the two-quantifier projection decision is PROVED CORRECT
% for single-polynomial families of degree <= 2.  Narrow, but complete.
%
% The multi-member case needs more than this.  The fibre set is a set of
% VECTORS, so it depends on how different members' roots interleave, and that
% is not settled by each member's own discriminant -- it needs the signs of
% one member at another's roots, i.e. Tarski queries, which is what the
% pairwise psc chains in Collins' operator are for.  That is the rest of
% Stage E and is NOT claimed here.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING delin_bridge, quad_det

  u0, u1, u2: VAR mpoly
  x, y, z: VAR real
  v: VAR SV

  %% NOTE the member is given as an EXPLICIT 3-element list rather than via a
  %% hypothesis length(u) = 3.  With the hypothesis, meval unfolds into nested
  %% datatype CASES that have to be resolved from the length, and the proof
  %% does not converge; with a literal cons chain it unfolds directly.  This
  %% also matches how the examples' members are actually written.

  %% a degree <= 2 member, specialized at the parameter, is a quadratic in z
  meval3: LEMMA meval(mpol((: u0, u1, u2 :)))((: z, x :))
    = meval(u0)((: x :)) + meval(u1)((: x :)) * z + meval(u2)((: x :)) * z * z

  %% so the fibre set of a one-member family is qset of those coefficients
  fib1_qset: LEMMA fib((: (: u0, u1, u2 :) :), (: x :))(v) IFF
    (EXISTS z: v = (: sign3(qv(meval(u2)((: x :)), meval(u1)((: x :)),
                                meval(u0)((: x :)))(z)) :))

  %% the same, phrased so that qset_det applies with no skolem bookkeeping:
  %% the fibre set is the 1-vectors of the REALIZED SIGNS
  fib1_qset2: LEMMA fib((: (: u0, u1, u2 :) :), (: x :))(v) IFF
    (EXISTS (s: Sign3): v = (: s :)
       AND qset(meval(u2)((: x :)), meval(u1)((: x :)), meval(u0)((: x :)))(s))

  %% and hence psc_det? holds for it
  fib1_det: LEMMA
        sign3(meval(u0)((: x :))) = sign3(meval(u0)((: y :)))
    AND sign3(meval(u1)((: x :))) = sign3(meval(u1)((: y :)))
    AND sign3(meval(u2)((: x :))) = sign3(meval(u2)((: y :)))
    AND sign3(dsc(meval(u2)((: x :)), meval(u1)((: x :)), meval(u0)((: x :))))
      = sign3(dsc(meval(u2)((: y :)), meval(u1)((: y :)), meval(u0)((: y :))))
    IMPLIES (FORALL v: fib((: (: u0, u1, u2 :) :), (: x :))(v)
                   IFF fib((: (: u0, u1, u2 :) :), (: y :))(v))
END fib_quad
