decb_u: THEORY
%----------------------------------------------------------------------------
% The escalating Collins decision is correct and always answers
% (COLLINS_PLAN.md M-I; with the smaller bottom-step projection, PROJ_PLAN.md P2), as decide_u for decn_u: by measure induction on
% the distance to the bound from which the certificate holds.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decb_u_def

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  decb_u_correct: THEOREM decb_u(qs, F, Psi, u)`ok IMPLIES
    (decb_u(qs, F, Psi, u)`val IFF sem(qs, F, Psi, null[real]))
  decb_u_complete: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES decb_u(qs, F, Psi, u)`ok
END decb_u
