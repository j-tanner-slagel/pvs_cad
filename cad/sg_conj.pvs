sg_conj: THEORY
%----------------------------------------------------------------------------
% The existence decision of a conjunction, by a sign function (Phase 6).
%
% ctree of conj_tree decides EXISTS x: E = 0 AND Q > 0 as a branch tree; its
% value at ys is select(ctree(k, E, Q), ys). ctree_sg computes that value
% for a sign function sg, through the normalizations (slofs_sg), the product
% of the inequalities (qprod_sg, the leaf of wtree), the count of roots
% under sign conditions (mts2_sg of sg_chain2, the reduced chain) and the far signs (posinfp, neginfp, read
% off the leading signs). ctree_sg_at is the agreement with the tree at
% msg(ys); with ctree_sound that is the semantics. ctree_rd lists what is
% read, ctree_det the determinism.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sg_chain2, conj_tree

  k: VAR nat
  l, l0: VAR list[mpoly]
  E, Q: VAR list[list[mpoly]]
  ps: VAR list[SL]
  sg, sg1, sg2: VAR SG
  ys: VAR list[real]

  %% the normalized inequalities
  slofs_sg(Q, sg): RECURSIVE list[SL] =
    IF null?(Q) THEN null[SL] ELSE cons(sl_sg(car(Q), sg), slofs_sg(cdr(Q), sg)) ENDIF
  MEASURE length(Q)
  slofs_rd(Q, sg): RECURSIVE list[mpoly] =
    IF null?(Q) THEN null[mpoly] ELSE append(snorm_rd(car(Q), sg), slofs_rd(cdr(Q), sg)) ENDIF
  MEASURE length(Q)
  slofs_sg_at: LEMMA FORALL Q: slofs_sg(Q, msg(ys)) = slofs(Q, ys)
  slofs_det: LEMMA FORALL Q: agree(sg1, sg2, slofs_rd(Q, sg1)) IMPLIES
    slofs_sg(Q, sg2) = slofs_sg(Q, sg1) AND slofs_rd(Q, sg2) = slofs_rd(Q, sg1)

  %% the product of the inequalities, normalized (the leaf of wtree)
  qprod_sg(ps, sg): RECURSIVE list[mpoly] =
    IF null?(ps) THEN one_list ELSE lmn_sg(car(ps)`slist, qprod_sg(cdr(ps), sg), sg) ENDIF
  MEASURE length(ps)
  qprod_rd(ps, sg): RECURSIVE list[mpoly] =
    IF null?(ps) THEN null[mpoly]
    ELSE append(qprod_rd(cdr(ps), sg), lmn_rd(car(ps)`slist, qprod_sg(cdr(ps), sg), sg))
    ENDIF
  MEASURE length(ps)
  qprod_sg_at: LEMMA FORALL ps: qprod_sg(ps, msg(ys)) = qprod(slists(ps), ys)
  qprod_det: LEMMA FORALL ps: agree(sg1, sg2, qprod_rd(ps, sg1)) IMPLIES
    qprod_sg(ps, sg2) = qprod_sg(ps, sg1) AND qprod_rd(ps, sg2) = qprod_rd(ps, sg1)

  %% a root of l0 with all of ps positive
  mcount_sg(k, l0, ps, sg): bool = mts2_sg(k, l0, slists(ps), one_list, sg) > 0
  mcount_rd(k, l0, ps, sg): list[mpoly] = mts2_rd(k, l0, slists(ps), one_list, sg)
  mcount_sg_at: LEMMA mcount_sg(k, l0, ps, msg(ys)) = select(mcount(k, sl_of(l0, ys), ps), ys)
  mcount_det: LEMMA agree(sg1, sg2, mcount_rd(k, l0, ps, sg1)) IMPLIES
    mcount_sg(k, l0, ps, sg2) = mcount_sg(k, l0, ps, sg1) AND mcount_rd(k, l0, ps, sg2) = mcount_rd(k, l0, ps, sg1)

  mcore_sg(k, l0, Q, sg): bool =
    LET ps = slofs_sg(Q, sg) IN
    IF allcons(slists(ps)) THEN mcount_sg(k, l0, ps, sg) ELSE FALSE ENDIF
  mcore_rd(k, l0, Q, sg): list[mpoly] =
    LET ps = slofs_sg(Q, sg) IN
    append(slofs_rd(Q, sg), IF allcons(slists(ps)) THEN mcount_rd(k, l0, ps, sg) ELSE null[mpoly] ENDIF)
  mcore_sg_at: LEMMA mcore_sg(k, l0, Q, msg(ys)) = select(mcore(k, sl_of(l0, ys), Q), ys)
  mcore_det: LEMMA agree(sg1, sg2, mcore_rd(k, l0, Q, sg1)) IMPLIES
    mcore_sg(k, l0, Q, sg2) = mcore_sg(k, l0, Q, sg1) AND mcore_rd(k, l0, Q, sg2) = mcore_rd(k, l0, Q, sg1)

  %% some x with all of Q positive
  itree_sg(k, Q, sg): bool =
    LET ps = slofs_sg(Q, sg) IN
    IF NOT allcons(slists(ps)) THEN FALSE
    ELSIF posinfp(ps) OR neginfp(ps) THEN TRUE
    ELSE LET w = qprod_sg(ps, sg) IN
         IF length(w) <= 2 THEN FALSE ELSE mcount_sg(k, lderiv(w), ps, sg) ENDIF
    ENDIF
  itree_rd(k, Q, sg): list[mpoly] =
    LET ps = slofs_sg(Q, sg) IN
    append(slofs_rd(Q, sg),
      IF NOT allcons(slists(ps)) THEN null[mpoly]
      ELSIF posinfp(ps) OR neginfp(ps) THEN null[mpoly]
      ELSE LET w = qprod_sg(ps, sg) IN
           append(qprod_rd(ps, sg),
                  IF length(w) <= 2 THEN null[mpoly] ELSE mcount_rd(k, lderiv(w), ps, sg) ENDIF)
      ENDIF)
  itree_sg_at: LEMMA itree_sg(k, Q, msg(ys)) = select(itree(k, Q), ys)
  itree_det: LEMMA agree(sg1, sg2, itree_rd(k, Q, sg1)) IMPLIES
    itree_sg(k, Q, sg2) = itree_sg(k, Q, sg1) AND itree_rd(k, Q, sg2) = itree_rd(k, Q, sg1)

  %% some x with E = 0 and Q > 0
  ctree_sg(k, E, Q, sg): bool =
    LET p0 = snorm_sg(sqsum(E), sg) IN
    IF null?(p0) THEN itree_sg(k, Q, sg)
    ELSIF length(p0) = 1 THEN FALSE
    ELSE mcore_sg(k, p0, Q, sg)
    ENDIF
  ctree_rd(k, E, Q, sg): list[mpoly] =
    LET p0 = snorm_sg(sqsum(E), sg) IN
    append(snorm_rd(sqsum(E), sg),
      IF null?(p0) THEN itree_rd(k, Q, sg)
      ELSIF length(p0) = 1 THEN null[mpoly]
      ELSE mcore_rd(k, p0, Q, sg)
      ENDIF)
  ctree_sg_at: LEMMA ctree_sg(k, E, Q, msg(ys)) = select(ctree(k, E, Q), ys)
  ctree_sg_sound: THEOREM length(sqsum(E)) + 2 * mlen(Q) + 1 <= k IMPLIES
    (ctree_sg(k, E, Q, msg(ys)) IFF (EXISTS (x: real): eqs_at(E, ys, x) AND allgt(Q, ys, x)))
  ctree_det: LEMMA agree(sg1, sg2, ctree_rd(k, E, Q, sg1)) IMPLIES
    ctree_sg(k, E, Q, sg2) = ctree_sg(k, E, Q, sg1) AND ctree_rd(k, E, Q, sg2) = ctree_rd(k, E, Q, sg1)
END sg_conj
