cad_fast_ex: THEORY
%----------------------------------------------------------------------------
% The fast two-quantifier decision, measured (FINISH_PLAN stage S4).
%
% Each lemma is closed by (eval-formula): the ground evaluator runs decw and
% compares.  ok = TRUE means the certificate passed, so by decw_correct the
% value IS the truth of the sentence; the _f lemmas are negative controls.
%
%   family     sentence                                    decide2    decw
%   f_line     ALL x EX y: y = x... (psi_line)             48 s       ~1 s
%   f_circle   psi_circle / control psi_circle_f           14 s       ~1 s
%   f_disc     ALL ALL psi_disc                             5 s       <1 s
%   f_meet     two curves meeting at x = +-sqrt(2)         refused    ~1 s
%   f_rad2     sections at discriminant roots (irrational) refused    ~1 s
%
% line_roots: closing the projection of f_line under the walk's intrinsic
% reads leaves ONE root -- the projection's own -- where the read closure of
% cad_lift has 21.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_fast_def, alg_bis_ex

  line_roots: LEMMA nroot(f_line) = 1

  w_line:     LEMMA decw(TRUE, FALSE, f_line, psi_line) = (# ok := TRUE, val := TRUE #)
  w_circle:   LEMMA decw(TRUE, FALSE, f_circle, psi_circle) = (# ok := TRUE, val := TRUE #)
  w_circle_f: LEMMA decw(TRUE, FALSE, f_circle, psi_circle_f) = (# ok := TRUE, val := FALSE #)
  w_disc:     LEMMA decw(TRUE, TRUE, f_disc, psi_disc) = (# ok := TRUE, val := TRUE #)
  w_meet:     LEMMA decw(FALSE, FALSE, f_meet, psi_meet) = (# ok := TRUE, val := TRUE #)
  w_meet_f:   LEMMA decw(TRUE, FALSE, f_meet, psi_meet) = (# ok := TRUE, val := FALSE #)
  w_rad2:     LEMMA decw(TRUE, FALSE, f_rad2, psi2) = (# ok := TRUE, val := TRUE #)
  w_rad2_f:   LEMMA decw(TRUE, FALSE, f_rad2, psi2_f) = (# ok := TRUE, val := FALSE #)
END cad_fast_ex
