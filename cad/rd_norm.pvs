rd_norm: THEORY
%----------------------------------------------------------------------------
% Reads normalized to a canonical scalar multiple (FINISH_PLAN 3g, A+B).
%
% The reads of the reduced chains of different pairs are scalar multiples of
% the same few polynomials (2026-09-22: 33 "live" members of a closed level,
% about seven distinct up to a constant), and the closure compares lists
% structurally.  rd_norm divides by the leading rational coefficient, so
% equal-up-to-a-constant reads coincide; the value scales by a fixed nonzero
% constant (rd_norm_eval), which is all sign invariance needs.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_pdiv

  p: VAR mpoly
  l: VAR list[mpoly]
  xs: VAR list[real]

  msize_llast: LEMMA FORALL l: cons?(l) IMPLIES msize(llast(l)) < msize(mpol(l))
  %% the leading rational: the last coefficient, recursively
  lrat(p): RECURSIVE rat =
    CASES p OF
      mconst(c): c,
      mpol(l): IF null?(l) THEN 0 ELSE lrat(llast(l)) ENDIF
    ENDCASES
  MEASURE msize(p)

  rd_norm(p): mpoly =
    LET q = mnorm(p), c = lrat(q) IN IF c = 0 THEN q ELSE mscal(1 / c, q) ENDIF

  %% a normal nonzero term has a nonzero leading rational (its last coefficient,
  %% recursively, is a nonzero constant or a term with a main variable)
  llast_lrat: LEMMA cons?(l) IMPLIES lrat(mpol(l)) = lrat(llast(l))
  lrat_normalx: LEMMA FORALL (n: nat): FORALL p, (tail?: bool): msize(p) <= n AND normalx(tail?, p) AND p /= zero
    IMPLIES lrat(p) /= 0
  lrat_nz: LEMMA mnorm(p) /= zero IMPLIES lrat(mnorm(p)) /= 0
  rd_norm_eval: LEMMA EXISTS (c: nzreal): FORALL xs: meval(rd_norm(p))(xs) = c * meval(p)(xs)
END rd_norm
