exists_dec: THEORY
%----------------------------------------------------------------------------
% Deciding a strict inequality: EXISTS x: q(x, ys) > 0 (Phase 3).
%
% This is the last question the phase needs to answer on its own, and the one
% that closes the gap in the sign conditions: when the polynomial of an
% equation vanishes identically, EXISTS x: p(x, ys) = 0 AND q(x, ys) > 0 is
% EXISTS x: q(x, ys) > 0, and no root count of p sees that.
%
% The tree is a case analysis on the normalized query.  A list that
% normalizes to nothing is the zero polynomial and has no positive value; a
% positive leading coefficient gives a positive value far to the right; a
% negative constant has none; a negative leading coefficient with an odd
% degree gives a positive value far to the left; and the one remaining case,
% even degree with a negative leading coefficient, is crit_pos's: the
% polynomial is positive somewhere exactly when it is positive at a critical
% point, which is what sign_tree's sdec decides for the derivative and the
% polynomial.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING sign_tree, crit_pos

  l, l0, q: VAR list[mpoly]
  ys: VAR list[real]
  k: VAR nat
  x: VAR real

  %% the two recognizers of a list, each from the other
  not_null_cons: LEMMA NOT null?(l) IMPLIES cons?(l)
  cons_not_null: LEMMA cons?(l) IMPLIES NOT null?(l)

  %% a list whose leading coefficient does not vanish is its own normalization
  snorm_fix: LEMMA cons?(l) AND meval(llast(l))(ys) /= 0 IMPLIES
    select(snorm(l), ys) = l

  %% the length of a nonempty list, and when an even degree forces three terms
  len_dg: LEMMA cons?(l) IMPLIES length(l) = dg(l) + 1
  odd_one: LEMMA odd?(1)
  even_dg_three: LEMMA cons?(l) AND length(l) >= 2 AND even?(dg(l)) IMPLIES
    length(l) >= 3

  %% normalizing does not change whether a positive value exists
  snorm_ex_pos: LEMMA
    (EXISTS (x: real): meval(mpol(select(snorm(q), ys)))(cons(x, ys)) > 0)
    IFF (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0)

  %% the derivative of a polynomial of degree at least two is a polynomial of
  %% degree at least one with a nonvanishing leading coefficient
  lderiv_ok: LEMMA cons?(l) AND length(l) >= 3 AND meval(llast(l))(ys) /= 0
    IMPLIES cons?(lderiv(l)) AND meval(llast(lderiv(l)))(ys) /= 0

  %% the derivative and the polynomial satisfy both Tarski queries
  tok2_lderiv: LEMMA cons?(l) AND length(l) >= 3 AND meval(llast(l))(ys) /= 0 AND
    3 * length(l) <= k IMPLIES tok2(k, lderiv(l), l, ys)

  %% sdec on lists that are already normalized
  sdec_at: LEMMA cons?(l0) AND meval(llast(l0))(ys) /= 0 AND
                 cons?(q) AND meval(llast(q))(ys) /= 0 AND tok2(k, l0, q, ys)
    IMPLIES (select(sdec(k, l0, q), ys) IFF
             (EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0 AND
                                meval(mpol(q))(cons(x, ys)) > 0))

  %% the even case for a list that is already normalized: crit_pos turns the
  %% question into the one sdec decides
  e_even_iff: LEMMA cons?(l) AND length(l) >= 2 AND even?(dg(l)) AND
    meval(llast(l))(ys) < 0 AND 3 * length(l) <= k
    IMPLIES (select(sdec(k, lderiv(l), l), ys) IFF
             (EXISTS (x: real): meval(mpol(l))(cons(x, ys)) > 0))

  %% the five leaves of the tree, each at the valuation
  e_null: LEMMA null?(select(snorm(q), ys)) IMPLIES
    NOT (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0)
  e_pos: LEMMA cons?(select(snorm(q), ys)) AND
    meval(llast(select(snorm(q), ys)))(ys) > 0 IMPLIES
    (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0)
  e_const: LEMMA length(select(snorm(q), ys)) = 1 AND
    meval(llast(select(snorm(q), ys)))(ys) < 0 IMPLIES
    NOT (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0)
  e_odd: LEMMA cons?(select(snorm(q), ys)) AND
    NOT even?(dg(select(snorm(q), ys))) AND
    meval(llast(select(snorm(q), ys)))(ys) < 0 IMPLIES
    (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0)
  e_even: LEMMA 3 * length(q) <= k AND cons?(select(snorm(q), ys)) AND
    length(select(snorm(q), ys)) >= 2 AND
    even?(dg(select(snorm(q), ys))) AND
    meval(llast(select(snorm(q), ys)))(ys) < 0 IMPLIES
    (select(sdec(k, lderiv(select(snorm(q), ys)), select(snorm(q), ys)), ys)
     IFF (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0))

  %% the decision tree for a strict inequality
  edec(k, q): btree[bool] =
    bbind(snormp(q),
          LAMBDA (p: SL):
            IF null?(p`slist) THEN bleaf(FALSE)
            ELSIF p`ssign = 1 THEN bleaf(TRUE)
            ELSIF length(p`slist) = 1 THEN bleaf(FALSE)
            ELSIF NOT even?(dg(p`slist)) THEN bleaf(TRUE)
            ELSE sdec(k, lderiv(p`slist), p`slist)
            ENDIF)

  edec_sound: THEOREM 3 * length(q) <= k IMPLIES
    (select(edec(k, q), ys) IFF
     (EXISTS (x: real): meval(mpol(q))(cons(x, ys)) > 0))
END exists_dec
