cad_meas2: THEORY
%----------------------------------------------------------------------------
% SCRATCH (Phase 6 plan item B1).  How big is the read set, and how long does
% it take to discover?  rsc_srd unions ctree2_rd over a 3^|F| tree, but the
% deduped result is small.  If the SET is small and only the DISCOVERY is
% exponential, then computing a directly-constructed superset makes inv1?
% cheap while every existing soundness lemma keeps its shape (Route 1).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_meas

  F: VAR list[list[mpoly]]

  %% the first sector of the projection's decomposition
  sec0(F): Sect = car(sects(rts(proj(F))))

  %% how many DISTINCT polynomials the sign computation reads there
  nrd(F): nat = length(reads1(F, sec0(F)))

  %% and how many reads it performs to find them (with duplicates)
  nraw(F): nat = length(svs_srd(sfuel(F), F, asgS(sec0(F))))

  nrd_line:   nat = nrd(f_line)
  nraw_line:  nat = nraw(f_line)
  nrd_circle: nat = nrd(f_circle)
  nrd_q3:     nat = nrd(q3)
  nraw_q3:    nat = nraw(q3)
  nmem_q3:    nat = length(q3)

  %% How many sectors, and how many of them are ROOT sectors?  svsec lifts a
  %% rational sector with svs_pt (polynomial) but a root sector with svs_sg
  %% (3^|F|), so the root sectors are what the lifting actually costs.
  nsec(F): nat = length(sects(rts(proj(F))))
  nrts_p(F): nat = length(rts(proj(F)))
  nrts_c(F): nat = length(rts(cl(F)))

  nrts_p_line: nat = nrts_p(f_line)
  nrts_c_line: nat = nrts_c(f_line)

  %%-------------------------------------------------------------------------
  %% B1 RESULT.  The read SET is small and barely grows with the family, while
  %% DISCOVERY is 3^|F|:  2 members -> 74 distinct out of 760 raw;
  %% 7 members -> 79 distinct out of 20132 raw.
  %%
  %% That looks like an argument for computing a superset of the read set
  %% directly (cheap inv1?, every existing soundness lemma unchanged).  It is
  %% not, and the root-sector counts are why: svsec lifts a rational sector
  %% with svs_pt (polynomial) but a ROOT sector with svs_sg (3^|F|), so the
  %% cost is #root_sectors x 3^|F|.  The projection leaves 1 root sector, the
  %% read closure 21 -- and a read-closed family must CONTAIN the ~74 read
  %% polynomials, whose roots are exactly what creates those 21.  So no
  %% cheaper read set can fix it: 21 x 3^|F| ~ 63 s is cv_line's 68.89 s, and
  %% 1 x 3^|F| ~ 1.25 s is pv_line's.
  %%
  %% CONCLUSION (plan item B2): delineability is REQUIRED -- it is what
  %% licenses the small projection family.  And exact algebraic samples at
  %% root sectors (plan item E) would replace the last 3^|F| with svs_pt.
  %%-------------------------------------------------------------------------
  read_set_small: LEMMA nrd_line = 74 AND nrd_q3 = 79 AND nraw_q3 = 20132
  root_sectors:   LEMMA nrts_p_line = 1 AND nrts_c_line = 21
END cad_meas2
