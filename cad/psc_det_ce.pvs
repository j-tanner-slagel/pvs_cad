psc_det_ce: THEORY
%----------------------------------------------------------------------------
% psc_det? is FALSE as a universal statement (GAP_PLAN.md, Tier 0).
%
% delin_bridge stated psc_det?(F) -- equal signs of projc(F) at two points
% give equal fibre sets there -- and the notes called it the one open step of
% the projection route.  It fails for a two-member family whose members
% are all non-defective at both points:
%
%   f = y^2 - 3y + 2 = (y-1)(y-2),   g = y - x,   at x = 1/2 and x = 3.
%
% Every member of projc(F) has the same sign at both points (ce_svec), but
% the fibre over x = 1/2 realizes (0, +) (take y = 1) while the fibre over
% x = 3 does not: there f = 0 only at y = 1, 2, where g = -2, -1 (ce_fib).
% The order of the roots of DIFFERENT members is not a function of the psc
% signs at two unrelated points; it is fixed only along a connected set,
% which is what the sector-local delin_projc and Tier 1 are about.
%
% Nothing verified is affected: psc_det? occurs only as a hypothesis
% (delin_from_psc) and in the proved single-quadratic case (psc_det_quad).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING delin_bridge

  negx: mpoly = mpol((: mconst(0), mconst(-1) :))           % -x

  ceF: list[list[mpoly]] =
    (: (: mconst(2), mconst(-3), mconst(1) :),              % y^2 - 3y + 2
       (: negx, mconst(1) :)                                % y - x
     :)

  %% the projection cannot tell x = 1/2 from x = 3
  ce_svec: LEMMA svec(projc(ceF), (: 1/2 :)) = svec(projc(ceF), (: 3 :))

  %% but the fibres differ: (0, +) is realized over 1/2 and not over 3
  ce_fib_half: LEMMA fib(ceF, (: 1/2 :))((: 0, 1 :))
  ce_fib_three: LEMMA NOT fib(ceF, (: 3 :))((: 0, 1 :))

  psc_det_false: THEOREM NOT psc_det?(ceF)
END psc_det_ce
