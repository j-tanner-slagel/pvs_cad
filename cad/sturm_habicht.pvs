sturm_habicht: THEORY
%----------------------------------------------------------------------------
% Non-defectiveness, and the shape of Stage C's remaining theorem.
%
% ITEM1_PLAN.md restricts item 1 to the NON-DEFECTIVE case, where the
% remainder sequence drops degree by exactly one at each step, because the
% defective (gap) case is where subresultant theory gets expensive.  This
% theory makes that restriction precise and proves the fact that makes it
% usable:
%
%   NON-DEFECTIVENESS IS ITSELF A SIGN CONDITION ON THE psc.
%
% So two points where projc(F) has the same signs are either both defective or
% both not (ndef_signs), and the runtime check the plan calls for is just
% "every psc is nonzero" -- which, since the psc are projc members, sect_svec
% already makes constant along a sector.  Nothing extra has to be computed.
%
% What remains of Stage C is the correspondence itself: NASALib's Sturm counts
% sign changes in compute_remainder_seq, a pseudo-remainder sequence over
% INTEGER coefficient arrays with content removed, so its entries are pinned
% only up to positive factors -- which is harmless, since sign changes are
% invariant under those and the leading coefficient's SIGN is what survives.
% In the non-defective case those signs are the psc signs.  That theorem is
% stated here as sh_count and is NOT proved; it is the remaining content of
% item 1 together with Stages D and E.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING subres2, spec_deg

  f, g: VAR list[mpoly]
  ys, zs: VAR list[real]
  j: VAR nat

  %% every principal subresultant coefficient up to jtop is nonzero at ys
  ndef_at(f, g, (j: nat | 2 * j <= dg(f) + dg(g)), ys): RECURSIVE bool =
    IF j = 0 THEN meval(psc(f, g, 0))(ys) /= 0
    ELSE meval(psc(f, g, j))(ys) /= 0 AND ndef_at(f, g, j - 1, ys)
    ENDIF
  MEASURE j

  ndef?(f, g, ys): bool =
    IF 2 * jtop(f, g) <= dg(f) + dg(g) THEN ndef_at(f, g, jtop(f, g), ys)
    ELSE FALSE ENDIF

  %% THE POINT: non-defectiveness depends only on the psc SIGNS, so it
  %% transfers between two points of a sector for free
  ndef_signs: LEMMA FORALL (j: nat): 2 * j <= dg(f) + dg(g) AND
    (FORALL (i: nat): 2 * i <= dg(f) + dg(g) IMPLIES
       sign3(meval(psc(f, g, i))(ys)) = sign3(meval(psc(f, g, i))(zs)))
    IMPLIES (ndef_at(f, g, j, ys) IFF ndef_at(f, g, j, zs))

  %%-------------------------------------------------------------------------
  %% STATED, NOT PROVED -- the remaining content of Stage C.
  %%
  %%   sh_count: in the non-defective case the number of distinct real roots
  %%   of the specialization of f is determined by the signs of the psc of
  %%   (f, f'), because NASALib's Sturm counts V(-inf) - V(+inf) and at
  %%   +-infinity each chain entry's sign is its leading coefficient's sign
  %%   times (-1)^degree, those leading coefficients being the psc up to
  %%   positive factors.
  %%
  %% Stage D turns sh_count into "same root count at x and y", and Stage E
  %% adds the pairwise resultants to get the same realizable sign vectors,
  %% which is psc_det?.
  %% [Corrected 2026-09-29: Stage E cannot work as stated.  The order of the
  %% roots of DIFFERENT members is not determined by psc signs at two
  %% unrelated points, and psc_det? is false (psc_det_ce).]
  %%-------------------------------------------------------------------------
END sturm_habicht
