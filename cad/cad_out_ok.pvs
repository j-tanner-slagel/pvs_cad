cad_out_ok: THEORY
%----------------------------------------------------------------------------
% The data cad_out returns is the CAD of cad_run (GAP_PLAN.md Tier 1C).
%
% One level (kids_idx, kids_cover, kids_lvl): at a certified descriptor of a
% level, the walk's children denote points of the fibre, each carries the
% stack index of its point (twice the roots below it, plus one at a root),
% and every stack index up to 2 nroot occurs.  The proof runs along the
% separators, the root list being the walk's gap roots (rtl_groots).
%
% The tree (ctree_in, ctree_cover): every record's sample lies in the cell
% its indices name over any base cell containing the start point, and over a
% CAD base (cad_over?) every nonempty cell has a record -- nroot is constant
% over a cell, so the indices of its stack occur at the start point.
%
% The run (cad_out_ok): when decn_o's certificate holds, every record of
% cad_out has a sector of the run and indices whose cell (rcell) contains
% its sample, and the recorded sign vector is F's at the sample; every
% nonempty cell of the run has a record.  With cad_run, cad_out is a CAD of
% R^(k+1) adapted to F with a sample point in every cell.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_out, od_exact, map_member[KD, list[CRec]], map_member[CRec, CRec],
    map_member[CRec, ORec], map_member[Sect, list[ORec]], clos_ok

  G, E, F: VAR list[list[mpoly]]
  od: VAR OD
  tb: VAR CT
  Y: VAR list[rat]
  n, a, u, m: VAR nat
  q: VAR list[real]
  kd: VAR KD
  TW: VAR Tower
  TB: VAR list[CT]
  C: VAR [list[real] -> bool]
  A: VAR list[nat]
  r: VAR CRec
  lo, hi, y0: VAR rat
  y: VAR real
  f: VAR [OD -> bool]

  %% ---- the walk's children, along the separators ------------------------------------------
  cellsf_kids: LEMMA FORALL Y, n: cellsf_o(f, E, od, tb, Y) = map(LAMBDA kd: f(kd`2))(kids(E, od, tb, Y, n))
  every_kd: LEMMA FORALL (L: list[KD]): every(LAMBDA (b: bool): b)(map(LAMBDA kd: f(kd`2))(L))
    AND member(kd, L) IMPLIES f(kd`2)
  every_kids: LEMMA every(LAMBDA (b: bool): b)(cellsf_o(f, E, od, tb, Y)) AND member(kd, kids(E, od, tb, Y, 0))
    IMPLIES f(kd`2)

  %% the stack index over the walk's root list for Y
  six(E, q, Y)(y): nat = 2 * nlt(groots(E, q, Y), y) + IF member(y, groots(E, q, Y)) THEN 1 ELSE 0 ENDIF

  %% the level's hypotheses at od, with the walk's family E and a gap test that is exact
  lvh?(E, od, tb, Y): bool = wf?(od) AND wsep?(E, den(od), Y) AND cons?(lives(E))
    AND slc?(bk(E), msg(den(od)), bprod(E))
    AND (FORALL lo, hi: gap_t(E, od, lo, hi, tb) = gap?(E, msg(den(od)), lo, hi))

  R: VAR list[rat]
  six_hd: LEMMA cons?(Y) AND wsep?(E, q, Y) IMPLIES six(E, q, Y)(car(Y)) = 0
  six_root: LEMMA wsep?(E, q, cons[rat](lo, cons[rat](hi, R))) AND gap?(E, msg(q), lo, hi)
    IMPLIES six(E, q, cons[rat](lo, cons[rat](hi, R)))(secbeta(E, q, lo, hi)) = 1
      AND lo < secbeta(E, q, lo, hi) AND secbeta(E, q, lo, hi) < hi
  six_gap: LEMMA wsep?(E, q, cons[rat](lo, cons[rat](hi, R))) AND gap?(E, msg(q), lo, hi) AND hi <= y
    IMPLIES six(E, q, cons[rat](lo, cons[rat](hi, R)))(y) = 2 + six(E, q, cons[rat](hi, R))(y)
  six_nogap: LEMMA NOT gap?(E, msg(q), lo, hi)
    IMPLIES six(E, q, cons[rat](lo, cons[rat](hi, R)))(y) = six(E, q, cons[rat](hi, R))(y)
  osec_ok: LEMMA wf?(od) AND wsep?(E, den(od), cons[rat](lo, cons[rat](hi, R))) AND cons?(lives(E))
    AND slc?(bk(E), msg(den(od)), bprod(E)) AND gap?(E, msg(den(od)), lo, hi)
    IMPLIES wf?(osec(od, E, lo, hi)) AND den(osec(od, E, lo, hi)) = cons(secbeta(E, den(od), lo, hi), den(od))
  lvh_cdr: LEMMA lvh?(E, od, tb, cons[rat](y0, R)) AND cons?(R) IMPLIES lvh?(E, od, tb, R)
  kids_idx: LEMMA FORALL Y, n: cons?(Y) AND lvh?(E, od, tb, Y) AND member(kd, kids(E, od, tb, Y, n))
    IMPLIES wf?(kd`2) AND cons?(den(kd`2)) AND cdr(den(kd`2)) = den(od)
      AND car(Y) <= car(den(kd`2))
      AND kd`1 = 2 * n + six(E, den(od), Y)(car(den(kd`2)))
  kids_cover: LEMMA FORALL Y, n: cons?(Y) AND lvh?(E, od, tb, Y)
    AND 2 * n <= a AND a <= 2 * n + 2 * length(groots(E, den(od), Y))
    IMPLIES EXISTS kd: member(kd, kids(E, od, tb, Y, n)) AND kd`1 = a

  %% a family with no live member: only separators, all in the one band
  kids_nolive: LEMMA FORALL Y, n: (FORALL lo, hi: NOT gap_t(E, od, lo, hi, tb)) AND member(kd, kids(E, od, tb, Y, n))
    IMPLIES kd`1 = 2 * n AND EXISTS y0: member(y0, Y) AND kd`2 = opt(od, y0)
  kids_first: LEMMA cons?(Y) IMPLIES member((2 * n, opt(od, car(Y))), kids(E, od, tb, Y, n))

  %% one level of the run, at a certified descriptor
  kids_lvl: LEMMA valid?(tb) AND wf?(od) AND lvok_o(u, G, od, tb) IMPLIES
    LET E = feff(G, od), Y = seps_t(u, E, od, tb) IN
        (FORALL kd: member(kd, kids(E, od, tb, Y, 0)) IMPLIES
           wf?(kd`2) AND cons?(den(kd`2)) AND cdr(den(kd`2)) = den(od)
           AND sidx(G, den(od), car(den(kd`2))) = kd`1)
    AND (FORALL a: a <= 2 * nroot(G, den(od)) IMPLIES
           EXISTS kd: member(kd, kids(E, od, tb, Y, 0)) AND kd`1 = a)

  %% ---- the tree -------------------------------------------------------------------------------
  mem_app: LEMMA FORALL (l1, l2: list[CRec]): member(r, append(l1, l2)) IFF (member(r, l1) OR member(r, l2))
  lflat_mem: LEMMA FORALL (L: list[list[CRec]]): member(r, lflat(L)) IFF EXISTS (l: list[CRec]): member(l, L) AND member(r, l)
  ctree_mem: LEMMA cons?(TW) AND cons?(TB) AND member(r, ctree(u, TW, TB, od)) IMPLIES
    EXISTS kd, (r1: CRec): member(kd, kids(feff(car(TW), od), od, car(TB), seps_t(u, feff(car(TW), od), od, car(TB)), 0))
      AND member(r1, ctree(u, cdr(TW), cdr(TB), kd`2)) AND r = addr(kd`1)(r1)
  ctree_intro: LEMMA cons?(TW) AND cons?(TB)
    AND member(kd, kids(feff(car(TW), od), od, car(TB), seps_t(u, feff(car(TW), od), od, car(TB)), 0))
    AND member(r, ctree(u, cdr(TW), cdr(TB), kd`2))
    IMPLIES member(addr(kd`1)(r), ctree(u, TW, TB, od))

  %% the tree's certificate: okn_o on a long enough table list
  okt?(u, TW, TB, od): bool = vtb?(TB) AND length(TB) >= length(TW) AND okn_o(u, TW, TB, od)

  ctree_in: LEMMA FORALL TW: FORALL TB, od, C, r: cons?(TW) AND okt?(u, TW, TB, od) AND wf?(od)
    AND C(den(od)) AND member(r, ctree(u, TW, TB, od))
    IMPLIES length(r`adr) = length(TW) AND wf?(r`sod) AND tcell(TW, C, r`adr)(den(r`sod))

  ctree_cover: LEMMA FORALL TW: FORALL TB, od, C, A: cons?(TW) AND okt?(u, TW, TB, od) AND wf?(od)
    AND C(den(od)) AND cad_over?(TW, C) AND length(A) = length(TW)
    AND (EXISTS q: tcell(TW, C, A)(q))
    IMPLIES EXISTS r: member(r, ctree(u, TW, TB, od)) AND r`adr = A

  %% ---- the run ----------------------------------------------------------------------------------
  qs: VAR list[bool]
  Psi: VAR [SV -> bool]
  s: VAR Sect
  o: VAR ORec

  osv_ok: LEMMA wf?(od) IMPLIES osv_of(F, od) = svec(F, den(od))

  omem_app: LEMMA FORALL (l1, l2: list[ORec]): member(o, append(l1, l2)) IFF (member(o, l1) OR member(o, l2))
  olflat_mem: LEMMA FORALL (L: list[list[ORec]]): member(o, olflat(L)) IFF EXISTS (l: list[ORec]): member(l, L) AND member(o, l)
  cad_out_mem: LEMMA length(qs) >= 2 IMPLIES
    (member(o, cad_out(u, qs, F)) IFF
       EXISTS s, r: member(s, runsects(u, length(cdr(qs)), F))
         AND member(r, ctree(u, runtw(u, length(cdr(qs)), F)(s),
                             tables(u, runtw(u, length(cdr(qs)), F)(s), odS(s)), odS(s)))
         AND o = (# rsec := s, radr := r`adr, rsod := r`sod, rsv := osv_of(F, r`sod) #))

  %% each sector's tree is certified and starts at the sector's sample
  sector_okt: LEMMA decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, runsects(u, length(cdr(qs)), F))
    IMPLIES okt?(u, runtw(u, length(cdr(qs)), F)(s), tables(u, runtw(u, length(cdr(qs)), F)(s), odS(s)), odS(s))
      AND scell(s)(den(odS(s)))

  cad_out_ok: THEOREM decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 IMPLIES
    LET k = length(cdr(qs)) IN
        (FORALL o: member(o, cad_out(u, qs, F)) IMPLIES
           member(o`rsec, runsects(u, k, F)) AND length(o`radr) = k
           AND rcell(u, k, F)(o`rsec, o`radr)(den(o`rsod))
           AND o`rsv = svec(F, den(o`rsod)))
    AND (FORALL s, A: member(s, runsects(u, k, F)) AND length(A) = k
           AND (EXISTS q: rcell(u, k, F)(s, A)(q))
           IMPLIES EXISTS o: member(o, cad_out(u, qs, F)) AND o`rsec = s AND o`radr = A)
END cad_out_ok
