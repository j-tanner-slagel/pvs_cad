cad_run: THEORY
%----------------------------------------------------------------------------
% The n-level run of decide5 computes a CAD adapted to F
% (GAP_PLAN.md Tier 1B).
%
% decn_o(u, qs, F, Psi) cuts the line of the outermost variable into the
% sectors of its outer family (runsects: points and open intervals) and,
% for each sector s, closes a tower of families runtw(s) whose last member
% is F.  Its certificate `ok checks, per sector, the tower's certificate at
% the sector's sample and, on an open sector, that the top reads keep their
% signs across the sector.
%
% rcell(s, A) is the cell of the run over sector s with stack indices A (one
% per level above the outermost variable).  cad_run: whenever the run's
% certificate holds,
%   (1) the cells cover R^(k+1) and two cells meet only if they are the same
%       (sector and indices);
%   (2) every cell is connected;
%   (3) over each sector the tower is a CAD (cad_over?): every level is
%       delineable (delin_cl?) -- continuous, non-crossing root functions
%       -- over every cell below it, and its cells are the sections and
%       bands of those functions;
%   (4) every polynomial of F has one sign on every cell.
% That is a cylindrical decomposition of R^(k+1) adapted to F into
% finitely many connected cells (finitely many sectors, and over a cell each
% stack has 2 nroot + 1 cells), built from sections and bands of continuous
% root functions as in Basu-Pollack-Roy, Def. 5.1.  BPR also require
% semi-algebraic cells: every cell, at every level, is first-order
% definable (rcf_cells, rcell_fod_le), and cad_verified states the
% definition (the partition for R^(k+1); at lower levels it follows from
% cad_tower's tcell_cover / tcell_disj and is not restated), semi-algebraic
% in the sense of first-order definable (the
% quantifier-free sense follows by qelim_ok's fod_qfd, the Tarski-Seidenberg
% theorem, and cad_sa's cad_cells_sa states it for these cells).  (Before
% 2026-09-30 this comment claimed Def. 5.1 without that.)
% Completeness (decn_complete, decide_u) makes the certificate hold for
% every large enough u, so such a decomposition is always obtained.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_tower, decn_ok

  s, s1, s2: VAR Sect
  rs: VAR list[Alg]
  x: VAR real
  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  p, p1, p2: VAR list[real]
  A, A1, A2: VAR list[nat]

  %% ---- the outer sectors partition the line ------------------------------------------------
  a0: VAR Alg
  R: VAR list[Alg]
  mem_gs1: LEMMA member(s, gsects((: a0 :))) IFF (s = at(a0) OR s = above(a0))
  mem_gs2: LEMMA cons?(R) IMPLIES
    (member(s, gsects(cons(a0, R))) IFF (s = at(a0) OR s = mid(a0, car(R)) OR member(s, gsects(R))))
  mem_sects: LEMMA cons?(rs) IMPLIES (member(s, sects(rs)) IFF (s = below(car(rs)) OR member(s, gsects(rs))))
  gsects_ge: LEMMA FORALL rs: incr?(rs) AND cons?(rs) AND member(s, gsects(rs)) AND in?(s, x)
    IMPLIES value(car(rs)) <= x AND (x = value(car(rs)) IMPLIES s = at(car(rs)))
  gsects_disj: LEMMA FORALL rs: incr?(rs) AND member(s1, gsects(rs)) AND member(s2, gsects(rs))
    AND in?(s1, x) AND in?(s2, x) IMPLIES s1 = s2
  sects_disj: LEMMA incr?(rs) AND member(s1, sects(rs)) AND member(s2, sects(rs))
    AND in?(s1, x) AND in?(s2, x) IMPLIES s1 = s2

  %% ---- what the run computes ------------------------------------------------------------------
  k: VAR nat
  runq(u, k, F): list[list[mpoly]] = nclos_o(u, cfuel + u, tw0(k, F), proj(topf(tw0(k, F))))
  runsects(u, k, F): list[Sect] = sects(rts(runq(u, k, F)))
  runtw(u, k, F)(s): Tower = lvln_o(u, tw0(k, F), s)
  scell(s): [list[real] -> bool] = sline(insec(s), null[real])
  rcell(u, k, F)(s, A): [list[real] -> bool] = tcell(runtw(u, k, F)(s), scell(s), A)

  len2: LEMMA length(qs) >= 2 IMPLIES cons?(qs) AND cons?(cdr(qs)) AND length(cdr(qs)) >= 1
  len1: LEMMA length(p) = 1 IMPLIES cons?(p) AND cdr(p) = null
  run_ok: LEMMA decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, runsects(u, length(cdr(qs)), F))
    IMPLIES sok2?(s) AND scok?(u)(scof(u, tw0(length(cdr(qs)), F), s)) AND in?(s, value(sample(s)))
  run_shape: LEMMA k >= 1 IMPLIES
    cons?(runtw(u, k, F)(s)) AND length(runtw(u, k, F)(s)) = k AND tlast(runtw(u, k, F)(s)) = F

  %% ---- one sector ------------------------------------------------------------------------------
  scell_conn: LEMMA conn?(scell(s))
  scell_mem: LEMMA scell(s)(p) IFF (cons?(p) AND cdr(p) = null AND in?(s, car(p)))
  sector_inv: LEMMA decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, runsects(u, length(cdr(qs)), F))
    IMPLIES invz?(car(runtw(u, length(cdr(qs)), F)(s)), insec(s), value(sample(s)), null[real])
      AND CLF(runtw(u, length(cdr(qs)), F)(s), (: value(sample(s)) :))
  sector_cad: THEOREM decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 AND member(s, runsects(u, length(cdr(qs)), F))
    IMPLIES cad_over?(runtw(u, length(cdr(qs)), F)(s), scell(s))

  %% ---- THE RUN COMPUTES A CAD ADAPTED TO F -----------------------------------------------------------
  cad_run: THEOREM decn_o(u, qs, F, Psi)`ok AND length(qs) >= 2 IMPLIES
    LET k = length(cdr(qs)), ss = runsects(u, length(cdr(qs)), F) IN
        (FORALL p: length(p) = k + 1 IMPLIES
           EXISTS s, A: member(s, ss) AND length(A) = k AND rcell(u, length(cdr(qs)), F)(s, A)(p))
    AND (FORALL p, s1, s2, A1, A2: member(s1, ss) AND member(s2, ss)
           AND length(A1) = k AND length(A2) = k
           AND rcell(u, length(cdr(qs)), F)(s1, A1)(p) AND rcell(u, length(cdr(qs)), F)(s2, A2)(p)
           IMPLIES s1 = s2 AND A1 = A2)
    AND (FORALL s, A: member(s, ss) AND length(A) <= k IMPLIES conn?(rcell(u, length(cdr(qs)), F)(s, A)))
    AND (FORALL s: member(s, ss) IMPLIES cad_over?(runtw(u, length(cdr(qs)), F)(s), scell(s)))
    AND (FORALL s, A, p1, p2: member(s, ss) AND length(A) = k
           AND rcell(u, length(cdr(qs)), F)(s, A)(p1) AND rcell(u, length(cdr(qs)), F)(s, A)(p2)
           IMPLIES svec(F, p1) = svec(F, p2))
END cad_run
