cad_local: THEORY
%----------------------------------------------------------------------------
% The stack is locally constant (GAP_PLAN.md Tier 1).
%
% Near a point p0 where the walk's certificate holds, at every p whose reads
% agree with p0's, the fibre over p looks like the fibre over p0: the same
% sign vectors at its roots (rsvl) and on its bands (bsvl), so the same root
% count (loc_stack), and each root within eta of the corresponding root over
% p0 (loc_cont).
%
% Proof: fix separators Y that pass the walk at p0 (wok_exist).  Near p0 they
% pass at p too, the same gaps hold roots, the separators and the gap roots
% see the same sign vectors (mwalk.near_cells), and each gap root moves
% continuously (mroot.mroot_near, through cad_gpar.gr_near).  Both root lists
% are the gap roots over the same Y (cad_roots.rtl_groots), so they run in
% parallel (cad_gpar).  A band's sign vector is read at a separator inside
% it, which has the same band index over p and over p0 (gr_cover, gr_nlt).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_gpar, structures@more_list_props[SV]

  G: VAR list[list[mpoly]]
  p, p0, xs: VAR list[real]
  x0: VAR real
  Y: VAR list[rat]
  y0: VAR rat
  i: VAR nat
  eta: VAR posreal

  %% ---- one point -------------------------------------------------------------------------------
  %% a separator is never a root
  sep_noroot: LEMMA certz?(G, p) AND wok?(zf(G, p), msg(p), Y) AND member(y0, Y)
    IMPLIES NOT member(y0, rtl(G, p))

  %% the sign vector at a separator is its band's entry of bsvl
  bsvl_sep: LEMMA certz?(G, p) AND wok?(zf(G, p), msg(p), Y) AND member(y0, Y)
    IMPLIES nlt(rtl(G, p), y0) <= nroot(G, p) AND length(bsvl(G, p)) = nroot(G, p) + 1
      AND svec(G, cons(y0, p)) = nth(bsvl(G, p), nlt(rtl(G, p), y0))

  %% ---- two points with the walk's local picture --------------------------------------------------
  same_walk?(G, p0, p, Y): bool =
    certz?(G, p0) AND certz?(G, p)
    AND wok?(zf(G, p0), msg(p0), Y) AND wok?(zf(G, p0), msg(p), Y)
    AND zf(G, p) = zf(G, p0) AND samepat?(zf(G, p0), p0, p, Y)
    AND (FORALL y0: member(y0, Y) IMPLIES svec(G, cons(y0, p)) = svec(G, cons(y0, p0)))
    AND (FORALL (lo, hi: rat), (beta0, beta1: real): member(lo, Y) AND member(hi, Y)
           AND gapf?(zf(G, p0), p0, lo, hi, beta0) AND gapf?(zf(G, p0), p, lo, hi, beta1)
           IMPLIES svec(G, cons(beta1, p)) = svec(G, cons(beta0, p0)))

  sw_rtl: LEMMA same_walk?(G, p0, p, Y) IMPLIES
    rtl(G, p) = groots(zf(G, p0), p, Y) AND rtl(G, p0) = groots(zf(G, p0), p0, Y)
  nroot_eq: LEMMA same_walk?(G, p0, p, Y) IMPLIES nroot(G, p) = nroot(G, p0)
  rsvl_eq: LEMMA same_walk?(G, p0, p, Y) IMPLIES rsvl(G, p) = rsvl(G, p0)
  bsvl_eq: LEMMA same_walk?(G, p0, p, Y) IMPLIES bsvl(G, p) = bsvl(G, p0)

  %% near_cells gives that picture near p0
  sw_near: LEMMA certz?(G, p0) IMPLIES EXISTS Y, (d: posreal):
    wok?(zf(G, p0), msg(p0), Y) AND
    FORALL p: near?(p, p0, d) AND agree(msg(p0), msg(p), wrs(G, p0)) IMPLIES same_walk?(G, p0, p, Y)

  %% ---- the stack is locally constant ---------------------------------------------------------------
  loc_stack: THEOREM certz?(G, p0) IMPLIES EXISTS (d: posreal): FORALL p:
    near?(p, p0, d) AND agree(msg(p0), msg(p), wrs(G, p0))
    IMPLIES certz?(G, p) AND rsvl(G, p) = rsvl(G, p0) AND bsvl(G, p) = bsvl(G, p0)

  loc_cont: THEOREM certz?(G, cons(x0, xs)) IMPLIES EXISTS (d: posreal): FORALL p:
    near?(p, cons(x0, xs), d) AND agree(msg(cons(x0, xs)), msg(p), wrs(G, cons(x0, xs)))
    IMPLIES nroot(G, p) = nroot(G, cons(x0, xs)) AND
      (FORALL i: i < nroot(G, cons(x0, xs)) IMPLIES abs(rt(G, p, i) - rt(G, cons(x0, xs), i)) < eta)
END cad_local
