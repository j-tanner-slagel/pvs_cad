qe_cad_ex: THEORY
%----------------------------------------------------------------------------
% Quantifier elimination with (cad-qe) (GAP_PLAN.md Tier 2): examples.
%
% (cad-qe FNUM) replaces a prenex formula with free real variables by the
% formula qe computes, proved equivalent from qe_correct (qe_all); for one
% free variable it is always quantifier-free (qe_qf1).
%
% qe_win: a moving point at distance sqrt((5 - t)^2 + (t/2)^2) from a fixed
% one comes within distance D at some time t in [0, 10] exactly when
% D^2 > 5 (the closest approach, at t = 4, is sqrt(5)).  (cad-qe) turns the
% existential into 125/4 - 25/4 D^2 < 0.  qe_sqrt and qe_disc: square roots
% and a discriminant; qe_disc2: two bound variables.  qe_eq2 and qe_quad have
% two free variables: (cad-qe) replaces the existential by a disjunction over
% the sectors of b (for qe_quad: b < 0, b = 0, or b > 0 and a^2 - 4 b >= 0),
% and each direction follows by propositional and linear reasoning (with
% a^2 >= 0 for qe_quad).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_all, mpoly_embed, cad_endgame

  D, a, b, r: VAR real

  qe_win: LEMMA
    (EXISTS (t: real): 0 <= t AND t <= 10 AND (5 - t)^2 + (t/2)^2 < D^2) IFF D^2 > 5

  %% a square root exists exactly for the non-negative numbers
  qe_sqrt: LEMMA (EXISTS (t: real): t^2 = D) IFF D >= 0

  %% x^2 + b x + 1 is positive everywhere exactly when the discriminant is negative
  qe_disc: LEMMA (FORALL (x: real): x^2 + b*x + 1 > 0) IFF b^2 < 4

  %% two bound variables: the open disc of "radius squared" r is nonempty exactly when r > 0
  qe_disc2: LEMMA (EXISTS (x: real): EXISTS (y: real): x^2 + y^2 < r) IFF r > 0

  %% two free variables: a common value exists exactly when they are equal
  qe_eq2: LEMMA (EXISTS (t: real): t = a AND t = b) IFF a = b

  %% two free variables: t^2 + a t + b has a real root exactly when a^2 >= 4 b
  qe_quad: LEMMA (EXISTS (t: real): t^2 + a*t + b = 0) IFF a^2 >= 4*b
END qe_cad_ex
