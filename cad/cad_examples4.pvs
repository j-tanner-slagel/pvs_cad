cad_examples4: THEORY
%----------------------------------------------------------------------------
% FOUR quantifiers through (cad) (FINISH_PLAN 3i, stage N10): the n-level
% decision decn_o of towern_od, proved correct in decn_ok (decn_correct) and
% reached through decide5.  Each TRUE sentence below is closed by the single
% step (cad); a FALSE one is stated in the antecedent form and refuted by
% (flatten) then (cad -1).
% Times of the decision alone (cad-mn, this machine): e4_above 16 s,
% e4_between 12 s, e4_sum 1 s, e4_square 2 s.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  %% above any three numbers there is a fourth
  e4_above: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w > z
  %% but not always one above two of them and below the third
  e4_between: LEMMA (FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w < z) IMPLIES FALSE
  %% alternating quantifiers
  e4_sum: LEMMA FORALL (x: real): EXISTS (y: real): FORALL (z: real): EXISTS (w: real):
    w > x + y + z
  e4_square: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): FORALL (w: real):
    w^2 + z > x + y
END cad_examples4
