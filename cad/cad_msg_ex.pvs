cad_msg_ex: THEORY
%----------------------------------------------------------------------------
% Inputs for tools/msgcheck.sh, which checks what (cad), (cad *), (cad-num),
% (cad-qe) and qe-exists say when they do not prove a formula: FALSE
% reports, refusals, hints, and the label cad on the formula that stays.
% The formulas are false or refused on purpose, so these theories are not in
% top.pvs and have no proofs.  cad_msg_pc imports pvs_cad only (the hint for
% constants), cad_msg_d5 cad_decide5 only (formulas of any shape need
% pvs_cad), cad_msg_qe qe_all only (no decision for (cad)).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING pvs_cad_num

  m_false: LEMMA FORALL (x: real): x^2 > 0
  m_true_hyp: LEMMA (FORALL (x: real): x^2 >= 0) IMPLIES (EXISTS (y: real): y^2 < 0)
  m_gen_false: LEMMA (FORALL (x: real): x^2 > 0) OR (EXISTS (y: real): y^2 < 0)
  m_star: LEMMA FORALL (x: real): x > 0 IMPLIES x > 1
  m_pi_false: LEMMA pi^2 > 10
  m_pi_prec: LEMMA pi > 3.14159265358979323846264338327
  m_nat: LEMMA FORALL (n: nat): n * n >= n
  m_qe_closed: LEMMA FORALL (x: real): x^2 >= 0
  m_qe_closed2: LEMMA FORALL (x, y: real): x^2 + y^2 >= 0
  m_t5_bound: LEMMA EXISTS (x: real): sin(x) = 1/2
  m_t5_false: LEMMA FORALL (x: real): 1/2 <= x AND x <= 1 IMPLIES sin(x) >= x
  m_sqrt_false: LEMMA sqrt(2) > 2
  m_t4_false: LEMMA FORALL (x: real): sqrt(x^2 + 1) > x + 1
  m_one: LEMMA FORALL (x: real): x^2 >= 0
  m_qe_nat: LEMMA NOT EXISTS (n: nat): 2 * n - 1 = 0
END cad_msg_ex

cad_msg_pc: THEORY
BEGIN
  IMPORTING pvs_cad

  m_hint: LEMMA FORALL (x: real): x^2 - pi * x + 3 > 0
END cad_msg_pc

cad_msg_d5: THEORY
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  m_shape: LEMMA (EXISTS (x: real): x > 0) AND (FORALL (y: real): y^2 >= 0)
END cad_msg_d5

cad_msg_qe: THEORY
BEGIN
  IMPORTING qe_all, mpoly_embed, cad_endgame

  m_nodec: LEMMA FORALL (x: real): x^2 >= 0
END cad_msg_qe
