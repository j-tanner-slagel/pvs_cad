bench_pdec: THEORY
%----------------------------------------------------------------------------
% The closed prenex problems of the Bath CAD example bank, as PVS formulas.
%
% Source: Wilson, Bradford and Davenport, "A repository for CAD examples",
% ACM Communications in Computer Algebra 46(3/4) 67-69, doi 10.1145/2429135.2429137;
% dataset maintained by David Wilson, University of Bath Research Data Archive
% version 4 (2013), doi 10.15125/BATH-00069, CC-BY-SA 4.0; this file is
% distributed under CC BY-SA 4.0 (NOTICE.md).  Translated from the QEPCAD-syntax
% file (by a script not kept in this repository): (E x)/(A x) to quantifiers,
% /\ \/ ==> to AND OR IMPLIES, brackets to parentheses, juxtaposition made
% explicit.
%
% These are the 12 entries with no free variables and a full quantifier prefix,
% i.e. the decision problems (cad) is meant to discharge.  Every one needs at
% least THREE quantifiers.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_pdec, mpoly_embed

  %% TWO ENTRIES ARE EXCLUDED, both for defects in the SOURCE data rather than
  %% in the translation (checked against QEPCADexamplebank_v4.txt directly):
  %%   bath_06  its third conjunct is a bare polynomial with NO relation
  %%            operator -- the only such atom in any formula line of the bank
  %%   bath_11  its formula line has two closing brackets to one opening
  %% Neither is guessed at here; adding "= 0" to 06 would be inventing the
  %% problem rather than translating it.

  %% sanity checks: the four examples whose answers are known and proved
  %% (cad_pdec_ex: pdec_examples, pdec_controls)
  chk_line:   LEMMA FORALL (x: real): EXISTS (y: real): x + 2 * y = 1 AND y * y >= 0
  chk_circle: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + y^2 = 1 OR x^2 > 1
  chk_disc:   LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 < 1 IMPLIES x < 1
  chk_three:  LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z > x AND z > y


  % Ball and Circular Cylinder  (3 vars, 3 quantifiers)
  bath_01_ball_and_circular_cylinder: LEMMA
    EXISTS (z: real): EXISTS (x: real): EXISTS (y: real): (((x^2 + y^2 + z^2 - 1 < 0) AND (x^2 + (y + z - 2)^2 - 1 < 0)))

  % Term Rewrite  (3 vars, 3 quantifiers)
  bath_02_term_rewrite: LEMMA
    EXISTS (r: real): FORALL (x: real): FORALL (y: real): ((((x - r > 0) AND (y - r > 0)) IMPLIES (x^2 * (1 + 2 * y)^2 - y^2 * (1 + 2 * x^2) > 0)))

  % Collision of Circle and Square  (3 vars, 3 quantifiers)
  bath_03_collision_of_circle_and_square: LEMMA
    EXISTS (y: real): EXISTS (x: real): EXISTS (t: real): (((17 * t - 96 >= 0) AND (17 * t - 160 <= 0) AND (16 * x - 17 * t + 16 >= 0) AND (16 * x - 17 * t - 16 <= 0) AND (16 * y - 17 * t + 144 >= 0) AND (16 * y - 17 * t + 112 <= 0) AND ((x - t)^2 + y^2 - 1 <= 0)))

  % McCallum Trivariate Random Polynomial  (3 vars, 3 quantifiers)
  bath_04_mccallum_trivariate_random_polynom: LEMMA
    EXISTS (x: real): EXISTS (y: real): EXISTS (z: real): (((y - 1) * z^4 + x * z^3 + x * (1 - y) * z^2 + (y - x - 1) * z + y = 0))

  % Random A from Buchberger-Hong  (3 vars, 3 quantifiers)
  bath_05_random_a_from_buchberger_hong: LEMMA
    EXISTS (x: real): FORALL (y: real): EXISTS (z: real): (((4 * x^2 + x * y^2 - z + 1/4 = 0) AND (2 * x + y^2 * z + 1/2 = 0) AND (x^2 * z - 1/2 * x - y^2 = 0 )))

  %% EXCLUDED (source defect)  Random A Grobner from Buchberger-Hong  (3 vars, 3 quantifiers)
  %% bath_06_random_a_grobner_from_buchberger_h: LEMMA
  %% EXISTS (x: real): FORALL (y: real): EXISTS (z: real): (((x^7 + 29/4 * x^6 - 17/16 * x^4 - 11/8 * x^3 + 1/32 * x^2 + 15/16 * x + 14 = 0) AND (y^2 + 112/2745 * x^6 - 84/305 * x^5 - 1264/305 * x^4 - 13/549 * x^3 + 84/305 * x^2 + 1772/2745 * x + 2/2745 = 0) AND (z - 1568/2745 * x^6 - 1264/305 * x^5 + 6/305 * x^4 + 182/549 * x^3 - 2047/610 * x^2 - 103/2745 * x - 2857/10980)))

  % Random B from Buchberger-Hong  (3 vars, 3 quantifiers)
  bath_07_random_b_from_buchberger_hong: LEMMA
    EXISTS (z: real): FORALL (y: real): EXISTS (x: real): (((4 * x^2 + x * y^2 - z + 1/4 = 0) AND (2 * x + y^2 * z + 1/2 = 0) AND (x^2 * z - 1/2 * x - y^2 = 0 )))

  % Random B Grobner from Buchberger-Hong  (3 vars, 3 quantifiers)
  bath_08_random_b_grobner_from_buchberger_h: LEMMA
    EXISTS (z: real): FORALL (y: real): EXISTS (x: real): (((z^7 - 1/2 * z^6 + 1/16 * z^5 + 13/4 * z^4 + 75/16 * z^3 - 171/8 * z^2 + 133/8 * z - 15/4 = 0) AND (y^2 - 19188/497 * z^6 + 318/497 * z^5 - 4197/1988 * z^4 - 251555/1988 * z^3 - 481837/1988 * z^2 + 1407741/1988 * z - 297833/994 = 0) AND (x + 4638/497 * z^6 - 75/497 * z^5 + 2111/3976 * z^4 + 61031/1988 * z^3 + 232833/3976 * z^2 - 85042/497 * z + 144407/1988 = 0)))

  % Joukowsky Transformation  (4 vars, 4 quantifiers)
  bath_09_joukowsky_transformation: LEMMA
    FORALL (a: real): FORALL (b: real): FORALL (c: real): FORALL (d: real): ((((a * (c^2 + d^2) * (a^2 + b^2 + 1) - c * (a^2 + b^2) * (c^2 + d^2 + 1) = 0) AND (b * (c^2 + d^2) * (a^2 + b^2 - 1) - d * (a^2 + b^2) * (c^2 + d^2 - 1) = 0) AND (b * d > 0) AND (c^2 + d^2 - 1 > 0)) IMPLIES ((a = c) AND (b = d))))

  % Joukowsky Transformation  (4 vars, 4 quantifiers)
  bath_10_joukowsky_transformation: LEMMA
    FORALL (a: real): FORALL (b: real): FORALL (c: real): FORALL (d: real): ((((a * (c^2 + d^2) * (a^2 + b^2 + 1) - c * (a^2 + b^2) * (c^2 + d^2 + 1) = 0) AND (b * (c^2 + d^2) * (a^2 + b^2 - 1) - d * (a^2 + b^2) * (c^2 + d^2 - 1) = 0) AND (b * d > 0) AND (c^2 + d^2 - 1 > 0)) IMPLIES ((a = c) AND (b = d))))

  %% EXCLUDED (source defect)  Separate Clauses  (4 vars, 4 quantifiers)
  %% bath_11_separate_clauses: LEMMA
  %% EXISTS (a: real): EXISTS (b: real): EXISTS (c: real): EXISTS (d: real): ((b^2 * c * d^2 + a^2 * c * d^2 - a * b^2 * d^2 - a^3 * d^2 - a * d^2 + b^2 * c^3 + a^2 * c^3 - a * b^2 * c^2 - a^3 * c^2 - a * c^2 + b^2 * c + a^2 * c = 0 AND b^2 * d^3 + a^2 * d^3 - b^3 * d^2 - a^2 * b * d^2 + b * d^2 + b^2 * c^2 * d + a^2 * c^2 * d - b^2 * d - a^2 * d - b^3 * c^2 - a^2 * b * c^2 + b * c^2 = 0 AND (d)(b) > 0 AND d^2 + c^2 - 1 > 0 AND c - a /= 0)))

  % Upper Half Plane  (4 vars, 4 quantifiers)
  bath_12_upper_half_plane: LEMMA
    FORALL (a: real): FORALL (b: real): FORALL (c: real): FORALL (d: real): ((((a * (c^2 + d^2) * (a^2 + b^2 + 1) - c * (a^2 + b^2) * (c^2 + d^2 + 1) = 0) AND (b * (c^2 + d^2) * (a^2 + b^2 - 1) - d * (a^2 + b^2) * (c^2 + d^2 - 1) = 0) AND (b > 0) AND (d > 0)) IMPLIES ((a = c) AND (b = d))))

END bench_pdec
