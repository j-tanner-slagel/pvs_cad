walk_same: THEORY
%----------------------------------------------------------------------------
% Two points whose oracles agree on the walk's reads have the same fibre set,
% for ARBITRARY valuations (FINISH_PLAN stage S5d, claim B).
%
% walk_transfer moves one coordinate of cons(x, xs).  Claim B compares the
% inner fibre over (y0, x) with (y0, x0), and over a section (beta(x), x) with
% (beta0, x0): neither is a move of the first coordinate alone.  So the
% middle of fib_local's proof is restated between any two valuations vs0,
% vs1 (walk_same), and the entry reads are described by pz?: each is nonzero
% at vs0 or is the zero polynomial outright (az?, the null entry that ends a
% chain).  pz? gives sign_pers's nz? and joint_cont's jz?, so either kind of
% persistence can supply walk_same's hypothesis.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING walk_transfer, joint_cont

  F, G: VAR list[list[mpoly]]
  g: VAR list[mpoly]
  cs: VAR list[list[mpoly]]
  u: VAR mpoly
  R, R1, R2: VAR list[mpoly]
  vs, vs0, vs1, xs: VAR list[real]
  Y, Z: VAR list[rat]
  y: VAR rat
  x0, y0: VAR real
  v: VAR SV

  az?(u): bool = FORALL vs: meval(u)(vs) = 0
  pz?(R, vs): bool = FORALL u: member(u, R) IMPLIES meval(u)(vs) /= 0 OR az?(u)

  pz_null: LEMMA pz?(null[mpoly], vs)
  pz_cons: LEMMA pz?(cons(u, R), vs) IFF ((meval(u)(vs) /= 0 OR az?(u)) AND pz?(R, vs))
  pz_append: LEMMA FORALL R1: pz?(append(R1, R2), vs) IFF (pz?(R1, vs) AND pz?(R2, vs))
  pz_nz: LEMMA pz?(R, cons(x0, xs)) IMPLIES nz?(R, x0, xs)
  pz_jz: LEMMA pz?(R, cons(y0, cons(x0, xs))) IMPLIES jz?(R, y0, x0, xs)

  %% the entry reads of a walk whose separators avoid the chains
  ent_pz: LEMMA FORALL cs: av?(cs, vs, y) IMPLIES pz?(ent_rd(cs, y), vs)
  ents_pz: LEMMA FORALL Y: (FORALL y: member(y, Y) IMPLIES av?(cs, vs, y))
    IMPLIES pz?(ents_rd(cs, Y), vs)
  me_nz_pz: LEMMA FORALL G:
    (FORALL y: member(y, Y) IMPLIES av?(mch(F, msg(vs), G), vs, y))
    IMPLIES pz?(me_nz(F, msg(vs), G, Y), vs)
  pe_pz: LEMMA FORALL G: (FORALL y: member(y, Y) IMPLIES av?(pch(msg(vs), g, G), vs, y))
    IMPLIES pz?(pe_rd(msg(vs), g, G, Y), vs)
  pairse_pz: LEMMA FORALL G: (FORALL y: member(y, Y) IMPLIES av?(pchs(msg(vs), G), vs, y))
    IMPLIES pz?(pairse_rd(msg(vs), G, Y), vs)
  wnz_pz: THEOREM avall?(F, vs, Y) IMPLIES pz?(wnz(F, msg(vs), Y), vs)

  %% members with no main variable, between any two valuations
  short_ents_g: LEMMA length(strip(g)) < 2
    AND (length(strip(g)) = 1 IMPLIES msg(vs1)(car(strip(g))) = msg(vs0)(car(strip(g))))
    IMPLIES FORALL Y: agree(msg(vs0), msg(vs1), ents_rd((: g :), Y))
  me_sh_agree_g: LEMMA FORALL G:
    (FORALL g: member(g, G) AND length(strip(g)) = 1 IMPLIES
       msg(vs1)(car(strip(g))) = msg(vs0)(car(strip(g))))
    IMPLIES agree(msg(vs0), msg(vs1), me_sh(G, Y))
  short_inv_g: LEMMA agree(msg(vs0), msg(vs1), wi_rd(F, msg(vs0)))
    IMPLIES agree(msg(vs0), msg(vs1), me_sh(F, Y))

  walk_same: THEOREM wok?(F, msg(vs0), Z)
    AND agree(msg(vs0), msg(vs1), wi_rd(F, msg(vs0)))
    AND agree(msg(vs0), msg(vs1), wnz(F, msg(vs0), Z))
    IMPLIES FORALL v: fib(F, vs1)(v) IFF fib(F, vs0)(v)
END walk_same
