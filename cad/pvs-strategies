;;; pvs_cad strategies: every proof command of the library, from Phase 1's
;;; mpoly-eq to (cad), (cad *), (cad-qe), (cad-num) and their helpers; the
;;; sections below say which plan each one comes from.  They need PVS built
;;; with SBCL for the budgets of the witness search and the measuring
;;; commands (sb-ext:with-timeout); elsewhere those run without a time limit.
;;;
;;; mpoly-eq proves an equality between two polynomial expressions over real
;;; atoms by computational reflection:
;;;   1. the Lisp printer below turns each side into a PolyExpr term
;;;      (variables are the maximal non-polynomial subterms, numbered by
;;;      first occurrence; numeric literals become pe_const);
;;;   2. peval(E)(xs) = side is proved by rewriting with the peval_* lemmas;
;;;   3. pnorm(E1) = pnorm(E2) is decided by the ground evaluator;
;;;   4. poly_eq_by_norm closes the goal.
;;; The printer is not trusted: every equation it suggests is proved.

;; is E an application of the connective or relation NAME ("AND", "OR",
;; "IMPLIES", "IFF", "NOT", "=", "/=", "<", ...)?  The connectives and /= are
;; recognized by the class PVS gives them, so every synonym counts: & and the
;; wedge (AND), the vee (OR), => and the double arrow (IMPLIES; WHEN, with its
;; arguments swapped by PVS), <=> (IFF), the negation sign (NOT), the
;; not-equal sign (/=).
(defun cad-is (e name)
  (cond ((string= name "AND") (conjunction? e))
        ((string= name "OR") (disjunction? e))
        ((string= name "IMPLIES") (implication? e))
        ((string= name "IFF") (iff? e))
        ((string= name "NOT") (negation? e))
        ((string= name "/=") (disequation? e))
        (t (is-function-expr e name))))

(defparameter *mpoly-atoms* nil)   ; atom strings, in order of first occurrence

(defun mpoly-atom-index (expr)
  (let* ((str (expr2str expr))
         (pos (position str *mpoly-atoms* :test #'string=)))
    (if pos (1+ pos)
      (progn (setq *mpoly-atoms* (append *mpoly-atoms* (list str)))
             (length *mpoly-atoms*)))))

(defun mpoly-expr-rec (expr)
  (let ((num (extra-get-number-from-expr expr t)))
    (cond (num (format nil "pe_const(~a)" num))
          ((and (unary-application? expr) (is-function-expr expr "-"))
           (format nil "pe_neg(~a)" (mpoly-expr-rec (args1 expr))))
          ((is-function-expr expr "+")
           (format nil "pe_add(~a, ~a)" (mpoly-expr-rec (args1 expr)) (mpoly-expr-rec (args2 expr))))
          ((is-function-expr expr "-")
           (format nil "pe_sub(~a, ~a)" (mpoly-expr-rec (args1 expr)) (mpoly-expr-rec (args2 expr))))
          ((is-function-expr expr "*")
           (format nil "pe_mul(~a, ~a)" (mpoly-expr-rec (args1 expr)) (mpoly-expr-rec (args2 expr))))
          ((is-function-expr expr "^")
           (let ((n (extra-get-number-from-expr (args2 expr) t)))
             (if (and n (integerp n) (>= n 0))
                 (format nil "pe_pow(~a, ~a)" (mpoly-expr-rec (args1 expr)) n)
               (format nil "pe_var(~a)" (mpoly-atom-index expr)))))
          ((is-function-expr expr "sq")   ; sq(a) expands to a*a, so print it as a product
           (let ((a (mpoly-expr-rec (args1 expr))))
             (format nil "pe_mul(~a, ~a)" a a)))
          ((is-function-expr expr "/")
           (let ((d (extra-get-number-from-expr (args2 expr) t)))
             (if (and d (not (zerop d)))
                 (format nil "pe_mul(~a, pe_const(~a))" (mpoly-expr-rec (args1 expr)) (/ 1 d))
               (format nil "pe_var(~a)" (mpoly-atom-index expr)))))
          (t (format nil "pe_var(~a)" (mpoly-atom-index expr))))))

(defun mpoly-valuation ()
  (if *mpoly-atoms*
      (format nil "(: ~{~a~^, ~} :)" *mpoly-atoms*)
    "null[real]"))

;; Names of user-defined constants (with a definition, declared outside the
;; prelude and outside library theories) occurring in EXPR, for unfolding.
(defun mpoly-user-defined-names (expr)
  (let ((names nil))
    (mapobject #'(lambda (obj)
                   (when (and (name-expr? obj)
                              (declaration obj)
                              (const-decl? (declaration obj))
                              (definition (declaration obj))
                              (not (from-prelude? (declaration obj)))
                              (not (lib-datatype-or-theory? (module (declaration obj)))))
                     (pushnew (string (id obj)) names :test #'string=))
                   nil)
               expr)
    (reverse names)))

(defhelper mpoly-unfold__ (fnum)
  (let ((fexpr (extra-get-formula fnum))
        (names (when fexpr (mpoly-user-defined-names fexpr)))
        ;; the steps are built here: FNUM may be a label, which a step built
        ;; inside mapstep's lambda would read as a Lisp variable
        (steps (loop for nm in names collect `(expand ,nm ,fnum))))
    (when names
      (mapstep #'(lambda (st) st) steps)))
  "[pvs_cad] Internal: unfolds user definitions in FNUM." "")

(defhelper mpoly-eq-side__ ()
  (then (rewrite-msg-off)
        (expand "sq")
        (auto-rewrite "peval_pconst" "peval_pvar" "peval_padd" "peval_psub" "peval_pmul"
                      "peval_pneg" "peval_ppow" "nth0_1" "nth0_succ")
        (assert)
        (stop-rewrite "peval_pconst" "peval_pvar" "peval_padd" "peval_psub" "peval_pmul"
                      "peval_pneg" "peval_ppow" "nth0_1" "nth0_succ"))
  "[pvs_cad] Internal: proves peval(E)(xs) = e by rewriting." "")

;;; Formulas are named by fresh labels (with-fresh-labels, discriminate),
;;; never by their position in the sequent.  A fact the strategies add to the
;;; sequent is split on with CAD-FACT-CASE: the case formula is wrapped in id,
;;; as extrategies does, so that PVS neither closes a branch nor moves a
;;; negation before the branch's own step runs (a case on a formula already in
;;; the sequent, or on NOT A, would otherwise shift the branches); each branch
;;; unwraps it first.  USE runs where FML is a hypothesis and PROVE where it
;;; is to be proved; LAB labels it in both.
(defun cad-fact-case (fml lab use prove)
  `(branch (discriminate (case ,(format nil "id(~a)" fml)) ,lab)
     ((then (expand "id" ,lab :assert? none) ,use)
      (then (expand "id" ,lab :assert? none) ,prove))))

;; the proof of one reflection equation, labelled LAB, meval(mpol(L))(CNS) =
;; EXPR: as_list(pnorm(E)) = L by evaluation, then peval_pnorm and
;; mpoly-eq-side__'s rewriting (ASL is the text of the first equation)
(defun cad-mev-proof (asl e cns lab)
  `(with-fresh-labels ((!cma) (!cmp))
     (then (hide-all-but ,lab)
           (branch (discriminate (case ,asl) !cma)
             ((then (replace !cma :dir RL) (rewrite "meval_as_list")
                    (discriminate (lemma "peval_pnorm") !cmp) (inst !cmp ,e ,cns) (replace !cmp)
                    (mpoly-eq-side__))
              (then (hide-all-but !cma) (eval-formula !cma)))))))

(defhelper mpoly-eq__ (fnum)
  (let ((fexpr (extra-get-formula fnum))
        (eq?   (and fexpr (is-function-expr fexpr "=")))
        (lhs   (when eq? (args1 fexpr)))
        (rhs   (when eq? (args2 fexpr)))
        (dummy (setq *mpoly-atoms* nil))
        (e1    (when eq? (mpoly-expr-rec lhs)))
        (e2    (when eq? (mpoly-expr-rec rhs)))
        (xs    (mpoly-valuation))
        (c1    (when eq? (format nil "peval(~a)(~a) = ~a" e1 xs (expr2str lhs))))
        (c2    (when eq? (format nil "peval(~a)(~a) = ~a" e2 xs (expr2str rhs))))
        (c3    (when eq? (format nil "pnorm(~a) = pnorm(~a)" e1 e2))))
    (if (not eq?)
        (printf "mpoly-eq: formula ~a is not an equality" fnum)
      (with-fresh-labels ((!mq1) (!mq2) (!mq3) (!mql))
        (branch (discriminate (case c1) !mq1)
          ((branch (discriminate (case c2) !mq2)
             ((branch (discriminate (case c3) !mq3)
                ((then (discriminate (lemma "poly_eq_by_norm") !mql) (inst !mql e1 e2 xs) (assert))
                 (then (hide-all-but !mq3) (eval-formula !mq3))))
              (then (hide-all-but !mq2) (mpoly-eq-side__))))
           (then (hide-all-but !mq1) (mpoly-eq-side__)))))))
  "[pvs_cad] Internal." "")

(defstep mpoly-eq (&optional (fnum 1))
  (with-fresh-labels ((!mqg fnum))
    (then (skeep !mqg) (mpoly-unfold__$ !mqg) (mpoly-eq__$ !mqg)))
  "[pvs_cad] Proves the polynomial identity in FNUM (an equality of real
expressions over arbitrary atoms, possibly universally quantified) by
reflection into the verified normal form of mpoly_embed."
  "Proving polynomial identity in ~a by reflection")

;;; ------------------------------------------------------------------
;;; mpoly-simp: replace a polynomial expression by its normal form.
;;; The normal form is computed by the ground evaluator (pnorm) and
;;; printed back as a PVS expression over the same atoms; the equation
;;; expr = normal-form is then proved by mpoly-eq, so nothing beyond the
;;; ground evaluator is trusted.

(defun mpoly-list-elems (arg)
  (cond ((list-expr? arg) (exprs arg))
        ((null-expr? arg) nil)
        (t nil)))

(defun mpoly-zero-term? (term)
  (and (is-function-expr term "mconst")
       (let ((n (extra-get-number-from-expr (args1 term) t)))
         (and n (zerop n)))))

(defun mpoly-const-term? (term)
  (is-function-expr term "mconst"))

(defun mpoly-num-str (n)
  (if (< n 0) (format nil "(~a)" n) (format nil "~a" n)))

;; a monomial coef * var^i as a string; coefstr is already rendered
(defun mpoly-monomial-str (coefstr const? var i)
  (let ((factor (cond ((= i 0) nil) ((= i 1) var) (t (format nil "~a^~a" var i)))))
    (cond ((null factor) coefstr)
          ((string= coefstr "1") factor)
          (const? (format nil "~a*~a" coefstr factor))
          (t (format nil "(~a)*~a" coefstr factor)))))

;; render an evaluated mpoly term; depth 1 is the head variable of *mpoly-atoms*
(defun mpoly-term->str (term depth)
  (cond ((is-function-expr term "mconst")
         (mpoly-num-str (extra-get-number-from-expr (args1 term) t)))
        ((is-function-expr term "mpol")
         (let* ((elems (mpoly-list-elems (args1 term)))
                (var   (nth (1- depth) *mpoly-atoms*))
                (terms nil))
           (loop for c in elems for i from 0 do
             (unless (mpoly-zero-term? c)
               (push (mpoly-monomial-str (mpoly-term->str c (1+ depth)) (mpoly-const-term? c) var i)
                     terms)))
           (if (null terms) "0" (format nil "~{~a~^ + ~}" (reverse terms)))))
        (t (format nil "~a" term))))

(defstep mpoly-simp (expr &optional (fnums *))
  (let ((fexpr (extra-get-expr expr))
        (dummy (setq *mpoly-atoms* nil))
        (e     (when fexpr (mpoly-expr-rec fexpr)))
        (val   (when e (evalexpr (format nil "pnorm(~a)" e) nil nil t)))
        (nf    (when val (mpoly-term->str val 1)))
        (estr  (when fexpr (expr2str fexpr)))
        (eqn   (when nf (format nil "~a = ~a" estr nf)))
        ;; FNUMS are labelled before the case adds the equation, so that they
        ;; name the formulas they named when the step was called
        (strat (when eqn
                 `(with-fresh-labels ((!msf ,fnums) (!mse))
                    ,(cad-fact-case eqn '!mse '(replace !mse !msf :hide? t)
                                    '(then (hide-all-but !mse) (mpoly-eq !mse)))))))
    (if (null nf)
        (printf "mpoly-simp: could not normalize ~a" expr)
      (if (string= estr nf)
          (printf "mpoly-simp: ~a is already in normal form" estr)
        strat)))
  "[pvs_cad] Replaces the polynomial expression EXPR (a string) by its
normal form in formulas FNUMS; the equation is proved by mpoly-eq."
  "Normalizing ~a")

;;; ------------------------------------------------------------------
;;; alg-roots (Phase 2): isolate the real roots of a univariate polynomial
;;; expression P in the variable X, and add to the sequent
;;;   P = 0 IMPLIES (lb_1 <= X AND X <= ub_1) OR ... OR (lb_k <= X AND X <= ub_k)
;;; and, for each polynomial Q of SIGNS and each root,
;;;   lb_i <= X AND X <= ub_i AND P = 0 IMPLIES Q > 0 / Q = 0 / Q < 0.
;;; The intervals come from the verified isolation (alg_isolate.roots), the
;;; signs from alg_sign; every fact is proved from root_interval /
;;; sign_at_root, ground evaluation and the reflection of Phase 1.

;; field VALUE of a record expression (as a string), by field name
(defun alg-record-field (rec field)
  (let ((asg (find-if #'(lambda (a) (string= (string (id (caar (arguments a)))) field))
                      (assignments rec))))
    (when asg (expr2str (expression asg)))))

;; the intervals of an evaluated list of alg records: list of (lb ub recstr)
(defun alg-intervals (lst)
  (mapcar #'(lambda (r) (list (alg-record-field r "lb") (alg-record-field r "ub") (expr2str r)))
          (mpoly-list-elems lst)))

(defun alg-interval-str (iv x)
  (format nil "(~a <= ~a AND ~a <= ~a)" (first iv) x x (second iv)))

(defun alg-rel-str (q s)
  (cond ((= s 1) (format nil "~a > 0" q))
        ((= s -1) (format nil "~a < 0" q))
        (t (format nil "~a = 0" q))))

;; proves the goal  polylist(PL)(X) = P  (PL the literal of upoly(E))
(defhelper alg-upoly__ (e pl x)
  (let ((eqc (format nil "upoly(~a) = ~a" e pl)))
    (with-fresh-labels ((!aue) (!aul))
      (branch (discriminate (case eqc) !aue)
        ((then (replace !aue :dir RL :hide? t)
               (discriminate (lemma "upoly_eval") !aul) (inst !aul e x) (replace !aul :hide? t)
               (mpoly-eq-side__))
         (then (hide-all-but !aue) (eval-formula !aue))))))
  "[pvs_cad] Internal." "")

(defun alg-sign-strategy (fact rec e pl pstr eq ql qstr s xstr)
  `(with-fresh-labels ((!asf) (!asa) (!asl) (!ass) (!asp) (!asq))
     ,(cad-fact-case
       fact '!asf '(skip)
       `(then (hide-all-but !asf) (flatten !asf)
              (branch (discriminate (case ,(format nil "alg?(~a)" rec)) !asa)
                ((then (discriminate (lemma "sign_at_root") !asl) (inst !asl ,ql ,xstr ,rec)
                       (branch (discriminate (case ,(format nil "alg_sign(~a, ~a) = ~a" rec ql s)) !ass)
                         ((branch (discriminate (case ,(format nil "polylist(~a)(~a) = ~a" pl xstr pstr)) !asp)
                            ((branch (discriminate (case ,(format nil "polylist(~a)(~a) = ~a" ql xstr qstr)) !asq)
                               ((then (assert) (expand "sign3") (lift-if) (assert))
                                (then (hide-all-but !asq) (alg-upoly__$ ,eq ,ql ,xstr))))
                             (then (hide-all-but !asp) (alg-upoly__$ ,e ,pl ,xstr))))
                          (then (hide-all-but !ass) (eval-formula !ass)))))
                 (then (hide-all-but !asa) (eval-formula !asa))))))))

(defstep alg-roots (p &optional (signs nil) (var nil) (split? nil))
  (let ((fexpr (extra-get-expr p))
        ;; VAR, when given, is atom 1, the variable of upoly
        (dummy (setq *mpoly-atoms* (when var (list var))))
        (e     (when fexpr (mpoly-expr-rec fexpr)))
        (pstr  (when fexpr (expr2str fexpr)))
        (xstr  (cond ((null e) nil)
                     ((/= (length *mpoly-atoms*) 1) nil)
                     (t (car *mpoly-atoms*))))
        (plval (when xstr (evalexpr (format nil "upoly(~a)" e) nil nil t)))
        (pl    (when plval (expr2str plval)))
        (degok (when pl (evalexpr (format nil "deg(~a) > 0" pl) nil nil t)))
        (rl    (when (and degok (string= (expr2str degok) "TRUE"))
                 (evalexpr (format nil "roots(~a)" pl) nil nil t)))
        (ivs   (when rl (alg-intervals rl)))
        (rlstr (when rl (expr2str rl)))
        (ks    (make-list (1+ (length ivs))))
        (disj  (when rl (if ivs (format nil "~{~a~^ OR ~}" (mapcar #'(lambda (iv) (alg-interval-str iv xstr)) ivs)) "FALSE")))
        (f1    (when rl (format nil "~a = 0 IMPLIES ~a" pstr disj)))
        (cplp  (when rl (format nil "polylist(~a)(~a) = ~a" pl xstr pstr)))
        (cpl0  (when rl (format nil "polylist(~a)(~a) = 0" pl xstr)))
        (crl   (when rl (format nil "roots(~a) = ~a" pl rlstr)))
        (cdeg  (when rl (format nil "deg(~a) > 0" pl)))
        ;; root_interval gives a root a of the list with x in its interval; the
        ;; list is replaced by its value, member is unfolded, and each case
        ;; a = r_i (labelled by discriminate as the split's new formula) is
        ;; substituted and evaluated
        (f1strat (when rl
                   `(with-fresh-labels ((!arf) (!ard) (!arp) (!arl) (!arc) (!are))
                      ,(cad-fact-case
                        f1 '!arf '(label "alg-roots" !arf)
                        `(then (hide-all-but !arf) (flatten !arf)
                               (branch (discriminate (case ,cdeg) !ard)
                                 ((branch (discriminate (case ,cplp) !arp)
                                    ((then (discriminate (lemma "root_interval") !arl) (inst !arl ,pl ,xstr)
                                           (assert) (skeep !arl)
                                           (branch (discriminate (case ,crl) !arc)
                                             ((then (replace !arc !arl :hide? t)
                                                    ,@(loop repeat (length ks) collect '(expand "member" !arl))
                                                    (discriminate (split !arl) !are)
                                                    (replace !are) (flatten) (assert))
                                              (then (hide-all-but !arc) (eval-formula !arc)))))
                                     (then (hide-all-but !arp) (alg-upoly__$ ,e ,pl ,xstr))))
                                  (then (hide-all-but !ard) (eval-formula !ard)))))))))
        (qstrats (when rl
                   (loop for q in signs append
                     (let* ((qexpr (extra-get-expr q))
                            (dummy2 (setq *mpoly-atoms* (list xstr)))
                            (eq    (mpoly-expr-rec qexpr))
                            (qstr  (expr2str qexpr))
                            (qlval (evalexpr (format nil "upoly(~a)" eq) nil nil t))
                            (ql    (expr2str qlval)))
                       (loop for iv in ivs collect
                         (let* ((sv (evalexpr (format nil "alg_sign(~a, ~a)" (third iv) ql) nil nil t))
                                (s  (extra-get-number-from-expr sv t))
                                (fact (format nil "~a AND ~a = 0 IMPLIES ~a" (alg-interval-str iv xstr) pstr (alg-rel-str qstr s))))
                           (alg-sign-strategy fact (third iv) e pl pstr eq ql qstr s xstr)))))))
        (allstrats (when rl (cons f1strat qstrats)))
        (finish (if split? '(then (assert) (split "alg-roots") (flatten) (assert)) '(skip))))
    (if (null xstr)
        (printf "alg-roots: ~a must be a polynomial in exactly one variable~@[ (~a)~]" p var)
      (if (null rl)
          (printf "alg-roots: ~a is constant or could not be evaluated" p)
        (then (mapstep #'(lambda (st) st) allstrats) finish))))
  "[pvs_cad] Isolates the real roots of the univariate polynomial expression
P (a string) and adds the isolating intervals as a hypothesis; with SIGNS, a
list of polynomial expressions in the same variable, also adds the sign of
each of them at each root; the interval fact is labeled alg-roots. With
SPLIT? the sequent is then split into one case per root (avoid prop on the
result: it is exponential in the number of sign facts). VAR names the variable
when P could mention it in a form the reader does not see as a variable; P
must still be a polynomial in VAR alone. All facts are proved."
  "Isolating the real roots of ~a")

;;; ------------------------------------------------------------------
;;; poly-pos (Phase 3): branching positivity.
;;; For a polynomial expression P in the eliminated variable X whose other
;;; atoms are parameters, the decision tree pdec of pos_dec is evaluated and
;;; every branch whose verdict is TRUE contributes
;;;    <sign conditions on the parameters> IMPLIES P > 0
;;; to the sequent, labelled poly-pos.  The conditions are the branch
;;; conditions printed as ordinary arithmetic; each fact is proved from
;;; pos_branch (branch_sound and pdec_sound), the ground evaluation of the
;;; tree, and the reflection of Phase 1.  Nothing is trusted.

;; field FIELD of a record expression, as an expression
(defun ppos-field (rec field)
  (let ((asg (find-if #'(lambda (a) (string= (string (id (caar (arguments a)))) field))
                      (assignments rec))))
    (when asg (expression asg))))

(defun ppos-rel-str (s)
  (cond ((= s 1) "> 0") ((= s -1) "< 0") (t "= 0")))

;; one sign condition, printed over the parameter atoms (atoms 2, 3, ...)
(defun ppos-cond-str (rec)
  (let* ((cp (ppos-field rec "cpol"))
         (sv (ppos-field rec "csign"))
         (s  (extra-get-number-from-expr sv t)))
    (format nil "(~a) ~a" (mpoly-term->str cp 2) (ppos-rel-str s))))

(defun ppos-conds-str (conds)
  (if conds (format nil "~{~a~^ AND ~}" (mapcar #'ppos-cond-str conds)) "TRUE"))

;; the proof of one branch fact
(defun ppos-branch-strategy (fact bstr bconds l0 k ys xstr e pstr)
  (let ((chstr (format nil "branch_tree[bool].conds_hold(~a, ~a)" bconds ys))
        (memb  (format nil "member(~a, branches(pdec(~a, ~a)))" bstr k l0))
        (lenc  (format nil "length(~a) <= ~a" l0 k))
        (mev   (format nil "meval(mpol(~a))(cons(~a, ~a)) = ~a" l0 xstr ys pstr))
        (asl   (format nil "as_list(pnorm(~a)) = ~a" e l0))
        (cns   (format nil "cons(~a, ~a)" xstr ys)))
    `(with-fresh-labels ((!ppf) (!ppc) (!ppm) (!ppl) (!ppb) (!ppv))
       ,(cad-fact-case
         fact '!ppf '(label "poly-pos" !ppf)
         `(then (hide-all-but !ppf) (flatten !ppf)
                (branch (discriminate (case ,chstr) !ppc)
                  ((branch (discriminate (case ,memb) !ppm)
                     ((branch (discriminate (case ,lenc) !ppl)
                        ((then (discriminate (lemma "pos_branch") !ppb) (inst !ppb ,bstr ,k ,l0 ,ys) (assert)
                               (inst !ppb ,xstr)
                               (branch (discriminate (case ,mev) !ppv)
                                 ((assert) ,(cad-mev-proof asl e cns '!ppv))))
                         (then (hide-all-but !ppl) (eval-formula !ppl))))
                      (then (hide-all-but !ppm) (eval-formula !ppm))
                      (grind)))
                   (then (expand "conds_hold") (expand "every") (expand "cond_holds")
                         (expand "msign") (grind))
                   (grind))))))))

(defstep poly-pos (p &optional (var nil))
  (let ((fexpr (extra-get-expr p))
        (dummy (setq *mpoly-atoms* (when var (list var))))
        (e     (when fexpr (mpoly-expr-rec fexpr)))
        (pstr  (when fexpr (expr2str fexpr)))
        (xstr  (cond ((null e) nil)
                     (var var)
                     ((= (length *mpoly-atoms*) 1) (car *mpoly-atoms*))
                     (t nil)))
        (ys    (if (cdr *mpoly-atoms*)
                   (format nil "(: ~{~a~^, ~} :)" (cdr *mpoly-atoms*))
                 "null[real]"))
        (l0v   (when xstr (evalexpr (format nil "as_list(pnorm(~a))" e) nil nil t)))
        (l0    (when l0v (expr2str l0v)))
        (kv    (when l0 (evalexpr (format nil "length(~a)" l0) nil nil t)))
        (k     (when kv (expr2str kv)))
        (brv   (when k (evalexpr (format nil "branches(pdec(~a, ~a))" k l0) nil nil t)))
        (brs   (when brv (mpoly-list-elems brv)))
        (tbrs  (remove-if-not #'(lambda (b) (string= (expr2str (ppos-field b "bres")) "TRUE")) brs))
        (strats (loop for b in tbrs collect
                  (let* ((bstr   (expr2str b))
                         (bconds (expr2str (ppos-field b "bconds")))
                         (cstr   (ppos-conds-str (mpoly-list-elems (ppos-field b "bconds"))))
                         (fact   (format nil "~a IMPLIES ~a > 0" cstr pstr)))
                    (ppos-branch-strategy fact bstr bconds l0 k ys xstr e pstr)))))
    (if (null xstr)
        (printf "poly-pos: ~a must be a polynomial in one variable (or give :var)" p)
      (if (null brs)
          (printf "poly-pos: could not evaluate the decision tree of ~a" p)
        (if (null tbrs)
            (printf "poly-pos: ~a is positive on no branch" p)
          (mapstep #'(lambda (st) st) strats)))))
  "[pvs_cad] For the polynomial expression P (a string) in the variable VAR,
adds to the sequent one fact per branch of the verified decision tree on which
P is everywhere positive:  <sign conditions on the other atoms> IMPLIES P > 0.
The facts are labelled poly-pos and every one of them is proved."
  "Deciding positivity of ~a by branching Sturm")

;;; poly-nonzero (Phase 3): the same tree, read for the absence of roots.
;;; Every branch of qdec whose verdict is FALSE contributes
;;;    <sign conditions on the parameters> IMPLIES P /= 0
;;; to the sequent, labelled poly-nonzero.

(defun pnz-branch-strategy (fact bstr bconds l0 k ys xstr e pstr)
  (let ((chstr (format nil "branch_tree[bool].conds_hold(~a, ~a)" bconds ys))
        (memb  (format nil "member(~a, branches(qdec(~a, ~a)))" bstr k l0))
        (lenc  (format nil "length(~a) <= ~a" l0 k))
        (mev   (format nil "meval(mpol(~a))(cons(~a, ~a)) = ~a" l0 xstr ys pstr))
        (asl   (format nil "as_list(pnorm(~a)) = ~a" e l0))
        (cns   (format nil "cons(~a, ~a)" xstr ys)))
    `(with-fresh-labels ((!ppf) (!ppc) (!ppm) (!ppl) (!ppb) (!ppv))
       ,(cad-fact-case
         fact '!ppf '(label "poly-nonzero" !ppf)
         `(then (hide-all-but !ppf) (flatten !ppf)
                (branch (discriminate (case ,chstr) !ppc)
                  ((branch (discriminate (case ,memb) !ppm)
                     ((branch (discriminate (case ,lenc) !ppl)
                        ((then (discriminate (lemma "noroot_branch") !ppb) (inst !ppb ,bstr ,k ,l0 ,ys) (assert)
                               (inst !ppb ,xstr)
                               (branch (discriminate (case ,mev) !ppv)
                                 ((assert) ,(cad-mev-proof asl e cns '!ppv))))
                         (then (hide-all-but !ppl) (eval-formula !ppl))))
                      (then (hide-all-but !ppm) (eval-formula !ppm))
                      (grind)))
                   (then (expand "conds_hold") (expand "every") (expand "cond_holds")
                         (expand "msign") (grind))
                   (grind))))))))

(defstep poly-nonzero (p &optional (var nil))
  (let ((fexpr (extra-get-expr p))
        (dummy (setq *mpoly-atoms* (when var (list var))))
        (e     (when fexpr (mpoly-expr-rec fexpr)))
        (pstr  (when fexpr (expr2str fexpr)))
        (xstr  (cond ((null e) nil)
                     (var var)
                     ((= (length *mpoly-atoms*) 1) (car *mpoly-atoms*))
                     (t nil)))
        (ys    (if (cdr *mpoly-atoms*)
                   (format nil "(: ~{~a~^, ~} :)" (cdr *mpoly-atoms*))
                 "null[real]"))
        (l0v   (when xstr (evalexpr (format nil "as_list(pnorm(~a))" e) nil nil t)))
        (l0    (when l0v (expr2str l0v)))
        (kv    (when l0 (evalexpr (format nil "length(~a)" l0) nil nil t)))
        (k     (when kv (expr2str kv)))
        (brv   (when k (evalexpr (format nil "branches(qdec(~a, ~a))" k l0) nil nil t)))
        (brs   (when brv (mpoly-list-elems brv)))
        (fbrs  (remove-if-not #'(lambda (b) (string= (expr2str (ppos-field b "bres")) "FALSE")) brs))
        (strats (loop for b in fbrs collect
                  (let* ((bstr   (expr2str b))
                         (bconds (expr2str (ppos-field b "bconds")))
                         (cstr   (ppos-conds-str (mpoly-list-elems (ppos-field b "bconds"))))
                         (fact   (format nil "~a IMPLIES ~a /= 0" cstr pstr)))
                    (pnz-branch-strategy fact bstr bconds l0 k ys xstr e pstr)))))
    (if (null xstr)
        (printf "poly-nonzero: ~a must be a polynomial in one variable (or give :var)" p)
      (if (null brs)
          (printf "poly-nonzero: could not evaluate the decision tree of ~a" p)
        (if (null fbrs)
            (printf "poly-nonzero: ~a has a root on every branch" p)
          (mapstep #'(lambda (st) st) strats)))))
  "[pvs_cad] For the polynomial expression P (a string) in the variable VAR,
adds to the sequent one fact per branch of the verified decision tree on which
P has no real root:  <sign conditions on the other atoms> IMPLIES P /= 0.
The facts are labelled poly-nonzero and every one of them is proved."
  "Deciding the absence of roots of ~a by branching Sturm")

;;; ------------------------------------------------------------------
;;; poly-sign / poly-nosign (Phase 3): a sign condition at a root.
;;; The formula FNUM is EXISTS (x: real): P = 0 AND Q > 0, with P and Q
;;; polynomial in x and in the parameters.  The pruned decision tree sdecide
;;; of sgn_prune is evaluated and every branch whose verdict is TRUE
;;; contributes
;;;    <sign conditions on the parameters> IMPLIES EXISTS x: P = 0 AND Q > 0
;;; to the sequent (poly-sign), and every branch whose verdict is FALSE
;;; contributes
;;;    <sign conditions> IMPLIES FORALL x: NOT (P = 0 AND Q > 0)
;;; (poly-nosign).  Each fact is proved from psign_branch or pnosign_branch,
;;; the ground evaluation of the tree, and the reflection of Phase 1: the
;;; witness the branch theorem provides is named after the bound variable of
;;; the formula, which is what lets the printed polynomials be reused as
;;; expressions in the proof.  Nothing is trusted.

;; the bound variable, the polynomial of the equation and the polynomial of
;; the inequality of EXISTS (x: real): P = 0 AND Q > 0
(defun psign-parts (fexpr)
  (when (and fexpr (exists-expr? fexpr))
    (let ((bs (bindings fexpr)) (body (expression fexpr)))
      ;; one real variable, whose name the proof can use as a skolem constant
      (when (and (= (length bs) 1) (tc-eq (type (car bs)) *real*)
                 (is-freevar (string (id (car bs))) *real*)
                 (cad-is body "AND"))
        (let ((eqn (args1 body)) (ineq (args2 body)))
          (when (and (is-function-expr eqn "=") (is-function-expr ineq ">"))
            (let ((z1 (extra-get-number-from-expr (args2 eqn) t))
                  (z2 (extra-get-number-from-expr (args2 ineq) t)))
              (when (and z1 z2 (zerop z1) (zerop z2))
                (list (string (id (car bs))) (args1 eqn) (args1 ineq))))))))))

;; the conditions of a branch, printed so that the empty list typechecks
(defun psign-conds-str (b)
  (if (mpoly-list-elems (ppos-field b "bconds"))
      (expr2str (ppos-field b "bconds"))
    "null[branch_tree[bool].SignCond]"))

;; the branch record itself, printed the same way
(defun psign-brec-str (b)
  (format nil "(# bconds := ~a, bres := ~a #)"
          (psign-conds-str b) (expr2str (ppos-field b "bres"))))

;; the proof of one branch fact.  PRE runs on the fact once its conditions are
;; in the sequent, USE once the branch theorem has been instantiated; the two
;; reflection equations are the last thing proved.  The fact is labelled !psf
;; (after flatten, its conclusion carries the label too) and the branch
;; theorem !psb; PRE and USE refer to them by these labels.
(defun psign-branch-strategy (name fact lem bstr bconds l0 q k ys xstr ep eq pstr qstr pre use)
  (let* ((chstr (format nil "branch_tree[bool].conds_hold(~a, ~a)" bconds ys))
         (memb  (format nil "member(~a, branches(sdecide(~a, ~a, ~a)))" bstr k l0 q))
         (fuel  (format nil "length(~a) + 3 * length(~a) <= ~a" l0 q k))
         (cns   (format nil "cons(~a, ~a)" xstr ys))
         (mevp  (format nil "meval(mpol(~a))(cons(~a, ~a)) = ~a" l0 xstr ys pstr))
         (mevq  (format nil "meval(mpol(~a))(cons(~a, ~a)) = ~a" q xstr ys qstr))
         (aslp  (format nil "as_list(pnorm(~a)) = ~a" ep l0))
         (aslq  (format nil "as_list(pnorm(~a)) = ~a" eq q))
         (finish `(branch (discriminate (case ,mevp) !psp)
                    ((branch (discriminate (case ,mevq) !psq)
                       ((assert) ,(cad-mev-proof aslq eq cns '!psq)))
                     ,(cad-mev-proof aslp ep cns '!psp))))
         (core `(then (discriminate (lemma ,lem) !psb) (inst !psb ,bstr ,k ,l0 ,q ,ys) (assert)
                      ,@use ,finish)))
    `(with-fresh-labels ((!psf) (!psc) (!psm) (!psu) (!psb) (!psp) (!psq))
       ,(cad-fact-case
         fact '!psf `(label ,name !psf)
         `(then (hide-all-but !psf) (flatten !psf) ,@pre
                (branch (discriminate (case ,chstr) !psc)
                  ((branch (discriminate (case ,memb) !psm)
                     ((branch (discriminate (case ,fuel) !psu)
                        (,core (then (hide-all-but !psu) (eval-formula !psu))))
                      (then (hide-all-but !psm) (eval-formula !psm))
                      (grind)))
                   (then (expand "conds_hold") (expand "every") (expand "cond_holds")
                         (expand "msign") (grind))
                   (grind))))))))

;; the common front end: parse the formula, evaluate the pruned tree
(defun psign-setup (fnum var)
  (let* ((fexpr (extra-get-formula fnum))
         (parts (psign-parts fexpr)))
    (when parts
      (let* ((xstr (if var var (first parts)))
             (pe   (second parts))
             (qe   (third parts))
             (ignore (setq *mpoly-atoms* (list xstr)))
             (ep   (mpoly-expr-rec pe))
             (eq   (mpoly-expr-rec qe))
             (pstr (expr2str pe))
             (qstr (expr2str qe))
             (ys   (if (cdr *mpoly-atoms*)
                       (format nil "(: ~{~a~^, ~} :)" (cdr *mpoly-atoms*))
                     "null[real]"))
             (l0v  (evalexpr (format nil "as_list(pnorm(~a))" ep) nil nil t))
             (l0   (when l0v (expr2str l0v)))
             (qv   (evalexpr (format nil "as_list(pnorm(~a))" eq) nil nil t))
             (qq   (when qv (expr2str qv)))
             (kv   (when (and l0 qq)
                     (evalexpr (format nil "length(~a) + 3 * length(~a)" l0 qq) nil nil t)))
             (k    (when kv (expr2str kv)))
             (brv  (when k (evalexpr (format nil "branches(sdecide(~a, ~a, ~a))" k l0 qq) nil nil t)))
             (brs  (when brv (mpoly-list-elems brv))))
        (declare (ignore ignore))
        (list xstr ep eq pstr qstr ys l0 qq k brs (expr2str fexpr))))))

(defstep poly-sign (&optional (fnum 1) (var nil))
  (let ((noimp (not (cad-imports? "sgn_prune")))
        (setup (unless noimp (psign-setup fnum var)))
        (xstr  (first setup))
        (ep    (second setup))
        (eq    (third setup))
        (pstr  (fourth setup))
        (qstr  (fifth setup))
        (ys    (sixth setup))
        (l0    (seventh setup))
        (qq    (eighth setup))
        (k     (ninth setup))
        (brs   (tenth setup))
        (gstr  (nth 10 setup))
        (tbrs  (remove-if-not #'(lambda (b) (string= (expr2str (ppos-field b "bres")) "TRUE")) brs))
        (strats (loop for b in tbrs collect
                  (let* ((bstr   (psign-brec-str b))
                         (bconds (psign-conds-str b))
                         (cstr   (ppos-conds-str (mpoly-list-elems (ppos-field b "bconds"))))
                         (fact   (format nil "~a IMPLIES (~a)" cstr gstr)))
                    (psign-branch-strategy "poly-sign" fact "psign_branch" bstr bconds l0 qq k ys
                                           xstr ep eq pstr qstr
                                           nil
                                           (list `(skolem !psb (,xstr)) '(flatten !psb) `(inst !psf ,xstr)))))))
    (if noimp
        (printf "poly-sign: this theory does not import sgn_prune, the decision poly-sign uses")
    (if (null setup)
        (printf "poly-sign: formula ~a is not of the form EXISTS (x: real): P = 0 AND Q > 0 (one real variable, whose name is not already declared here)" fnum)
      (if (null brs)
          (printf "poly-sign: could not evaluate the decision tree")
        (if (null tbrs)
            (printf "poly-sign: no branch has a root with a positive value")
          (mapstep #'(lambda (st) st) strats))))))
  "[pvs_cad] For the formula FNUM, EXISTS (x: real): P = 0 AND Q > 0 over
polynomials in x and in the parameters, adds to the sequent one fact per
branch of the verified decision tree on which such a root exists:
<sign conditions on the parameters> IMPLIES <the formula>.  The facts are
labelled poly-sign and every one of them is proved."
  "Deciding a sign condition at a root of ~a by branching Sturm-Tarski")

(defstep poly-nosign (&optional (fnum 1) (var nil))
  (let ((noimp (not (cad-imports? "sgn_prune")))
        (setup (unless noimp (psign-setup fnum var)))
        (xstr  (first setup))
        (ep    (second setup))
        (eq    (third setup))
        (pstr  (fourth setup))
        (qstr  (fifth setup))
        (ys    (sixth setup))
        (l0    (seventh setup))
        (qq    (eighth setup))
        (k     (ninth setup))
        (brs   (tenth setup))
        (fbrs  (remove-if-not #'(lambda (b) (string= (expr2str (ppos-field b "bres")) "FALSE")) brs))
        (strats (loop for b in fbrs collect
                  (let* ((bstr   (psign-brec-str b))
                         (bconds (psign-conds-str b))
                         (cstr   (ppos-conds-str (mpoly-list-elems (ppos-field b "bconds"))))
                         (fact   (format nil "~a IMPLIES (FORALL (~a: real): NOT (~a = 0 AND ~a > 0))"
                                         cstr xstr pstr qstr)))
                    (psign-branch-strategy "poly-nosign" fact "pnosign_branch" bstr bconds l0 qq k ys
                                           xstr ep eq pstr qstr
                                           (list '(skeep !psf) '(flatten !psf))
                                           (list `(inst !psb ,xstr)))))))
    (if noimp
        (printf "poly-nosign: this theory does not import sgn_prune, the decision poly-nosign uses")
    (if (null setup)
        (printf "poly-nosign: formula ~a is not of the form EXISTS (x: real): P = 0 AND Q > 0 (one real variable, whose name is not already declared here)" fnum)
      (if (null brs)
          (printf "poly-nosign: could not evaluate the decision tree")
        (if (null fbrs)
            (printf "poly-nosign: every branch has a root with a positive value")
          (mapstep #'(lambda (st) st) strats))))))
  "[pvs_cad] For the formula FNUM, EXISTS (x: real): P = 0 AND Q > 0 over
polynomials in x and in the parameters, adds to the sequent one fact per
branch of the verified decision tree on which no such root exists:
<sign conditions on the parameters> IMPLIES FORALL x: NOT (P = 0 AND Q > 0).
The facts are labelled poly-nosign and every one of them is proved."
  "Deciding the absence of a root with a sign condition in ~a")


;;; ------------------------------------------------------------------
;;; qe-exists (Phase 3): quantifier elimination for one real variable.
;;; The formula FNUM is EXISTS (x: real): PHI or FORALL (x: real): PHI, with
;;; PHI a Boolean combination of sign conditions on polynomials in x with
;;; numeric coefficients.  The Boolean structure is put in disjunctive normal
;;; form here, in Lisp, and is not trusted: what the strategy adds to the
;;; sequent is the formula itself, proved from qe_sound of qe_formula, the
;;; ground evaluation of the decision, and the reflection of Phase 1, one
;;; proved equation per polynomial.

;; a literal is (POLYEXPR PRINTED . REL) with REL :eq or :gt, meaning
;; PRINTED = 0 or PRINTED > 0
(defun qe-lit (e p rel) (list e p rel))
(defun qe-lit-e (l) (first l))
(defun qe-lit-p (l) (second l))
(defun qe-lit-rel (l) (third l))

(defun qe-neg-e (e) (format nil "pe_neg(~a)" e))
(defun qe-neg-p (p) (format nil "-(~a)" p))
(defun qe-sub-e (e1 e2) (format nil "pe_sub(~a, ~a)" e1 e2))
(defun qe-sub-p (p1 p2) (format nil "(~a) - (~a)" p1 p2))

;; the cross product of two DNFs (conjunction)
(defun qe-cross (d1 d2)
  (loop for c1 in d1 append (loop for c2 in d2 collect (append c1 c2))))

;; the sign atom of a relational expression, as (POLYEXPR PRINTED . OP)
(defun qe-atom-parts (expr)
  (let ((op (cond ((is-function-expr expr "=") "=")
                  ((is-function-expr expr ">") ">")
                  ((is-function-expr expr "<") "<")
                  ((is-function-expr expr ">=") ">=")
                  ((is-function-expr expr "<=") "<=")
                  ((cad-is expr "/=") "/=")
                  (t nil))))
    (when op
      (let* ((lhs (args1 expr)) (rhs (args2 expr))
             (z (extra-get-number-from-expr rhs t))
             (e (if (and z (zerop z))
                    (mpoly-expr-rec lhs)
                  (qe-sub-e (mpoly-expr-rec lhs) (mpoly-expr-rec rhs))))
             (p (if (and z (zerop z))
                    (expr2str lhs)
                  (qe-sub-p (expr2str lhs) (expr2str rhs)))))
        (list e p op)))))

;; the first subformula qe-dnf could not read (not a sign condition on a
;; polynomial in the variable), or nil
(defparameter *qe-dnf-bad* nil)

;; the DNF of EXPR (or of its negation when NEG): a list of conjuncts, each a
;; list of literals; nil is FALSE and (nil) is TRUE.  A subformula it cannot
;; read is recorded in *qe-dnf-bad* (the caller refuses the formula) rather
;; than read as FALSE
(defun qe-dnf (expr neg)
  (cond
   ((cad-is expr "IFF")
    (let ((pa (qe-dnf (args1 expr) nil)) (na (qe-dnf (args1 expr) t))
          (pb (qe-dnf (args2 expr) nil)) (nb (qe-dnf (args2 expr) t)))
      (if neg (append (qe-cross pa nb) (qe-cross na pb))
        (append (qe-cross pa pb) (qe-cross na nb)))))
   ((cad-is expr "AND")
    (if neg (append (qe-dnf (args1 expr) t) (qe-dnf (args2 expr) t))
      (qe-cross (qe-dnf (args1 expr) nil) (qe-dnf (args2 expr) nil))))
   ((cad-is expr "OR")
    (if neg (qe-cross (qe-dnf (args1 expr) t) (qe-dnf (args2 expr) t))
      (append (qe-dnf (args1 expr) nil) (qe-dnf (args2 expr) nil))))
   ((cad-is expr "IMPLIES")
    (if neg (qe-cross (qe-dnf (args1 expr) nil) (qe-dnf (args2 expr) t))
      (append (qe-dnf (args1 expr) t) (qe-dnf (args2 expr) nil))))
   ((and (unary-application? expr) (cad-is expr "NOT"))
    (qe-dnf (args1 expr) (not neg)))
   ((and (name-expr? expr) (string= (string (id expr)) "TRUE"))
    (if neg nil (list nil)))
   ((and (name-expr? expr) (string= (string (id expr)) "FALSE"))
    (if neg (list nil) nil))
   (t (let ((a (qe-atom-parts expr)))
        (unless a (unless *qe-dnf-bad* (setq *qe-dnf-bad* expr)))
        (when a
          (let* ((e (first a)) (p (second a)) (op (third a))
                 (eq-lit  (qe-lit e p :eq))
                 (gt-lit  (qe-lit e p :gt))
                 (ngt-lit (qe-lit (qe-neg-e e) (qe-neg-p p) :gt)))
            (cond
             ((string= op "=")  (if neg (list (list gt-lit) (list ngt-lit))
                                  (list (list eq-lit))))
             ((string= op "/=") (if neg (list (list eq-lit))
                                  (list (list gt-lit) (list ngt-lit))))
             ((string= op ">")  (if neg (list (list ngt-lit) (list eq-lit))
                                  (list (list gt-lit))))
             ((string= op "<")  (if neg (list (list gt-lit) (list eq-lit))
                                  (list (list ngt-lit))))
             ((string= op ">=") (if neg (list (list ngt-lit))
                                  (list (list gt-lit) (list eq-lit))))
             ((string= op "<=") (if neg (list (list gt-lit))
                                  (list (list ngt-lit) (list eq-lit))))
             (t (unless *qe-dnf-bad* (setq *qe-dnf-bad* expr)) nil))))))))

;; the unfolding rounds the proof of qe-exists needs for DNF: some over the k
;; conjuncts takes k + 1, conjunct j (from 0) its equations j + 1 + |ceqs|
;; and its inequalities j + 2 + |cgts|; two to spare, and never fewer than 8
(defun qe-rounds (dnf)
  (max 8 (+ 2 (max (1+ (length dnf))
                   (loop for c in dnf for j from 0
                         maximize (+ j 2 (max (count :eq c :key #'qe-lit-rel)
                                              (count :gt c :key #'qe-lit-rel))))))))

;; the coefficient list of a literal, evaluated
(defun qe-list-of (lit)
  (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (qe-lit-e lit)) nil nil t)))
    (when v (expr2str v))))

;; a PVS list of strings, printed so that the empty one typechecks
(defun qe-list-str (strs empty)
  (if strs (format nil "(: ~{~a~^, ~} :)" strs) empty))

;; the Conj record of one conjunct, and the lists it mentions
(defun qe-conj-str (lits lists)
  (let ((eqs nil) (gts nil))
    (loop for l in lits for s in lists do
      (if (eq (qe-lit-rel l) :eq) (push s eqs) (push s gts)))
    (format nil "(# ceqs := ~a, cgts := ~a #)"
            (qe-list-str (reverse eqs) "null[list[mpoly]]")
            (qe-list-str (reverse gts) "null[list[mpoly]]"))))

;; the proof of the answer.  When the decision says the existential holds, the
;; witness comes from qe_sound and the formula's own quantifier is instantiated
;; with it; when it says the existential fails, the witness comes from the
;; formula and qe_sound's universal is instantiated with it.
(defun qe-strategy (fact fokstr qestr fstr kstr ysstr xstr mevs truth isall &optional (rounds 8))
  (let* ((unfold `(then ,@(loop repeat rounds append '((expand "feval") (expand "some")
                                                  (expand "ceval") (expand "every")
                                                  (expand "allgt")))))
         ;; the fact (labelled !qef) is the formula G when it holds and NOT G
         ;; when it fails; where the fact is proved, G stands in the consequent
         ;; in the first case and in the antecedent in the second.  qe_sound
         ;; (labelled !qes) gives a witness when TRUTH, and takes one otherwise
         (holds (if isall (not truth) truth))
         (pre (cond ((and holds (not isall)) nil)
                    (holds '((skeep !qef)))
                    (isall '((flatten !qef)))
                    (t `((flatten !qef) (skolem !qef (,xstr))))))
         (usex (if truth
                   `((skolem !qes (,xstr)) (inst !qef ,xstr))
                 `((inst !qes ,xstr))))
         (qecase (if truth qestr (format nil "NOT (~a)" qestr)))
         (core `(then (discriminate (lemma "qe_sound") !qes) (inst !qes ,fstr ,kstr ,ysstr) (assert)
                      ,@usex ,unfold ,@mevs (ground))))
    `(with-fresh-labels ((!qef) (!qes))
       ,(cad-fact-case
         fact '!qef '(label "qe" !qef)
         `(then (hide-all-but !qef) ,@pre
                (spread (case ,fokstr)
                  ((spread (case ,qecase)
                     (,core (then (eval-expr ,qestr) (assert))))
                   (then (eval-expr ,fokstr) (assert)))))))))

;; the reflection equation of one polynomial list, as a case with its proof
(defun qe-mev (l e pstr xstr ysstr rest)
  (let ((mev (format nil "meval(mpol(~a))(cons(~a, ~a)) = ~a" l xstr ysstr pstr))
        (asl (format nil "as_list(pnorm(~a)) = ~a" e l))
        (cns (format nil "cons(~a, ~a)" xstr ysstr)))
    `(with-fresh-labels ((!qmv))
       (branch (discriminate (case ,mev) !qmv)
         ((then (replace !qmv) ,rest)
          ,(cad-mev-proof asl e cns '!qmv))))))

;; the proof of one branch fact of the parametric decision.  The fact is
;; <conditions> IMPLIES <the formula or its negation>; its proof establishes
;; the conditions (grind on the signs), the membership of the branch and the
;; fuel bound (both by evaluation), instantiates qe_branch, and then handles
;; the witness as qe-strategy does, after flattening the conditions in.
(defun qe-param-strategy (fact bstr bconds fstr kstr ysstr xstr mevs truth isall &optional (rounds 8))
  (let* ((unfold `(then ,@(loop repeat rounds append '((expand "feval") (expand "some")
                                                  (expand "ceval") (expand "every")
                                                  (expand "allgt")))))
         ;; after the fact (labelled !qpf) is flattened, its conclusion G or NOT
         ;; G carries the label with the conditions; inst and skolem take the
         ;; one quantified formula among them.  qe_branchc is labelled !qps
         (usex (if truth
                   `((skolem !qps (,xstr)) (inst !qpf ,xstr))
                 `((skeep !qpf) (inst !qps ,xstr))))
         (chstr (format nil "branch_tree[bool].conds_hold(~a, ~a)" bconds ysstr))
         (memb  (format nil "member(~a, branches(qdecidec(~a, ~a)))" bstr kstr fstr))
         (fuel  (format nil "tfuel(~a) <= ~a" fstr kstr))
         (core `(then (discriminate (lemma "qe_branchc") !qps) (inst !qps ,fstr ,bstr ,kstr ,ysstr)
                      (spread (split !qps)
                        ((then (assert) (flatten) ,@usex ,unfold ,@mevs (ground))
                         (ground))))))
    `(with-fresh-labels ((!qpf) (!qps) (!qpc) (!qpm) (!qpu))
       ,(cad-fact-case
         fact '!qpf '(label "qe" !qpf)
         `(then (hide-all-but !qpf)
                (branch (discriminate (case ,chstr) !qpc)
                  ((branch (discriminate (case ,memb) !qpm)
                     ((branch (discriminate (case ,fuel) !qpu)
                        (,core (then (hide-all-but !qpu) (eval-formula !qpu))))
                      (then (hide-all-but !qpm) (eval-formula !qpm))
                      (grind)))
                   (then (flatten) (expand "conds_hold") (expand "every") (expand "cond_holds")
                         (expand "msign") (grind))
                   (grind))))))))

(defstep qe-exists (&optional (fnum 1))
  (let ((noimp  (not (cad-imports? "qe_formula")))
        (fexpr  (unless noimp (extra-get-formula fnum)))
        (isex   (and fexpr (exists-expr? fexpr)))
        (isall  (and fexpr (forall-expr? fexpr)))
        (bs     (when (or isex isall) (bindings fexpr)))
        (ok1    (and bs (= (length bs) 1) (tc-eq (type (car bs)) *real*)))
        (xstr   (when ok1 (string (id (car bs)))))
        ;; the proof makes the bound variable a skolem constant of that name
        (clash  (and xstr (not (is-freevar xstr *real*))))
        (body   (when (and ok1 (not clash)) (expression fexpr)))
        (dummy  (setq *mpoly-atoms* (when xstr (list xstr)) *qe-dnf-bad* nil))
        (dnf    (when body (qe-dnf body (and isall t))))
        (unread *qe-dnf-bad*)
        (params (cdr *mpoly-atoms*))
        ;; the parametric decision (qdecidec, tfuel) is in qe_ctx
        (noctx  (and params (not (cad-imports? "qe_ctx"))))
        (lists  (when (and dnf (not unread))
                  (loop for c in dnf collect (loop for l in c collect (qe-list-of l)))))
        (bad    (or (null xstr) clash unread noctx (null dnf)
                    (some #'(lambda (c) (some #'null c)) lists)))
        (fstr   (unless bad
                  (qe-list-str (loop for c in dnf for ls in lists collect (qe-conj-str c ls))
                               "null[Conj]")))
        (ysstr  (if params (format nil "(: ~{~a~^, ~} :)" params) "null[real]"))
        (kv     (unless bad
                  (evalexpr (format nil (if params "tfuel(~a)" "qe_fuel(~a)") fstr) nil nil t)))
        (kstr   (when kv (expr2str kv)))
        (fokstr (when (and kstr (null params)) (format nil "fok(~a, ~a, ~a)" kstr fstr ysstr)))
        (qestr  (when (and kstr (null params)) (format nil "qe_exists(~a, ~a, ~a)" kstr fstr ysstr)))
        (qev    (when qestr (evalexpr qestr nil nil t)))
        (truth  (and qev (string= (expr2str qev) "TRUE")))
        (brv    (when (and kstr params)
                  (evalexpr (format nil "branches(qdecidec(~a, ~a))" kstr fstr) nil nil t)))
        (brs    (when brv (mpoly-list-elems brv)))
        (gstr   (when fexpr (expr2str fexpr)))
        (holds  (if isall (not truth) truth))
        (fact   (when (and gstr kstr (null params))
                  (if holds gstr (format nil "NOT (~a)" gstr))))
        (pairs  (unless bad
                  (remove-duplicates
                   (loop for c in dnf for ls in lists append
                     (loop for l in c for s in ls collect (list s (qe-lit-e l) (qe-lit-p l))))
                   :key #'car :test #'string=)))
        (mevs   (unless bad
                  (list (reduce #'(lambda (rest pr)
                                    (qe-mev (first pr) (second pr) (third pr) xstr ysstr rest))
                                (reverse pairs) :initial-value '(skip)))))
        (rounds (unless bad (qe-rounds dnf)))
        (strat  (when (and (not bad) kstr (null params))
                  (qe-strategy fact fokstr qestr fstr kstr ysstr xstr mevs truth (and isall t) rounds)))
        (pstrats (when (and (not bad) kstr params brs)
                   (loop for b in brs collect
                     (let* ((bres  (string= (expr2str (ppos-field b "bres")) "TRUE"))
                            (bstr  (psign-brec-str b))
                            (bconds (psign-conds-str b))
                            (cstr  (ppos-conds-str (mpoly-list-elems (ppos-field b "bconds"))))
                            (bholds (if isall (not bres) bres))
                            (bfact (format nil "~a IMPLIES ~a" cstr
                                           (if bholds (format nil "(~a)" gstr)
                                             (format nil "NOT (~a)" gstr)))))
                       (qe-param-strategy bfact bstr bconds fstr kstr ysstr xstr mevs bres (and isall t) rounds))))))
    (if noimp
        (printf "qe-exists: this theory does not import qe_formula, the decision qe-exists uses (IMPORTING pvs_cad brings it)")
    (if (null xstr)
        (printf "qe-exists: formula ~a is not a quantified formula in one real variable" fnum)
     (if clash
        (printf "qe-exists: formula ~a binds ~a, a name already declared here; rename the bound variable" fnum xstr)
      (if unread
        (printf "qe-exists: ~a in formula ~a is not a sign condition on a polynomial in ~a" unread fnum xstr)
      (if noctx
        (printf "qe-exists: formula ~a has parameters (~{~a~^, ~}); deciding it for every value of them needs qe_ctx (IMPORTING pvs_cad brings it)" fnum params)
      (if (null kstr)
          (printf "qe-exists: could not evaluate the decision")
        (if params
            (if (null brs)
                (printf "qe-exists: could not evaluate the decision tree")
              (mapstep #'(lambda (st) st) pstrats))
          strat))))))))
  "[pvs_cad] Decides the formula FNUM, EXISTS (x: real): PHI or
FORALL (x: real): PHI with PHI a Boolean combination of sign conditions on
polynomials in x, and adds the answer to the sequent, labelled qe.  With
numeric coefficients the answer is the formula or its negation, proved from
qe_sound; with parameters it is one fact per branch of the pruned decision
tree qdecidec of qe_ctx (built with the conditions of the path, so a sign
the path decides is not branched on), <sign conditions on the parameters>
IMPLIES <the formula or its negation>, proved from qe_branchc.  Both use the ground evaluation of the
decision and the reflection of Phase 1; the disjunctive normal form is
computed here but is not trusted."
  "Deciding ~a by quantifier elimination")

;;; ---------------------------------------------------------------------------
;;; Phase 5: cad, the cylindrical decision procedure for a closed prenex
;;; formula with any quantifier prefix (cad-direct; (cad) adds the witness
;;; search below).  The prefix and the Boolean matrix are read here, in Lisp,
;;; and are not trusted: the fact added to the sequent is proved from the
;;; correctness theorem of the decision (decide8_correct, decide5_correct or
;;; decide7_correct; decide_correct_os of cad_decide for the complete
;;; fallback), the ground evaluation of the decision, and the reflection of
;;; Phase 1, one proved equation per polynomial; the quantifiers are walked
;;; one by one, skolemizing one side and instantiating the other with the same
;;; name (a name already declared goes to the general route instead).
;;; ---------------------------------------------------------------------------

;; whether the current theory imports the theory NAME (directly or not)
(defun cad-imports? (name)
  (and *current-context*
       (let ((found nil))
         (map-lhash #'(lambda (th insts)
                        (declare (ignore insts))
                        (when (and (not found) (string-equal (string (id th)) name))
                          (setq found t)))
                    (current-using-hash))
         found)))

;; the decision (cad) uses: decide8, the Collins run (cad_decide8_def,
;; COLLINS_PLAN.md M-I), in a theory that imports cad_decide8; otherwise
;; decide5, the read-closure run (cad_decide5_def)
(defun cad-dec () (if (cad-imports? "cad_decide8") "decide8" "decide5"))

;; the elimination (cad-qe) uses: qe8, the Collins run (qe8_def), in a
;; theory that imports qe8; otherwise qe (qe_all_def, the read-closure run)
(defun cad-qe-fn () (if (cad-imports? "qe8") "qe8" "qe"))

;; the quantifier prefix of EXPR, outermost first, as (NAME . ISALL), and the
;; matrix; nil when a quantifier binds several variables
(defun cad-prefix (expr)
  (let ((pre nil) (e expr) (bad nil))
    (loop while (and (not bad) (or (forall-expr? e) (exists-expr? e))) do
      (let ((bs (bindings e)))
        (if (and (= (length bs) 1) (tc-eq (type (car bs)) *real*))
            (progn (push (cons (string (id (car bs))) (and (forall-expr? e) t)) pre)
                   (setq e (expression e)))
          (setq bad t))))
    (unless bad (list (reverse pre) e))))

;; the polynomials of the matrix, in index order, as (POLYEXPR . PRINTED)
(defvar *cad-polys* nil)

(defun cad-poly-index (e p)
  (let ((pos (position e *cad-polys* :key #'car :test #'string=)))
    (if pos pos
      (progn (setq *cad-polys* (append *cad-polys* (list (cons e p))))
             (1- (length *cad-polys*))))))

;; the matrix as a BF term of bform; nil when some atom is not a sign condition
(defun cad-bf (expr)
  (cond
   ((cad-is expr "AND")
    (let ((a (cad-bf (args1 expr))) (b (cad-bf (args2 expr))))
      (when (and a b) (format nil "band(~a, ~a)" a b))))
   ((cad-is expr "OR")
    (let ((a (cad-bf (args1 expr))) (b (cad-bf (args2 expr))))
      (when (and a b) (format nil "bor(~a, ~a)" a b))))
   ((cad-is expr "IMPLIES")
    (let ((a (cad-bf (args1 expr))) (b (cad-bf (args2 expr))))
      (when (and a b) (format nil "bor(bnot(~a), ~a)" a b))))
   ((cad-is expr "IFF")
    (let ((a (cad-bf (args1 expr))) (b (cad-bf (args2 expr))))
      (when (and a b) (format nil "band(bor(bnot(~a), ~a), bor(bnot(~a), ~a))" a b b a))))
   ((and (unary-application? expr) (cad-is expr "NOT"))
    (let ((a (cad-bf (args1 expr)))) (when a (format nil "bnot(~a)" a))))
   ((and (name-expr? expr) (string= (string (id expr)) "TRUE"))
    "bnot(band(batom(0, 0), bnot(batom(0, 0))))")
   ((and (name-expr? expr) (string= (string (id expr)) "FALSE"))
    "band(batom(0, 0), bnot(batom(0, 0)))")
   (t (let ((a (qe-atom-parts expr)))
        (when a
          (let* ((i (cad-poly-index (first a) (second a))) (op (third a)))
            (cond
             ((string= op "=")  (format nil "batom(~a, 0)" i))
             ((string= op ">")  (format nil "batom(~a, 1)" i))
             ((string= op "<")  (format nil "batom(~a, -1)" i))
             ((string= op ">=") (format nil "bor(batom(~a, 1), batom(~a, 0))" i i))
             ((string= op "<=") (format nil "bor(batom(~a, -1), batom(~a, 0))" i i))
             ((string= op "/=") (format nil "bnot(batom(~a, 0))" i))
             (t nil))))))))

;; the unfoldings of bfeval that cad-bf's encoding of EXPR needs, one to
;; spare: each bfeval expansion opens one level of the BF term; an atom is
;; one level (= < >) or two (>= <= /=), TRUE four, FALSE three, NOT one more
;; than its argument, AND / OR one more than the deeper side, IMPLIES
;; (bor(bnot(a), b)) the larger of 2 + a and 1 + b, IFF three more than the
;; deeper side
(defun cad-depth (expr) (1+ (cad-depth1 expr)))
(defun cad-depth1 (expr)
  (cond
   ((or (cad-is expr "AND") (cad-is expr "OR"))
    (1+ (max (cad-depth1 (args1 expr)) (cad-depth1 (args2 expr)))))
   ((cad-is expr "IMPLIES")
    (max (+ 2 (cad-depth1 (args1 expr))) (1+ (cad-depth1 (args2 expr)))))
   ((cad-is expr "IFF")
    (+ 3 (max (cad-depth1 (args1 expr)) (cad-depth1 (args2 expr)))))
   ((and (unary-application? expr) (cad-is expr "NOT"))
    (1+ (cad-depth1 (args1 expr))))
   ((and (name-expr? expr) (string= (string (id expr)) "TRUE")) 4)
   ((and (name-expr? expr) (string= (string (id expr)) "FALSE")) 3)
   (t 2)))

;; one reflection equation, as a case with its proof.  The formulas are
;; named by fresh labels, never by position (2026-09-27).
(defun cad-mev (l e pstr vstr rest)
  (let ((mev (format nil "meval(mpol(~a))(~a) = ~a" l vstr pstr))
        (asl (format nil "as_list(pnorm(~a)) = ~a" e l)))
    `(with-fresh-labels ((!cmv))
       (branch (discriminate (case ,mev) !cmv)
         ((then (replace !cmv) ,rest)
          ,(cad-mev-proof asl e vstr '!cmv))))))

;; the atoms of the matrix EXPR as pairs (ATOM . LEAVES): LEAVES is the atom
;; as the sign condition(s) cad-bf gave it, over the printed polynomial that
;; the reflection equations put in place of meval (ENDGAME_PLAN.md).  CANON
;; lists that polynomial per index: two members with the same coefficient
;; list (0 - x ^ 2 and 1 - (x ^ 2 + 1)) are both replaced by the text of the
;; first, whose equation comes first.  Call after cad-bf, which fills
;; *cad-polys*; one pair per distinct atom.
(defun cad-atom-eqs (expr canon)
  (cond
   ((or (cad-is expr "AND") (cad-is expr "OR")
        (cad-is expr "IMPLIES") (cad-is expr "IFF"))
    (let ((a (cad-atom-eqs (args1 expr) canon)))
      (append a (remove-if #'(lambda (e) (member e a :test #'equal))
                           (cad-atom-eqs (args2 expr) canon)))))
   ((and (unary-application? expr) (cad-is expr "NOT"))
    (cad-atom-eqs (args1 expr) canon))
   ((and (name-expr? expr) (member (string (id expr)) '("TRUE" "FALSE") :test #'string=))
    nil)
   (t (let* ((a  (qe-atom-parts expr))
             (i  (when a (position (first a) *cad-polys* :key #'car :test #'string=)))
             (s  (when (and i (nth i canon)) (format nil "sign3(~a)" (nth i canon))))
             (op (when s (third a))))
        (when s
          (list (cons (expr2str expr)
                      (cond ((string= op "=")  (format nil "~a = 0" s))
                            ((string= op ">")  (format nil "~a = 1" s))
                            ((string= op "<")  (format nil "~a = -1" s))
                            ((string= op ">=") (format nil "(~a = 1 OR ~a = 0)" s s))
                            ((string= op "<=") (format nil "(~a = -1 OR ~a = 0)" s s))
                            (t                 (format nil "NOT (~a = 0)" s))))))))))

;; the new endgame for the sentence labelled GOAL: one case per atom equation
;; of AEQS, replaced in GOAL only and proved by the cad_endgame rewrites and
;; ground; last, bddsimp on GOAL and !cfs (bound by cad-strategy).
(defun cad-endgame-leaves (goal aeqs)
  (reduce #'(lambda (ae rest)
              `(with-fresh-labels ((!cae))
                 (branch (discriminate (case ,(format nil "(~a) = (~a)" (car ae) (cdr ae))) !cae)
                   ((then (replace !cae ,goal) ,rest)
                    (then (hide-all-but !cae)
                          (rewrite "cadz_s3_pos" !cae) (rewrite "cadz_s3_zero" !cae)
                          (rewrite "cadz_s3_neg" !cae) (iff !cae) (ground))))))
          aeqs :from-end t :initial-value `(bddsimp (,goal !cfs))))

;; the proof of the fact.  GL labels the sentence and EV the decision record;
;; every other formula is named by a fresh label.  A universal is skolemized in
;; the consequent and instantiated in the antecedent, an existential the other
;; way round.  AEQS are the atom equations of cad-atom-eqs.
(defun cad-strategy (gl ev osstr fstr phistr okstr decstr pre depth m mevs truth ante aeqs
                     &optional (lem "decide5_correct"))
  (let* ((deccase (if truth decstr (format nil "NOT (~a)" decstr))))
    (flet ((core (goal)
             ;; the asserts of the unfolding name the formula from the lemma
             ;; and the two case facts (the rest of the sequent is GOAL), so
             ;; GOAL reaches the endgame as written and the atom equations
             ;; match it: a whole-sequent assert reorders its sums
             ;; (x ^ 2 + 1 becomes 1 + x ^ 2) and moves its disequalities
             (let* ((con (if truth goal '!cfs)) (ant (if truth '!cfs goal))
                    (asr `(assert ,(if okstr '(!cfs !cok !cvl) '(!cfs !cvl))))
                    (unfold-fsem (loop repeat (1+ (length pre)) append `((expand "fsem" !cfs) ,asr)))
                    (unfold-bf (append (loop repeat depth append '((expand "bfeval" !cfs)))
                                       (loop repeat (1+ m) append
                                         `((expand "nth" !cfs) (expand "length" !cfs) ,asr)))))
               ;; The endgame (ENDGAME_PLAN.md).  The unfolded formula !cfs is a
               ;; Boolean combination of leaves sign3(P) = s.  Each atom of the
               ;; goal is restated as the leaves cad-bf gave it (one small
               ;; equation per distinct atom, proved by the cad_endgame rewrites
               ;; and arithmetic) and replaced in the goal; then both formulas
               ;; are combinations of the same leaves and bddsimp closes the
               ;; goal with no case split on the signs.  Inside finalize: it
               ;; closes the goal or changes nothing, and then the case-split
               ;; endgame below runs as before, after the whole-sequent assert
               ;; that the unfolding no longer applies to the goal.
               ;;
               ;; The case-split endgame needs unrestricted lift-if rounds after the ground.
               ;; lift-if is blind past the first disjunct: collect-conds recurses
               ;; into args1 only for AND/OR/IMPLIES (proofrules.lisp:724-731), so a
               ;; compound matrix (bor/band/bnot) keeps its later atoms as TERM-level
               ;; conditionals, which ground's split cannot reach. Two bounded rounds,
               ;; deliberately not repeat*, which would multiply branches.  Its
               ;; lift-if builds a term exponential in the number of atoms.
               `(then ,asr ,@unfold-fsem
                      ,@(loop for q in pre append
                          (if (cdr q)
                              `((skolem ,con (,(car q))) (inst ,ant ,(car q)))
                            `((skolem ,ant (,(car q))) (inst ,con ,(car q)))))
                      ,@unfold-bf ,@mevs
                      (else (finalize__$ ,(cad-endgame-leaves goal aeqs))
                            (then (printf "cad: case-split endgame")
                                  (assert) (expand "sign3" !cfs) (repeat (lift-if !cfs)) (ground)
                                  (then (lift-if) (ground)) (then (lift-if) (ground))))))))
      ;; the decision record is evaluated once (EV); the completion flag and the
      ;; value are then read off it by assert.  LEM is decide5_correct, or
      ;; decide_correct_os (no flag, OKSTR nil) for the complete fallback
      (flet ((tail (goal)
               `((discriminate (lemma ,lem) !cfs) (inst !cfs ,fstr ,osstr ,phistr)
                 ,(if okstr
                      `(spread (discriminate (case ,okstr) !cok)
                         ((spread (discriminate (case ,deccase) !cvl)
                            ((then (hide ,ev) ,(core goal)) (assert)))
                          (assert)))
                    `(spread (discriminate (case ,deccase) !cvl)
                       ((then (hide ,ev) ,(core goal)) (assert)))))))
        ;; The sentence is proved where it stands when it is TRUE in the
        ;; consequent, and refuted where it stands when it is FALSE in the
        ;; antecedent, which closes the goal.  Otherwise it is already its own
        ;; answer: a TRUE hypothesis, or a FALSE sentence in the consequent,
        ;; which PVS's sequent reads as the hypothesis NOT A (a case on NOT A
        ;; would only repeat A in the consequent).  It is labelled cad, the
        ;; record is deleted, and a message says which it is.
        `(with-fresh-labels ((!cfs) (!cok) (!cvl))
           ,(if (eq (and ante t) (not truth))
                `(then (hide-all-but (,gl ,ev)) ,@(tail gl))
              `(then (printf "cad: the sentence is ~a; it stays as it is, labelled cad"
                             ,(if truth "TRUE" "FALSE"))
                     (delete ,ev) (label "cad" ,gl :push? t))))))))

(defhelper cad-finish__ (gl ev ante &optional complete? decide? (dec "decide5"))
  (let ((fexpr  (extra-get-formula gl))
         (pp     (when fexpr (cad-prefix fexpr)))
         (pre    (when pp (first pp)))
         (body   (when pp (second pp)))
         (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
         (dummy2 (setq *cad-polys* nil))
         (phistr (when (and pre body) (cad-bf body)))
         (lists  (when phistr (loop for pr in *cad-polys* collect
                               (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                 (when v (expr2str v))))))
         (fstr   (qe-list-str lists "null[list[mpoly]]"))
         (osstr  (format nil "(: ~{~a~^, ~} :)"
                         (loop for q in pre collect (if (cdr q) "TRUE" "FALSE"))))
         (okstr  (unless decide? (format nil "~a(reverse(~a), ~a, ~a)`ok" dec osstr fstr phistr)))
         (dstr   (format nil "decide(reverse(~a), ~a, ~a)" osstr fstr phistr))
         (decstr (if decide? dstr (format nil "~a(reverse(~a), ~a, ~a)`val" dec osstr fstr phistr)))
         ;; the decision record is ALREADY in the sequent, labelled EV by
         ;; cad-direct; read the flags off it instead of evaluating again
         (evf    (extra-get-formula ev))
         (evs    (when evf (expr2str evf)))
         ;; decide5's record carries ok and val; decide's is a Boolean
         (okay   (or decide? (and evs (search "ok := TRUE" evs) t)))
         (truth  (and evs okay
                      (if decide?
                          (and (is-function-expr evf "=") (string= (expr2str (args2 evf)) "TRUE"))
                        (search "val := TRUE" evs))
                      t))
         (vstr   (mpoly-valuation))
         (mevs   (list (reduce #'(lambda (rest pr)
                                   (cad-mev (first pr) (second pr) (third pr) vstr rest))
                               (reverse (loop for pr in *cad-polys* for l in lists
                                              collect (list l (car pr) (cdr pr))))
                               :initial-value '(skip))))
         (strat  (cad-strategy gl ev osstr fstr phistr okstr decstr pre (cad-depth body)
                               (length lists) mevs truth ante
                               (cad-atom-eqs body (loop for l in lists collect
                                                    (cdr (nth (position l lists :test #'equal) *cad-polys*))))
                               (if decide? "decide_correct_os" (format nil "~a_correct" dec)))))
    (if (null evs)
        (printf "cad: could not read the decision record")
      (if okay
          strat
        (if complete?
            (with-fresh-labels ((!cdf))
              (then (printf "cad: the certificate did not pass; deciding by the complete decision of cad_decide (exponential)")
                    (delete ev)
                    (discriminate (eval-expr dstr) !cdf)
                    (cad-finish__$ gl !cdf ante nil t)))
          (then (delete ev)
                (printf "cad: the certificate of the decision did not pass (~a`ok is FALSE), so there is no proof; the formula is unchanged.  (cad-direct FNUM t \"decide4\") style calls with COMPLETE? fall back to the complete but exponential decision" dec))))))
  "[pvs_cad] Internal: finishes (cad) for the sentence labelled GL from the decision record labelled EV (of decide5, or of decide when DECIDE?)." "")

(defstep cad-direct (&optional (fnum 1) complete? dec)
  (let ((fnum   (cad-default-fnum fnum))
        (dec    (or dec (cad-dec)))
        (grouped (let ((f (extra-get-formula fnum))) (and f (cadg-grouped-prenex? f))))
        (fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (closed (= (length *mpoly-atoms*) (length pre)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (bad    (or (null phistr) (not closed) (some #'null lists)))
        (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
        (osstr  (unless bad (format nil "(: ~{~a~^, ~} :)"
                                    (loop for q in pre collect (if (cdr q) "TRUE" "FALSE")))))
        (recstr (unless bad (format nil "~a(reverse(~a), ~a, ~a)" dec osstr fstr phistr)))
        ;; the side of the sentence decides the shape of the proof; after this
        ;; every formula is named by a fresh label, never by its position
        (fn     (extra-get-fnum fnum))
        (ante   (and (integerp fn) (< fn 0)))
        ;; the proof makes each bound variable a skolem constant of its own
        ;; name: a name already declared here (lnexp's e, a skolem constant)
        ;; or bound twice is refused by skolem; the general route uses fresh
        ;; names
        (names  (mapcar #'car pre))
        (clash  (when names
                  (or (remove-if #'(lambda (nm) (is-freevar nm *real*)) names)
                      (when (/= (length names) (length (remove-duplicates names :test #'string=)))
                        (list (find-if #'(lambda (nm) (> (count nm names :test #'string=) 1)) names))))))
        ;; why the prenex route does not apply, said when the general route
        ;; is not available (no gform_ok)
        (gbad   (and fexpr (eq (ignore-errors (cadg-tree fexpr nil)) :bad)))
        (why    (cond ((null fexpr) (format nil "cad: there is no formula ~a" fnum))
                      ;; the decision must be visible: (cad) in a theory that
                      ;; imports only qe_all, say, would hit a resolution error
                      ((not (cad-imports? (format nil "cad_~a" dec)))
                       (format nil "cad: this theory does not import cad_~a, the decision (cad) uses here; IMPORTING pvs_cad makes (cad) and (cad-qe) available" dec))
                      (clash
                       (format nil "cad: formula ~a binds ~{~a~^, ~}, ~:[a name~;names~] already declared here or bound twice; rename the bound variable~:*~:[~;s~], or IMPORTING pvs_cad, whose general route uses fresh names" fnum clash (cdr clash)))
                      ;; refused by the general route too: say what it takes
                      ((and gbad (or (null pp) (null pre) (cadg-has-quant? body)))
                       (format nil "cad: formula ~a is not a first-order formula over the reals whose atoms compare polynomials (binders over real, posreal, nnreal, negreal, npreal or nzreal; other real terms must not contain a bound variable)" fnum))
                      ((null pp)
                       (format nil "cad: formula ~a is not prenex with one real variable per quantifier (it binds a variable of another type, or several at once); formulas of any shape need IMPORTING pvs_cad (or gform_ok)" fnum))
                      ((cadg-has-quant? body)
                       (format nil "cad: formula ~a has quantifiers inside its connectives; formulas of any shape need IMPORTING pvs_cad (or gform_ok)" fnum))
                      ((null pre)
                       (format nil "cad: formula ~a has no quantifier; quantifier-free formulas need IMPORTING pvs_cad (or gform_ok)" fnum))
                      ((or (null phistr) gbad)
                       (format nil "cad: the matrix of formula ~a is not a Boolean combination of polynomial sign conditions in its quantified variables" fnum))
                      ((not closed)
                       (format nil "cad: formula ~a has real terms other than its quantified variables; they are generalized as unknowns only in a theory that imports pvs_cad (or gform_ok)" fnum))
                      (t (format nil "cad: the polynomials of formula ~a could not be normalized" fnum)))))
    (if (and fexpr (not (cad-imports? (format nil "cad_~a" dec))))
        ;; the decision is not visible here: say so before any route
        (printf "~a" why)
    (if grouped
        ;; grouped binders in a prenex formula: through its nested form
        (cad-nest__$ fnum "direct" 10 complete? nil dec)
     (if (or (null pre) (null body) bad clash)
        ;; not a closed prenex formula with one real per quantifier and a
        ;; polynomial matrix, or its names clash: the general route
        ;; (FORMS_PLAN.md), which needs gform_ok (IMPORTING pvs_cad)
        (if (and fexpr (cad-imports? "gform_ok"))
            (cadg__$ fnum)
          (printf "~a" why))
        (with-fresh-labels ((!cdg fnum) (!cde))
          (then (discriminate (eval-expr recstr) !cde)
                (cad-finish__$ !cdg !cde ante complete? nil dec)))))))
  "[pvs_cad] Decides the formula FNUM without the witness search (by default
1, or -1 when the sequent has no consequent).  A formula of any other shape
(quantifiers inside NOT / AND / OR / IMPLIES / IFF, binders over posreal,
nnreal, negreal, npreal or nzreal, no quantifier at all) and a formula with
other real terms (unknowns, generalized) are taken as (cad) takes them, by
decide_g, in a theory that imports pvs_cad (or gform_ok) (FORMS_PLAN.md);
grouped binders FORALL (x, y: real) go through the nested form and need no
more.  The prenex case is Q1 x1: ... Qn xn: PHI
with each Qi FORALL or EXISTS over one real variable and PHI a Boolean
combination of sign conditions on polynomials in the xi, by decide8 of
cad_decide8_def in a theory that imports cad_decide8 (for two or more
quantifiers decb_u: the walk over the tower of Collins projections of the
checked basis of the input (PROJ_PLAN.md P3), the line cut by the smaller bottom-step
projection, decc_o when its check fails; decide2 for one), otherwise by
decide5 of cad_decide5_def (the n-level cylindrical decision decn_u for three
or more quantifiers; decw, then decn_u, for two; decide2 for one); DEC names
another.  A bound variable whose name is already declared (lnexp's e) goes to
the general route, which uses fresh names.  A TRUE formula in the
consequent is proved and a FALSE one in the antecedent refuted, which closes the
goal; otherwise the formula is already the answer and stays, labelled cad, with a
message saying whether it is TRUE or FALSE.  The proof instantiates
decide8_correct or decide5_correct, evaluates the completion flag and the decision on the ground,
walks the quantifiers, and closes the matrix with the reflection of Phase 1.
With COMPLETE? a certificate that does not pass is followed by the complete
decision decide of cad_decide (decide_correct_os: no flag), which always
answers but can take hours; decide5, decide7 and decide8 always pass their
certificate (decide5_complete, decq7_complete, decq8_complete), so COMPLETE?
matters only for another DEC.  The theory must import cad_decide5 (or
cad_decide8) and mpoly_embed.  (cad) is this, after a witness search when one
can settle the goal."
  "Deciding ~a by cylindrical decision")

;;; ------------------------------------------------------------------
;;; (cad) with a witness first (2026-09-27).  The TARGET is the sentence at
;;; FNUM when it is in the consequent, and its negation when it is in the
;;; antecedent (cad -1).  (cad) tries, in order:
;;;   1. a MODEL SEARCH when the target is existential throughout (proving an
;;;      existential sentence, refuting a universal one): points (the
;;;      candidate constants and the rational roots of the atoms in one
;;;      variable, then pseudo-random ones) are checked exactly in Lisp, and
;;;      the proof instantiates the one found and evaluates the ground formula
;;;      (eval-formula);
;;;   2. with two or more quantifiers, a constant at an existential position
;;;      that folds the matrix to TRUE (cadw-trivial): the proof instantiates
;;;      it and closes the goal by ground;
;;;   3. the full decision (cad-direct): at once with two quantifiers or
;;;      fewer, and with three or more when the ground evaluator answers
;;;      within BUDGET seconds;
;;;   4. a ONE-VARIABLE REDUCTION: an existential position of the target fixed
;;;      to a small constant c, the smaller sentence decided within BUDGET
;;;      seconds; when it holds the proof splits on it (case), proves it by
;;;      (cad-direct), and closes the goal by instantiation -- a witness that
;;;      does not depend on the variables outside it is a witness;
;;;   5. the full decision without a budget.
;;; A plan of steps 1, 2 or 4 closes the goal or changes nothing
;;; (cad-main__), and the decision then runs as in 5.
;;; Nothing new is trusted: the searches only choose, the proof instantiates
;;; quantifiers and calls the same decision.
;;; ------------------------------------------------------------------

(defparameter *cadw-consts* '(0 1 -1 2 -2 1/2 -1/2 3 -3))

;; the matrix, compiled to closures over a vector of rationals; nil when a
;; construct is not arithmetic in the prefix variables
(defun cadw-cnum (e names)
  (let ((i (and (name-expr? e) (position (string (id e)) names :test #'string=))))
    (cond (i #'(lambda (v) (svref v i)))
          ((rational-expr? e) (let ((c (number e))) #'(lambda (v) (declare (ignore v)) c)))
          ((decimal? e) (let ((c (/ (number (args1 e)) (number (args2 e)))))
                          #'(lambda (v) (declare (ignore v)) c)))
          ((and (unary-application? e) (is-function-expr e "-"))
           (let ((a (cadw-cnum (args1 e) names))) (and a #'(lambda (v) (- (funcall a v))))))
          ((is-function-expr e "+") (cadw-cbin #'+ e names))
          ((is-function-expr e "-") (cadw-cbin #'- e names))
          ((is-function-expr e "*") (cadw-cbin #'* e names))
          ((is-function-expr e "/")
           (let ((a (cadw-cnum (args1 e) names)) (b (cadw-cnum (args2 e) names)))
             (and a b #'(lambda (v) (let ((d (funcall b v)))
                                      (if (zerop d) (throw 'cadw-undef nil) (/ (funcall a v) d)))))))
          ((is-function-expr e "^")
           (let ((a (cadw-cnum (args1 e) names))
                 (k (extra-get-number-from-expr (args2 e) t)))
             (and a (integerp k) (>= k 0) #'(lambda (v) (expt (funcall a v) k)))))
          (t nil))))
(defun cadw-cbin (f e names)
  (let ((a (cadw-cnum (args1 e) names)) (b (cadw-cnum (args2 e) names)))
    (and a b #'(lambda (v) (funcall f (funcall a v) (funcall b v))))))
(defun cadw-cbool (e names)
  (flet ((b2 (f) (let ((a (cadw-cbool (args1 e) names)) (b (cadw-cbool (args2 e) names)))
                   (and a b #'(lambda (v) (funcall f (funcall a v) (funcall b v))))))
         (rel (f) (let ((a (cadw-cnum (args1 e) names)) (b (cadw-cnum (args2 e) names)))
                    (and a b #'(lambda (v) (and (funcall f (funcall a v) (funcall b v)) t))))))
    (cond ((cad-is e "AND") (b2 #'(lambda (a b) (and a b))))
          ((cad-is e "OR") (b2 #'(lambda (a b) (or a b))))
          ((cad-is e "IMPLIES") (b2 #'(lambda (a b) (or (not a) b))))
          ((cad-is e "IFF") (b2 #'(lambda (a b) (eq (not a) (not b)))))
          ((and (unary-application? e) (cad-is e "NOT"))
           (let ((a (cadw-cbool (args1 e) names))) (and a #'(lambda (v) (not (funcall a v))))))
          ((and (name-expr? e) (string= (string (id e)) "TRUE")) #'(lambda (v) (declare (ignore v)) t))
          ((and (name-expr? e) (string= (string (id e)) "FALSE")) #'(lambda (v) (declare (ignore v)) nil))
          ((is-function-expr e "=") (rel #'=))
          ((cad-is e "/=") (rel #'/=))
          ((is-function-expr e "<") (rel #'<))
          ((is-function-expr e "<=") (rel #'<=))
          ((is-function-expr e ">") (rel #'>))
          ((is-function-expr e ">=") (rel #'>=))
          (t nil))))

;; a point (rationals in prefix order) at which the matrix BODY is WANT, or nil:
;; the grid of each variable's candidate constants (cadw-cands; up to four
;; variables), then pseudo-random
;; rationals in boxes of radius 1, 10 and 100 with denominators 1, 2, 10, 100
(defun cadw-search (names body want &optional (tries 60000))
  (let ((f (cadw-cbool body names)) (n (length names)) (found nil))
    (when f
      (let ((st #+sbcl (sb-ext:seed-random-state 20260927) #-sbcl (make-random-state t))
            (cands (loop for i below n collect (cadw-cands names body i))))
        (flet ((try (vals)
                 (let ((r (catch 'cadw-undef (list (funcall f (coerce vals 'simple-vector))))))
                   (when (and r (eq (and (car r) t) want)) (setq found vals)))))
          (when (<= n 4)
            (labels ((grid (k acc)
                       (unless found
                         (if (= k n) (try (reverse acc))
                           (dolist (c (nth k cands)) (unless found (grid (1+ k) (cons c acc))))))))
              (grid 0 nil)))
          (loop for i below tries until found
                do (let ((lim (nth (mod i 3) '(1 10 100)))
                         (den (nth (mod (floor i 3) 4) '(1 2 10 100))))
                     (try (loop repeat n collect
                            (/ (- (random (1+ (* 2 lim den)) st) (* lim den)) den))))))))
    found))

;; the ground evaluator's value of the matrix at the point agrees with WANT
(defun cadw-confirm (names pt body want)
  (let* ((txt (format nil "LET ~{~a~^, ~} IN (~a)"
                      (loop for nm in names for c in pt collect (format nil "~a: real = ~a" nm c))
                      body))
         (v (ignore-errors (evalexpr txt nil nil t)))
         (s (and v (expr2str v))))
    (and s (string= s (if want "TRUE" "FALSE")))))

;; the record of (cad)'s decision (cad-dec) for a closed prenex formula EXPR, as a string, or nil
(defun cadw-recstr (expr)
  (let* ((pp (cad-prefix expr)) (pre (first pp)) (body (second pp)))
    (when (and pre body)
      (setq *mpoly-atoms* (reverse (mapcar #'car pre)))
      (setq *cad-polys* nil)
      (let* ((phistr (cad-bf body))
             (closed (= (length *mpoly-atoms*) (length pre)))
             (lists (when phistr (loop for pr in *cad-polys* collect
                                   (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                     (when v (expr2str v)))))))
        (when (and phistr closed (notany #'null lists))
          (format nil "~a(reverse(~a), ~a, ~a)" (cad-dec)
                  (format nil "(: ~{~a~^, ~} :)" (loop for q in pre collect (if (cdr q) "TRUE" "FALSE")))
                  (qe-list-str lists "null[list[mpoly]]") phistr))))))

;; the value of the ground expression text STR, as a string ("" when it
;; cannot be evaluated), within SECS seconds (:timeout after them; with no
;; limit on a Lisp other than SBCL).  Only running the code is timed: the
;; translation into Lisp comes first and is not interrupted.  PVS's
;; translator records a function as translated before it has translated its
;; body; an interrupt in between would leave, for the rest of the session, a
;; function that returns NIL, which later trusted evaluations (eval-expr)
;; would run
(defun cad-eval-timed (str secs)
  (handler-case
      (let* ((*generate-tccs* 'none)
             (tc (pc-typecheck (pc-parse str 'expr)))
             (cl (pvs2cl tc)))
        (flet ((run () (let ((v (cl2pvs (eval cl) (type tc)))) (if v (expr2str v) ""))))
          #+sbcl (handler-case (sb-ext:with-timeout secs (run))
                   (sb-ext:timeout () :timeout))
          #-sbcl (run)))
    (error () "")))

;; the decision on EXPR within SECS seconds: :true, :false (both certified),
;; :fail (no certificate) or :timeout
(defun cadw-try (expr secs)
  (let ((rec (ignore-errors (cadw-recstr expr))))
    (if (null rec) :fail
      (let ((s (cad-eval-timed rec secs)))
        (cond ((eq s :timeout) :timeout)
              ((not (search "ok := TRUE" s)) :fail)
              ((search "val := TRUE" s) :true)
              (t :false))))))

;; ---- candidate constants: *cadw-consts*, then the rational roots of the
;; atoms that mention one prefix variable alone (r096 of the robustness set
;; is false only at z = -4/5, the root of its atom 5 * z + 4 /= 0)

;; the atoms (relational subterms) of a matrix
(defun cadw-atoms (e)
  (cond ((or (cad-is e "AND") (cad-is e "OR")
             (cad-is e "IMPLIES") (cad-is e "IFF"))
         (append (cadw-atoms (args1 e)) (cadw-atoms (args2 e))))
        ((and (unary-application? e) (cad-is e "NOT")) (cadw-atoms (args1 e)))
        ((some #'(lambda (op) (cad-is e op)) '("=" "/=" "<" "<=" ">" ">=")) (list e))
        (t nil)))

;; the prefix positions a term mentions, from its free variables (mapobject
;; also reaches objects outside the term's own syntax)
(defun cadw-vars (e names)
  (let ((vs nil))
    (dolist (fv (freevars e))
      (let ((i (position (string (id fv)) names :test #'string=)))
        (when i (pushnew i vs))))
    vs))

;; a bound on the degree of an arithmetic term in the prefix variables, or nil
(defun cadw-deg (e names)
  (cond ((and (name-expr? e) (position (string (id e)) names :test #'string=)) 1)
        ((or (rational-expr? e) (decimal? e)) 0)
        ((and (unary-application? e) (is-function-expr e "-")) (cadw-deg (args1 e) names))
        ((or (is-function-expr e "+") (is-function-expr e "-"))
         (let ((a (cadw-deg (args1 e) names)) (b (cadw-deg (args2 e) names))) (and a b (max a b))))
        ((is-function-expr e "*")
         (let ((a (cadw-deg (args1 e) names)) (b (cadw-deg (args2 e) names))) (and a b (+ a b))))
        ((is-function-expr e "/")
         (let ((a (cadw-deg (args1 e) names)) (b (cadw-deg (args2 e) names))) (and a b (= b 0) a)))
        ((is-function-expr e "^")
         (let ((a (cadw-deg (args1 e) names)) (k (extra-get-number-from-expr (args2 e) t)))
           (and a (integerp k) (>= k 0) (* a k))))
        (t nil)))

;; the exact coefficients, lowest first, of the polynomial closure F of
;; degree <= D in position I of an N-vector: Newton interpolation at 0..D
(defun cadw-coeffs (f d n i)
  (let ((c (coerce (loop for x from 0 to d collect
                     (let ((v (make-array n :initial-element 0)))
                       (setf (svref v i) x)
                       (funcall f v)))
                   'simple-vector)))
    (loop for j from 1 to d do
      (loop for k from d downto j do
        (setf (svref c k) (/ (- (svref c k) (svref c (1- k))) j))))
    (let ((p (list (svref c d))))
      (loop for k from (1- d) downto 0 do
        (let ((q (make-list (1+ (length p)) :initial-element 0)))
          (loop for a in p for j from 0 do
            (incf (nth (1+ j) q) a)
            (decf (nth j q) (* k a)))
          (incf (nth 0 q) (svref c k))
          (setq p q)))
      p)))

(defun cadw-divisors (n)
  (let ((n (abs n)))
    (when (<= 1 n 1000000)
      (loop for k from 1 to (isqrt n)
            when (zerop (mod n k)) append (if (= (* k k) n) (list k) (list k (/ n k)))))))

(defun cadw-peval (p x)
  (reduce #'(lambda (a acc) (+ a (* x acc))) p :from-end t :initial-value 0))

;; the rational roots of P (rational coefficients, lowest first), by the
;; rational root theorem; none when the extreme coefficients are too large
(defun cadw-rat-roots (p)
  (let ((hi (position-if-not #'zerop p :from-end t)))
    (when (and hi (> hi 0))
      (let* ((lo (position-if-not #'zerop p))
             (q (subseq p lo (1+ hi)))
             (l (reduce #'lcm (mapcar #'denominator q)))
             (z (mapcar #'(lambda (a) (* a l)) q))
             (roots (when (> lo 0) (list 0))))
        (dolist (a (cadw-divisors (first z)))
          (dolist (b (cadw-divisors (car (last z))))
            (dolist (r (list (/ a b) (- (/ a b))))
              (when (and (zerop (cadw-peval q r)) (not (member r roots)))
                (push r roots)))))
        (reverse roots)))))

;; the constants tried at position I: *cadw-consts*, then up to twelve roots
(defun cadw-cands (names body i)
  (let ((extra nil))
    (dolist (a (cadw-atoms body))
      (when (equal (cadw-vars a names) (list i))
        (let ((f (cadw-cbin #'- a names))
              (d (let ((d1 (cadw-deg (args1 a) names)) (d2 (cadw-deg (args2 a) names)))
                   (and d1 d2 (max d1 d2)))))
          (when (and f d (<= 1 d 12))
            (let ((p (catch 'cadw-undef (cadw-coeffs f d (length names) i))))
              (when p
                (dolist (r (cadw-rat-roots p))
                  (unless (or (member r *cadw-consts*) (member r extra)) (push r extra)))))))))
    (append *cadw-consts* (let ((e (reverse extra))) (subseq e 0 (min 12 (length e)))))))

;; ---- folding: the matrix with the variable of position I set to C.  Atoms
;; in that variable alone are evaluated exactly and the Boolean structure is
;; simplified; the result is :true, :false, or (TEXT . POSITIONS) with the
;; positions (other than I) that TEXT still mentions.  Nothing here is
;; trusted: the proof re-derives the folding with ground, after unfolding ^
;; when ground alone does not (it does not evaluate powers), and a plan whose
;; proof does not close the goal changes nothing (cad-main__).
(defun cadw-ftxt (a) (if (consp a) (format nil "(~a)" (car a)) (if (eq a :true) "TRUE" "FALSE")))
(defun cadw-fand (a b)
  (cond ((or (eq a :false) (eq b :false)) :false) ((eq a :true) b) ((eq b :true) a)
        (t (cons (format nil "~a AND ~a" (cadw-ftxt a) (cadw-ftxt b)) (union (cdr a) (cdr b))))))
(defun cadw-for (a b)
  (cond ((or (eq a :true) (eq b :true)) :true) ((eq a :false) b) ((eq b :false) a)
        (t (cons (format nil "~a OR ~a" (cadw-ftxt a) (cadw-ftxt b)) (union (cdr a) (cdr b))))))
(defun cadw-fnot (a)
  (cond ((eq a :true) :false) ((eq a :false) :true)
        (t (cons (format nil "NOT ~a" (cadw-ftxt a)) (cdr a)))))
(defun cadw-fold (e names i c)
  (flet ((f (x) (cadw-fold x names i c)))
    (cond ((cad-is e "AND") (cadw-fand (f (args1 e)) (f (args2 e))))
          ((cad-is e "OR") (cadw-for (f (args1 e)) (f (args2 e))))
          ((cad-is e "IMPLIES") (cadw-for (cadw-fnot (f (args1 e))) (f (args2 e))))
          ((cad-is e "IFF")
           (let ((a (f (args1 e))) (b (f (args2 e))))
             (cadw-fand (cadw-for (cadw-fnot a) b) (cadw-for (cadw-fnot b) a))))
          ((and (unary-application? e) (cad-is e "NOT")) (cadw-fnot (f (args1 e))))
          ((and (name-expr? e) (string= (string (id e)) "TRUE")) :true)
          ((and (name-expr? e) (string= (string (id e)) "FALSE")) :false)
          (t (let* ((vs (cadw-vars e names))
                    (g (and (subsetp vs (list i)) (cadw-cbool e names)))
                    (r (and g (catch 'cadw-undef
                                (let ((v (make-array (length names) :initial-element 0)))
                                  (setf (svref v i) c)
                                  (list (funcall g v)))))))
               (if r (if (car r) :true :false)
                 (cons (expr2str e) (remove i vs))))))))

;; the reduced sentence: quantifiers QT (t = FORALL) over the positions KEPT,
;; the folded matrix STXT under LET x_I = C
(defun cadw-rtext (names qt i c kept stxt)
  (format nil "~{~a~}(LET ~a: real = ~a IN (~a))"
          (loop for nm in names for q in qt for j from 0
                when (member j kept) collect (format nil "~a (~a: real): " (if q "FORALL" "EXISTS") nm))
          (nth i names) c stxt))

;; the proof of the goal (FNUM) with position I fixed to C, by labels.  The
;; walk goes through the sentence's positions in order: I is instantiated
;; with C; a KEPT position is skolemized on one side and instantiated with the
;; same name on the other; a position the folding dropped is skolemized when
;; the target is universal there and instantiated with 0 otherwise.  With
;; RTEXT nil the folded target is TRUE and the walk and ground close the goal;
;; otherwise RTEXT is split on and proved by (cad-direct).  QS are the
;; sentence's own quantifiers (t = FORALL); ANTE: it is in the antecedent.
(defun cadw-reduce-steps (fnum names qs i c kept rtext ante)
  (let ((walk (loop for q in qs for j from 0
                    append (let ((tuniv (eq (not ante) q)) (n (freshname "cw")))
                             (cond ((= j i) `((inst !cwg ,(format nil "~a" c))))
                                   ((and rtext (member j kept))
                                    (if tuniv
                                        `((skolem !cwg (,n)) (inst !cwr ,n))
                                      `((skolem !cwr (,n)) (inst !cwg ,n))))
                                   (tuniv `((skolem !cwg (,n))))
                                   (t `((inst !cwg "0"))))))))
    (if (null rtext)
        `(with-fresh-labels ((!cwg ,fnum))
           (then ,@walk (beta) (cadw-close__$)))
      `(with-fresh-labels ((!cwg ,fnum) (!cwr))
         (branch (discriminate (case ,rtext) !cwr)
           ((then ,@walk (beta) (cadw-close__$))
            (then (beta !cwr) (cad-direct !cwr))))))))

;; the folded atoms after the walk: ground, else ground after unfolding the
;; powers of numbers (2 ^ 2 = 4), which ground does not evaluate
(defhelper cadw-close__ ()
  (else (finalize__$ (ground))
        (then (expand "^") (repeat (expand "expt")) (ground)))
  "[pvs_cad] Internal: closes the witness walk." "")

;; the target's matrix folded at position I, C: :true, :false or (TEXT . KEPT)
(defun cadw-tfold (body names i c ante)
  (let ((f (cadw-fold body names i c))) (if ante (cadw-fnot f) f)))

;; a constant that makes the target's matrix TRUE outright, at any of its
;; existential positions: the proof is the walk and ground, no decision
(defun cadw-trivial (fnum names qs qt body ante)
  (loop for i from 0 below (length names)
        unless (nth i qt)
        do (dolist (c (cadw-cands names body i))
             (when (eq (cadw-tfold body names i c ante) :true)
               (return-from cadw-trivial (cadw-reduce-steps fnum names qs i c nil nil ante)))))
  nil)

;; the reduction: the target's existential positions, outermost first, each
;; with its candidate constants; the first folded sentence certified TRUE
;; wins.  Each gets at most BUDGET seconds, the whole search 6 BUDGET
(defun cadw-reduce (fnum names qs qt body budget ante)
  (let ((stop (+ (get-internal-real-time) (* 6 budget internal-time-units-per-second))))
    (loop for i from 0 below (length names)
          unless (nth i qt)
          do (dolist (c (cadw-cands names body i))
               (when (> (get-internal-real-time) stop) (return-from cadw-reduce nil))
               (let ((tf (cadw-tfold body names i c ante)))
                 (when (consp tf)
                   (let* ((kept (cdr tf))
                          (rtext (cadw-rtext names qt i c kept (car tf)))
                          (rexpr (ignore-errors
                                  (beta-reduce (pc-typecheck (pc-parse rtext 'expr) :expected *boolean*)))))
                     (when (and rexpr (eq (cadw-try rexpr budget) :true))
                       (return-from cadw-reduce
                         (cadw-reduce-steps fnum names qs i c kept rtext ante))))))))
    nil))

;; the plan of (cad), or nil for the full decision.  FNUM may be a number or
;; a label; ANTE (the sentence is in the antecedent) comes from where it is now
(defun cadw-plan (fnum fexpr pre body budget ante)
  (let* ((names (mapcar #'car pre))
         (qs (mapcar #'cdr pre))
         (qt (if ante (mapcar #'not qs) qs))
         (want (not ante)))
    (or (when (notany #'identity qt)
          (let ((pt (cadw-search names body want)))
            ;; the point is checked again by the ground evaluator that
            ;; eval-formula uses, so the step cannot leave the goal open.  The
            ;; ground instance may change sides (a negation moves across the
            ;; sequent), so every formula is offered to the evaluator
            (when (and pt (cadw-confirm names pt body want))
              `(with-fresh-labels ((!cwp ,fnum))
                 (then ,@(loop for c in pt collect `(inst !cwp ,(format nil "~a" c)))
                       (else (finalize__$ (eval-formula !cwp)) (eval-formula* *)))))))
        (when (>= (length names) 2)
          (cadw-trivial fnum names qs qt body ante))
        (when (>= (length names) 3)
          (let ((full (cadw-try fexpr budget)))
            (unless (member full '(:true :false))
              (cadw-reduce fnum names qs qt body (max 1 (floor budget 2)) ante)))))))

;;; ------------------------------------------------------------------
;;; (cad *): the polynomial content of the whole sequent (CADSTAR_PLAN.md).
;;;
;;; The usable formulas of FNUMS -- a prefix of real quantifiers, then a
;;; Boolean combination of comparisons of real terms that are polynomial in
;;; the bound variables -- are collected into ONE closed prenex formula
;;;   G = FORALL (v: real): TYPEFACTS IMPLIES ((A1 AND ...) IMPLIES (C1 OR ...))
;;; with every other real subterm free of bound variables (a constant,
;;; sqrt(x), f(a), a nat) replaced by a variable v.  An antecedent's
;;; quantifiers flip in G, a consequent's stay; bound variables are renamed
;;; apart.  G enters by case and PVS checks both branches: with G assumed,
;;; G's variables are instantiated with the terms, G's quantifiers are
;;; matched one by one with the sequent formulas' (skolemize one side,
;;; instantiate the other), and prop closes; G itself is proved by (cad).
;;; Nothing new is trusted.  The whole attempt is wrapped in finalize, so a
;;; FALSE G leaves the sequent as it was.
;;; ------------------------------------------------------------------
(defparameter *cadstar-abs* nil)    ; (key-text name expr) per abstracted term
(defparameter *cadstar-count* 0)    ; counter for fresh bound-variable names

(defun cadstar-multi? (fnum)
  (or (member fnum '(* + -)) (and (consp fnum) (not (member (car fnum) '(:in))))))

(defun cadstar-real-type? (te)
  (and te (or (tc-eq te *real*) (subtype-of? te *real*))))

;; does E mention one of the binding declarations DECLS?
(defun cadstar-mentions? (e decls)
  (let ((found nil))
    (mapobject #'(lambda (obj)
                   (or found
                       (when (and (name-expr? obj) (member (declaration obj) decls))
                         (setq found t))))
               e)
    found))

;; the text of the term E for proof steps, which typecheck it again: its own
;; text when that resolves to E alone, else with full names (e is ln_exp's
;; e or vector_arithmetic's when both are imported)
(defun cadstar-key-text (e)
  (let ((plain (expr2str e)))
    (if (let ((re (ignore-errors (with-no-type-errors (pc-typecheck (pc-parse plain 'expr))))))
          (and re (tc-eq re e)))
        plain
      (expr2str (full-name e)))))

;; the unknown's name of the real term E: the same term (tc-eq: the same
;; resolutions, however it is written -- e and lnexp@ln_exp.e) gets the same
;; name in every formula
(defun cadstar-abstract (e)
  (let ((hit (find-if #'(lambda (a) (tc-eq (third a) e)) *cadstar-abs*)))
    (if hit (second hit)
      (let ((nm (format nil "cadv_~a" (1+ (length *cadstar-abs*)))))
        (setq *cadstar-abs* (append *cadstar-abs* (list (list (cadstar-key-text e) nm e))))
        nm))))

;; is E real-valued: a real type, a number, or arithmetic over such terms
;; (the arithmetic nodes have the prelude's type numfield)
(defun cadstar-realval? (e)
  (or (cadstar-real-type? (type e))
      (extra-get-number-from-expr e t)
      (and (application? e)
           (some #'(lambda (op) (is-function-expr e op)) '("+" "-" "*" "/" "^" "sq"))
           (every #'cadstar-realval? (arguments e)))))

;; the text of the real term E over the renamed bound variables BV (an alist
;; bind-decl -> name) and the abstracted terms, with E's own structure; nil
;; when a bound variable occurs outside the polynomial operations or a leaf
;; is not real.  A quotient by a non-number and a power with another
;; exponent are leaves (unknowns) when free of the bound variables.
(defun cadstar-term (e bv)
  (cond
   ((and (name-expr? e) (assoc (declaration e) bv)) (cdr (assoc (declaration e) bv)))
   ((and (extra-get-number-from-expr e t) (not (cadstar-mentions? e (mapcar #'car bv))))
    (format nil "(~a)" (expr2str e)))
   ((and (unary-application? e) (is-function-expr e "-"))
    (let ((a (cadstar-term (args1 e) bv))) (when a (format nil "(- ~a)" a))))
   ((and (not (unary-application? e))
         (or (is-function-expr e "+") (is-function-expr e "-") (is-function-expr e "*")))
    (let ((a (cadstar-term (args1 e) bv)) (b (cadstar-term (args2 e) bv)))
      (when (and a b) (format nil "(~a ~a ~a)" a (id (operator e)) b))))
   ((and (is-function-expr e "^")
         (let ((n (extra-get-number-from-expr (args2 e) t))) (and n (integerp n) (>= n 0))))
    (let ((n (extra-get-number-from-expr (args2 e) t)) (a (cadstar-term (args1 e) bv)))
      (when a (format nil "(~a ^ ~a)" a n))))
   ((and (is-function-expr e "/")
         (let ((d (extra-get-number-from-expr (args2 e) t))) (and d (not (zerop d)))))
    (let ((a (cadstar-term (args1 e) bv)))
      (when a (format nil "(~a / (~a))" a (expr2str (args2 e))))))
   ((is-function-expr e "sq")
    (let ((a (cadstar-term (args1 e) bv))) (when a (format nil "sq(~a)" a))))
   ;; a leaf: an unknown real, when it is real-valued and free of the bound
   ;; variables
   ((or (not (cadstar-realval? e)) (cadstar-mentions? e (mapcar #'car bv))) nil)
   (t (cadstar-abstract e))))

;; the text of the Boolean matrix E, or nil
(defun cadstar-bool (e bv)
  (flet ((bin (op) (let ((a (cadstar-bool (args1 e) bv)) (b (cadstar-bool (args2 e) bv)))
                     (when (and a b) (format nil "(~a ~a ~a)" a op b)))))
    (cond
     ((cad-is e "AND") (bin "AND"))
     ((cad-is e "OR") (bin "OR"))
     ((cad-is e "IMPLIES") (bin "IMPLIES"))
     ((cad-is e "IFF") (bin "IFF"))
     ((and (unary-application? e) (cad-is e "NOT"))
      (let ((a (cadstar-bool (args1 e) bv))) (when a (format nil "(NOT ~a)" a))))
     ((and (name-expr? e) (member (string (id e)) '("TRUE" "FALSE") :test #'string=))
      (string (id e)))
     (t (let ((op (find-if #'(lambda (o) (cad-is e o)) '("=" "/=" "<" "<=" ">" ">="))))
          (when (and op (not (unary-application? e)))
            (let ((a (cadstar-term (args1 e) bv)) (b (cadstar-term (args2 e) bv)))
              (when (and a b) (format nil "(~a ~a ~a)" a op b)))))))))

;; (NODES MATRIX) for a usable formula: NODES lists (forall? name ...) per
;; quantifier of the prefix, bound variables renamed; nil when not usable
(defun cadstar-formula (fml)
  (let ((nodes nil) (bv nil) (e fml) (bad nil))
    (loop while (and (not bad) (or (forall-expr? e) (exists-expr? e))) do
      (let ((names nil))
        (dolist (b (bindings e))
          (if (tc-eq (type b) *real*)
              (let ((nm (format nil "cadb_~a" (incf *cadstar-count*))))
                (push (cons b nm) bv) (push nm names))
            (setq bad t)))
        (push (cons (and (forall-expr? e) t) (reverse names)) nodes)
        (setq e (expression e))))
    (unless bad
      (let ((m (cadstar-bool e bv)))
        (when m (list (reverse nodes) m))))))

;; the comparisons of the bound variable of the subtype predicate PRED with
;; numbers, as a list of (OP . NUMBER): {x: T | x > 0}, {x: T | 1 <= x},
;; {k: int | i <= k AND k <= j} (conjunctions split)
(defun cad-pred-guards (pred)
  (when (and (lambda-expr? pred) (= (length (bindings pred)) 1))
    (let ((v (car (bindings pred))))
      (labels ((var? (x) (and (name-expr? x) (eq (declaration x) v)))
               (cmps (body)
                 (if (and (not (unary-application? body)) (cad-is body "AND"))
                     (append (cmps (args1 body)) (cmps (args2 body)))
                   (let ((op (and (application? body) (not (unary-application? body))
                                  (find-if #'(lambda (o) (cad-is body o)) '(">" ">=" "<" "<=" "/=")))))
                     (when op
                       (let ((l (args1 body)) (r (args2 body)))
                         (cond ((and (var? l) (extra-get-number-from-expr r t))
                                (list (cons op (extra-get-number-from-expr r t))))
                               ((and (var? r) (extra-get-number-from-expr l t))
                                (list (cons (cdr (assoc op '((">" . "<") (">=" . "<=") ("<" . ">")
                                                             ("<=" . ">=") ("/=" . "/="))
                                                        :test #'string=))
                                            (extra-get-number-from-expr l t)))))))))))
        (cmps (expression pred))))))

;; the comparisons with numbers that the type TE of a real term gives it, as a
;; list of (OP . TEXT): every comparison of its variable with a number in the
;; predicates up TE's subtype chain (posreal: > 0, nnreal: >= 0, nzreal: /= 0,
;; below(5): >= 0 and < 5, a user's {x: real | x < 1}: < 1), strict bounds
;; made non-strict on an integer type (posnat: >= 1, negint: <= -1, below(5):
;; <= 4), and of those the strongest lower and upper bound and the /= that
;; they do not already give.  The types are read, not named, so a type
;; declared again elsewhere (NASALib's own negint) counts too
(defun cad-type-guards (te)
  (let* ((raw (loop for ty = te then (supertype ty)
                    while (subtype? ty)
                    append (ignore-errors (cad-pred-guards (predicate ty)))))
         (int? (ignore-errors (subtype-of? te (pc-typecheck (pc-parse "int" 'type-expr)))))
         (gs (mapcar #'(lambda (g)
                         (let ((op (car g)) (c (cdr g)))
                           (cond ((and int? (integerp c) (string= op ">")) (cons ">=" (1+ c)))
                                 ((and int? (integerp c) (string= op "<")) (cons "<=" (1- c)))
                                 (t g))))
                     raw))
         (lo nil) (hi nil) (nes nil))
    (dolist (g gs)
      (let ((op (car g)) (c (cdr g)))
        (cond ((member op '(">" ">=") :test #'string=)
               (when (or (null lo) (> c (cdr lo)) (and (= c (cdr lo)) (string= op ">")))
                 (setq lo g)))
              ((member op '("<" "<=") :test #'string=)
               (when (or (null hi) (< c (cdr hi)) (and (= c (cdr hi)) (string= op "<")))
                 (setq hi g)))
              (t (pushnew c nes)))))
    (setq nes (remove-if #'(lambda (c) (or (and lo (or (> (cdr lo) c) (and (= (cdr lo) c) (string= (car lo) ">"))))
                                           (and hi (or (< (cdr hi) c) (and (= (cdr hi) c) (string= (car hi) "<"))))))
                         (reverse nes)))
    (mapcar #'(lambda (g) (cons (car g) (format nil "~a" (cdr g))))
            (append (when lo (list lo)) (when hi (list hi))
                    (mapcar #'(lambda (c) (cons "/=" c)) nes)))))

;; a TCC that typepred or an exact fact raises (sqrt(x^2 + 1) re-typechecked
;; asks for x^2 + 1 >= 0 when the type of x does not show it), formula 1 of
;; its subgoal (PVS puts a TCC there): decided by (cad) alone, else with the
;; hypotheses, else with the hidden hypotheses revealed (the mirror walk hides
;; the other side of an AND: x > 0 AND sqrt(x) > y), else with every formula
;; (the guard can be in another goal: c > 0 IMPLIES 1 / c > 0) -- cad-main__,
;; without the fallbacks for constants and operators
;; is the goal's first consequent (the TCC) also the first consequent of an
;; ancestor goal?  Then the TCC is being decided inside its own decision:
;; deciding with the hypotheses, (cad *) took the same term as an unknown,
;; and its type fact's typepred raised the TCC again.  cadstar-tcc__ then
;; makes only the attempt on the TCC alone, so the recursion stops.
(defun cadstar-tcc-again? ()
  (let* ((sfs (pos-s-forms (current-goal *ps*)))
         (f (when sfs (formula (car sfs)))))
    (when f
      (loop for a = (parent-proofstate *ps*) then (parent-proofstate a)
            while a
            thereis (let ((afs (pos-s-forms (current-goal a))))
                      (and afs (tc-eq (formula (car afs)) f)))))))

;; the TCC alone; with the hypotheses; with the hidden ones too; after
;; flatten, which makes a guard inside a goal (c >= 0 IMPLIES ...) a
;; hypothesis; last by ground.  Never the whole sequent: its formula with the
;; term would raise the same TCC again
(defhelper cadstar-tcc__ ()
  (let ((again (cadstar-tcc-again?)))
    (if again
        (finalize__$ (then (hide-all-but 1) (cad-main__$ 1)))
      (else (finalize__$ (then (hide-all-but 1) (cad-main__$ 1)))
            (else (finalize__$ (cad-main__$ (1 -)))
                  (else (finalize__$ (then (reveal -) (cad-main__$ (1 -))))
                        (else (finalize__$ (then (reveal -) (flatten) (cad-main__$ (1 -))))
                              (finalize__$ (then (reveal -) (flatten) (ground)))))))))
  "[pvs_cad] Internal: a TCC of a type fact or an exact fact, decided by (cad)." "")

;; (typepred KEY), with the TCCs that re-typechecking KEY raises decided
(defhelper cadstar-typepred__ (key)
  (branch (typepred key) ((skip) (cadstar-tcc__$)))
  "[pvs_cad] Internal: typepred with its TCCs decided." "")

;; the fact the type of the abstracted term E gives its variable NM, or nil
(defun cadstar-typefact (e nm)
  (let ((gs (cad-type-guards (type e))))
    (cond ((null gs) nil)
          ((null (cdr gs)) (format nil "(~a ~a ~a)" nm (car (car gs)) (cdr (car gs))))
          (t (format nil "(~{~a~^ AND ~})"
                     (mapcar #'(lambda (g) (format nil "(~a ~a ~a)" nm (car g) (cdr g))) gs))))))

;; the usable formulas of FNUMS as (fnum nodes matrix), and the skipped fnums
(defun cadstar-collect (fnums)
  (setq *cadstar-abs* nil *cadstar-count* 0)
  (let ((used nil) (skipped nil))
    (dolist (fn (extra-get-fnums fnums))
      (let* ((f (extra-get-formula-from-fnum fn))
             (saved *cadstar-abs*)
             (r (when f (ignore-errors (cadstar-formula f)))))
        (if r (push (list fn (first r) (second r)) used)
          (progn (setq *cadstar-abs* saved) (push fn skipped)))))
    (list (reverse used) (reverse skipped))))

;; the abstracted terms of FNUMS, in *cadstar-abs*: each formula read as
;; (cad *) reads it, prenex (cadstar-formula) or else whole (cadg-text, the
;; general route), so that terms under nested binders count too (sqrt(2) in
;; FORALL x: x < 0 OR (EXISTS y: ...) OR sqrt(2) > 1); the terms of a
;; formula that neither reads are dropped
(defun cadstar-terms (fnums)
  (setq *cadstar-abs* nil *cadstar-count* 0)
  (dolist (fn (extra-get-fnums fnums))
    (let ((f (extra-get-formula-from-fnum fn))
          (saved *cadstar-abs*))
      (unless (and f (or (ignore-errors (cadstar-formula f))
                         (progn (setq *cadstar-abs* saved)
                                (ignore-errors (cadg-text f nil)))))
        (setq *cadstar-abs* saved))))
  *cadstar-abs*)

;; is the quantifier of NODE, of a formula on side ANTE, universal in G?
(defun cadstar-gall? (node ante) (if ante (not (car node)) (car node)))

(defun cadstar-g (used tfs)
  (let* ((ants (loop for u in used when (< (first u) 0) collect (third u)))
         (cons (loop for u in used when (> (first u) 0) collect (third u)))
         (body (cond ((and ants cons) (format nil "((~{~a~^ AND ~}) IMPLIES (~{~a~^ OR ~}))" ants cons))
                     (cons (format nil "(~{~a~^ OR ~})" cons))
                     (ants (format nil "(NOT (~{~a~^ AND ~}))" ants))
                     (t "FALSE")))
         (body2 (if tfs (format nil "((~{~a~^ AND ~}) IMPLIES ~a)" tfs body) body))
         (qs (loop for u in used append
                   (let ((ante (< (first u) 0)))
                     (loop for node in (second u) append
                           (loop for nm in (cdr node) collect
                                 (format nil "~a (~a: real):"
                                         (if (cadstar-gall? node ante) "FORALL" "EXISTS") nm))))))
         (vq (loop for a in *cadstar-abs* collect (format nil "FORALL (~a: real):" (second a)))))
    (format nil "~{~a ~}~{~a ~}~a" vq qs body2)))

;; the steps that derive the goal from G (labelled GL, an antecedent),
;; the used formulas labelled LABS
(defun cadstar-use (used labs gl)
  (let ((k 0))
    (flet ((fresh () (format nil "cadk_~a" (incf k))))
      `(then
        ,@(loop for a in *cadstar-abs* collect `(inst ,gl ,(first a)))
        ,@(loop for u in used for lab in labs append
                (let ((ante (< (first u) 0)))
                  (loop for node in (second u) append
                        (let ((names (loop for nm in (cdr node) collect (fresh))))
                          (if (cadstar-gall? node ante)
                              `((skolem ,lab ,names) ,@(loop for n in names collect `(inst ,gl ,n)))
                            `(,@(loop for n in names collect `(skolem ,gl (,n)))
                              (inst ,lab ,@names)))))))
        ,@(loop for a in *cadstar-abs* when (cadstar-typefact (third a) (second a))
                collect `(cadstar-typepred__$ ,(first a)))
        (prop)
        (assert)))))

(defhelper cad-seq__ (fnums budget &optional cad-only?)
  (let ((cs      (cadstar-collect fnums))
        (used    (first cs))
        (skipped (second cs))
        ;; a skipped formula the general route can read: every formula is
        ;; kept whole instead (FORMS_PLAN.md F5)
        (gen?    (and (cad-imports? "gform_ok")
                      (some #'(lambda (fn) (cadg-usable? (extra-get-formula-from-fnum fn))) skipped)))
        (tfs     (loop for a in *cadstar-abs* for f = (cadstar-typefact (third a) (second a))
                       when f collect f))
        (gstr    (when used (cadstar-g used tfs)))
        (labs    (freshlabels "cadsf" (length used)))
        (gl      (freshlabel "cadsg"))
        (msg     (format nil "cad*: using ~a, skipping ~a~@[; unknown reals: ~{~a~^, ~}~]"
                         (or (mapcar #'first used) "nothing") (or skipped "nothing")
                         (loop for a in *cadstar-abs* collect (format nil "~a = ~a" (second a) (first a))))))
    (if gen? (cadg-seq__$ fnums budget cad-only?)
    (if (null used)
        (printf "cad*: no formula of the sequent is a polynomial formula over the reals")
      (let ((step `(then ,@(loop for u in used for lab in labs collect `(label ,lab ,(first u)))
                         ,(cad-fact-case gstr gl (cadstar-use used labs gl) `(cad ,gl ,budget nil ,cad-only?)))))
        (then (printf "~a~%cad*: deciding ~a" msg gstr)
              (else (finalize__$ step)
                    (printf "cad*: not proved; the sequent is unchanged")))))))
  "[pvs_cad] Internal: (cad *) for the formulas FNUMS." "")

;;; ------------------------------------------------------------------
;;; Algebraic operators as exact facts (TERMS_PLAN.md T3).
;;; A real term that (cad *) turns into an unknown and that is sqrt(t),
;;; abs(t), max(a, b), min(a, b) or t / u with u not a number gets the
;;; formulas that pin it down exactly, proved and added as hypotheses before
;;; the decision: sqrt(t) >= 0 and sqrt(t) * sqrt(t) = t (sqrt's type, by
;;; typepred), abs / max / min by their definitions as two cases, and
;;; (t / u) * u = t.  t, u, a and b are themselves read by (cad *), so nested
;;; terms are pinned down from the inside out: sqrt(1 + sqrt(2)) gives
;;; s1 * s1 = 2 and s2 * s2 = 1 + s1.

;; is E an application of the prelude or NASALib function named OP?
(defun cadf-op? (e op &optional (n 1))
  (and (application? e) (is-function-expr e op) (= (length (arguments e)) n)))

;; the step that adds the exact fact of the abstracted term E (text KEY),
;; or nil
(defun cadf-step (e key)
  (flet ((txt (x) (cadstar-key-text x))
         (cases (fml prf) `(branch (case ,fml) ((skip) ,prf (cadstar-tcc__$)))))
    (cond
     ((cadf-op? e "sqrt") `(cadstar-typepred__$ ,key))
     ((cadf-op? e "abs")
      (let ((a (txt (args1 e))))
        (cases (format nil "(~a >= 0 AND ~a = ~a) OR (~a < 0 AND ~a = -(~a))" a key a a key a)
               `(then (hide-all-but 1) (case ,(format nil "~a < 0" a)) (expand "abs") (assert) (ground)))))
     ((or (cadf-op? e "max" 2) (cadf-op? e "min" 2))
      (let ((a (txt (args1 e))) (b (txt (args2 e))) (mx (cadf-op? e "max" 2)))
        (cases (format nil "(~a ~a ~a AND ~a = ~a) OR (~a ~a ~a AND ~a = ~a)"
                       a (if mx ">=" "<=") b key a a (if mx "<" ">") b key b)
               `(then (hide-all-but 1) (case ,(format nil "~a ~a ~a" a (if mx "<" ">") b))
                      (expand ,(if mx "max" "min")) (assert) (ground)))))
     ((and (cadf-op? e "/" 2) (not (extra-get-number-from-expr (args2 e) t)))
      (let ((a (txt (args1 e))) (b (txt (args2 e))))
        (cases (format nil "(~a) * (~a) = ~a" key b a)
               '(then (assert) (ground)))))
     (t nil))))

;;; ------------------------------------------------------------------
;;; Functions of constants (NEXT_PLAN.md T5): polynomial bounds.
;;; sin(t), cos(t), exp(t), ln(t) and atan(t) are unknowns to (cad *).  In a
;;; theory that imports trans_bounds (pvs_cad_num does) they get the bounds
;;; of trans_bounds at t, proved lemma instances, by rungs of cad-num: the
;;; ranges (-1 <= sin(t) <= 1, -8/5 < atan(t) < 8/5) with the exact facts;
;;; the bounds of degree 3 (t - t^3/6 <= sin(t) <= t for t >= 0, 1 + t <=
;;; exp(t), ln(t) <= t - 1 for t > 0, ...) next; those of higher degree (sin
;;; to degree 7, cos to 6) last.  A range keeps the decision to the terms;
;;; a bound of degree 3 brings t in, with its constants.  The bounds hold
;;; where the two sides touch (sin(c) <= c at c = 0), which no enclosure can
;;; show.

;; trans_bounds's lemmas for each function, with the theory that defines
;; the function, by rung: the ranges, degree 3, higher degree; the lemmas'
;; variable is x
(defparameter *cadf-trans*
  '(("sin" "sincos_def" ("sin_bnd_rng") ("sin_bnd_pos" "sin_bnd_neg") ("sin_bnd7_pos" "sin_bnd7_neg"))
    ("cos" "sincos_def" ("cos_bnd_rng") ("cos_bnd") ("cos_bnd6"))
    ("exp" "ln_exp" () ("exp_bnd_lb" "exp_bnd_ub") ())
    ("ln" "ln_exp" () ("ln_bnd") ())
    ("atan" "atan" ("atan_bnd_rng") ("atan_bnd_pos" "atan_bnd_neg") ())))

;; the row for E, an application of NASALib's function to one argument, or
;; nil
(defun cadf-trans-row (e)
  (loop for row in *cadf-trans*
        when (and (cadf-op? e (first row))
                  (name-expr? (operator e))
                  (string= (string (id (module (declaration (operator e))))) (second row)))
        return row))

;; the instances at E's argument of the lemmas of rung LEVEL (0: the
;; ranges, 1: degree 3, 2: higher degree) for E's function, as steps (nil
;; when there are none or trans_bounds is not imported)
(defun cadf-trans-steps (e &optional (level 0))
  (let ((row (cadf-trans-row e)))
    (when (and row (cad-imports? "trans_bounds"))
      (let ((a (cadstar-key-text (args1 e))))
        (loop for lem in (nth (+ 2 level) row)
              collect `(lemma ,(format nil "trans_bounds.~a" lem) ("x" ,a)))))))

;; the exact facts and the ranges of the abstracted terms of FNUMS not
;; handled yet (*cadf-done*), as steps; the terms are then recorded as
;; handled
(defparameter *cadf-done* nil)
(defun cadf-new-steps (fnums)
  (cadstar-terms fnums)
  (loop for a in *cadstar-abs*
        for e = (third a)
        unless (find-if #'(lambda (d) (tc-eq d e)) *cadf-done*)
        append (let ((step (cadf-step e (first a))))
                 (push e *cadf-done*)
                 (append (when step (list step)) (cadf-trans-steps e)))))

;; the new hypotheses (the first N1 - N0, as PVS puts them first) labelled FL
(defhelper cadf-label-new__ (n0 fl)
  (let ((n1  (length (extra-get-fnums '-)))
        (new (loop for i from 1 to (- n1 n0) collect (- i))))
    (if new (label fl new) (skip)))
  "[pvs_cad] Internal: labels the hypotheses a step added." "")

;; STEP, with the hypotheses it adds labelled FL; a TCC the step raises is
;; decided by cadstar-tcc__.  All or nothing: when the TCC stays open the
;; step is undone, so one fact that cannot be justified here drops alone
;; instead of leaving cad-num with an open branch
(defhelper cadf-add__ (step fl)
  (let ((n0 (length (extra-get-fnums '-))))
    (try (branch step ((cadf-label-new__$ n0 fl) (then (cadstar-tcc__$) (fail))))
         (skip)
         (skip)))
  "[pvs_cad] Internal: one exact fact." "")

;; facts for the terms of the formulas labelled UL and FL, round after round
;; (a fact can bring a new term: sqrt(1 + sqrt(2))), each labelled FL
(defhelper cadf-loop__ (ul fl)
  (let ((steps (cadf-new-steps (list ul fl)))
        (strat (when steps
                 `(then ,@(loop for st in steps collect `(cadf-add__$ ,st ,fl))
                        (cadf-loop__$ ,ul ,fl)))))
    (if strat strat (skip)))
  "[pvs_cad] Internal: the exact facts, until no new term appears." "")

(defstep cad-facts (&optional (fnums *))
  (let ((dummy (setq *cadf-done* nil)))
    (with-fresh-labels ((!cfu fnums) (!cff))
      (cadf-loop__$ !cfu !cff)))
  "[pvs_cad] Adds, as hypotheses, the formulas that pin down every sqrt(t), abs(t), max(a, b),
min(a, b) and t / u (u not a number) among the real terms of FNUMS that (cad *) generalizes:
sqrt(t) >= 0 and sqrt(t) * sqrt(t) = t, abs, max and min by their definitions as two cases,
(t / u) * u = t; in a theory that imports trans_bounds (pvs_cad_num does), the ranges of
sin(t), cos(t) and atan(t) (-1 <= sin(t) <= 1, -8/5 < atan(t) < 8/5)." "Adding exact facts")

;;; ------------------------------------------------------------------
;;; cad-num: constants by interval arithmetic (TERMS_PLAN.md T2).
;;; A real term of the sequent that (cad *) turns into an unknown and that
;;; NASALib's interval arithmetic evaluates as it stands (numbers, + - * / ^,
;;; sq, abs, sqrt, pi, e, exp, ln, sin, cos, tan, atan; no variables, no
;;; skolem constants) gets an enclosure lb <= t AND t <= ub, proved by
;;; NASALib's (numerical t) and added as a hypothesis.  Then the sequent G,
;;; with t an unknown in [lb, ub], is decided by evaluation: TRUE, it is
;;; proved by (cad) on those formulas; otherwise, when the sequent with its
;;; goals moved among the hypotheses has no solution in the enclosures (H),
;;; the goal is FALSE at the constants wherever the hypotheses hold, and the
;;; strategy says so and stops; otherwise the precision rises (PRECISIONS,
;;; in decimals) and it tries again.  The enclosures are proved formulas
;;; about the terms (by numerical, through the ground evaluator, the trusted
;;; base of the decisions too), and (cad) proves the rest.

(defparameter *cadc-verdict* nil)   ; :false once H is TRUE

;; numerical's substitutions for the builtin names that the text KEY writes
;; with their theories (lnexp@ln_exp.e for e): the builtin's own entry
(defun cadc-subs (key)
  (let ((e (ignore-errors (with-no-type-errors (pc-typecheck (pc-parse key 'expr)))))
        (subs nil))
    (when e
      (mapobject #'(lambda (obj)
                     (when (name-expr? obj)
                       (let ((txt (expr2str obj))
                             (b   (assoc (string (id obj)) *ia-builtin* :test #'string=)))
                         (when (and b (not (string= txt (string (id obj))))
                                    (not (assoc txt subs :test #'string=)))
                           (push (cons txt (cdr b)) subs))))
                     nil)
                 e))
    subs))

;; the terms of FNUMS that (cad *) abstracts, that have no exact facts
;; (cadf-step) and that interval arithmetic evaluates, as (text subs) for
;; numerical (nil when the theory does not import interval_arith's
;; strategies)
(defun cadc-consts (fnums)
  (when (and (fboundp 'ia-interval-expr)
             (null (no-qualified-name "interval_arith@strategies4Q.IntervalStrategies4Q__")))
    (cadstar-terms fnums)
    (loop for a in *cadstar-abs*
          for e = (third a)
          when (and (null (cadf-step e (first a)))
                    (null (ignore-errors (ia-get-vars-from-expr e *ia-builtin*)))
                    (stringp (ignore-errors (ia-interval-expr e 3 nil *ia-builtin*))))
          collect (list (first a) (cadc-subs (first a))))))

;; is the name O a constant that interval arithmetic takes as a variable: a
;; skolem constant, a theory parameter (c: real), or a theory's constant
;; without a definition -- not one it evaluates itself (*ia-builtin*: pi,
;; which NASALib declares with no definition)
(defun cadt5-free-name? (o)
  (and (name-expr? o)
       (let ((d (declaration o)))
         (or (skolem-const-decl? d)
             (and (or (formal-const-decl? d) (and (const-decl? d) (null (def-axiom d))))
                  (not (funtype? (find-supertype (type o))))
                  (not (and (const-decl? d) (boundp '*ia-builtin*)
                            (assoc (string (id o)) (symbol-value '*ia-builtin*) :test #'string=))))))))

;; the names of interval arithmetic's builtin operations and constants
(defparameter *cadc-ia-names*
  '("+" "-" "*" "/" "^" "sq" "abs" "sqrt" "pi" "e" "sin" "cos" "tan" "atan" "exp" "ln"))

;; is E a constant term that interval arithmetic would evaluate: numbers and
;; its builtin names only, at least one of pi, e, sin, cos, tan, atan, exp or
;; ln among them, and no constant it takes as a variable.  The walk is over
;; E's subterms (cadt-subterms), not their types, which mapobject would visit
(defun cadc-transcendental? (e)
  (let ((hit nil))
    (and (every #'(lambda (o)
                    (cond ((cadt5-free-name? o) nil)
                          ((name-expr? o)
                           (let ((nm (string (id o))))
                             (when (member nm '("pi" "e" "sin" "cos" "tan" "atan" "exp" "ln") :test #'string=)
                               (setq hit t))
                             (member nm *cadc-ia-names* :test #'string=)))
                          (t t)))
                (cadt-subterms e))
         hit)))

;; is E sin, cos, tan, atan, exp or ln of a term with a constant that
;; interval arithmetic takes as a variable (a T5 term)
(defun cadc-t5-term? (e) (and (cadt5-trans-app? e) (cadt5-has-free? (args1 e))))

;; the hint (cad) gives in a theory without interval_arith's strategies when
;; FNUMS mention such constants, or nil
(defun cadc-hint (fnums)
  (when (no-qualified-name "interval_arith@strategies.IntervalStrategies__")
    (cadstar-terms fnums)
    (let ((cs (loop for a in *cadstar-abs*
                    when (and (null (cadf-step (third a) (first a))) (cadc-transcendental? (third a)))
                    collect (first a)))
          (vs (loop for a in *cadstar-abs* when (cadc-t5-term? (third a)) collect (first a))))
      (cond (cs (format nil "cad: ~{~a~^, ~} ~:[is a constant~;are constants~] that interval arithmetic can enclose between two rationals; with IMPORTING pvs_cad_num (pvs_cad, trans_bounds and NASALib's interval_arith@strategies), (cad) does so when the decision with ~:[it~;them~] as unknown~:*~:[~;s~] does not prove the goal"
                        cs (cdr cs) (cdr cs)))
            (vs (format nil "cad: ~{~a~^, ~} appl~:[ies~;y~] sin, cos, tan, atan, exp or ln to constants of the sequent; with IMPORTING pvs_cad_num (pvs_cad, trans_bounds and NASALib's interval_arith@strategies), (cad) bounds such terms by polynomials (tan excepted) and encloses them over the ranges that the hypotheses give the constants"
                        vs (cdr vs)))))))

;; does (cad) have more to say about the terms of FNUMS than their types:
;; exact facts, polynomial bounds, or enclosures
(defun cadx-applies? (fnums)
  (or (progn (cadstar-terms fnums)
             (some #'(lambda (a) (or (cadf-step (third a) (first a))
                                     (cadf-trans-steps (third a) 0) (cadf-trans-steps (third a) 1)))
                   *cadstar-abs*))
      (cadc-consts fnums)
      (some #'third (cadt5-terms fnums))))

;; the truth of the closed prenex sentence with text STR by evaluation of the
;; decision (cad) uses: :true, :false, or nil (not a sentence it reads, or
;; the certificate did not pass)
(defun cadc-truth (str)
  (let* ((fexpr (ignore-errors (with-no-type-errors (pc-typecheck (pc-parse str 'expr) :expected *boolean*))))
         (pp    (when fexpr (cad-prefix fexpr)))
         (pre   (first pp))
         (body  (second pp)))
    (when (and pre body)
      (setq *mpoly-atoms* (reverse (mapcar #'car pre)) *cad-polys* nil)
      (let* ((phistr (cad-bf body))
             (lists  (when phistr (loop for pr in *cad-polys* collect
                                    (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                      (when v (expr2str v)))))))
        (when (and phistr (= (length *mpoly-atoms*) (length pre)) (notany #'null lists))
          (let* ((fstr  (qe-list-str lists "null[list[mpoly]]"))
                 (osstr (format nil "(: ~{~a~^, ~} :)" (loop for q in pre collect (if (cdr q) "TRUE" "FALSE"))))
                 (v     (evalexpr (format nil "~a(reverse(~a), ~a, ~a)" (cad-dec) osstr fstr phistr) nil nil t))
                 (s     (when v (expr2str v))))
            (cond ((or (null s) (not (search "ok := TRUE" s))) nil)
                  ((search "val := TRUE" s) :true)
                  (t :false))))))))

;; the sequent's formulas LABS (the user's and the enclosures).  When (cad *)
;; reads all of them, G is decided by evaluation first: TRUE (or no answer),
;; (cad LABS) proves it; FALSE, H (the goals among the hypotheses) is
;; decided, and when it is TRUE the verdict is FALSE.  When (cad *) cannot
;; read one of them, (cad LABS) is tried with no verdict.  K, for the
;; messages: the precision in decimals, or a text (T5's piece); QUIET?: no
;; message when it is not decided
(defhelper cadc-decide__ (labs budget k &optional quiet? cad-only?)
  (let ((cs    (cadstar-collect labs))
        (used  (first cs))
        (whole (and used (null (second cs))))
        (tfs   (loop for a in *cadstar-abs* for f = (cadstar-typefact (third a) (second a))
                     when f collect f))
        (gval  (when whole (cadc-truth (cadstar-g used tfs))))
        ;; H: no goal holds where the hypotheses do.  The goals are a
        ;; disjunction, so H is one sentence per goal (that goal among the
        ;; hypotheses, the other goals left out), and the verdict needs every
        ;; one of them TRUE; moving all the goals at once would only show that
        ;; they cannot all hold together
        (ants  (loop for u in used when (< (first u) 0) collect u))
        (goals (loop for u in used when (> (first u) 0) collect u))
        (hval  (when (and whole (eq gval :false) goals
                          (every #'(lambda (g)
                                     (eq (cadc-truth (cadstar-g (append ants (list (cons (- (first g)) (cdr g))))
                                                                tfs))
                                         :true))
                                 goals))
                 :true))
        (dummy (setq *cadc-verdict* (when (eq hval :true) :false)))
        (with  (cond ((numberp k) (format nil " with ~a decimals" k)) ((stringp k) k) (t ""))))
    (if (not (eq gval :false))
        (cad-main__$ labs budget nil cad-only?)
      (if (eq hval :true)
          (printf "cad-num:~a the goal is FALSE wherever the hypotheses hold" with)
        (if quiet? (skip) (printf "cad-num: not decided~a" with)))))
  "[pvs_cad] Internal: cad-num's decision at one precision." "")

;; numerical's enclosure T ## [|lb, ub|] at LAB, made lb <= T AND T <= ub
(defhelper cadc-unhash__ (lab)
  (then (expand "##" lab) (assert lab))
  "[pvs_cad] Internal: an enclosure as two comparisons." "")

;; the enclosure of the term TXT (with numerical's substitutions SUBS) at
;; precision K, labelled EL and made two comparisons.  It fails when
;; numerical adds no enclosure (a constant with no range, an evaluation
;; error), so that no other formula is labelled by its position
(defhelper cadc-enc__ (txt subs k el)
  (let ((n0 (length (extra-get-fnums '-))))
    (then (numerical txt :precision k :subs subs) (cadc-enc-label__$ n0 el)))
  "[pvs_cad] Internal: one enclosure by interval arithmetic." "")

(defhelper cadc-enc-label__ (n0 el)
  (let ((n1 (length (extra-get-fnums '-)))
        (f  (when (> n1 n0) (extra-get-formula -1)))
        (ok (and f (is-function-expr f "##"))))
    (if ok (then (label el -1) (cadc-unhash__$ el)) (fail)))
  "[pvs_cad] Internal: labels the enclosure numerical has just added, or fails." "")

;; the enclosures of the terms KS at precision K, then the decision
(defun cadc-attempt (ks k budget ulab flab &optional cad-only?)
  (let ((elabs (loop for key in ks collect (freshlabel "cce"))))
    `(then ,@(loop for c in ks for el in elabs collect `(cadc-enc__$ ,(first c) ,(second c) ,k ,el))
           (cadc-decide__$ (,ulab ,flab ,@elabs) ,budget ,k nil ,cad-only?))))

(defhelper cadc-try__ (ks precisions budget ulab flab &optional cad-only?)
  (let ((k    (car precisions))
        (rest (cdr precisions))
        (step (when precisions (cadc-attempt ks k budget ulab flab cad-only?))))
    (if (null precisions)
        (printf "cad-num: not decided at the highest precision tried")
      (else (finalize__$ step)
            (if (eq *cadc-verdict* :false)
                (skip)
              (cadc-try__$ ks rest budget ulab flab cad-only?)))))
  "[pvs_cad] Internal: cad-num's refinement." "")

;; after the exact facts: the enclosures and the refinement when there are
;; constants for them, else the decision once
(defhelper cadc-main__ (ulab flab budget precisions &optional cad-only?)
  (let ((ks    (cadc-consts (list ulab flab)))
        (names (format nil "~{~a~^, ~}" (mapcar #'first ks))))
    (if ks
        (then (printf "cad-num: enclosing ~a" names)
              (cadc-try__$ ks precisions budget ulab flab cad-only?))
      (cadc-decide__$ (ulab flab) budget "" nil cad-only?)))
  "[pvs_cad] Internal: cad-num after the exact facts." "")

;;; ------------------------------------------------------------------
;;; Functions of constants (NEXT_PLAN.md T5): the ladder.
;;; cad-num's first rung is the exact facts and the ranges (cadf-loop__),
;;; with T2's enclosures of the constant terms (cadc-main__).  For the terms
;;; with constants (sin(x), exp(x + y)) three more rungs follow, each a
;;; finalize (a rung that fails changes nothing), cheapest first:
;;;   2. trans_bounds's bounds of degree 3, decided;
;;;   3. the terms enclosed by NASALib's (numerical) over the box of
;;;      rational ranges that the hypotheses give the constants (cadt5-box),
;;;      each range first stated as a hypothesis, the form numerical reads;
;;;      where the decision fails, the box halved at the middle of its
;;;      widest range, by a case on the constant (c <= m OR m < c, split: a
;;;      hypothesis, labelled and decided with the rest, so that the FALSE
;;;      test, which moves the goals among the hypotheses, leaves it where
;;;      it is), each half enclosed and decided on its own, up to SPLITS
;;;      halvings deep; a half not proved at the deepest level ends the rung;
;;;   4. the bounds of higher degree (sin to degree 7, cos to 6), decided.
;;; FALSE as in T2: when the goal fails for every value that the bounds,
;;; the enclosures and the hypotheses allow (in a piece: there), cad-num
;;; says so and stops.

;; the hypotheses that the sequent formula E gives (ANTE: an antecedent),
;; for the constants' ranges: E's parts as flatten takes them apart, a
;; consequent's negated
(defun cadt5-hyps (e ante)
  (cond ((and ante (cad-is e "AND")) (append (cadt5-hyps (args1 e) t) (cadt5-hyps (args2 e) t)))
        ((and (not ante) (cad-is e "OR")) (append (cadt5-hyps (args1 e) nil) (cadt5-hyps (args2 e) nil)))
        ((and (not ante) (cad-is e "IMPLIES")) (append (cadt5-hyps (args1 e) t) (cadt5-hyps (args2 e) nil)))
        ((cad-is e "NOT") (cadt5-hyps (args1 e) (not ante)))
        (ante (list e))
        (t (list (make-negation e)))))

;; the rational range of each constant in VARS that the hypotheses bound on
;; both sides (comparisons with numbers, abs(c) <= b, c ## [| a, b |]), as
;; (name lo hi)
(defun cadt5-box (vars)
  (let ((fms (append (loop for f in (extra-get-fnums '-)
                           append (cadt5-hyps (extra-get-formula-from-fnum f) t))
                     (loop for f in (extra-get-fnums '+)
                           append (cadt5-hyps (extra-get-formula-from-fnum f) nil)))))
    (extra-get-var-ranges fms vars)
    (loop for v in vars
          for xv = (gethash v *extra-varranges*)
          when (and xv (xterval-lb xv) (xterval-ub xv) (<= (xterval-lb xv) (xterval-ub xv)))
          collect (list v (xterval-lb xv) (xterval-ub xv)))))

;; the terms of FNUMS that (cad *) abstracts, other than the constants
;; themselves, that have no exact facts and that interval arithmetic
;; evaluates, with the constants they mention, as (text subs vars); nil when
;; the theory does not import interval_arith's strategies
(defun cadt5-terms (fnums)
  (when (and (fboundp 'ia-interval-expr)
             (null (no-qualified-name "interval_arith@strategies4Q.IntervalStrategies4Q__")))
    (cadstar-terms fnums)
    (loop for a in *cadstar-abs*
          for e = (third a)
          for vs = (ignore-errors (ia-get-vars-from-expr e *ia-builtin*))
          when (and (not (cadt5-free-name? e))
                    (null (cadf-step e (first a)))
                    (stringp (ignore-errors (ia-interval-expr e 3 vs *ia-builtin*))))
          collect (list (first a) (cadc-subs (first a)) vs))))

;; a rational as PVS reads it
(defun cadt5-rat (r)
  (if (integerp r) (format nil "~a" r) (format nil "~a/~a" (numerator r) (denominator r))))

;; " for x in [0, 1/2], y in [1, 2]": BOX in words
(defun cadt5-where (box)
  (format nil " for ~{~a~^, ~}"
          (loop for b in box collect
                (format nil "~a in [~a, ~a]" (first b) (cadt5-rat (second b)) (cadt5-rat (third b))))))

;; the constant of BOX with the widest range, and that range's middle; nil
;; when every range is a point
(defun cadt5-widest (box)
  (let ((b (first (sort (copy-list box) #'> :key #'(lambda (b) (- (third b) (second b)))))))
    (when (< (second b) (third b))
      (list (first b) (/ (+ (second b) (third b)) 2)))))

;; BOX with V's range cut at MID: its lower half (LOW?) or its upper half
(defun cadt5-half (box v mid low?)
  (loop for b in box collect
        (cond ((not (string= (first b) v)) b)
              (low? (list v (second b) mid))
              (t (list v mid (third b))))))

;; each range of BOX as two hypotheses labelled RL (numerical reads only
;; top-level ones, and the decisions read RL: the range may come from a
;; hypothesis outside the formulas decided), each proved from the sequent by
;; flatten and assert, else as numerical proves its boxes (abs(c) <= b,
;; c ## [| a, b |]); a range that is not proved is left out
(defun cadt5-range-steps (box rl)
  (loop for b in box append
        (loop for f in (list (format nil "~a <= ~a" (cadt5-rat (second b)) (first b))
                             (format nil "~a <= ~a" (first b) (cadt5-rat (third b))))
              collect `(try (branch (case ,f)
                                    ((label ,rl -1)
                                     (then (else (finalize__$ (then (flatten) (assert))) (vars-sharp__$))
                                           (fail))))
                            (skip)
                            (skip)))))

;; the abstracted terms of the formula FN, as (cad *) reads it
(defun cadt5-keys (fn)
  (cadstar-terms (list fn))
  (mapcar #'first *cadstar-abs*))

;; the formulas of LABS whose unknowns are all among those of the goals
;; (LABS' consequents) and of the formulas CORE, or nil when that leaves
;; none out.  A constant that only the bounds and the ranges tie to the
;; goal stays out with them: exp(x) * exp(y) <= 8 with its two enclosures
;; is decided over two unknowns, not four
(defun cadt5-core (labs core)
  (let* ((fns  (extra-get-fnums labs))
         (keys (remove-duplicates
                (loop for f in (append (remove-if-not #'plusp fns) (extra-get-fnums core))
                      append (cadt5-keys f))
                :test #'string=))
         (sel  (remove-if-not #'(lambda (f) (subsetp (cadt5-keys f) keys :test #'string=)) fns)))
    (when (< (length sel) (length fns)) sel)))

;; a piece's decision: over the goals' part (cadt5-core) first, then over
;; all of LABS; a FALSE from the part holds for the whole, which has more
;; hypotheses
(defhelper cadt5-dec__ (labs core budget where &optional cad-only?)
  (let ((sel (cadt5-core labs core)))
    (if sel
        (else (finalize__$ (cadc-decide__$ sel budget where t cad-only?))
              (if (eq *cadc-verdict* :false) (fail) (cadc-decide__$ labs budget where nil cad-only?)))
      (cadc-decide__$ labs budget where nil cad-only?)))
  "[pvs_cad] Internal: T5's decision of a piece, the goals' part first." "")

;; the enclosures of the terms TS at precision K, each labelled apart, then
;; the decision of the formulas FL, UL, PL and the enclosures (BOX for the
;; messages).  The facts are read first, so that each constant comes next
;; to its terms among the unknowns (x, exp(x), y, exp(y)); in the order x,
;; y, exp(x), exp(y), the decision of exp(x) * exp(y) <= 8 with its bounds
;; of degree 3 took 477 s instead of 13 s
(defun cadt5-attempt (ts box k budget ul fl pl rl &optional cad-only?)
  (let ((elabs (loop for c in ts collect (freshlabel "cte"))))
    `(then ,@(loop for c in ts for el in elabs collect `(cadc-enc__$ ,(first c) ,(second c) ,k ,el))
           (cadt5-dec__$ (,fl ,ul ,rl ,pl ,@elabs) (,pl ,@elabs) ,budget ,(cadt5-where box) ,cad-only?))))

;; one piece BOX: decided with its enclosures, else halved (DEPTH more
;; times at most), the halves' case formulas labelled PL; a FALSE piece,
;; or one not proved at the deepest level, fails the rung
(defhelper cadt5-piece__ (ts box depth k budget ul fl pl rl &optional cad-only?)
  (let ((step (cadt5-attempt ts box k budget ul fl pl rl cad-only?))
        (cut  (when (> depth 0) (cadt5-widest box)))
        (v    (first cut))
        (mid  (second cut))
        (cf   (when cut (format nil "~a <= ~a OR ~a < ~a" v (cadt5-rat mid) (cadt5-rat mid) v)))
        (lo   (when cut (cadt5-half box v mid t)))
        (hi   (when cut (cadt5-half box v mid nil)))
        (d1   (- depth 1))
        (msg  (format nil "cad-num: not proved~a, the smallest piece" (cadt5-where box))))
    (else (finalize__$ step)
          (if (eq *cadc-verdict* :false)
              (fail)
            (if cut
                (branch (case cf)
                        ((branch (split -1)
                                 ((then (label pl -1) (cadt5-piece__$ ts lo d1 k budget ul fl pl rl cad-only?))
                                  (then (label pl -1) (cadt5-piece__$ ts hi d1 k budget ul fl pl rl cad-only?))))
                         (then (flatten) (assert))))
              (then (printf msg) (fail))))))
  "[pvs_cad] Internal: T5's enclosures over a piece of the constants' ranges." "")

;; does E mention a constant that interval arithmetic takes as a variable?
(defun cadt5-has-free? (e) (some #'cadt5-free-name? (cadt-subterms e)))

;; the steps that add the bounds of rung LEVEL (1: degree 3, 2: higher
;; degree) of the terms of UL and FL with constants, labelled FL
(defun cadt5-bound-steps (ul fl level)
  (cadstar-terms (list ul fl))
  (loop for a in *cadstar-abs*
        when (cadt5-has-free? (third a))
        append (loop for st in (cadf-trans-steps (third a) level)
                     collect `(cadf-add__$ ,st ,fl))))

;; rungs 2 to 4, once the first did not prove the formulas UL (the facts
;; labelled FL); each decision reads the facts first (cadt5-attempt).  The
;; constants' ranges come first, as hypotheses labelled RL that every rung
;; reads; rungs 2 and 4 also enclose the constant terms (pi, e, sin(1)),
;; which rung 1's enclosures (rolled back with it) no longer give them
(defhelper cadt5-main__ (ul fl pl budget precisions splits &optional cad-only?)
  (let ((ts0  (cadt5-terms (list ul fl)))
        (vars (remove-duplicates (loop for c in ts0 append (third c)) :test #'string=))
        (box  (when vars (cadt5-box vars)))
        (bvs  (mapcar #'first box))
        (ts   (loop for c in ts0 when (subsetp (third c) bvs :test #'string=) collect c))
        (cts  (loop for c in ts0 unless (third c) collect c))
        (k    (or (car precisions) 3))
        (rl   (freshlabel "ctr"))
        (cl   (freshlabel "ctc"))
        (rngs (cadt5-range-steps box rl))
        (cenc (loop for c in cts collect `(cadc-enc__$ ,(first c) ,(second c) ,k ,cl)))
        (free (set-difference vars bvs :test #'string=))
        (nob  (format nil "cad-num: the hypotheses give no rational range on both sides for ~{~a~^, ~}, so ~:[its~;their~] terms get no enclosure"
                      free (cdr free)))
        (pmsg (format nil "cad-num: enclosing ~{~a~^, ~}~a, halving where the decision fails"
                      (mapcar #'first ts) (cadt5-where box)))
        (pcs  (when (some #'third ts)
                `(then (printf ,pmsg)
                       (cadt5-piece__$ ,ts ,box ,splits ,k ,budget ,ul ,fl ,pl ,rl ,cad-only?))))
        (d3   (cadt5-bound-steps ul fl 1))
        (d7   (cadt5-bound-steps ul fl 2))
        (r4   (if d7
                  `(finalize__$ (then (printf "cad-num: adding the bounds of sin and cos of higher degree")
                                      ,@d7 ,@cenc (cadc-decide__$ (,fl ,ul ,rl ,cl) ,budget "" nil ,cad-only?)))
                '(fail)))
        (r3   (let ((core (if pcs
                              `(else (finalize__$ ,pcs) (if (eq *cadc-verdict* :false) (fail) ,r4))
                            r4)))
                (if free `(then (printf ,nob) ,core) core)))
        (r2   (if d3
                  `(then (printf "cad-num: adding the bounds of degree 3")
                         ,@d3
                         (else (finalize__$ (then ,@cenc (cadc-decide__$ (,fl ,ul ,rl ,cl) ,budget "" nil ,cad-only?)))
                               (if (eq *cadc-verdict* :false) (fail) ,r3)))
                r3))
        (all  (if rngs `(then ,@rngs ,r2) r2)))
    all)
  "[pvs_cad] Internal: T5's rungs after the ranges." "")

;; T2's enclosures, then T5's rungs.  When a term mentions constants of the
;; sequent (sin(x)), only the first precision comes before the rungs: more
;; decimals for pi or e cannot decide what the hypotheses leave free (sin(x)
;; anywhere in [-1, 1]), and each costs a full decision; the other precisions
;; come after the rungs
(defhelper cadn-ladder__ (ul fl pl budget precisions splits &optional cad-only?)
  (let ((t5?   (some #'third (cadt5-terms (list ul fl))))
        (p1    (list (car precisions)))
        (prest (cdr precisions)))
    (if (and t5? prest)
        (else (finalize__$ (cadc-main__$ ul fl budget p1 cad-only?))
              (if (eq *cadc-verdict* :false)
                  (fail)
                (else (finalize__$ (cadt5-main__$ ul fl pl budget precisions splits cad-only?))
                      (if (eq *cadc-verdict* :false)
                          (fail)
                        (cadc-main__$ ul fl budget prest cad-only?)))))
      (else (finalize__$ (cadc-main__$ ul fl budget precisions cad-only?))
            (if (eq *cadc-verdict* :false)
                (fail)
              (cadt5-main__$ ul fl pl budget precisions splits cad-only?)))))
  "[pvs_cad] Internal: cad-num's ladder." "")

(defstep cad-num (&optional (fnums *) (budget 10) (precisions (3 6 10 16 24)) (splits 5) cad-only?)
  (let ((dummy (setq *cadc-verdict* nil *cadf-done* nil)))
    (with-fresh-labels ((!ccu fnums) (!ccf) (!ccp))
      (finalize__$ (then (cadf-loop__$ !ccu !ccf)
                         (cadn-ladder__$ !ccu !ccf !ccp budget precisions splits cad-only?)))))
  "[pvs_cad] Decides the formulas FNUMS (by default all) as (cad *) does, after adding as
hypotheses what pins down their real terms that (cad *) would otherwise leave as unknowns:
for sqrt(t), abs(t), max(a, b), min(a, b) and t / u (u not a number) the exact facts of
cad-facts; for the constants that NASALib's interval arithmetic evaluates (pi, e, sin(1),
ln(2), ...) an enclosure between two rationals, proved by (numerical), the precision rising
through PRECISIONS (decimals) until the sequent is proved, or until the goal is FALSE for
every value in the enclosures (then it says so); when a term mentions constants of the
sequent (sin(x) after skeep), the precisions after the first come after the rungs below.  Terms with constants of the sequent
(NEXT_PLAN.md T5), in rungs, each tried when the one before does not prove the goal:
sin(t), cos(t) and atan(t) get their ranges (-1 <= sin(t) <= 1, ...) with the exact facts;
then sin(t), cos(t), exp(t), ln(t) and atan(t) get trans_bounds's bounds of degree 3 at t
(t - t^3/6 <= sin(t) <= t for t >= 0, 1 + t <= exp(t), ...); then the terms that interval
arithmetic evaluates are enclosed over the box of rational ranges that the hypotheses give
the constants, the box halved where the decision fails, up to SPLITS halvings deep, each
half decided in its own branch; last, sin and cos get bounds of higher degree (7 and 6).
It proves the goal or changes nothing.  The enclosures and the bounds need IMPORTING
pvs_cad_num (pvs_cad, trans_bounds and interval_arith's strategies).  With CAD-ONLY? every
decision is (cad :cad-only? t)'s, through the verified CAD engine alone."
  "Deciding with exact facts and enclosures")

;;; ------------------------------------------------------------------
;;; Terms under binders (TERMS_PLAN.md T4).  sqrt, abs, max, min and
;;; quotients (by a term that is not a number) applied to terms that mention
;;; bound variables: the formula B is read into an equivalent formula A
;;; without them.
;;;   M(sqrt(T))   becomes  FORALL (s: nnreal): s * s = T IMPLIES M(s)
;;;                (true where T >= 0, which is where sqrt(T) is defined)
;;;   M(abs(T))    becomes  (T >= 0 AND M(T)) OR (T < 0 AND M(-T))
;;;   M(max(a, b)) becomes  (a >= b AND M(a)) OR (a < b AND M(b))
;;;   M(min(a, b)) becomes  (a <= b AND M(a)) OR (a > b AND M(b))
;;;   M(T / U)     becomes  FORALL (q: real): q * U = T IMPLIES M(q)
;;;                (true where U /= 0, which is where T / U is defined)
;;; The terms are taken innermost first, a sqrt or a quotient before an abs,
;;; max or min.  A is decided by (cad) (the general route reads it), and B is
;;; proved from A, or A from B, by the mirror walk (cadg-walk) over a tree
;;; whose leaves are :same (identical pieces), :sqrtdef (s instantiated with
;;; sqrt(T), or skolemized and sqrt(T) rewritten to s), :divdef (likewise q
;;; and T / U), :casedef (when the cases hold only abs, max and min: the
;;; definitions expanded and the cases split by ground) and :casesplit (when
;;; a case still holds a sqrt or a quotient, as in sqrt(abs(x)): each case
;;; taken on its own, the term replaced by its value there, and the walk
;;; going on inside).

(defparameter *cadt-count* 0)
(defun cadt-name () (format nil "cadr_~a" (incf *cadt-count*)))

;; the text of the operator OP (sqrt, abs, max, min) in the terms the leaves
;; build: its full name (reals@sqrt.sqrt, real_defs.max), which resolves
;; alone; checking the bare name would typecheck max on its own, which is
;; ambiguous where NASALib is loaded, and PVS reports even a caught type
;; error when the strategy fails
(defun cadt-op-text (op) (expr2str (full-name op)))

;; the side of the walk as the leaves take it: "ab" or "ba" (a keyword as a
;; required argument of a strategy draws a warning)
(defun cadt-dirtxt (dir) (if (eq dir :ab) "ab" "ba"))

;; does the term E mention one of the binding declarations DECLS?  The
;; walks of this block use their own recursion, not mapobject: mapobject
;; keeps one table of the objects it has visited, so a mapobject inside
;; another skips what the outer one has reached (cadstar-mentions? answered
;; NIL on 1 / x there), and a subterm that PVS shares is visited once
(defun cadt-mentions? (e decls)
  (cond ((name-expr? e) (and (member (declaration e) decls) t))
        ((application? e)
         (or (cadt-mentions? (operator e) decls)
             (some #'(lambda (a) (cadt-mentions? a decls)) (arguments e))))
        ((tuple-expr? e) (some #'(lambda (a) (cadt-mentions? a decls)) (exprs e)))
        ((binding-expr? e) (cadt-mentions? (expression e) decls))
        (t nil)))

;; the kind of E when it is sqrt / abs / max / min / a quotient mentioning one
;; of DECLS
(defun cadt-op (e decls)
  (when (and (application? e) decls (cadt-mentions? e decls))
    (cond ((cadf-op? e "sqrt") :sqrt)
          ((cadf-op? e "abs") :abs)
          ((cadf-op? e "max" 2) :max)
          ((cadf-op? e "min" 2) :min)
          ((and (cadf-op? e "/" 2) (not (extra-get-number-from-expr (args2 e) t))) :div))))

;; the subterms of E (applications, tuples, binding bodies), E first
(defun cadt-subterms (e)
  (cons e (cond ((application? e) (mapcan #'cadt-subterms (cons (operator e) (arguments e))))
                ((tuple-expr? e) (mapcan #'cadt-subterms (exprs e)))
                ((binding-expr? e) (cadt-subterms (expression e)))
                (t nil))))

;; does E hold such an application (E itself included)?
(defun cadt-has-op? (e decls)
  (some #'(lambda (o) (cadt-op o decls)) (cadt-subterms e)))

;; an innermost such application in E (none of its arguments holds one), the
;; leftmost sqrt or quotient if there is one, else the leftmost abs, max or
;; min: their cases are then free of sqrt and quotients wherever the order
;; of the terms allows it
(defun cadt-find (e decls)
  (let ((inner (remove-if-not #'(lambda (o)
                                  (and (cadt-op o decls)
                                       (notany #'(lambda (a) (cadt-has-op? a decls)) (arguments o))))
                              (cadt-subterms e))))
    (or (find-if #'(lambda (o) (member (cadt-op o decls) '(:sqrt :div))) inner)
        (first inner))))

;; the text of E with every occurrence of the application U replaced by the
;; text R, or nil when U's text does not occur.  U prints as a function call
;; (sqrt(...), abs(...), max(..., ...)) or, for a quotient, as A / B, which
;; standing alone prints in parentheses; an occurrence of A / B must not
;; continue with ^ (1 / x ^ 2 is 1 / (x ^ 2)) nor follow a *, / or ^
(defun cadt-subst-text (e u r)
  (let* ((et (expr2str e))
         (ut (expr2str u))
         (n  (length ut))
         (ut (if (and (> n 2) (char= (char ut 0) #\() (char= (char ut (1- n)) #\)))
                 (subseq ut 1 (1- n))
               ut))
         (out (make-string-output-stream))
         (start 0) (hit nil))
    (loop for pos = (search ut et :start2 start)
          while pos
          do (let* ((before (string-right-trim " " (subseq et 0 pos)))
                    (after  (string-left-trim " " (subseq et (+ pos (length ut)))))
                    (ok (or (not (search " / " ut))
                            (and (not (and (> (length after) 0) (char= (char after 0) #\^)))
                                 (not (and (> (length before) 0)
                                           (find (char before (1- (length before))) "*/^")))))))
               (write-string et out :start start :end pos)
               (write-string (if ok r ut) out)
               (when ok (setq hit t))
               (setq start (+ pos (length ut)))))
    (write-string et out :start start)
    (when hit (get-output-stream-string out))))

;; does the formula E have such an application under its binders?
(defun cadt-applies? (e &optional decls)
  (cond ((or (forall-expr? e) (exists-expr? e))
         (cadt-applies? (expression e) (append (bindings e) decls)))
        ((and (application? e)
              (some #'(lambda (o) (cad-is e o)) '("AND" "OR" "IMPLIES" "IFF" "NOT")))
         (some #'(lambda (a) (cadt-applies? a decls)) (arguments e)))
        (t (and decls (cadt-has-op? e decls)))))

;; the binders DECLS (innermost first) as PVS binding text, outermost first
(defun cadt-binds-text (decls)
  (format nil "~{~a~^, ~}"
          (loop for d in (reverse decls)
                collect (format nil "~a: ~a" (id d) (expr2str (or (declared-type d) (type d)))))))

;; the atom with text TXT over DECLS and one more variable S of type STYPE
;; (or none), typechecked again: (atom-expr new-decls)
(defun cadt-retype (txt decls &optional s (stype "nnreal"))
  (let* ((binds (cadt-binds-text decls))
         (w (format nil "FORALL (~a~:[~;, ~]~@[~a~]): ~a"
                    binds (and s (not (string= binds ""))) (when s (format nil "~a: ~a" s stype)) txt))
         (we (pc-typecheck (pc-parse w 'expr) :expected *boolean*)))
    (list (expression we) (reverse (bindings we)))))

;; (TEXT TREE) for the atom E over the binders DECLS, or :bad
(defun cadt-atom (e decls)
  (let ((u (cadt-find e decls)))
    (if (null u)
        (list (format nil "(~a)" (expr2str e)) (list :same))
      (case (cadt-op u decls)
        (:sqrt
         (let* ((s  (cadt-name))
                (tx (expr2str (args1 u)))
                (m  (cadt-subst-text e u s))
                (rt (when m (cadt-retype m decls s)))
                (r  (if rt (cadt-atom (first rt) (second rt)) :bad)))
           (if (eq r :bad) :bad
             (list (format nil "(FORALL (~a: nnreal): (~a * ~a = (~a)) IMPLIES ~a)" s s s tx (first r))
                   (list :sqrtdef (second r) (cadt-op-text (operator u)))))))
        ((:abs :max :min)
         (let* ((kind (cadt-op u decls))
                (a  (expr2str (args1 u)))
                (b  (unless (eq kind :abs) (expr2str (args2 u))))
                (m1 (or (cadt-subst-text e u (format nil "(~a)" a)) (return-from cadt-atom :bad)))
                (m2 (or (cadt-subst-text e u (if (eq kind :abs) (format nil "(-(~a))" a) (format nil "(~a)" b)))
                        (return-from cadt-atom :bad)))
                (c1 (case kind (:abs (format nil "(~a) >= 0" a)) (:max (format nil "(~a) >= (~a)" a b))
                          (:min (format nil "(~a) <= (~a)" a b))))
                (c2 (case kind (:abs (format nil "(~a) < 0" a)) (:max (format nil "(~a) < (~a)" a b))
                          (:min (format nil "(~a) > (~a)" a b))))
                (t1 (cadt-retype m1 decls))
                (t2 (cadt-retype m2 decls))
                (r1 (cadt-atom (first t1) (second t1)))
                (r2 (cadt-atom (first t2) (second t2))))
           ;; cases that hold only more abs / max / min (cases inside cases) are
           ;; closed at once (:casedef); else each case is walked (:casesplit)
           (cond ((or (eq r1 :bad) (eq r2 :bad)) :bad)
                 ((and (member (car (second r1)) '(:same :casedef))
                       (member (car (second r2)) '(:same :casedef)))
                  (list (format nil "((~a AND ~a) OR (~a AND ~a))" c1 (first r1) c2 (first r2))
                        (cons :casedef (remove-duplicates
                                        (append (list (string-downcase (symbol-name kind)))
                                                (cdr (second r1)) (cdr (second r2)))
                                        :test #'string=))))
                 (t (list (format nil "((~a AND ~a) OR (~a AND ~a))" c1 (first r1) c2 (first r2))
                          (list :casesplit (string-downcase (symbol-name kind))
                                (cadt-op-text (operator u)) (second r1) (second r2)))))))
        (:div
         (let* ((q  (cadt-name))
                (tx (expr2str (args1 u)))
                (ux (expr2str (args2 u)))
                (m  (cadt-subst-text e u q))
                (rt (when m (cadt-retype m decls q "real")))
                (r  (if rt (cadt-atom (first rt) (second rt)) :bad)))
           (if (eq r :bad) :bad
             (list (format nil "(FORALL (~a: real): (~a * (~a) = (~a)) IMPLIES ~a)" q q ux tx (first r))
                   (list :divdef (second r))))))
        (t :bad)))))

;; (TEXT TREE) for the formula E with the binders DECLS (innermost first)
;; around it, or :bad
(defun cadt-form (e decls)
  (cond
   ((not (cadt-applies? e decls)) (list (format nil "(~a)" (expr2str e)) (list :same)))
   ((or (forall-expr? e) (exists-expr? e))
    (let* ((bs (bindings e))
           (r  (cadt-form (expression e) (append (reverse bs) decls))))
      (if (eq r :bad) :bad
        (list (format nil "(~{~a~}~a)"
                      (loop for b in bs collect
                            (format nil "~a (~a: ~a): " (if (forall-expr? e) "FORALL" "EXISTS") (id b)
                                    (expr2str (or (declared-type b) (type b)))))
                      (first r))
              (list (if (forall-expr? e) :all :ex) bs (loop for b in bs collect (cadg-name))
                    (second r) (loop for b in bs collect nil))))))
   ((and (unary-application? e) (cad-is e "NOT"))
    (let ((r (cadt-form (args1 e) decls)))
      (if (eq r :bad) :bad (list (format nil "(NOT ~a)" (first r)) (list :not (second r))))))
   ((and (not (unary-application? e))
         (find-if #'(lambda (o) (cad-is e o)) '("AND" "OR" "IMPLIES" "IFF")))
    (let* ((op (find-if #'(lambda (o) (cad-is e o)) '("AND" "OR" "IMPLIES" "IFF")))
           (a (cadt-form (args1 e) decls)) (b (cadt-form (args2 e) decls)))
      (if (or (eq a :bad) (eq b :bad)) :bad
        (list (format nil "(~a ~a ~a)" (first a) op (first b))
              (list (cdr (assoc op '(("AND" . :and) ("OR" . :or) ("IMPLIES" . :imp) ("IFF" . :iff))
                                :test #'string=))
                    (second a) (second b))))))
   (t (cadt-atom e decls))))

;; the leaf of a sqrt: DIR "ab" (A, labelled LA, a hypothesis) instantiates
;; s with sqrt(T) (its TCC T >= 0 decided by cadstar-tcc__) and proves the
;; guard by typepred; "ba" (A a goal) skolemizes s and turns sqrt(T) in B (LB)
;; into s: when T occurs in B only inside the sqrt, T is rewritten to s * s
;; by the guard and sqrt(s * s) to s (sqrt_square); otherwise sqrt(T) = s is
;; proved from the guard (sqrt_lem; its TCC T >= 0 from the guard) and
;; replaced.  K is the tree below.
(defhelper cadt-sqrt__ (la lb dir k op)
  (let ((fa  (extra-get-formula la))
        (fb  (extra-get-formula lb))
        (te  (when (and fa (forall-expr? fa)) (args2 (args1 (expression fa)))))
        (tx  (when te (cadstar-key-text te)))
        (sq  (format nil "~a(~a)" op tx))
        (s   (cadt-name))
        ;; T only inside the sqrt in B: T may be rewritten to s * s there
        (once (and te fb (<= (cadt-count-tc te fb) 1)))
        (strat (if (equal dir "ab")
                   `(branch (inst ,la ,sq)
                      ((spread (split ,la :depth 1)
                         (,(cadg-walk k la lb :ab)
                          (then (cadstar-typepred__$ ,sq) (assert))))
                       (cadstar-tcc__$)))
                 (if once
                     `(with-fresh-labels ((!tg) (!ta))
                        (then (skolem ,la (,s)) (flatten-disjunct ,la 1)
                              (relabel (!tg !ta) ,la :pairing? t :push? nil)
                              (replace !tg ,lb :dir rl)
                              (rewrite "sqrt_square" ,lb)
                              ,(cadg-walk k '!ta lb :ba)))
                   `(with-fresh-labels ((!tg) (!ta) (!te))
                      (then (skolem ,la (,s)) (flatten-disjunct ,la 1)
                            (relabel (!tg !ta) ,la :pairing? t :push? nil)
                            (branch (discriminate (case ,(format nil "~a = ~a" sq s)) !te)
                              ((then (replace !te ,lb) (hide !te) ,(cadg-walk k '!ta lb :ba))
                               (branch (rewrite "sqrt_lem" !te)
                                 ((assert) (else (finalize__$ (then (hide-all-but (1 !tg)) (cad-main__$ (1 !tg))))
                                                 (cadstar-tcc__$))))
                               (else (finalize__$ (then (hide-all-but (1 !tg)) (cad-main__$ (1 !tg))))
                                     (cadstar-tcc__$))))))))))
    (if tx strat (skip)))
  "[pvs_cad] Internal: the walk at a sqrt under binders (TERMS_PLAN.md T4)." "")

;; the number of occurrences of T (tc-eq) in E, by its own recursion (mapobject
;; visits a shared object once, and PVS shares the subterms of a formula)
(defun cadt-count-tc (te e)
  (cond ((tc-eq e te) 1)
        ((application? e)
         (+ (cadt-count-tc te (operator e))
            (reduce #'+ (mapcar #'(lambda (a) (cadt-count-tc te a)) (arguments e)))))
        ((tuple-expr? e) (reduce #'+ (mapcar #'(lambda (a) (cadt-count-tc te a)) (exprs e))))
        ((binding-expr? e) (cadt-count-tc te (expression e)))
        (t 0)))

;; the leaf of a quotient T / U: DIR "ab" instantiates q with T / U (the TCC
;; U /= 0 decided by cadstar-tcc__) and proves the guard (T / U) * U = T by
;; div_cancel2; "ba" skolemizes q, proves T / U = q from the guard
;; (div_cancel3) and replaces T / U by q in B.  K is the tree below.
(defhelper cadt-div__ (la lb dir k)
  (let ((fa  (extra-get-formula la))
        (g   (when (and fa (forall-expr? fa)) (args1 (expression fa))))
        (ux  (when g (cadstar-key-text (args2 (args1 g)))))
        (tx  (when g (cadstar-key-text (args2 g))))
        (qd  (format nil "(~a) / (~a)" tx ux))
        (q   (cadt-name))
        (strat (if (equal dir "ab")
                   `(branch (inst ,la ,qd)
                      ((spread (split ,la :depth 1)
                         (,(cadg-walk k la lb :ab)
                          (branch (rewrite "div_cancel2") ((assert) (cadstar-tcc__$)))))
                       (cadstar-tcc__$)))
                 `(with-fresh-labels ((!tg) (!ta) (!te))
                    (then (skolem ,la (,q)) (flatten-disjunct ,la 1)
                          (relabel (!tg !ta) ,la :pairing? t :push? nil)
                          (branch (discriminate (case ,(format nil "~a = ~a" qd q)) !te)
                            ((then (replace !te ,lb) (hide !te) ,(cadg-walk k '!ta lb :ba))
                             (branch (rewrite "div_cancel3" !te) ((assert) (cadstar-tcc__$)))
                             (cadstar-tcc__$))))))))
    (if g strat (skip)))
  "[pvs_cad] Internal: the walk at a quotient under binders (TERMS_PLAN.md T4)." "")

;; the leaf of abs / max / min (K = (:casedef ops)): in B the operators are
;; expanded and their IFs lifted, then ground closes the cases on both sides
(defun cadt-case-leaf (k la lb dir)
  (declare (ignore la dir))
  `(then ,@(loop for op in (cdr k) collect `(expand ,op ,lb))
         (repeat (lift-if ,lb))
         (ground)))

;; the leaf of an abs, max or min whose cases still hold a sqrt or a quotient
;; (K = (:casesplit kind op k1 k2), KIND "abs", "max" or "min", OP the
;; operator's text): A is (C1 AND A1) OR (C2 AND A2), where A1 and A2 read B
;; with the term op(a) or op(a, b) replaced by its value in the case
;; (abs(a) = a where a >= 0, ...).  Each case is taken on its own: the value
;; is proved by expanding the operator under the case's condition, replaced
;; in B (LB), and the walk goes on with K1 or K2.  DIR "ab" splits A (a
;; hypothesis); "ba" cases on C1 and proves the disjunct of A (a goal) that
;; holds.
(defhelper cadt-cases__ (la lb dir kind op k1 k2)
  (let ((fa  (extra-get-formula la))
        (c1  (when (and fa (cad-is fa "OR") (cad-is (args1 fa) "AND")) (args1 (args1 fa))))
        (ax  (when c1 (cadstar-key-text (args1 c1))))
        (bx  (when (and c1 (not (string= kind "abs"))) (cadstar-key-text (args2 c1))))
        (u   (if (string= kind "abs") (format nil "~a(~a)" op ax) (format nil "~a(~a, ~a)" op ax bx)))
        (e1  (format nil "~a = (~a)" u ax))
        (e2  (if (string= kind "abs") (format nil "~a = (-(~a))" u ax) (format nil "~a = (~a)" u bx)))
        (c1x (when c1 (cadstar-key-text c1)))
        ;; the term's value in a case, from the case's condition !c (a
        ;; hypothesis, or a goal when its negation is the case)
        (val `(then (hide-all-but (!eq !c)) (expand ,kind !eq) (repeat (lift-if !eq)) (ground)))
        (strat (if (equal dir "ab")
                   `(with-fresh-labels ((!c) (!a) (!eq))
                      (spread (split ,la :depth 1)
                        ((then (flatten-disjunct ,la 1) (relabel (!c !a) ,la :pairing? t :push? nil)
                               (branch (discriminate (case ,e1) !eq)
                                 ((then (replace !eq ,lb) (hide !eq) ,(cadg-walk k1 '!a lb :ab))
                                  ,val)))
                         (then (flatten-disjunct ,la 1) (relabel (!c !a) ,la :pairing? t :push? nil)
                               (branch (discriminate (case ,e2) !eq)
                                 ((then (replace !eq ,lb) (hide !eq) ,(cadg-walk k2 '!a lb :ab))
                                  ,val))))))
                 `(with-fresh-labels ((!c) (!d1) (!d2) (!eq))
                    (branch (discriminate (case ,c1x) !c)
                      ((then (flatten-disjunct ,la 1) (relabel (!d1 !d2) ,la :pairing? t :push? nil)
                             (hide !d2)
                             (spread (split !d1 :depth 1)
                               ((else (propax) (assert))
                                (branch (discriminate (case ,e1) !eq)
                                  ((then (replace !eq ,lb) (hide !eq) ,(cadg-walk k1 '!d1 lb :ba))
                                   ,val)))))
                       (then (flatten-disjunct ,la 1) (relabel (!d1 !d2) ,la :pairing? t :push? nil)
                             (hide !d1)
                             (spread (split !d2 :depth 1)
                               ((assert)
                                (branch (discriminate (case ,e2) !eq)
                                  ((then (replace !eq ,lb) (hide !eq) ,(cadg-walk k2 '!d2 lb :ba))
                                   ,val)))))))))))
    (if c1 strat (skip)))
  "[pvs_cad] Internal: the walk at an abs, max or min whose cases hold a sqrt or a quotient (TERMS_PLAN.md T4)." "")

;; the reading of the formula E: (TEXT TREE) of the equivalent formula A
;; without such terms, when A typechecks and has none left (else (cad) would
;; come back here), or nil
(defun cadt-reading (e)
  (let* ((r  (ignore-errors (with-no-type-errors (cadt-form e nil))))
         (ax (when (and r (consp r) (stringp (first r)))
               (ignore-errors (with-no-type-errors
                                (pc-typecheck (pc-parse (first r) 'expr) :expected *boolean*))))))
    (when (and ax (not (cadt-applies? ax))) r)))

;; FNUM through its form A without such terms: proved from A as a goal, used
;; to refute it as a hypothesis; A decided by (cad).  Nothing changes when
;; it does not close the goal.
(defhelper cadt__ (fnum &optional (budget 10) complete? cad-only?)
  (let ((fexpr (extra-get-formula fnum))
        (fn    (when fexpr (extra-get-fnum fnum)))
        (ante  (and (integerp fn) (< fn 0)))
        (r     (when fexpr (cadt-reading fexpr)))
        (ok    (and r t))
        (txt   (when ok (first r)))
        (tree  (when ok (second r)))
        (dcd   `(cad !ctn ,budget ,complete? ,cad-only?))
        (strat (when ok
                 `(with-fresh-labels ((!ctb ,fnum) (!ctn))
                    ,(if ante
                         (cad-fact-case txt '!ctn dcd (cadg-walk tree '!ctn '!ctb :ba))
                       (cad-fact-case txt '!ctn (cadg-walk tree '!ctn '!ctb :ab)
                                      `(then (hide !ctb) ,dcd)))))))
    (if strat
        (then (printf "cad: reading ~a as ~a" fexpr txt)
              (else (finalize__$ strat) (cad-unproved__$ fnum)))
      (skip)))
  "[pvs_cad] Internal: a formula with sqrt, abs, max, min or a quotient under its binders (TERMS_PLAN.md T4)." "")

;; the end of a (cad) on one formula whose readings and fallbacks all
;; failed: FNUM stays as it was, labelled cad, as when the decision itself
;; answers FALSE (the attempts ran inside finalize, which also took back the
;; label that a decision inside them gave)
(defhelper cad-unproved__ (fnum)
  (then (label "cad" fnum :push? t)
        (printf "cad: not proved; formula ~a stays as it is, labelled cad" fnum))
  "[pvs_cad] Internal: labels a formula that (cad) did not prove." "")

;; (cad) without what pins its unknowns down; cad-num calls it
(defhelper cad-main__ (&optional (fnum 1) (budget 10) complete? cad-only?)
  (let ((fnum  (cad-default-fnum fnum))
        (multi (cadstar-multi? fnum))
        (fexpr (unless multi (extra-get-formula fnum)))
        (grouped (and fexpr (cadg-grouped-prenex? fexpr)))
        (pp    (when fexpr (cad-prefix fexpr)))
        (pre   (when pp (first pp)))
        (body  (when pp (second pp)))
        (fn    (when fexpr (extra-get-fnum fnum)))
        (plan  (when (and pre body (integerp fn) (not cad-only?) (not (cadg-has-quant? body))
                          (cad-imports? (format nil "cad_~a" (cad-dec))))
                 (cadw-plan fnum fexpr pre body budget (< fn 0))))
        ;; the verified-CAD engine: decide8 (cad_decide8_def) when the theory
        ;; imports cad_decide8, else the read-closure run (decide7)
        (odec  (if (cad-imports? "cad_decide8") "decide8" "decide7")))
    (if multi (cad-seq__$ fnum budget cad-only?)
     (if grouped (cad-nest__$ fnum "main" budget complete? cad-only?)
      (if cad-only? (cad-direct fnum complete? odec)
        ;; a plan (a witness) closes the goal or changes nothing
        (if plan
            (else (finalize__$ plan) (cad-direct fnum complete?))
          (cad-direct fnum complete?))))))
  "[pvs_cad] Internal: (cad) without what pins its unknowns down (cad-num)." "")

;;; Functions of bound variables (NEXT_PLAN.md T5): a formula whose sin,
;;; cos, tan, atan, exp or ln apply to variables that flatten and skolem
;;; constants can free (a goal's FORALL, a hypothesis's EXISTS, also inside
;;; the parts flatten takes apart: (EXISTS x: ...) IMPLIES FALSE) is
;;; flattened and skolemized first, which makes those terms terms of
;;; constants; such terms under other binders are refused.

;; is E an application of NASALib's sin, cos, tan, atan, exp or ln?
(defun cadt5-trans-app? (e)
  (and (application? e) (name-expr? (operator e)) (= (length (arguments e)) 1)
       (member (string (id (operator e))) '("sin" "cos" "tan" "atan" "exp" "ln") :test #'string=)
       (member (string (id (module (declaration (operator e)))))
               '("sincos_def" "trig_basic" "atan" "ln_exp") :test #'string=)))

;; the binding declarations that flatten and skolem constants free in the
;; sequent formula E (ANTE: an antecedent): a goal's FORALL, a
;; hypothesis's EXISTS, through the parts flatten takes apart
(defun cadt5-skdecls (e ante)
  (cond ((and (not ante) (forall-expr? e)) (append (bindings e) (cadt5-skdecls (expression e) nil)))
        ((and ante (exists-expr? e)) (append (bindings e) (cadt5-skdecls (expression e) t)))
        ((and ante (cad-is e "AND")) (append (cadt5-skdecls (args1 e) t) (cadt5-skdecls (args2 e) t)))
        ((and (not ante) (cad-is e "OR")) (append (cadt5-skdecls (args1 e) nil) (cadt5-skdecls (args2 e) nil)))
        ((and (not ante) (cad-is e "IMPLIES")) (append (cadt5-skdecls (args1 e) t) (cadt5-skdecls (args2 e) nil)))
        ((cad-is e "NOT") (cadt5-skdecls (args1 e) (not ante)))
        (t nil)))

;; the formulas labelled LAB flattened and skolemized, until neither changes
;; them
(defhelper cadt5-sk__ (lab)
  (try (then (flatten lab) (skeep* lab :preds? t)) (cadt5-sk__$ lab) (skip))
  "[pvs_cad] Internal: T5's flatten and skolem constants." "")

;; the binding declarations of E's quantifiers along its Boolean structure
;; (connectives and quantifiers, not the terms of its atoms: a set or a
;; LAMBDA inside a term stays in its term, which (cad *) takes whole, as
;; before T5: card({n: below(3) | EXISTS (z: real): sin(z) = n}) >= 0)
(defun cadt5-binders (e)
  (cond ((or (forall-expr? e) (exists-expr? e)) (append (bindings e) (cadt5-binders (expression e))))
        ((or (cad-is e "AND") (cad-is e "OR") (cad-is e "IMPLIES") (cad-is e "IFF"))
         (append (cadt5-binders (args1 e)) (cadt5-binders (args2 e))))
        ((and (unary-application? e) (cad-is e "NOT")) (cadt5-binders (args1 e)))
        (t nil)))

;; the applications of sin, cos, tan, atan, exp and ln in E whose argument
;; mentions one of DECLS
(defun cadt5-bound-apps (e decls)
  (when decls
    (remove-if-not #'(lambda (s) (and (cadt5-trans-app? s) (cadt-mentions? (args1 s) decls)))
                   (cadt-subterms e))))

(defstep cad (&optional (fnum 1) (budget 10) complete? cad-only?)
  (let ((fnum   (cad-default-fnum fnum))
        (multi  (cadstar-multi? fnum))
        (fnums  (if multi fnum (list fnum)))
        (fexpr  (unless multi (extra-get-formula fnum)))
        (t4?    (and fexpr (ignore-errors (cadt-applies? fexpr))))
        ;; such a formula is read first; the decision without the reading
        ;; refuses it (its terms mention bound variables)
        (t4r    (when t4? (ignore-errors (cadt-reading fexpr))))
        (more?  (cadx-applies? fnums))
        (hint   (cadc-hint fnums))
        (tell   (if hint `(printf ,hint) '(skip)))
        ;; T5: the binders that skolem constants free, or a refusal
        (fn     (when fexpr (extra-get-fnum fnum)))
        (skd    (when (and fexpr (integerp fn)) (cadt5-skdecls fexpr (< fn 0))))
        (allb   (when fexpr (cadt5-binders fexpr)))
        (t5r    (cadt5-bound-apps fexpr (set-difference allb skd)))
        (t5s?   (and (null t5r) (cadt5-bound-apps fexpr skd)))
        (rmsg   (when t5r
                  (format nil "cad: formula ~a applies sin, cos, tan, atan, exp or ln to variables bound inside it (~a); (cad) reads such terms with constants only, after skolem constants for a goal's FORALL or a hypothesis's EXISTS"
                          fnum (expr2str (first t5r))))))
    (if t5s?
        (else (finalize__$
               (with-fresh-labels ((!cks fnum))
                 (then (printf "cad: skolem constants for the variables of formula ~a that sin, cos, tan, atan, exp or ln apply to" fnum)
                       (cadt5-sk__$ !cks)
                       (cad (!cks) budget complete? cad-only?))))
              (cad-unproved__$ fnum))
    (if t5r
        (printf rmsg)
    (if t4?
        (if t4r
            (cadt__$ fnum budget complete? cad-only?)
          (printf "cad: formula ~a applies sqrt, abs, max, min or a quotient to terms with bound variables in a form it does not read" fnum))
    (if more?
        (else (finalize__$ (cad-main__$ fnum budget complete? cad-only?))
              (then (printf "cad: not proved with these terms as unknowns; adding what pins them down (cad-num)")
                    (cad-num fnums budget :cad-only? cad-only?)
                    tell
                    (if multi (skip) (cad-unproved__$ fnum))))
      (then (cad-main__$ fnum budget complete? cad-only?) tell))))))
  "[pvs_cad] Decides the closed formula FNUM (a formula number or a label;
by default 1, or -1 when the sequent has no consequent, as for a goal NOT A),
a first-order formula over the reals with polynomial comparisons: in prenex
form Q1 x1: ... Qn xn: PHI it is decided as below; with grouped binders
FORALL (x, y: real) through its nested form; of any other shape --
quantifiers inside NOT / AND / OR / IMPLIES / IFF, binders over posreal,
nnreal, negreal, npreal or nzreal (no other binder types) -- by decide_g
(gform_ok), in a theory that imports pvs_cad (FORMS_PLAN.md).  The
connectives may be written with any of PVS's synonyms (&, =>, <=>, WHEN, the
negation and not-equal signs, ...).  Other real terms that mention no bound
variable (f(c), sqrt(c), length(l)) are unknowns, generalized (FORALL in a
goal, EXISTS in a hypothesis), each with the comparisons with numbers its
type gives up its subtype chain (c > 0 for a posreal c, sqrt(c) >= 0,
n >= 1 for a posnat n, 0 <= i <= 4 for i of type below(5)); a term such as f(x) under a binder for
x is refused.  In the consequent it is
proved when it holds, in the antecedent it closes the goal when it fails;
otherwise it stays, labelled cad, and a message says whether it is TRUE or
FALSE (when what pins its terms down, a reading or skolem constants did not
prove it, the closing message says only that it was not proved).  Before the full
decision (cad-direct) it looks for a witness: a model search when one point
settles the goal, and with three or more quantifiers, when the decision does
not answer within BUDGET seconds (default 10), one existential position of
the goal fixed to a small constant, the smaller sentence decided (BUDGET/2
seconds each, 3 BUDGET in all), the goal closed by instantiation.  With
COMPLETE?, when the certificate does not pass, the complete (exponential)
decision of cad_decide answers instead (COMPLETENESS_PLAN C1).  With
CAD-ONLY? (cad :cad-only? t) the answer comes only from the verified CAD
engine: no witness search and no two-variable fast path; the sentence is
decided by decide8 in a theory that imports cad_decide8, otherwise by
decide7 (cad_decide7_def: decn_o, whose run is a proved CAD (cad_verified),
for two or more quantifiers, the sectors of the line for one), and the
theory must then also import cad_decide7; terms are still read and pinned
down as below, every decision going through that engine.  The formulas the
user gives are named by fresh labels; a position is used only right after a
step that puts a formula there.  The theory must import cad_decide5 and
mpoly_embed; in a theory that also imports cad_decide8 the full decision is
decide8 instead of decide5: for two or more quantifiers decb_u, the walk over
the tower of Collins projections of the checked basis (PROJ_PLAN.md P3) of the
input, the line cut by a smaller bottom-step projection (decc_o, the Collins
run, when its check fails).

(cad *) -- or (cad -), (cad +), (cad (-1 2 3)) -- uses the whole sequent
(those formulas): every formula that is a real quantifier prefix over a
Boolean combination of polynomial comparisons is collected, other real
subterms free of bound variables (constants, sqrt(c), f(a), nat variables)
become unknown reals, with the comparisons their types give, and the
implication from the antecedents to the consequents is decided and, when
TRUE, closes the goal (CADSTAR_PLAN.md).  In a theory that imports pvs_cad
(gform_ok), a selected first-order formula over the reals of any other shape
makes every selected formula be used whole, decided as one sentence by the
general route (FORMS_PLAN.md F5); formulas that are not about the reals are
ignored either way.

Terms (TERMS_PLAN.md T2, T3): when the decision with the real terms as
unknowns does not prove the goal, (cad) adds what pins them down and decides
again (cad-num): for sqrt(t), abs(t), max(a, b), min(a, b) and t / u (u not a
number) the formulas that fix them exactly (sqrt(t) >= 0 and sqrt(t) *
sqrt(t) = t, the definitions of abs, max and min as two cases, (t / u) * u =
t); in a theory that imports pvs_cad_num (pvs_cad and interval_arith's
strategies), for every constant term that NASALib's interval arithmetic
evaluates (pi, e, sin(1), ln(2), atan(1), ...) an enclosure between two
rationals, proved by (numerical), the precision rising until the goal is
proved, or until it is FALSE for every value in the enclosures (then it says
so and changes nothing).  With pvs_cad alone it says which constants it
could have enclosed.  Under a binder (TERMS_PLAN.md T4), sqrt, abs, max,
min and quotients of terms with bound variables are read into an equivalent
formula without them (s * s = T for sqrt(T), with s >= 0; q * U = T for
T / U; two cases for abs, max and min), which is decided, and the formula is
proved from it by the mirror walk.

Functions of constants (NEXT_PLAN.md T5): in a theory that imports pvs_cad_num, sin(t),
cos(t), exp(t), ln(t) and atan(t) with t a term of constants (skolem constants, a theory's
constants) get trans_bounds's polynomial bounds at t (t - t^3/6 <= sin(t) <= t for t >= 0,
1 + t <= exp(t), ln(t) <= t - 1 for t > 0, ...); when they do not prove the goal, the terms
are enclosed by (numerical) over the box of rational ranges that the hypotheses give the
constants, the box halved where the decision fails, and last the bounds of sin and cos of
higher degree are added (cad-num).  A goal FORALL x: ... (a hypothesis EXISTS x: ..., also
inside the parts flatten takes apart) whose x such a function is applied to is flattened and
skolemized first; such terms under other binders are refused."
  "Deciding ~a by cylindrical decision, witness first")

;;; ------------------------------------------------------------------
;;; cad-bench: report what the PROJECTION decision (cad_pdec's pdecidef)
;;; answers on a closed prenex formula, and do NOT claim a proof.
;;;
;;; It reuses cad's formula-to-family translation verbatim -- same fstr,
;;; osstr, phistr -- and osstr is already outermost-first, which is what
;;; pdecide wants (decide2 has to reverse it).  Nothing here touches the
;;; sequent: the projection route's correctness rests on delineability, which
;;; is stated in cad_delin as a PREDICATE and is not yet proved to hold, so
;;; this measures and prints rather than discharging anything.  Use (cad) for
;;; a real proof.
;;; ------------------------------------------------------------------
(defstep cad-bench (&optional (fnum 1))
  (let ((fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (closed (= (length *mpoly-atoms*) (length pre)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (bad    (or (null phistr) (not closed) (some #'null lists)))
        (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
        (osstr  (unless bad (format nil "(: ~{~a~^, ~} :)"
                                    (loop for q in pre collect (if (cdr q) "TRUE" "FALSE")))))
        ;; pdecqf is the HYBRID: sign-vector recursion on the projection
        ;; family, svs_pt where a sector's sample is exactly rational and
        ;; svs_sg (proved, via alg_sign2) where it is algebraic.  It needs no
        ;; rational samples, so there is no ok flag and no silent fallback --
        ;; the only caveat left is delineability.  qs must be INNERMOST-first
        ;; for pdecq, so osstr is reversed here.
        (valv   (unless bad (let ((v (evalexpr (format nil "pdecqf(~a, reverse(~a), ~a)" fstr osstr phistr) nil nil t)))
                              (when v (expr2str v)))))
        (okv    (unless bad (let ((v (evalexpr (format nil "pdecidef(~a, ~a, ~a)`ok" fstr osstr phistr) nil nil t)))
                              (when v (expr2str v)))))
        ;; WHERE does exactness fail?  If the OUTERMOST level's sector
        ;; samples are already irrational, the very first coordinate is
        ;; algebraic and no amount of rational-sample machinery helps -- that
        ;; case needs arithmetic in an algebraic extension.  A number or
        ;; boolean comes back from evalexpr; structured values do not.
        (rat1   (unless bad (let ((v (evalexpr (format nil "allrat(sects(rts(evalF(car(tower(length(~a) - 1, ~a)), null[rat]))))" osstr fstr) nil nil t)))
                              (when v (expr2str v)))))
        (rat1o  (or rat1 "<none>"))
        ;; printf in a defstep evaluates VARIABLES but not function
        ;; applications in its arguments, so the counts are computed here
        (nvars  (length pre))
        (npolys (length lists))
        (okout  (or okv "<none>"))
        (valout (or valv "<none>")))
    (if (or (null pre) (null body))
        (printf "cad-bench: formula ~a is not a closed prenex formula" fnum)
      (if bad
          (printf "cad-bench: the matrix is not a Boolean combination of polynomial sign conditions in the quantified variables")
        (printf "cad-bench: vars=~a polys=~a  hybrid-val=~a  rational-route-ok=~a  outer-level-rational=~a  (projection route, NOT a proof)"
                nvars npolys valout okout rat1o))))
  "[pvs_cad] Reports what the projection decision pdecidef of cad_pdec answers
on the closed prenex formula FNUM, without changing the sequent and without
claiming a proof.  ok = TRUE means every sample point it used was exactly
rational, so no approximation entered; it does NOT mean the answer is proved,
because delineability (cad_delin's delin?) is not yet established.  For a
proof use (cad)."
  "Benchmarking ~a by the projection decision")


;;; ------------------------------------------------------------------
;;; cad-m3: MEASURE the three-quantifier decision decw3 of cad3_def on a
;;; closed prenex formula with exactly three quantifiers.  Prints the value
;;; and the wall-clock time; changes nothing and proves nothing (FINISH_PLAN
;;; S5c: measure before proving).  The theory must import cad3_def.
(defstep cad-m3 (&optional (fnum 1))
  (let ((fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (bad    (or (null phistr) (/= (length pre) 3) (/= (length *mpoly-atoms*) (length pre))
                    (some #'null lists)))
        (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
        (qs     (loop for q in pre collect (if (cdr q) "TRUE" "FALSE")))
        (t0     (get-internal-real-time))
        (valv   (unless bad
                  (let ((v (evalexpr (format nil "decw3(~a, ~a, ~a, ~a, LAMBDA (v: SV): bfsv(~a, v))"
                                             (first qs) (second qs) (third qs) fstr phistr) nil nil t)))
                    (when v (expr2str v)))))
        (secs   (round (- (get-internal-real-time) t0) internal-time-units-per-second))
        (npolys (length lists))
        (valout (or valv "<none>")))
    (if bad
        (printf "cad-m3: not a closed three-quantifier prenex formula over polynomial sign conditions")
      (printf "cad-m3: polys=~a  decw3=~a  ~a s  (a measurement, NOT a proof)" npolys valout secs)))
  "[pvs_cad] Measures the three-quantifier decision decw3 of cad3_def on FNUM (the theory must import cad3_def)."
  "Measuring ~a by the three-quantifier decision")

;;; cad-mn: MEASURE the n-level decision decn_o of towern_od at fuel 0 on a
;;; closed prenex formula (any number of quantifiers >= 2).  Prints the value
;;; and the wall-clock time; changes nothing and proves nothing (FINISH_PLAN
;;; S5e-1: measure before proving).  The theory must import towern_od
;;; (cad_decide5 does).  (cad-mx FNUM "decn_o" U) takes another fuel.
(defstep cad-mn (&optional (fnum 1))
  (let ((fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (bad    (or (null phistr) (< (length pre) 2) (/= (length *mpoly-atoms*) (length pre))
                    (some #'null lists)))
        (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
        (osstr  (format nil "(: ~{~a~^, ~} :)"
                        (loop for q in pre collect (if (cdr q) "TRUE" "FALSE"))))
        (t0     (get-internal-real-time))
        (valv   (unless bad
                  (let ((v (evalexpr (format nil "decn_o(0, ~a, ~a, LAMBDA (v: SV): bfsv(~a, v))"
                                             osstr fstr phistr) nil nil t)))
                    (when v (expr2str v)))))
        (secs   (round (- (get-internal-real-time) t0) internal-time-units-per-second))
        (npolys (length lists))
        (valout (or valv "<none>")))
    (if bad
        (printf "cad-mn: not a closed prenex formula (>= 2 quantifiers) over polynomial sign conditions")
      (printf "cad-mn: polys=~a  decn_o=~a  ~a s  (a measurement, NOT a proof)" npolys valout secs)))
  "[pvs_cad] Measures the n-level decision decn_o of towern_od at fuel 0 on FNUM (the theory must import towern_od)."
  "Measuring ~a by the n-quantifier decision")

;;; cad-time: MEASURE the ground evaluation of an expression: prints its value
;;; and the wall-clock time, giving up after SECS seconds; changes nothing.
(defstep cad-time (expr &optional (secs 300))
  (let ((t0   (get-internal-real-time))
        (r    (cad-eval-timed expr secs))
        (v    (cond ((eq r :timeout) (format nil "<timeout after ~a s>" secs))
                    ((string= r "") "<none>")
                    (t r)))
        (tsec (/ (round (* 100 (- (get-internal-real-time) t0)) internal-time-units-per-second) 100.0))
        (vs   (if (> (length v) 200) (concatenate 'string (subseq v 0 200) " ...") v)))
    (printf "cad-time: ~a s  ~a" tsec vs))
  "[pvs_cad] Evaluates the ground expression EXPR and prints the time and the value (a measurement; changes nothing)."
  "Timing ~a")

(defstep cad-qeshow (&optional (fnum 1))
  (let ((fexpr (extra-get-formula fnum))
        (pr    (when fexpr (cadqe-parse fexpr)))
        (bad   (or (null pr) (getf pr :bad)))
        (nf    (unless bad (length (getf pr :frees))))
        (os    (unless bad (getf pr :osstr)))
        (fs    (unless bad (getf pr :fstr)))
        (ph    (unless bad (getf pr :phistr))))
    (if bad
        (printf "cad-qeshow: not a prenex formula with free variables over polynomial sign conditions")
      (printf "cad-qeshow: m = ~a~%cad-qeshow: os = ~a~%cad-qeshow: F = ~a~%cad-qeshow: phi = ~a"
              nf os fs ph)))
  "[pvs_cad] Prints the number of free variables, the prefix, the family and the matrix of the
formula FNUM as (cad-qe) encodes it; changes nothing."
  "Showing the QE encoding of ~a")

(defstep cad-showf (&optional (fnum 1))
  (let ((fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (fstr   (when (and lists (notany #'null lists)) (qe-list-str lists "null[list[mpoly]]"))))
    (printf "cad-showf: F = ~a~%cad-showf: phi = ~a" fstr phistr))
  "[pvs_cad] Prints the family F and the matrix phi (cad_decide's encoding) of the closed prenex formula FNUM; changes nothing."
  "Showing the family of ~a")

;;; cad-mx: MEASURE a decision function FN (decn_o, decc_o, ...) with fuel U
;;; on a closed prenex formula: prints FN's record and the wall-clock time and
;;; changes nothing (COLLINS_PLAN.md M-I/M-K measurements).
(defstep cad-mx (&optional (fnum 1) (fn "decc_o") (u 0) (secs 120))
  (let ((fexpr  (extra-get-formula fnum))
        (pp     (when fexpr (cad-prefix fexpr)))
        (pre    (when pp (first pp)))
        (body   (when pp (second pp)))
        (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
        (dummy2 (setq *cad-polys* nil))
        (phistr (when (and pre body) (cad-bf body)))
        (lists  (when phistr (loop for pr in *cad-polys* collect
                              (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                (when v (expr2str v))))))
        (bad    (or (null phistr) (< (length pre) 2) (/= (length *mpoly-atoms*) (length pre))
                    (some #'null lists)))
        (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
        (osstr  (format nil "(: ~{~a~^, ~} :)"
                        (loop for q in pre collect (if (cdr q) "TRUE" "FALSE"))))
        (t0     (get-internal-real-time))
        (valv   (unless bad
                  (let ((r (cad-eval-timed (format nil "~a(~a, ~a, ~a, LAMBDA (v: SV): bfsv(~a, v))"
                                                   fn u osstr fstr phistr)
                                           secs)))
                    (cond ((eq r :timeout) (format nil "<timeout after ~a s>" secs))
                          ((string= r "") nil)
                          (t r)))))
        (tsec   (/ (round (* 10 (- (get-internal-real-time) t0)) internal-time-units-per-second) 10.0))
        (npolys (length lists))
        (valout (or valv "<none>")))
    (if bad
        (printf "cad-mx: not a closed prenex formula (>= 2 quantifiers) over polynomial sign conditions")
      (printf "cad-mx: ~a(u=~a) polys=~a  value=~a  ~a s  (a measurement, NOT a proof)" fn u npolys valout tsec)))
  "[pvs_cad] Measures the decision function FN with fuel U on FNUM, giving up after SECS seconds."
  "Measuring ~a with ~a")

;;; ------------------------------------------------------------------
;;; cad-qe: quantifier elimination (GAP_PLAN.md Tier 2; QE_PLAN.md).
;;; (cad-qe FNUM) takes a prenex formula ORIG at FNUM, Q1 x1: ... Qn xn: PHI,
;;; with PHI a Boolean combination of polynomial sign conditions in the xi
;;; and m >= 1 further real terms y1, ..., ym (the free variables), and
;;; replaces it by an equivalent quantifier-free formula TEXT in the yi.  The
;;; answer is computed by qe8 of qe8_def (the Collins run) in a theory that
;;; imports qe8, otherwise by qe of qe_all_def, and printed here; nothing
;;; printed is trusted: the case ORIG IFF TEXT is proved from qe8_correct or
;;; qe_correct (the answer's qfsem at the point (: y1, ..., ym :) IFF fsem of
;;; the formula there), the ground evaluation of the record, and reflection.
;;; The TEXT side unfolds qfsem and uses one proved equation per output
;;; polynomial; the ORIG side is walked against fsem as (cad) does, in the
;;; direction the case on fsem leaves; both close with bddsimp.  The answer
;;; is always quantifier-free (qe8_isqf, qe_isqf).  Grouped binders go through
;;; the nested form (cad-nest__); a formula of any other shape goes to qe_g
;;; of gform_def (cadg-qe__, qe_g_ok) in a theory that imports gform_ok.  The
;;; theory must import qe8 (or qe_all), mpoly_embed and cad_endgame; pvs_cad
;;; imports qe8, mpoly_embed and cad_endgame.  (Names here start with cadqe-: the qe- names belong to
;;; Phase 3's qe-exists.)
;;; ------------------------------------------------------------------

;; field FIELD of an evaluated record expression, as an expression
(defun cadqe-rec-field (rec field)
  (let ((asg (find-if #'(lambda (a) (string= (string (id (caar (arguments a)))) field))
                      (assignments rec))))
    (when asg (expression asg))))

;; the evaluated Fm term FM as text over *mpoly-atoms* (the free variables,
;; innermost first); collects (LIST . POLYTEXT) per output polynomial in
;; *cadqe-polys* and (ATOM . LEAF) per atom in *cadqe-aeqs*
(defvar *cadqe-polys* nil)
(defvar *cadqe-aeqs* nil)

(defun cadqe-num (e)
  (or (extra-get-number-from-expr e t)
      (let ((v (ignore-errors (read-from-string
                                (remove-if #'(lambda (c) (member c '(#\Space #\( #\))))
                                           (expr2str e))))))
        (when (rationalp v) v))))

;; mpoly-term->str with cadqe-num (the record read from the sequent carries
;; rational literals that extra-get-number-from-expr does not read)
(defun cadqe-term->str (term depth)
  (cond ((is-function-expr term "mconst")
         (mpoly-num-str (cadqe-num (args1 term))))
        ((is-function-expr term "mpol")
         (let* ((elems (mpoly-list-elems (args1 term)))
                (var   (nth (1- depth) *mpoly-atoms*))
                (terms nil))
           (loop for c in elems for i from 0 do
             (unless (and (is-function-expr c "mconst") (eql (cadqe-num (args1 c)) 0))
               (push (mpoly-monomial-str (cadqe-term->str c (1+ depth)) (mpoly-const-term? c) var i)
                     terms)))
           (if (null terms) "0" (format nil "~{~a~^ + ~}" (reverse terms)))))
        (t (format nil "~a" term))))

(defun cadqe-fm-text (fm)
  (cond
   ((and (name-expr? fm) (string= (string (id fm)) "ftrue")) "TRUE")
   ((is-function-expr fm "fsg")
    (let* ((p    (args1 fm))
           (s    (cadqe-num (args2 fm)))
           (pstr (cadqe-term->str p 1))
           (lstr (when (is-function-expr p "mpol") (expr2str (args1 p))))
           (atom (cond ((eql s 1) (format nil "~a > 0" pstr))
                       ((eql s -1) (format nil "~a < 0" pstr))
                       (t (format nil "~a = 0" pstr))))
           (leaf (format nil "sign3(~a) = ~a" pstr s)))
      (when lstr
        (pushnew (cons lstr pstr) *cadqe-polys* :test #'equal)
        (pushnew (cons atom leaf) *cadqe-aeqs* :test #'equal))
      (format nil "(~a)" atom)))
   ((is-function-expr fm "fnot")
    (let ((a (args1 fm)))
      (cond ((and (name-expr? a) (string= (string (id a)) "ftrue")) "FALSE")
            ((and (is-function-expr a "fand")
                  (is-function-expr (args1 a) "fnot") (is-function-expr (args2 a) "fnot"))
             (format nil "(~a OR ~a)" (cadqe-fm-text (args1 (args1 a))) (cadqe-fm-text (args1 (args2 a)))))
            (t (format nil "(NOT ~a)" (cadqe-fm-text a))))))
   ((is-function-expr fm "fand")
    (format nil "(~a AND ~a)" (cadqe-fm-text (args1 fm)) (cadqe-fm-text (args2 fm))))
   (t "(unprintable)")))

(defun cadqe-fm-depth (fm)
  (cond ((is-function-expr fm "fnot") (1+ (cadqe-fm-depth (args1 fm))))
        ((is-function-expr fm "fand") (1+ (max (cadqe-fm-depth (args1 fm)) (cadqe-fm-depth (args2 fm)))))
        (t 1)))

;; the TEXT side: after the atom equations of AEQS replace each atom of TEXT
;; in GOAL by its sign leaf, bddsimp closes GOAL
(defun cadqe-text-endgame (goal aeqs)
  (reduce #'(lambda (ae rest)
              `(with-fresh-labels ((!cae))
                 (branch (discriminate (case ,(format nil "(~a) = (~a)" (car ae) (cdr ae))) !cae)
                   ((then (replace !cae ,goal) ,rest)
                    (then (hide-all-but !cae)
                          (rewrite "cadz_s3_pos" !cae) (rewrite "cadz_s3_zero" !cae)
                          (rewrite "cadz_s3_neg" !cae) (iff !cae) (ground))))))
          aeqs :from-end t
          ;; leaves on constant polynomials (sign3(0) = 0, sign3(1) = 1) are
          ;; atoms to bddsimp; what they leave is closed by evaluation
          :initial-value `(then (bddsimp ,goal) (expand "sign3") (assert))))

;; one reflection equation for an answer polynomial L (as its text PSTR, PolyExpr
;; E): meval(mpol(L))(VSTR) = PSTR.  L need not be in normal form (a tower
;; family's coefficients can be unnormalized zeros), so the check is on normal
;; forms, mnorm(mpol(L)) = pnorm(E), and meval_mnorm carries it back.
(defun cadqe-mev (l e pstr vstr rest)
  (let ((mev (format nil "meval(mpol(~a))(~a) = ~a" l vstr pstr))
        (nrm (format nil "mnorm(mpol(~a)) = pnorm(~a)" l e)))
    `(with-fresh-labels ((!cmv))
       (branch (discriminate (case ,mev) !cmv)
         ((then (replace !cmv) ,rest)
          (with-fresh-labels ((!cma) (!cmp))
            (then (hide-all-but !cmv)
                  (branch (discriminate (case ,nrm) !cma)
                    ((then (rewrite "meval_mnorm" !cmv :dir rl) (replace !cma !cmv)
                           (discriminate (lemma "peval_pnorm") !cmp) (inst !cmp ,e ,vstr)
                           (replace !cmp) (mpoly-eq-side__))
                     (then (hide-all-but !cma) (eval-formula !cma)))))))))))

;; the ORIG side: fsem labelled !cfs against the sentence GOAL, as the core of
;; cad-strategy without a completion flag.  TRUTH: GOAL (consequent) from
;; !cfs (antecedent); nil: !cfs (consequent) from GOAL (antecedent).
(defun cadqe-orig-core (goal truth pre depth m mevs aeqs)
  (let* ((con (if truth goal '!cfs)) (ant (if truth '!cfs goal))
         (asr '(assert !cfs))
         (unfold-fsem (loop repeat (1+ (length pre)) append `((expand "fsem" !cfs) ,asr)))
         (unfold-bf (append (loop repeat depth append '((expand "bfeval" !cfs)))
                            (loop repeat (1+ m) append
                              `((expand "nth" !cfs) (expand "length" !cfs) ,asr)))))
    `(then ,asr ,@unfold-fsem
           ,@(loop for q in pre append
               (if (cdr q)
                   `((skolem ,con (,(car q))) (inst ,ant ,(car q)))
                 `((skolem ,ant (,(car q))) (inst ,con ,(car q)))))
           ,@unfold-bf ,@mevs
           (else (finalize__$ ,(cad-endgame-leaves goal aeqs))
                 (then (printf "cad-qe: case-split endgame")
                       (assert) (expand "sign3" !cfs) (repeat (lift-if !cfs)) (ground)
                       (then (lift-if) (ground)) (then (lift-if) (ground)))))))

(defun cadqe-strategy (gl ev fstr osstr phistr nfree fvstr pre depth m mevs aeqs
                       text fact fsemstr origstr qfstr odepth omevs outstr recstr)
  (let ((prove-fact
         `(then
           ;; the answer, as parsed from its printed form (so that every
           ;; formula below is built from the same text): qe1(...)`out is the
           ;; evaluated record's out (EV), and that equals the parsed text by
           ;; a ground evaluation of constants only
           (branch (discriminate (case ,(format nil "(~a)`out = ~a" recstr outstr)) !qr)
             ((then (replace !qr !qb) (hide !qr))
              (then (hide-all-but (!qr ,ev)) (replace ,ev !qr) (eval-formula !qr))))
           (branch (discriminate (case ,(format nil "(~a) IFF ~a" text qfstr)) !qt)
             ((branch (discriminate (case ,(format nil "id(~a)" fsemstr)) !cfs)
                ((then (expand "id" !cfs :assert? none)
                       (branch (discriminate (case ,(format nil "id(~a)" origstr)) !cgo)
                         ((then (expand "id" !cgo :assert? none) (bddsimp (!qe !qb !qt !cfs !cgo)))
                          (then (expand "id" !cgo :assert? none) (hide-all-but (!cgo !cfs))
                                ,(cadqe-orig-core '!cgo t pre depth m mevs aeqs)))))
                 (then (expand "id" !cfs :assert? none)
                       (branch (discriminate (case ,(format nil "id(~a)" origstr)) !cgo)
                         ((then (expand "id" !cgo :assert? none) (hide-all-but (!cgo !cfs))
                                ,(cadqe-orig-core '!cgo nil pre depth m mevs aeqs))
                          (then (expand "id" !cgo :assert? none) (bddsimp (!qe !qb !qt !cfs !cgo))))))))
              (then (hide-all-but !qt) (expand "qfsem" !qt)
                    ,@(loop repeat odepth collect '(expand "fsem" !qt))
                    ,omevs))))))
    `(with-fresh-labels ((!qe) (!qb) (!qc) (!qr) (!qt) (!cfs) (!cgo))
       (branch (discriminate (case ,fact) !qe)
         ((then (replace !qe ,gl) (delete !qe) (delete ,ev)
                (printf "cad-qe: ~a" ,text))
          (then (hide-all-but (!qe ,ev))
                ;; qe_correct's conclusion, proved on its own: after the split
                ;; of the instance the conclusion closes by itself, and the
                ;; hypothesis cons?(os) AND length(pt) = m by evaluation
                (branch (discriminate (case ,(format nil "(~a)`ok AND (qfsem((~a)`out)(~a) IFF ~a)"
                                                     recstr recstr fvstr fsemstr)) !qb)
                  ((then (flatten !qb) ,prove-fact)
                   (then (hide-all-but !qb)
                         (discriminate (lemma ,(format nil "~a_correct" (cad-qe-fn))) !qc)
                         (inst !qc ,fstr ,(format nil "~a" nfree) ,osstr ,phistr ,fvstr)
                         (split !qc)
                         (then (split 1) (assert) (repeat (expand "length" 1)) (assert)))))))))))

;; the formula FEXPR as cad-qe reads it: the prefix, the matrix as a BF, the
;; free terms, the reflection lists and the name of the elimination record
(defun cadqe-parse (fexpr)
  (let* ((pp     (when fexpr (cad-prefix fexpr)))
         (pre    (when pp (first pp)))
         (body   (when pp (second pp)))
         (dummy1 (setq *mpoly-atoms* (reverse (mapcar #'car pre))))
         (dummy2 (setq *cad-polys* nil))
         (phistr (when (and pre body) (cad-bf body)))
         (frees  (nthcdr (length pre) *mpoly-atoms*))
         (lists  (when phistr (loop for pr in *cad-polys* collect
                               (let ((v (evalexpr (format nil "as_list(pnorm(~a))" (car pr)) nil nil t)))
                                 (when v (expr2str v))))))
         (bad    (or (null pre) (null body) (null phistr) (< (length frees) 1) (some #'null lists)))
         (fstr   (unless bad (qe-list-str lists "null[list[mpoly]]")))
         (osstr  (unless bad (format nil "(: ~{~a~^, ~} :)"
                                     (loop for q in pre collect (if (cdr q) "TRUE" "FALSE"))))))
    (declare (ignore dummy1 dummy2))
    (list :pre pre :body body :phistr phistr :frees frees :lists lists :bad bad
          :fstr fstr :osstr osstr
          :recstr (unless bad (format nil "~a(~a, ~a, ~a, ~a)" (cad-qe-fn) (length frees) osstr fstr phistr)))))

(defhelper cad-qe__ (gl ev)
  (let ((fexpr   (extra-get-formula gl))
        (pr      (cadqe-parse fexpr))
        (pre     (getf pr :pre))
        (body    (getf pr :body))
        (frees   (getf pr :frees))
        (lists   (getf pr :lists))
        (fstr    (getf pr :fstr))
        (osstr   (getf pr :osstr))
        (phistr  (getf pr :phistr))
        (recstr  (getf pr :recstr))
        ;; the ORIG side: reflection equations over all atoms, bound first
        (vstr    (mpoly-valuation))
        (mevs    (unless (getf pr :bad)
                   (list (reduce #'(lambda (rest p3) (cad-mev (first p3) (second p3) (third p3) vstr rest))
                                 (reverse (loop for p2 in *cad-polys* for l in lists
                                                collect (list l (car p2) (cdr p2))))
                                 :initial-value '(skip)))))
        (aeqs    (unless (getf pr :bad)
                   (cad-atom-eqs body (loop for l in lists collect
                                        (cdr (nth (position l lists :test #'equal) *cad-polys*))))))
        (depth   (unless (getf pr :bad) (cad-depth body)))
        ;; the answer, read off the evaluated record EV (qe1(...) = VALUE)
        (evf     (extra-get-formula ev))
        (rec     (when (and evf (is-function-expr evf "=")) (args2 evf)))
        (recs    (when rec (expr2str rec)))
        (okqf    (and recs (search "ok := TRUE" recs) (search "qf := TRUE" recs) t))
        (outx    (when okqf (cadqe-rec-field rec "out")))
        (dummy3  (setq *mpoly-atoms* frees))
        (dummy4  (setq *cadqe-polys* nil *cadqe-aeqs* nil))
        (text    (when outx (cadqe-fm-text outx)))
        (fvstr   (mpoly-valuation))
        (outstr  (when outx (expr2str outx)))
        (odepth  (when outx (cadqe-fm-depth outx)))
        ;; the TEXT side: one reflection equation per output polynomial
        (omevs   (when outx
                   (reduce #'(lambda (p2 rest)
                               (let ((e (mpoly-expr-rec (extra-get-expr (cdr p2)))))
                                 (cadqe-mev (car p2) e (cdr p2) fvstr rest)))
                           (reverse *cadqe-polys*) :from-end t
                           :initial-value (cadqe-text-endgame '!qt (reverse *cadqe-aeqs*)))))
        (origstr (when fexpr (expr2str fexpr)))
        (fsemstr (when outx (format nil "fsem(~a, ~a, ~a, ~a)" osstr fstr phistr fvstr)))
        (qfstr   (when outx (format nil "qfsem(~a)(~a)" outstr fvstr)))
        (fact    (when outx (format nil "(~a) IFF ~a" origstr text)))
        (strat   (when outx (cadqe-strategy gl ev fstr osstr phistr (length frees) fvstr pre depth
                                            (length lists) mevs aeqs text fact fsemstr origstr
                                            qfstr odepth omevs outstr recstr)))
        ;; qe and qe8 always answer, quantifier-free (qe_isqf, qe8_isqf), so
        ;; a failure here is a failure to evaluate or to read the record
        (failwhy (cond ((null recs) "the ground evaluation gave no value")
                       ((not okqf) "its ok or qf flag is not TRUE")
                       (t "its answer could not be printed"))))
    (if strat
        strat
      (then (printf "cad-qe: the elimination record could not be read (~a); the formula is unchanged"
                    failwhy)
            (delete ev))))
  "[pvs_cad] Internal: finishes (cad-qe) for the formula labelled GL from the elimination record labelled EV." "")

(defstep cad-qe (&optional (fnum 1))
  (let ((fnum   (cad-default-fnum fnum))
        (fexpr  (extra-get-formula fnum))
        (grouped (and fexpr (cadg-grouped-prenex? fexpr)))
        (pr0    (unless grouped (cadqe-parse fexpr)))
        ;; the proof makes each bound variable a skolem constant of its own
        ;; name; one already declared here, or bound twice, goes to the
        ;; general route, which uses fresh names
        (qnames (when (and pr0 (not (getf pr0 :bad))) (mapcar #'car (getf pr0 :pre))))
        (clash  (when qnames
                  (or (some #'(lambda (nm) (not (is-freevar nm *real*))) qnames)
                      (/= (length qnames) (length (remove-duplicates qnames :test #'string=))))))
        (pr     (if clash (list :bad t) pr0))
        (bad    (getf pr :bad))
        (recstr (getf pr :recstr))
        (gplan  (when (and bad fexpr) (cadg-qe-plan fexpr)))
        (grec   (when gplan (format nil "qe_g(~a, ~a)" (third gplan) (length (second gplan)))))
        (why    (cond ((null fexpr) (format nil "cad-qe: there is no formula ~a" fnum))
                      ;; a closed formula, as the grouped route says too
                      ((let ((tr (ignore-errors (cadg-tree fexpr nil))))
                         (and tr (not (eq tr :bad)) (null (cadg-unknowns tr nil nil))))
                       (format nil "cad-qe: formula ~a has no free real term to keep; (cad) decides it" fnum))
                      ((and clash (not (cad-imports? "gform_ok")))
                       (format nil "cad-qe: formula ~a binds a name already declared here, or one name twice; rename the bound variable, or IMPORTING pvs_cad, whose general route uses fresh names" fnum))
                      ((cad-imports? "gform_ok")
                       (format nil "cad-qe: formula ~a is not a first-order formula over the reals whose atoms compare polynomials with at least one free real term (binders over real, posreal, nnreal, negreal, npreal or nzreal; other real terms must not contain a bound variable)" fnum))
                      ((eq (ignore-errors (cadg-tree fexpr nil)) :bad)
                       (format nil "cad-qe: formula ~a is not a first-order formula over the reals whose atoms compare polynomials (binders over real, posreal, nnreal, negreal, npreal or nzreal; other real terms must not contain a bound variable)" fnum))
                      (t (format nil "cad-qe: formula ~a is not a prenex formula over the reals whose atoms compare polynomials, with one real per quantifier and at least one free real term (formulas of any other shape need IMPORTING pvs_cad)" fnum)))))
    (if grouped (cad-nest__$ fnum "qe")
    (if (and bad gplan (cad-imports? "gform_ok"))
        ;; all or nothing: when the proof of the answer does not close,
        ;; cadg-qe__ fails and the sequent is restored
        (else (with-fresh-labels ((!qg fnum) (!qv))
                (then (discriminate (eval-expr grec) !qv)
                      (cadg-qe__$ !qg !qv)))
              (printf "cad-qe: the proof of the answer did not close; the formula is unchanged"))
    (if bad
        (printf "~a" why)
      (with-fresh-labels ((!qg fnum) (!qv))
        (then (discriminate (eval-expr recstr) !qv)
              (cad-qe__$ !qg !qv)))))))
  "[pvs_cad] Quantifier elimination.  FNUM (by default 1, or -1 when the sequent
has no consequent, as for (cad)) is a formula over one or more real
terms y1, ..., ym (the free variables): prenex, Q1 x1: ... Qn xn: PHI with PHI
a Boolean combination of polynomial sign conditions, or, in a theory that
imports pvs_cad, of any shape (quantifiers inside connectives, binders over
posreal, nnreal, negreal, npreal or nzreal: qe_g of gform_ok, FORMS_PLAN.md);
grouped binders FORALL (x, y: real) go through the nested form with either
import.  It is replaced by an
equivalent quantifier-free formula in the yi, computed by qe8 of qe8_def (the
Collins run, COLLINS_PLAN.md) in a theory that imports qe8, otherwise by qe of
qe_all_def (evaluated once), and proved equivalent from qe8_correct or
qe_correct (qe_g_ok for other shapes), ground evaluation and reflection.
The answer is always quantifier-free, for every m >= 1 free variables
(qe8_complete, qe_complete; qe_g_qf).  The theory must import qe8 (or qe_all), mpoly_embed and
cad_endgame."
  "Eliminating the quantifiers of ~a")

;;; ------------------------------------------------------------------
;;; cring: a complex ring identity, by its real and imaginary parts
;;; (COLLINS_PLAN.md M-B).  NASALib's complex numbers are records, so
;;; assert does not normalize complex products; their components are
;;; real polynomials, which it does.
(defstep cring (&optional (fnum 1))
  (with-fresh-labels ((!crg fnum))
    ;; Re_add1 ... Im_neg1 are AUTO_REWRITE+ in NASALib's complex_types, so
    ;; assert uses them already (and a stop-rewrite here would turn them off
    ;; for the rest of the branch)
    (then (rewrite "complex_ext" !crg)
          (assert !crg)))
  "[pvs_cad] Proves the complex ring identity in FNUM (an equation of
complex expressions built with +, -, *) by comparing real and imaginary
parts."
  "Proving a complex ring identity in ~a by components")

;;; ------------------------------------------------------------------
;;; Formulas as people write them (FORMS_PLAN.md).  A closed formula with
;;; quantifiers anywhere -- grouped binders FORALL (x, y: real), NOT,
;;; AND / OR / IMPLIES / IFF around quantified parts -- is encoded as a Gm
;;; term of gform_def (each atom's two sides as polynomials over the
;;; variables in scope, innermost first; other real terms become unknowns,
;;; generalized outermost: FORALL for a goal, EXISTS for a hypothesis, each
;;; with the comparisons with numbers its type gives, cad-type-guards),
;;; decided by decide_g (gform_ok's decide_g_ok: qelim on the Collins run,
;;; decide8 for sentences), and proved by a MIRROR WALK: gsem unfolded on
;;; the code has the formula's own shape, and the two formulas are taken
;;; apart together, connective by connective -- the strong side skolemized
;;; and the weak side instantiated with the same constant, one side split
;;; and the other flattened, the pieces named by fresh labels (relabel with
;;; pairing).  At a quantifier-free leaf they differ only in their atoms,
;;; meval(pnorm(E))(VS) against the polynomial itself; cadg-leaf__ proves
;;; one equation per atom side there (peval_pnorm, mpoly-eq-side__) and the
;;; leaf closes by propax.
;;; ------------------------------------------------------------------
(defparameter *cadg-count* 0)

(defun cadg-name () (format nil "cadg_~a" (incf *cadg-count*)))
(defun cadg-label () (intern (format nil "!CGL~a" (incf *cadg-count*))))

;; the guard of a binding over a subtype of the reals: its comparison with 0.
;; The types are the prelude's, named with their theories and compared as
;; types (tc-eq), so nnreal, npreal and nzreal (abbreviations) count, and a
;; user's type of the same name does not
(defparameter *cadg-guards*
  '(("real_types.posreal" . ">") ("real_types.nonneg_real" . ">=") ("real_types.negreal" . "<")
    ("real_types.nonpos_real" . "<=") ("reals.nonzero_real" . "/=")))

;; :real for a real binding, its guard's comparison for a binding over
;; posreal, nnreal, negreal, npreal or nzreal, nil otherwise
(defun cadg-guard-of (b)
  (let ((te (type b)))
    (if (tc-eq te *real*) :real
      (loop for (name . op) in *cadg-guards*
            for ty = (ignore-errors (pc-typecheck (pc-parse name 'type-expr)))
            when (and ty (tc-eq te ty)) return op))))

(defparameter *cadg-rels*
  '(("=" . "geq") ("/=" . "gne") ("<" . "glt") ("<=" . "gle") (">" . "ggt") (">=" . "gge")))

;; is E a polynomial in the bound variables DECLS and in real terms free of them?
(defun cadg-poly-ok? (e decls)
  (cond
   ((and (name-expr? e) (member (declaration e) decls)) t)
   ((extra-get-number-from-expr e t) (not (cadstar-mentions? e decls)))
   ((and (unary-application? e) (is-function-expr e "-")) (cadg-poly-ok? (args1 e) decls))
   ((and (not (unary-application? e))
         (or (is-function-expr e "+") (is-function-expr e "-") (is-function-expr e "*")))
    (and (cadg-poly-ok? (args1 e) decls) (cadg-poly-ok? (args2 e) decls)))
   ((is-function-expr e "^")
    (let ((n (extra-get-number-from-expr (args2 e) t)))
      (if (and n (integerp n) (>= n 0)) (cadg-poly-ok? (args1 e) decls)
        (and (cadstar-real-type? (type e)) (not (cadstar-mentions? e decls))))))
   ((is-function-expr e "/")
    (let ((d (extra-get-number-from-expr (args2 e) t)))
      (if (and d (not (zerop d))) (cadg-poly-ok? (args1 e) decls)
        (and (cadstar-real-type? (type e)) (not (cadstar-mentions? e decls))))))
   ((is-function-expr e "sq") (cadg-poly-ok? (args1 e) decls))
   (t (and (cadstar-real-type? (type e)) (not (cadstar-mentions? e decls))))))

;; the unknowns of E (real leaves that are neither bound variables nor numbers),
;; as expressions, appended to ACC in order of first occurrence
(defun cadg-leaves (e decls acc)
  (cond
   ((and (name-expr? e) (member (declaration e) decls)) acc)
   ((extra-get-number-from-expr e t) acc)
   ((and (unary-application? e) (is-function-expr e "-")) (cadg-leaves (args1 e) decls acc))
   ((and (not (unary-application? e))
         (or (is-function-expr e "+") (is-function-expr e "-") (is-function-expr e "*")))
    (cadg-leaves (args2 e) decls (cadg-leaves (args1 e) decls acc)))
   ((and (is-function-expr e "^")
         (let ((n (extra-get-number-from-expr (args2 e) t))) (and n (integerp n) (>= n 0))))
    (cadg-leaves (args1 e) decls acc))
   ((and (is-function-expr e "/")
         (let ((d (extra-get-number-from-expr (args2 e) t))) (and d (not (zerop d)))))
    (cadg-leaves (args1 e) decls acc))
   ((is-function-expr e "sq") (cadg-leaves (args1 e) decls acc))
   ((member (expr2str e) acc :key #'expr2str :test #'string=) acc)
   (t (append acc (list e)))))

;; :true or :false when E compares a term with itself (= <= >= or /= < >), else nil
(defun cadg-refl (e)
  (let ((op (and (application? e) (not (unary-application? e))
                 (find-if #'(lambda (o) (cad-is e o)) '("=" "<=" ">=" "/=" "<" ">")))))
    (when (and op (tc-eq (args1 e) (args2 e))
               (let ((te (type (args1 e))))
                 ;; a number: real, a subtype of it, or numfield, the type of
                 ;; the prelude's arithmetic
                 (or (cadstar-real-type? te) (tc-eq te *number_field*) (tc-eq te *number*))))
      (if (member op '("=" "<=" ">=") :test #'string=) :true :false))))

;; the formula E as a tree: (:atom OP LHS RHS), (:const BOOL), (:not K),
;; (:and K1 K2) (:or ..) (:imp ..) (:iff ..), (:all BINDINGS NAMES K),
;; (:ex BINDINGS NAMES K); NAMES are fresh skolem names; :bad when E is not a
;; first-order formula over the reals with polynomial atoms
(defun cadg-tree (e decls)
  (flet ((bin (kind)
           (let ((a (cadg-tree (args1 e) decls)) (b (cadg-tree (args2 e) decls)))
             (if (or (eq a :bad) (eq b :bad)) :bad (list kind a b)))))
    (cond
     ((or (forall-expr? e) (exists-expr? e))
      (let ((bs (bindings e)))
        (if (every #'cadg-guard-of bs)
            (let ((k (cadg-tree (expression e) (append bs decls))))
              (cond ((eq k :bad) :bad)
                    ;; a quantifier over a body that folds to TRUE or FALSE is
                    ;; that constant (the types bound are all nonempty), as
                    ;; PVS's expand and assert treat it
                    ((eq (car (cadg-simp k)) :const) (cadg-simp k))
                    (t (list (if (forall-expr? e) :all :ex) bs (loop for b in bs collect (cadg-name)) k
                             (loop for b in bs collect (let ((g (cadg-guard-of b))) (unless (eq g :real) g)))))))
          :bad)))
     ((and (not (unary-application? e)) (cad-is e "AND")) (bin :and))
     ((and (not (unary-application? e)) (cad-is e "OR")) (bin :or))
     ((and (not (unary-application? e)) (cad-is e "IMPLIES")) (bin :imp))
     ((and (not (unary-application? e)) (cad-is e "IFF")) (bin :iff))
     ((and (unary-application? e) (cad-is e "NOT"))
      (let ((k (cadg-tree (args1 e) decls))) (if (eq k :bad) :bad (list :not k))))
     ((and (name-expr? e) (string= (string (id e)) "TRUE")) (list :const t))
     ((and (name-expr? e) (string= (string (id e)) "FALSE")) (list :const nil))
     ;; a comparison of a term with itself is a constant (an equation with
     ;; the same two sides PVS's substitution itself makes TRUE)
     ((cadg-refl e) (list :const (eq (cadg-refl e) :true)))
     (t (let ((op (find-if #'(lambda (o) (cad-is e o)) '("=" "/=" "<" "<=" ">" ">="))))
          (if (and op (not (unary-application? e))
                   (cadg-poly-ok? (args1 e) decls) (cadg-poly-ok? (args2 e) decls))
              (list :atom op (args1 e) (args2 e))
            :bad))))))

;; the unknowns of a tree, in order of first occurrence
(defun cadg-unknowns (k decls acc)
  (case (car k)
    (:atom (cadg-leaves (fourth k) decls (cadg-leaves (third k) decls acc)))
    (:const acc)
    (:not (cadg-unknowns (second k) decls acc))
    ((:and :or :imp :iff) (cadg-unknowns (third k) decls (cadg-unknowns (second k) decls acc)))
    ((:all :ex) (cadg-unknowns (fourth k) (append (second k) decls) acc))))

;; E as an mpoly term over SCOPE (names, innermost first) then the unknowns
(defun cadg-poly (e scope unk)
  (setq *mpoly-atoms* (append scope unk))
  (let ((s (mpoly-expr-rec e)))
    (when (= (length *mpoly-atoms*) (+ (length scope) (length unk)))
      (format nil "pnorm(~a)" s))))

;; the Gm term of a tree
(defun cadg-enc (k scope unk)
  (case (car k)
    (:const (if (second k) "gtrue" "gfalse"))
    (:atom (let ((p (cadg-poly (third k) scope unk)) (q (cadg-poly (fourth k) scope unk)))
             (when (and p q)
               (format nil "~a(~a, ~a)" (cdr (assoc (second k) *cadg-rels* :test #'string=)) p q))))
    (:not (let ((a (cadg-enc (second k) scope unk))) (when a (format nil "gnot(~a)" a))))
    ((:and :or :imp :iff)
     (let ((a (cadg-enc (second k) scope unk)) (b (cadg-enc (third k) scope unk)))
       (when (and a b)
         (format nil "~a(~a, ~a)"
                 (cdr (assoc (car k) '((:and . "gand") (:or . "gor") (:imp . "gimp") (:iff . "giff"))))
                 a b))))
    ((:all :ex)
     (let* ((bs (second k))
            (body (cadg-enc (fourth k) (append (reverse (mapcar #'(lambda (b) (string (id b))) bs)) scope) unk)))
       (when body
         (let ((r body))
           (loop for b in (reverse bs) for g in (reverse (fifth k)) do
             (let ((gd (when g (format nil "~a(pnorm(pe_var(1)), pnorm(pe_const(0)))"
                                       (cdr (assoc g *cadg-rels* :test #'string=))))))
               (setq r (cond ((null gd) r)
                             ((eq (car k) :all) (format nil "gimp(~a, ~a)" gd r))
                             (t (format nil "gand(~a, ~a)" gd r))))
               (setq r (format nil "~a(~a)" (if (eq (car k) :all) "gall" "gex") r))))
           r))))))

;; the nesting depth of the Gm term of a tree (gsem unfoldings needed)
(defun cadg-depth (k)
  (case (car k)
    ((:atom :const) 1)
    (:not (1+ (cadg-depth (second k))))
    ((:and :or :imp :iff) (1+ (max (cadg-depth (second k)) (cadg-depth (third k)))))
    ((:all :ex) (+ (length (second k)) (count-if #'identity (fifth k)) (cadg-depth (fourth k))))))

(defun cadg-qf? (k)
  (case (car k)
    ((:atom :const) t)
    (:not (cadg-qf? (second k)))
    ((:and :or :imp :iff) (and (cadg-qf? (second k)) (cadg-qf? (third k))))
    (t nil)))

;; the mirror walk for the tree K: LA labels the unfolded gsem (A), LB the
;; formula (B); DIR :ab when A is a hypothesis and B a goal, :ba the other way
(defun cadg-walk (k la lb dir)
  (cond
   ((eq (car k) :same) '(propax))
   ;; terms under binders (TERMS_PLAN.md T4)
   ((eq (car k) :sqrtdef) `(cadt-sqrt__$ ,la ,lb ,(cadt-dirtxt dir) ,(second k) ,(third k)))
   ((eq (car k) :casedef) (cadt-case-leaf k la lb dir))
   ((eq (car k) :divdef) `(cadt-div__$ ,la ,lb ,(cadt-dirtxt dir) ,(second k)))
   ((eq (car k) :casesplit)
    `(cadt-cases__$ ,la ,lb ,(cadt-dirtxt dir) ,(second k) ,(third k) ,(fourth k) ,(fifth k)))
   ((not (equal (cadg-simp k) k))
    `(then (cadg-unconst__$ ,la) (cadg-unconst__$ ,lb) ,(cadg-walk (cadg-simp k) la lb dir)))
   ;; a leaf: a piece still stored as NOT X (left by expand, rewrite or
   ;; replace) is moved first, so that both pieces have the same shape
   ((cadg-qf? k)
      `(then (repeat (cadg-unnot__$ ,la)) (repeat (cadg-unnot__$ ,lb)) (cadg-leaf__$ ,la ,lb)))
   (t
    (let ((flip (if (eq dir :ab) :ba :ab)))
      (case (car k)
        ((:all :ex)
         (let ((names (third k))
               (strong-b (if (eq (car k) :all) (eq dir :ab) (eq dir :ba))))
           (if strong-b
               `(then (skolem ,lb ,names)
                      ,(cadg-strong-layers k names (fifth k) la lb dir))
             (cadg-weak-layers k names (fifth k) la lb dir))))
        ;; NOT X: PVS has usually moved both pieces already (a goal NOT X is
        ;; shown as the hypothesis X, and inst, skolem, split and flatten
        ;; strip a NOT as they make a piece); only the piece on the
        ;; hypothesis side can still read NOT X (after expand or rewrite), and
        ;; cadg-unnot__ moves it.  Flattening a moved piece would take X
        ;; itself apart one level too early.
        (:not `(then (cadg-unnot__$ ,(if (eq dir :ab) la lb)) ,(cadg-walk (second k) la lb flip)))
        ((:and :or)
         ;; the side where the connective is weak is flattened into two named
         ;; pieces, the other split
         (let* ((p1 (cadg-label)) (p2 (cadg-label))
                (flat-a (if (eq (car k) :and) (eq dir :ab) (eq dir :ba)))
                (flat (if flat-a la lb)) (spl (if flat-a lb la)))
           `(with-fresh-labels ((,p1) (,p2))
              (then (flatten-disjunct ,flat 1) (relabel (,p1 ,p2) ,flat :pairing? t :push? nil)
                    (spread (split ,spl 1)
                      ((then (hide ,p2) ,(if flat-a (cadg-walk (second k) p1 lb dir) (cadg-walk (second k) la p1 dir)))
                       (then (hide ,p1) ,(if flat-a (cadg-walk (third k) p2 lb dir) (cadg-walk (third k) la p2 dir)))))))))
        (:imp
         ;; the goal side is flattened (its premise becomes a hypothesis), the
         ;; hypothesis side split: its conclusion as a hypothesis, its premise
         ;; as a goal (roles swap there)
         (let ((p1 (cadg-label)) (p2 (cadg-label)))
           (if (eq dir :ab)
               `(with-fresh-labels ((,p1) (,p2))
                  (then (flatten-disjunct ,lb 1) (relabel (,p1 ,p2) ,lb :pairing? t :push? nil)
                        (spread (split ,la 1)
                          ((then (hide ,p1) ,(cadg-walk (third k) la p2 :ab))
                           (then (hide ,p2) ,(cadg-walk (second k) la p1 :ba))))))
             `(with-fresh-labels ((,p1) (,p2))
                (then (flatten-disjunct ,la 1) (relabel (,p1 ,p2) ,la :pairing? t :push? nil)
                      (spread (split ,lb 1)
                        ((then (hide ,p1) ,(cadg-walk (third k) p2 lb :ba))
                         (then (hide ,p2) ,(cadg-walk (second k) p1 lb :ab)))))))))
        (:iff
         ;; the hypothesis side is flattened into its two implications, the
         ;; goal side split into them
         (let ((p1 (cadg-label)) (p2 (cadg-label))
               (fwd (list :imp (second k) (third k))) (bwd (list :imp (third k) (second k))))
           (if (eq dir :ab)
               `(with-fresh-labels ((,p1) (,p2))
                  (then (flatten-disjunct ,la 1) (relabel (,p1 ,p2) ,la :pairing? t :push? nil)
                        (spread (split ,lb 1)
                          ((then (hide ,p2) ,(cadg-walk fwd p1 lb :ab))
                           (then (hide ,p1) ,(cadg-walk bwd p2 lb :ab))))))
             `(with-fresh-labels ((,p1) (,p2))
                (then (flatten-disjunct ,lb 1) (relabel (,p1 ,p2) ,lb :pairing? t :push? nil)
                      (spread (split ,la 1)
                        ((then (hide ,p2) ,(cadg-walk fwd la p1 :ba))
                         (then (hide ,p1) ,(cadg-walk bwd la p2 :ba))))))))))))))

;; B's binder is skolemized (all its names at once, done by the caller); A's
;; layers are instantiated one by one, outermost first.  A guarded layer of A
;; reads G IMPLIES rest (FORALL, A a hypothesis) or G AND rest (EXISTS, A a
;; goal): it is split, and G -- the binding's comparison with 0 over meval --
;; is proved from the type of the skolem constant (cadg-guard__, typepred)
(defun cadg-strong-layers (k names guards la lb dir)
  (if (null names) (cadg-walk (fourth k) la lb dir)
    (let ((n (car names)) (g (car guards))
          (rest (cadg-strong-layers k (cdr names) (cdr guards) la lb dir)))
      (cond
       ((null g) `(then (inst ,la ,n) ,rest))
       ((eq (car k) :all)
        `(then (inst ,la ,n)
               (spread (split ,la 1)
                 (,rest
                  (then (cadg-guard__$ ,la ,n) (typepred ,n) (assert))))))
       (t
        `(then (inst ,la ,n)
               (spread (split ,la 1)
                 ((then (cadg-guard__$ ,la ,n) (typepred ,n) (assert))
                  ,rest))))))))

;; A's layers are skolemized one by one, a guarded one flattened into its
;; guard (made a comparison of the constant with 0) and the rest; then B's
;; binder is instantiated with all the names at once, and the TCCs that its
;; subtypes give (n > 0, ...) close by assert on the guards
(defun cadg-weak-layers (k names guards la lb dir &optional done)
  (if (null names)
      `(branch (inst ,lb ,@(reverse done)) (,(cadg-walk (fourth k) la lb dir) (assert)))
    (let ((n (car names)) (g (car guards)))
      (if (null g)
          `(then (skolem ,la (,n))
                 ,(cadg-weak-layers k (cdr names) (cdr guards) la lb dir (cons n done)))
        (let ((pg (cadg-label)) (pr (cadg-label)))
          `(with-fresh-labels ((,pg) (,pr))
             (then (skolem ,la (,n)) (flatten-disjunct ,la 1)
                   (relabel (,pg ,pr) ,la :pairing? t :push? nil)
                   (cadg-guard__$ ,pg ,n)
                   ,(cadg-weak-layers k (cdr names) (cdr guards) pr lb dir (cons n done)))))))))

;; the guard at LAB, meval(pnorm(pe_var(1)))(VS) OP meval(pnorm(pe_const(C)))(VS),
;; rewritten to N OP C
(defhelper cadg-guard__ (lab n &optional (c "0"))
  (let ((fa (extra-get-formula lab))
        (strat (when (and fa (application? fa) (not (unary-application? fa)))
                 `(then ,(or (cadg-leaf-eq (cons (args1 fa) (format nil "~a" n)) lab) '(skip))
                        ,(or (cadg-leaf-eq (cons (args2 fa) (format nil "~a" c)) lab) '(skip))))))
    (if strat strat (skip)))
  "[pvs_cad] Internal: a guard as a comparison of a constant or term with C." "")

;; at a NOT node of the walk: the piece labelled LAB is flattened only when it
;; is a hypothesis that still reads NOT X (it becomes the goal X)
(defhelper cadg-unnot__ (lab)
  (let ((fn (extra-get-fnum lab))
        (f  (extra-get-formula lab))
        (strat (if (and (integerp fn) (< fn 0) f (negation? f))
                   `(flatten-disjunct ,lab 1)
                 '(skip))))
    strat)
  "[pvs_cad] Internal: the NOT step of the mirror walk." "")

;; the unknowns' layers of A (labelled LA), outermost first (UNK, GUARDS given
;; outermost first): each instantiated with its term; a guarded layer is then
;; split, and its guard -- the term's comparison with a constant, over meval --
;; proved from the term's type (cadg-guard__, typepred); REST continues
(defun cadg-unk-steps (unk guards la dir rest)
  (if (null unk) rest
    (let* ((u (expr2str (car unk)))
           (more (cadg-unk-steps (cdr unk) (cdr guards) la dir rest)))
      ;; re-typechecking the term can raise a TCC its theory leaves to its
      ;; own obligations (is_finite(S) for card(S)): on that subgoal the
      ;; original formula is still there, and its type (nat) settles it
      `(branch (inst ,la ,u) (,(cadg-guard-steps u (car guards) la dir more)
                               (then (flatten) (assert)))))))

;; the guards GDS of the unknown U, outermost first: each split off and proved
;; from U's type (cadg-guard__, typepred, assert); REST continues
(defun cadg-guard-steps (u gds la dir rest)
  (if (null gds) rest
    (let ((more (cadg-guard-steps u (cdr gds) la dir rest))
          (prove `(then (cadg-guard__$ ,la ,u ,(cdr (car gds))) (typepred ,u) (assert))))
      (if (eq dir :ab)
          `(spread (split ,la 1) (,more ,prove))
        `(spread (split ,la 1) (,prove ,more))))))

;; the pairs (A-term . B-term) of a quantifier-free leaf: A's atoms compare
;; meval(pnorm(E))(VS) terms, B's the polynomials themselves
(defun cadg-leaf-pairs (a b acc)
  (cond
   ((and (or (and (cad-is a "AND") (cad-is b "AND"))
             (and (cad-is a "OR") (cad-is b "OR"))
             (and (cad-is a "IMPLIES") (cad-is b "IMPLIES"))
             (and (cad-is a "IFF") (cad-is b "IFF")))
         (not (unary-application? a)) (not (unary-application? b)))
    (cadg-leaf-pairs (args2 a) (args2 b) (cadg-leaf-pairs (args1 a) (args1 b) acc)))
   ((and (unary-application? a) (cad-is a "NOT")
         (unary-application? b) (cad-is b "NOT"))
    (cadg-leaf-pairs (args1 a) (args1 b) acc))
   ((and (application? a) (application? b) (not (unary-application? a)) (not (unary-application? b))
         (find-if #'(lambda (o) (and (cad-is a o) (cad-is b o)))
                  '("=" "/=" "<" "<=" ">" ">=")))
    (let ((acc1 (cons (cons (args1 a) (args1 b)) acc)))
      (cons (cons (args2 a) (args2 b)) acc1)))
   (t acc)))

;; one equation meval(pnorm(E))(VS) = B-term, replaced in LA
(defun cadg-leaf-eq (pr la)
  (let* ((at (car pr)) (bt (if (stringp (cdr pr)) (cdr pr) (expr2str (cdr pr))))
         (pn (when (application? at) (operator at)))
         (pe (when (and pn (application? pn)) (argument pn)))
         (e  (when (and pe (application? pe)) (argument pe)))
         (vs (when (application? at) (argument at))))
    (when (and e vs)
      (let* ((vss (let ((v (expr2str vs))) (if (string= v "null") "null[real]" v)))
             (eq  (format nil "meval(pnorm(~a))(~a) = ~a" (expr2str e) vss bt)))
        `(with-fresh-labels ((!cgq) (!cgp))
           ,(cad-fact-case eq '!cgq
              `(then (replace !cgq ,la) (hide !cgq))
              `(then (hide-all-but !cgq)
                     (discriminate (lemma "peval_pnorm" ("e" ,(expr2str e) "xs" ,vss)) !cgp)
                     (replace !cgp !cgq) (hide !cgp)
                     (mpoly-eq-side__))))))))

(defhelper cadg-leaf__ (la lb)
  (let ((fa (extra-get-formula la))
        (fb (extra-get-formula lb))
        (prs (when (and fa fb) (reverse (cadg-leaf-pairs fa fb nil))))
        (seen nil)
        (eqs (loop for pr in prs
                   for key = (expr2str (car pr))
                   unless (member key seen :test #'string=)
                   do (push key seen)
                   and collect (cadg-leaf-eq pr la)))
        (strat `(then ,@(remove nil eqs)
                      (try (propax) (skip)
                           (then (bddsimp) (assert) (try (expand "sq") (assert) (skip)))))))
    strat)
  "[pvs_cad] Internal: closes a quantifier-free leaf of the mirror walk." "")

;; ---- grouped binders in a prenex formula ----------------------------------
;; FORALL (x, y: real): EXISTS (z: real): PHI is decided as its nested form
;; FORALL (x: real): FORALL (y: real): EXISTS (z: real): PHI by the fast route
;; (witness search, decide8); the two are proved equivalent by the mirror
;; walk with the matrix shared (:same).

;; a prenex formula over real binders, some binding several variables, whose
;; matrix has no quantifier
(defun cadg-grouped-prenex? (e)
  (let ((grouped nil) (ok t))
    (loop while (or (forall-expr? e) (exists-expr? e)) do
      (unless (every #'(lambda (b) (tc-eq (type b) *real*)) (bindings e)) (setq ok nil))
      (when (> (length (bindings e)) 1) (setq grouped t))
      (setq e (expression e)))
    (and ok grouped
         (let ((quant nil))
           (mapobject #'(lambda (o) (or quant (when (or (forall-expr? o) (exists-expr? o)) (setq quant t))))
                      e)
           (not quant)))))

;; the nested form of E as text: one quantifier per variable
(defun cadg-nest-str (e)
  (let ((parts nil))
    (loop while (or (forall-expr? e) (exists-expr? e)) do
      (dolist (b (bindings e))
        (push (format nil "~a (~a: real): " (if (forall-expr? e) "FORALL" "EXISTS") (id b)) parts))
      (setq e (expression e)))
    (format nil "~{~a~}(~a)" (reverse parts) (expr2str e))))

;; the walk tree of E's prefix over a shared matrix
(defun cadg-nest-tree (e)
  (if (or (forall-expr? e) (exists-expr? e))
      (list (if (forall-expr? e) :all :ex) (bindings e)
            (loop for b in (bindings e) collect (cadg-name))
            (cadg-nest-tree (expression e))
            (loop for b in (bindings e) collect nil))
    (list :same)))

;; FNUM (a grouped prenex formula) through its nested form: proved from it
;; as a goal, or used to prove it as a hypothesis; the nested form is decided
;; by (cad) when KIND is "cad", by cad-main__ when "main", replaced by its
;; quantifier elimination when "qe", decided by (cad-direct) otherwise
;; ("direct").  It is first checked that the
;; nested form can be handled (polynomial atoms; other real terms only with
;; gform_ok for (cad) and (cad-direct), at least one for (cad-qe)), else
;; nothing changes.  For (cad) and (cad-direct), when the decision does not close the goal
;; (a FALSE goal, a TRUE hypothesis), the sequent is restored and the
;; formula itself is labelled cad.
(defhelper cad-nest__ (fnum kind &optional (budget 10) complete? cad-only? dec)
  (let ((fexpr (extra-get-formula fnum))
        (fn    (when fexpr (extra-get-fnum fnum)))
        (ante  (and (integerp fn) (< fn 0)))
        (tree0 (when fexpr (ignore-errors (cadg-tree fexpr nil))))
        (poly? (and tree0 (not (eq tree0 :bad))))
        (unk   (when poly? (cadg-unknowns tree0 nil nil)))
        (qe?   (equal kind "qe"))
        (who   (if qe? "cad-qe" "cad"))
        (why   (cond ((null fexpr) (format nil "~a: there is no formula ~a" who fnum))
                     ((not poly?)
                      (format nil "~a: formula ~a is not a first-order formula over the reals whose atoms compare polynomials" who fnum))
                     ((and qe? (null unk))
                      (format nil "cad-qe: formula ~a has no free real term to keep; (cad) decides it" fnum))
                     ((and unk (not qe?) (not (cad-imports? "gform_ok")))
                      (format nil "cad: formula ~a has real terms other than its quantified variables; they are generalized as unknowns only in a theory that imports pvs_cad (or gform_ok)" fnum))
                     (t nil)))
        (nstr  (unless why (cadg-nest-str fexpr)))
        (tree  (unless why (cadg-nest-tree fexpr)))
        (dcd   (cond ((equal kind "cad") `(cad !cnn ,budget ,complete? ,cad-only?))
                     ;; from cad-main__: the nested form without the fallbacks,
                     ;; which the (cad) around it runs once
                     ((equal kind "main") `(cad-main__$ !cnn ,budget ,complete? ,cad-only?))
                     (qe? '(then (hide !cnb) (cad-qe !cnn)))
                     (t `(cad-direct !cnn ,complete? ,dec))))
        (strat (unless why
                 `(with-fresh-labels ((!cnb ,fnum) (!cnn))
                    ,(if ante
                         (cad-fact-case nstr '!cnn dcd (cadg-walk tree '!cnn '!cnb :ba))
                       (cad-fact-case nstr '!cnn (cadg-walk tree '!cnn '!cnb :ab)
                                      `(then (hide !cnb) ,dcd)))))))
    (if why (printf "~a" why)
      (if qe? strat
        (else (finalize__$ strat) (label "cad" fnum :push? t)))))
  "[pvs_cad] Internal: a prenex formula with grouped binders, through its nested
form (FORMS_PLAN.md)." "")

;; ---- TRUE / FALSE beside a quantified part ----------------------------------
;; PVS's flatten and split drop a TRUE hypothesis or FALSE goal and close a goal
;; with a FALSE hypothesis or TRUE goal, and its substitution (skolem, inst,
;; expand) simplifies TRUE / FALSE away beside AND, OR, IMPLIES and NOT and makes
;; an equation with two equal sides TRUE, so the mirror walk could not pair the
;; pieces.  The tree therefore counts a comparison of a term with itself, and a
;; quantifier over a constant, as that constant (cadg-tree).  When the walk
;; reaches a node with a constant, the node is at the top of both formulas (the
;; binders above it are skolemized or instantiated by then -- PVS does not
;; rewrite an instance holding a bound variable), and the constants are taken
;; away there in both formulas and, by the same rules (cadg-simp), in the
;; walk's tree: first by rewriting with gform_ok's gb_* lemmas ((TRUE AND b) =
;; b, (b IMPLIES FALSE) = NOT b, ...) to a fixpoint, then, for what those
;; cannot reach (a connective written with a synonym, a comparison of a term
;; with itself), by replacing the formula with its simplified text
;; (cadg-unconst2__), proved equal to it by propositional reasoning and assert.
(defparameter *cadg-bool-lemmas*
  '("gb_and_tl" "gb_and_tr" "gb_and_fl" "gb_and_fr" "gb_or_tl" "gb_or_tr" "gb_or_fl" "gb_or_fr"
    "gb_imp_tl" "gb_imp_tr" "gb_imp_fl" "gb_imp_fr" "gb_iff_tl" "gb_iff_tr" "gb_iff_fl" "gb_iff_fr"
    "gb_not_t" "gb_not_f"))

;; the propositional layer of the tree K (down to its quantifiers) with the
;; constants simplified away, as the gb_* lemmas do
(defun cadg-simp (k)
  (flet ((c? (x v) (and (eq (car x) :const) (eq (and (second x) t) v))))
    (case (car k)
      (:not (let ((a (cadg-simp (second k))))
              (cond ((c? a t) (list :const nil)) ((c? a nil) (list :const t)) (t (list :not a)))))
      ((:and :or :imp :iff)
       (let ((a (cadg-simp (second k))) (b (cadg-simp (third k))))
         (case (car k)
           (:and (cond ((c? a t) b) ((c? b t) a) ((c? a nil) a) ((c? b nil) b) (t (list :and a b))))
           (:or  (cond ((c? a t) a) ((c? b t) b) ((c? a nil) b) ((c? b nil) a) (t (list :or a b))))
           (:imp (cond ((c? a t) b) ((c? b t) b) ((c? a nil) (list :const t)) ((c? b nil) (list :not a))
                       (t (list :imp a b))))
           (:iff (cond ((c? a t) b) ((c? b t) a) ((c? a nil) (list :not b)) ((c? b nil) (list :not a))
                       (t (list :iff a b)))))))
      (t k))))

;; the propositional layer of the formula E (down to its quantifiers and
;; atoms) with the constants simplified away by the rules of cadg-simp, a
;; comparison of a term with itself and a quantifier over a constant counting
;; as constants (cadg-refl, as in cadg-tree): (STRING . CHANGED?), STRING the
;; text of the result with keyword connectives, CHANGED? whether anything was
;; simplified
(defun cadg-simp-expr (e)
  (labels
      ((const (x) (cond ((eq x :true) t) ((eq x :false) nil) (t :no)))
       (txt (x) (cond ((eq x :true) "TRUE") ((eq x :false) "FALSE") (t x)))
       (simp1 (e)
         ;; :true, :false, or (TEXT . CHANGED?)
         (cond
          ((and (name-expr? e) (string= (string (id e)) "TRUE")) :true)
          ((and (name-expr? e) (string= (string (id e)) "FALSE")) :false)
          ((cadg-refl e) (cadg-refl e))
          ;; a quantifier whose body simplifies to a constant is that constant
          ((or (forall-expr? e) (exists-expr? e))
           (let ((r (simp1 (expression e))))
             (if (consp r) (cons (format nil "(~a)" (expr2str e)) nil) r)))
          ((and (cad-is e "NOT") (not (or (forall-expr? e) (exists-expr? e))))
           (let ((a (simp1 (args1 e))))
             (case (const a)
               ((t) :false) ((nil) :true)
               (t (cons (format nil "(NOT ~a)" (car a)) (cdr a))))))
          ((and (not (unary-application? e))
                (some #'(lambda (o) (cad-is e o)) '("AND" "OR" "IMPLIES" "IFF")))
           (let* ((op (find-if #'(lambda (o) (cad-is e o)) '("AND" "OR" "IMPLIES" "IFF")))
                  (a (simp1 (args1 e))) (b (simp1 (args2 e)))
                  (ca (const a)) (cb (const b))
                  (bin (cons (format nil "(~a ~a ~a)" (txt (if (consp a) (car a) a)) op
                                     (txt (if (consp b) (car b) b)))
                             (or (and (consp a) (cdr a)) (and (consp b) (cdr b)))))
                  (r (cond
                      ((string= op "AND") (cond ((eq ca t) b) ((eq cb t) a) ((null ca) :false) ((null cb) :false) (t bin)))
                      ((string= op "OR") (cond ((eq ca t) :true) ((eq cb t) :true) ((null ca) b) ((null cb) a) (t bin)))
                      ((string= op "IMPLIES") (cond ((eq ca t) b) ((eq cb t) :true) ((null ca) :true)
                                                    ((null cb) (cons (format nil "(NOT ~a)" (car a)) t)) (t bin)))
                      (t (cond ((eq ca t) b) ((eq cb t) a)
                               ((null ca) (if (consp b) (cons (format nil "(NOT ~a)" (car b)) t) (if (eq b :true) :false :true)))
                               ((null cb) (if (consp a) (cons (format nil "(NOT ~a)" (car a)) t) (if (eq a :true) :false :true)))
                               (t bin))))))
             (if (eq r bin) r (if (consp r) (cons (car r) t) r))))
          (t (cons (format nil "(~a)" (expr2str e)) nil)))))
    (let ((r (simp1 e)))
      (if (consp r) r (cons (txt r) t)))))

(defhelper cadg-unconst__ (fnum)
  (let ((strat `(then (repeat (then ,@(loop for l in *cadg-bool-lemmas* collect `(rewrite ,l ,fnum))))
                      (cadg-unconst2__$ ,fnum))))
    strat)
  "[pvs_cad] Internal: rewrites TRUE and FALSE away beside quantified parts." "")

;; what the gb_* lemmas cannot rewrite -- a constant beside a connective
;; written with a synonym (<=>, &, ...), an equation with the same two sides --
;; is removed by replacing the formula at FNUM with its simplified text
;; (cadg-simp-expr), proved equal to it by propositional reasoning
(defhelper cadg-unconst2__ (fnum)
  (let ((f     (extra-get-formula fnum))
        (sc    (when f (cadg-simp-expr f)))
        (strat (if (or (null sc) (not (cdr sc))) '(skip)
                 `(with-fresh-labels ((!cuq))
                    (branch (discriminate (case ,(format nil "(~a) = (~a)" (expr2str f) (car sc))) !cuq)
                      ((then (replace !cuq ,fnum) (hide !cuq))
                       (then (hide-all-but !cuq) (iff !cuq) (bddsimp) (assert))))))))
    strat)
  "[pvs_cad] Internal: removes the constants rewriting cannot reach." "")

;; does E contain a quantifier?
(defun cadg-has-quant? (e)
  (let ((q nil))
    (mapobject #'(lambda (o) (or q (when (or (forall-expr? o) (exists-expr? o)) (setq q t)))) e)
    q))

;; the formula (cad) decides by default: 1, or -1 when the sequent has no
;; consequent -- PVS keeps a goal NOT A as the hypothesis A
(defun cad-default-fnum (fnum)
  (if (and (eql fnum 1) (null (extra-get-formula 1)) (extra-get-formula -1)) -1 fnum))

;; (TREE UNKNOWNS GSTR DEPTH GUARDS) for a formula FEXPR, or nil: the
;; unknowns are generalized outermost, FORALL for a goal and EXISTS for a
;; hypothesis (ANTE), each with the comparisons with numbers its type gives
;; (cad-type-guards: c > 0 for a posreal constant c, sqrt(c) >= 0, i >= 0 and
;; i <= 4 for a below(5) term i, ...) as premises (goal) or conjuncts
;; (hypothesis), as (cad *) does; GUARDS lists them per unknown
(defun cadg-plan (fexpr ante)
  (let ((tree (cadg-tree fexpr nil)))
    (unless (eq tree :bad)
      (let* ((unk (cadg-unknowns tree nil nil))
             (guards (mapcar #'(lambda (u) (cad-type-guards (type u))) unk))
             (body (cadg-enc tree nil (mapcar #'expr2str unk))))
        (when body
          (let ((g body))
            (loop for gds in guards do
              (dolist (gd (reverse gds))
                (setq g (format nil "~a(~a(pnorm(pe_var(1)), pnorm(pe_const(~a))), ~a)"
                                (if ante "gand" "gimp")
                                (cdr (assoc (car gd) *cadg-rels* :test #'string=)) (cdr gd) g)))
              (setq g (format nil "~a(~a)" (if ante "gex" "gall") g)))
            (list tree unk g (+ (cadg-depth tree) (length unk) (reduce #'+ (mapcar #'length guards)))
                  guards)))))))

(defhelper cadg-finish__ (gb ge ante)
  (let ((fexpr  (extra-get-formula gb))
        (plan   (when fexpr (cadg-plan fexpr ante)))
        (tree   (first plan))
        (unk    (second plan))
        (gstr   (third plan))
        (depth  (or (fourth plan) 0))
        (guards (fifth plan))
        ;; the record reads decide_g(G) = TRUE or = FALSE; anything else
        ;; (nothing, when the ground evaluation failed) is not an answer
        (evf    (extra-get-formula ge))
        (val    (when (and evf (is-function-expr evf "=")) (expr2str (args2 evf))))
        (truth  (equal val "TRUE"))
        (dir    (if ante :ba :ab))
        (unfold (loop repeat depth collect '(expand "gsem" !cga)))
        (walk   (when plan (cadg-unk-steps (reverse unk) (reverse guards) '!cga dir
                                           (cadg-walk tree '!cga gb dir))))
        (strat
         (cond
          ((null plan) '(printf "cad: the formula changed"))
          ((not (member val '("TRUE" "FALSE") :test #'equal))
           `(then (printf "cad: the value of decide_g could not be read (the ground evaluation gave no answer); the formula is unchanged")
                  ,@(when evf `((delete ,ge)))))
          ;; the proof is all or nothing: when the walk does not close it, the
          ;; sequent is restored (finalize) and the formula stays, labelled cad
          ((and (not ante) truth)
           `(else (finalize__$
                   (with-fresh-labels ((!cga))
                     (then (discriminate (lemma "decide_g_ok" ("g" ,gstr)) !cga)
                           (replace ,ge !cga) (hide ,ge) (assert !cga)
                           ,@unfold ,walk)))
                  ;; with unknown terms, (cad *) on the formula alone: it never
                  ;; writes a term back into a case formula, so a term whose
                  ;; TCCs its theory leaves open (card(S)) does not stop it
                  (else (finalize__$ ,(if unk `(then (delete ,ge) (cad-seq__$ (,gb) 10)) '(fail)))
                        (then (printf "cad: decide_g says the formula is TRUE, but the proof did not close; it stays as it is, labelled cad")
                              (delete ,ge) (label "cad" ,gb :push? t)))))
          ((and ante (not truth))
           `(else (finalize__$
                   (with-fresh-labels ((!cga))
                     (then (discriminate (lemma "decide_g_ok" ("g" ,gstr)) !cga)
                           (replace ,ge !cga) (hide ,ge) (assert !cga) (flatten !cga)
                           ,@unfold ,walk)))
                  (else (finalize__$ ,(if unk `(then (delete ,ge) (cad-seq__$ (,gb) 10)) '(fail)))
                        (then (printf "cad: decide_g says the hypothesis is FALSE, but the proof did not close; it stays as it is, labelled cad")
                              (delete ,ge) (label "cad" ,gb :push? t)))))
          (t `(then (printf "cad: the ~a is ~a~a; it stays as it is, labelled cad"
                            ,(if ante "hypothesis" "formula")
                            ,(if truth "TRUE" "FALSE")
                            ,(if unk " for some values of its other real terms (unknowns, each with only the comparisons with numbers that its type gives, e.g. c > 0 for a posreal c)" ""))
                    (delete ,ge) (label "cad" ,gb :push? t))))))
    strat)
  "[pvs_cad] Internal: finishes the general route of (cad) from the decision ~
record GE of the formula GB." "")

(defhelper cadg__ (fnum)
  (let ((fexpr (extra-get-formula fnum))
        (fn    (when fexpr (extra-get-fnum fnum)))
        (ante  (and (integerp fn) (< fn 0)))
        (plan  (when fexpr (cadg-plan fexpr ante)))
        (rec   (when plan (format nil "decide_g(~a)" (third plan)))))
    (if (null plan)
        (printf "cad: formula ~a is not a first-order formula over the reals whose atoms compare polynomials (binders over real, posreal, nnreal, negreal, npreal or nzreal; other real terms must not contain a bound variable)" fnum)
      (with-fresh-labels ((!cgb fnum) (!cge))
        (then (discriminate (eval-expr rec) !cge)
              (cadg-finish__$ !cgb !cge ante)))))
  "[pvs_cad] Internal: the general route of (cad) -- a formula of any shape,
decided by decide_g and proved by the mirror walk (FORMS_PLAN.md)." "")

;; ---- (cad *) with formulas of any shape -----------------------------------------
;; the text of the first-order formula E with its bound variables renamed
;; (BV: bind-decl -> name, fresh cadb_N names) and its unknown real terms
;; abstracted (cadstar-abstract); nil when E is not usable
(defun cadg-text (e bv)
  (flet ((bin (op) (let ((a (cadg-text (args1 e) bv)) (b (cadg-text (args2 e) bv)))
                     (when (and a b) (format nil "(~a ~a ~a)" a op b)))))
    (cond
     ((or (forall-expr? e) (exists-expr? e))
      (let ((names nil) (bad nil) (bv2 bv))
        (dolist (b (bindings e))
          (let ((g (cadg-guard-of b)))
            (if (null g) (setq bad t)
              (let ((nm (format nil "cadb_~a" (incf *cadstar-count*))))
                (push (format nil "~a: ~a" nm (if (eq g :real) "real"
                                                 (car (rassoc g *cadg-guards* :test #'string=))))
                      names)
                (push (cons b nm) bv2)))))
        (unless bad
          (let ((body (cadg-text (expression e) bv2)))
            (when body
              (format nil "(~a (~{~a~^, ~}): ~a)" (if (forall-expr? e) "FORALL" "EXISTS")
                      (reverse names) body))))))
     ((and (not (unary-application? e)) (cad-is e "AND")) (bin "AND"))
     ((and (not (unary-application? e)) (cad-is e "OR")) (bin "OR"))
     ((and (not (unary-application? e)) (cad-is e "IMPLIES")) (bin "IMPLIES"))
     ((and (not (unary-application? e)) (cad-is e "IFF")) (bin "IFF"))
     ((and (unary-application? e) (cad-is e "NOT"))
      (let ((a (cadg-text (args1 e) bv))) (when a (format nil "(NOT ~a)" a))))
     ((and (name-expr? e) (member (string (id e)) '("TRUE" "FALSE") :test #'string=))
      (string (id e)))
     (t (let ((op (find-if #'(lambda (o) (cad-is e o)) '("=" "/=" "<" "<=" ">" ">="))))
          (when (and op (not (unary-application? e)))
            (let ((a (cadstar-term (args1 e) bv)) (b (cadstar-term (args2 e) bv)))
              (when (and a b) (format nil "(~a ~a ~a)" a op b)))))))))

;; is the formula F usable by the general route (a first-order formula over the reals)?
(defun cadg-usable? (f) (and f (not (eq (ignore-errors (cadg-tree f nil)) :bad))
                             (ignore-errors (cadg-tree f nil))))

;; (cad *) when a selected formula is not prenex (or binds a variable over
;; posreal, nnreal, negreal, npreal or nzreal): the sentence FORALL (unknowns): (type facts AND antecedents) IMPLIES
;; (consequents), every formula kept whole, decided by (cad) (the general
;; route); the sequent follows from it by instantiation and propositional logic
(defhelper cadg-seq__ (fnums budget &optional cad-only?)
  (let ((dummy  (setq *cadstar-abs* nil *cadstar-count* 0))
        ;; the unknowns a formula abstracted are dropped again when the
        ;; formula is skipped, as cadstar-collect does
        (items  (loop for fn in (extra-get-fnums fnums)
                      for f = (extra-get-formula-from-fnum fn)
                      collect (let* ((saved *cadstar-abs*)
                                     (txt (when f (ignore-errors (cadg-text f nil)))))
                                (unless txt (setq *cadstar-abs* saved))
                                (list fn txt))))
        (ants   (loop for it in items when (and (second it) (< (first it) 0)) collect (second it)))
        (cnss   (loop for it in items when (and (second it) (> (first it) 0)) collect (second it)))
        (skip   (loop for it in items unless (second it) collect (first it)))
        (tfs    (loop for a in *cadstar-abs* for f = (cadstar-typefact (third a) (second a))
                      when f collect f))
        (unk    (mapcar #'second *cadstar-abs*))
        (terms  (mapcar #'first *cadstar-abs*))
        (hyp    (when (or tfs ants) (format nil "~{~a~^ AND ~}" (append tfs ants))))
        (con    (when cnss (format nil "~{~a~^ OR ~}" cnss)))
        (matrix (cond ((and hyp con) (format nil "(~a) IMPLIES (~a)" hyp con))
                      (con (format nil "(~a)" con))
                      (t (format nil "NOT (~a)" hyp))))
        (sstr   (if unk (format nil "FORALL (~{~a~^, ~}: real): ~a" unk matrix) matrix))
        (gl     (freshlabel "cadsg"))
        (use    `(then ,@(when unk `((inst ,gl ,@terms)))
                       ,@(loop for a in *cadstar-abs*
                               when (cadstar-typefact (third a) (second a))
                               collect `(cadstar-typepred__$ ,(first a)))
                       (prop) (assert)))
        (step   (cad-fact-case sstr gl use `(cad ,gl ,budget nil ,cad-only?)))
        (skips  (if skip (format nil "~{~a~^, ~}" skip) "nothing")))
    (if (null (or ants cnss))
        (printf "cad*: no formula of the sequent is a first-order formula over the reals")
      (then (printf "cad*: skipping ~a; deciding ~a" skips sstr)
            (else (finalize__$ step)
                  (printf "cad*: not proved; the sequent is unchanged")))))
  "[pvs_cad] Internal: (cad *) with formulas of any shape (FORMS_PLAN.md)." "")

;; ---- (cad-qe) on a formula of any shape --------------------------------------
;; (TREE UNKNOWNS GSTR DEPTH): the free real terms are the point's coordinates
(defun cadg-qe-plan (fexpr)
  (let ((tree (cadg-tree fexpr nil)))
    (unless (eq tree :bad)
      (let* ((unk (cadg-unknowns tree nil nil))
             (g (cadg-enc tree nil (mapcar #'expr2str unk))))
        (when (and g unk) (list tree unk g (cadg-depth tree)))))))

;; the formula GL is replaced by the quantifier-free answer qe_g(G, m) = OUT
;; read off EV.  The fact (GL) IFF TEXT is proved from qe_g_ok (qfsem(OUT)(PT)
;; IFF gsem(G)(PT)), the text side of (cad-qe) (TEXT IFF qfsem(OUT)(PT)) and
;; gsem(G)(PT) IFF GL, by the mirror walk in each direction
(defhelper cadg-qe__ (gl ev)
  (let ((fexpr  (extra-get-formula gl))
        (plan   (when fexpr (cadg-qe-plan fexpr)))
        (tree   (first plan))
        (unk    (second plan))
        (gstr   (third plan))
        (depth  (or (fourth plan) 0))
        (evf    (extra-get-formula ev))
        (outx   (when (and plan evf (is-function-expr evf "=")) (args2 evf)))
        (dummy1 (setq *mpoly-atoms* (mapcar #'expr2str unk)))
        (dummy2 (setq *cadqe-polys* nil *cadqe-aeqs* nil))
        (text   (when outx (cadqe-fm-text outx)))
        (pts    (mpoly-valuation))
        (outstr (when outx (expr2str outx)))
        (odepth (when outx (cadqe-fm-depth outx)))
        (omevs  (when outx
                  (reduce #'(lambda (p2 rest)
                              (let ((e (mpoly-expr-rec (extra-get-expr (cdr p2)))))
                                (cadqe-mev (car p2) e (cdr p2) pts rest)))
                          (reverse *cadqe-polys*) :from-end t
                          :initial-value (cadqe-text-endgame '!qt (reverse *cadqe-aeqs*)))))
        (origstr (when fexpr (expr2str fexpr)))
        (gsemstr (format nil "gsem(~a)(~a)" gstr pts))
        (qestr   (format nil "qe_g(~a, ~a)" gstr (length unk)))
        (strat
         (when text
           `(with-fresh-labels ((!qe) (!qb) (!qt) (!qg) (!qx) (!qy) (!qc))
              (branch (discriminate (case ,(format nil "(~a) IFF ~a" origstr text)) !qe)
                ((then (replace !qe ,gl) (delete !qe) (delete ,ev) (printf "cad-qe: ~a" ,text))
                 (else
                  (finalize__$
                 (then
                  (hide-all-but (!qe ,ev))
                  (branch (discriminate (case ,(format nil "qfsem(~a)(~a) IFF ~a" qestr pts gsemstr)) !qb)
                    ((then
                      (replace ,ev !qb) (hide ,ev)
                      (branch (discriminate (case ,(format nil "(~a) IFF qfsem(~a)(~a)" text outstr pts)) !qt)
                        ((branch (discriminate (case ,(format nil "~a IFF (~a)" gsemstr origstr)) !qg)
                           ((bddsimp (!qe !qb !qt !qg))
                            (then (hide-all-but !qg)
                                  (spread (split !qg 1)
                                    ((then (flatten-disjunct !qg 1) (relabel (!qx !qy) !qg :pairing? t :push? nil)
                                           ,@(loop repeat depth collect '(expand "gsem" !qx))
                                           ,(cadg-walk tree '!qx '!qy :ab))
                                     (then (flatten-disjunct !qg 1) (relabel (!qy !qx) !qg :pairing? t :push? nil)
                                           ,@(loop repeat depth collect '(expand "gsem" !qx))
                                           ,(cadg-walk tree '!qx '!qy :ba)))))))
                         (then (hide-all-but !qt) (expand "qfsem" !qt)
                               ,@(loop repeat odepth collect '(expand "fsem" !qt))
                               ,omevs))))
                     (then (hide-all-but !qb) (expand "qfsem" !qb)
                           (discriminate (lemma "qe_g_ok" ("g" ,gstr "m" ,(format nil "~a" (length unk)) "pt" ,pts)) !qc)
                           (split !qc)
                           (then (split 1) (assert) (repeat (expand "length" 1)) (assert)))))))
                  (fail))))))))
    (if strat strat
      (then (printf "cad-qe: the answer could not be read") (delete ev))))
  "[pvs_cad] Internal: (cad-qe) on a formula of any shape (FORMS_PLAN.md)." "")
