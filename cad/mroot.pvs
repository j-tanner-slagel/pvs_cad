mroot: THEORY
%----------------------------------------------------------------------------
% The section of a gap moves continuously, every coordinate moving
% (FINISH_PLAN 3i, stage N4).
%
% root_cont proved this along one coordinate, with the family's reads
% invariant on a set S.  Here the point vs1 is anywhere near vs0 = (x0, xs)
% and its oracle agrees with vs0's on the walk's intrinsic reads.  The count
% argument is unchanged: the member g that owns the root (own_root), rational
% ends a < beta0 < b within eta that avoid g's chain (ends_exist), the count
% of g between them is one at vs0 (cnt_one_gap) and stays one near vs0
% (cnt_mlocal: the chain is read off the intrinsic reads, its entries at a
% and b are nonzero at vs0 and keep their signs, msg_mpers); so g has a root
% in (a, b] at vs1, it is a root of the product in the gap, hence THE root.
% root_cont's lemmas are used at the one-point set {x0}.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpar, root_cont

  G: VAR list[list[mpoly]]
  g: VAR list[mpoly]
  x0, beta, beta0: VAR real
  xs, vs1: VAR list[real]
  a, b, lo, hi: VAR rat
  d, eta: VAR posreal

  %% the one-point set, where root_cont's hypotheses hold trivially
  pt1(x0): [real -> bool] = LAMBDA (x: real): x = x0
  lev_pt1: LEMMA cert?(G, msg(cons(x0, xs))) AND cons?(lives(G)) IMPLIES lev?(G, pt1(x0), x0, xs, x0)

  cs: VAR list[list[mpoly]]
  f: VAR list[mpoly]
  y: VAR rat
  Y: VAR list[rat]
  vs0: VAR list[real]
  %% an entry read nonzero at vs0 by avoidance, agreeing at vs1: the chain member is nonzero at vs1
  ents_nz_near: LEMMA av?(cs, vs0, y) AND member(f, cs) AND cons?(f) AND member(y, Y)
    AND agree(msg(vs0), msg(vs1), ents_rd(cs, Y))
    IMPLIES meval(mpol(f))(cons(y, vs1)) /= 0

  cnt_mlocal: LEMMA member(g, G) AND length(strip(g)) >= 2 AND a < b
    AND av?(schain(bk(G), msg(cons(x0, xs)), strip(g)), cons(x0, xs), a)
    AND av?(schain(bk(G), msg(cons(x0, xs)), strip(g)), cons(x0, xs), b)
    IMPLIES EXISTS d: FORALL vs1: near?(vs1, cons(x0, xs), d)
      AND agree(msg(cons(x0, xs)), msg(vs1), wi_rd(G, msg(cons(x0, xs))))
      IMPLIES cnt(bk(G), msg(vs1), strip(g), a, b) = cnt(bk(G), msg(cons(x0, xs)), strip(g), a, b)
        AND meval(mpol(strip(g)))(cons(a, vs1)) /= 0 AND meval(mpol(strip(g)))(cons(b, vs1)) /= 0

  mroot_near: THEOREM cert?(G, msg(cons(x0, xs))) AND cons?(lives(G))
    AND gapf?(G, cons(x0, xs), lo, hi, beta0)
    IMPLIES EXISTS d: FORALL vs1, beta: near?(vs1, cons(x0, xs), d)
      AND agree(msg(cons(x0, xs)), msg(vs1), wi_rd(G, msg(cons(x0, xs))))
      AND gapf?(G, vs1, lo, hi, beta)
      IMPLIES abs(beta - beta0) < eta
END mroot
