runT_def: THEORY
%----------------------------------------------------------------------------
% The n-level run from a GIVEN initial tower T0 (QE_PLAN.md section 11,
% 2C).  Executable.
%
% decn_o builds its initial tower as tw0(k, F), the projections of F; its
% certificate and everything proved from it use T0 only through
% length(T0) = k and tlast(T0) = F (tw0_shape).  These are decn_o's parts
% with T0 as an argument: the outer family runqT, its sectors runsectsT,
% each sector's closed tower runtwT, the certificate runokT (decn_o's `ok),
% and the records cad_outT (cad_out's).  At T0 = tw0(k, F) they are
% runq, runsects, runtw, decn_o's `ok and cad_out.  QE starts from a tower
% whose free families are closed under the formal derivative.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_out

  u: VAR nat
  T0: VAR Tower
  F: VAR list[list[mpoly]]
  s: VAR Sect

  runqT(u, T0): list[list[mpoly]] = nclos_o(u, cfuel + u, T0, proj(topf(T0)))
  runsectsT(u, T0): list[Sect] = sects(rts(runqT(u, T0)))
  runtwT(u, T0)(s): Tower = lvln_o(u, T0, s)
  runokT(u, T0): bool =
    gaps_ok(rts(runqT(u, T0))) AND every(scok?(u))(map(LAMBDA (s: Sect): scof(u, T0, s))(runsectsT(u, T0)))
  cad_outT(u, T0, F): list[ORec] =
    olflat(map(LAMBDA (s: Sect): srecs(u, F, s, runtwT(u, T0)(s)))(runsectsT(u, T0)))
END runT_def
