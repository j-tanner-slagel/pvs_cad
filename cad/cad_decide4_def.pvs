cad_decide4_def: THEORY
%----------------------------------------------------------------------------
% The decision (cad) ran until N10, executable part: the fast route for TWO quantifiers
% (decw, through decq3) and for THREE (decw3), with decide2 as the fallback
% whenever a fast certificate does not come back TRUE, and for every other
% number of quantifiers.  qs is innermost first, as everywhere below decide.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide3_def, cad3_def

  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  decq4(qs, F, Psi): [# ok: bool, val: bool #] =
    IF length(qs) = 3 THEN
      LET d = decw3(car(cdr(cdr(qs))), car(cdr(qs)), car(qs), F, Psi) IN
      IF d`ok THEN d ELSE decq2(qs, F, Psi) ENDIF
    ELSE decq3(qs, F, Psi)
    ENDIF

  decide4(qs, F, phi): [# ok: bool, val: bool #] = decq4(qs, F, LAMBDA (v: SV): bfsv(phi, v))

  %% which route answered, for reports
  fast3?(qs, F, phi): bool =
    length(qs) = 3 AND
    decw3(car(cdr(cdr(qs))), car(cdr(qs)), car(qs), F, LAMBDA (v: SV): bfsv(phi, v))`ok
END cad_decide4_def
