decc_u: THEORY
%----------------------------------------------------------------------------
% The escalating Collins decision is correct and always answers
% (COLLINS_PLAN.md M-I), as decide_u for decn_u: by measure induction on
% the distance to the bound from which the certificate holds.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_u_def

  u: VAR nat
  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]

  decc_u_correct: THEOREM decc_u(qs, F, Psi, u)`ok IMPLIES
    (decc_u(qs, F, Psi, u)`val IFF sem(qs, F, Psi, null[real]))
  decc_u_complete: THEOREM cons?(qs) AND cons?(cdr(qs)) IMPLIES decc_u(qs, F, Psi, u)`ok
END decc_u
