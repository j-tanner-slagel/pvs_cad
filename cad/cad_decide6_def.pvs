cad_decide6_def: THEORY
%----------------------------------------------------------------------------
% A decision without a failure flag (COMPLETENESS_PLAN C1).  decide6 is the
% fast decision decide5 when its certificate passes, and otherwise the
% Phase 5 decision decide of cad_decide, which needs no certificate but is
% exponential.  It is the formal safety net of the completeness plan: the
% goal of stages C2-C8 is the same statement for the fast decision alone.
% (cad) runs the fallback only when asked, (cad :complete? t).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5_def

  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  phi: VAR BF

  decide6(qs, F, phi): bool =
    LET d = decide5(qs, F, phi) IN
    IF d`ok THEN d`val ELSE decide(qs, F, phi) ENDIF
END cad_decide6_def
