svs_tree: THEORY
%----------------------------------------------------------------------------
% All the sign vectors a family realizes along the top variable (Phase 5).
%
% svs(k, F, cx) is the branch tree over the parameters whose leaf lists
% every sign vector of F realized by some value of the top variable: the
% vectors at the roots of the product G = prodl(F) (rsc), the vectors at the
% roots of G' (rsc again: every bounded sector between consecutive roots of
% G contains a root of G' and the vector is constant on the sector), and
% the two vectors at +oo and -oo (infvs, from the normalized leading
% coefficients). The tree's conditions are the projection polynomials of
% the level. svs_sound: the vector of any x is listed; svs_complete: every
% listed vector is the vector of some x.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING rsc_tree, far_sign, sector_rep, bbindc_ex[list[SL], list[list[Sign3]]],
      branch_map[list[SL], list[list[Sign3]]]

  k: VAR nat
  F: VAR list[list[mpoly]]
  cx: VAR snorm_ctx.Cx
  ys: VAR list[real]
  x, a, b, c, z: VAR real
  v: VAR SV

  infvs(F, cx): btree[SVL] =
    bmap(LAMBDA (ps: list[SL]): (: infv(ps, TRUE), infv(ps, FALSE) :), snormpsc(F, cx))
  select_infvs: LEMMA branch_tree[bool].conds_hold(cx, ys) IMPLIES
    select(infvs(F, cx), ys) = (: infv(slofs(F, ys), TRUE), infv(slofs(F, ys), FALSE) :)

  sfuel(F): nat = max(rfuel(prodl(F), F, null, null), rfuel(lderiv(prodl(F)), F, null, null))

  svs(k, F, cx): btree[SVL] =
    bbindc(rsc(k, prodl(F), F, null, null, null, cx), cx,
      LAMBDA (a: SVL, cx1: snorm_ctx.Cx):
        bbindc(rsc(k, lderiv(prodl(F)), F, null, null, null, cx1), cx1,
          LAMBDA (b: SVL, cx2: snorm_ctx.Cx):
            bmap(LAMBDA (c: SVL): append(a, append(b, c)), infvs(F, cx2))))

  %% the leaf, at a valuation the context admits
  select_svs: LEMMA branch_tree[bool].conds_hold(cx, ys) IMPLIES
    EXISTS (cx1, cx2: snorm_ctx.Cx):
      branch_tree[bool].conds_hold(cx1, ys) AND branch_tree[bool].conds_hold(cx2, ys) AND
      select(svs(k, F, cx), ys) =
        append(select(rsc(k, prodl(F), F, null, null, null, cx), ys),
               append(select(rsc(k, lderiv(prodl(F)), F, null, null, null, cx1), ys),
                      (: infv(slofs(F, ys), TRUE), infv(slofs(F, ys), FALSE) :)))

  %% a root of the derivative between two roots realizes the vector between
  between_rep: LEMMA a < x AND x < b AND pf(prodl(F), ys)(a) = 0 AND pf(prodl(F), ys)(b) = 0 AND
    (FORALL z: a < z AND z < b IMPLIES pf(prodl(F), ys)(z) /= 0)
    IMPLIES EXISTS c: meval(mpol(lderiv(prodl(F))))(cons(c, ys)) = 0 AND
                      svec(F, cons(c, ys)) = svec(F, cons(x, ys))
  %% beyond all roots the vector is the one at infinity
  right_rep: LEMMA (FORALL z: z >= x IMPLIES pf(prodl(F), ys)(z) /= 0) IMPLIES
    svec(F, cons(x, ys)) = infv(slofs(F, ys), TRUE)
  left_rep: LEMMA (FORALL z: z <= x IMPLIES pf(prodl(F), ys)(z) /= 0) IMPLIES
    svec(F, cons(x, ys)) = infv(slofs(F, ys), FALSE)

  svs_sound: THEOREM branch_tree[bool].conds_hold(cx, ys) AND sfuel(F) <= k IMPLIES
    member(svec(F, cons(x, ys)), select(svs(k, F, cx), ys))
  svs_complete: THEOREM branch_tree[bool].conds_hold(cx, ys) AND sfuel(F) <= k AND
    member(v, select(svs(k, F, cx), ys)) IMPLIES
    EXISTS x: v = svec(F, cons(x, ys))
END svs_tree
