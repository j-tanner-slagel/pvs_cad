aug_univ: THEORY
%----------------------------------------------------------------------------
% The derivative augmentation stays inside a finite universe fixed by the
% initial tower, so it stops (QE_PLAN.md section 11, 2C completeness).
%
% tower_univ bounds the engine's closure of one initial tower; here the
% initial tower itself grows (qe2c_def's taug adds derivatives at the first
% d levels), so the universe is built for the whole process at once.  tu1
% gives the universe of a tower's first level, from the top down as tul
% does: the level's family and the reads (rwalld: RW of every list over
% the level above's universe with at most as many members as a family there
% can have), closed under the formal derivative at the free levels (dcls).
% Every tower the process builds is tinvd?: each family is its initial
% family followed by distinct new members of its universe.  The engine's
% closure keeps this (treads_subd, zipadd_invd, as treads_sub and
% zipadd_inv), so does taug (the universe of a free level is closed under
% lderiv), and so tsize stays below tbndd; a round that adds nothing is a
% fixpoint, and augT reaches one (aug_stop).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tower_univ, qe2c_def, list_flat[list[mpoly]], map_member[list[mpoly], list[list[mpoly]]],
            map_member[list[mpoly], list[mpoly]], map_member[Sect, Tower]

  d, n, fuel, u: VAR nat
  T0, T, TW, TR, T1, T2: VAR Tower
  TWs: VAR list[Tower]
  U, F, A, B: VAR list[list[mpoly]]
  g, h, x: VAR list[mpoly]
  c: VAR mpoly
  od: VAR OD
  tb: VAR CT
  TB: VAR list[CT]
  s: VAR Sect

  %% ---- the derivatives of a member, and a closed universe --------------------------------------
  alld(g): RECURSIVE list[list[mpoly]] =
    IF length(g) < 2 THEN null[list[mpoly]] ELSE cons(lderiv(g), alld(lderiv(g))) ENDIF
  MEASURE length(g)
  dcls(U): list[list[mpoly]] = append(U, flat(map(alld)(U)))
  pd(d): nat = IF d = 0 THEN 0 ELSE d - 1 ENDIF
  dclif(d, U): list[list[mpoly]] = IF d > 0 THEN dcls(U) ELSE U ENDIF

  LLf: VAR list[list[list[mpoly]]]
  flat_inv: LEMMA FORALL LLf: member(h, flat(LLf)) IMPLIES EXISTS U: member(U, LLf) AND member(h, U)
  lderiv_len1: LEMMA length(g) >= 1 IMPLIES length(lderiv(g)) = length(g) - 1
  alld_unf: LEMMA length(g) >= 2 IMPLIES alld(g) = cons(lderiv(g), alld(lderiv(g)))
  alld_closed: LEMMA FORALL g: member(h, alld(g)) AND length(h) >= 2 IMPLIES member(lderiv(h), alld(g))
  dcls_closed: LEMMA member(h, dcls(U)) AND length(h) >= 2 IMPLIES member(lderiv(h), dcls(U))
  dclif_sup: LEMMA sub?(U, dclif(d, U))
  pg: VAR [list[mpoly] -> bool]
  filter_memg: LEMMA FORALL F: member(g, filter(pg)(F)) IFF (member(g, F) AND pg(g))
  dvs_sub: LEMMA d > 0 AND sub?(F, dcls(U)) IMPLIES sub?(dvs(F), dcls(U))

  %% ---- the universe ---------------------------------------------------------------------------
  rwalld(U, n): list[list[mpoly]] = flat(map(RW)(wl(U, n)))
  rwalld_in: LEMMA sub?(F, U) AND length(F) <= n AND valid?(tb) AND member(c, wi_rd_t(F, od, tb))
    IMPLIES member(as_list(rd_norm(c)), rwalld(U, n))

  tu1(T0, d): RECURSIVE list[list[mpoly]] =
    IF null?(T0) THEN null[list[mpoly]]
    ELSIF null?(cdr(T0)) THEN dclif(d, car(T0))
    ELSE dclif(d, append(car(T0), rwalld(tu1(cdr(T0), pd(d)),
                                         length(car(cdr(T0))) + length(tu1(cdr(T0), pd(d))))))
    ENDIF
  MEASURE length(T0)
  tu1_init: LEMMA cons?(T0) IMPLIES sub?(car(T0), tu1(T0, d))
  tu1_reads: LEMMA cons?(T0) AND cons?(cdr(T0)) IMPLIES
    sub?(rwalld(tu1(cdr(T0), pd(d)), length(car(cdr(T0))) + length(tu1(cdr(T0), pd(d)))), tu1(T0, d))
  tu1_dcl: LEMMA d > 0 AND cons?(T0) IMPLIES EXISTS U: tu1(T0, d) = dcls(U)

  %% ---- the shape of every tower of the process -------------------------------------------------
  tinvd?(T0, d, TW): RECURSIVE bool =
    IF null?(T0) THEN null?(TW)
    ELSE cons?(TW) AND
      (EXISTS A: car(TW) = append(car(T0), A) AND nd?(A) AND sub?(A, tu1(T0, d)))
      AND tinvd?(cdr(T0), pd(d), cdr(TW))
    ENDIF
  MEASURE length(T0)
  tinvd_refl: LEMMA FORALL T0: FORALL d: tinvd?(T0, d, T0)
  tinvd_car: LEMMA tinvd?(T0, d, TW) AND cons?(T0) IMPLIES
    sub?(car(TW), tu1(T0, d)) AND length(car(TW)) <= length(car(T0)) + length(tu1(T0, d))
  tinvd_len: LEMMA FORALL T0: FORALL d, TW: tinvd?(T0, d, TW) IMPLIES length(TW) = length(T0)

  tbndd(T0, d): RECURSIVE nat =
    IF null?(T0) THEN 0 ELSE length(car(T0)) + length(tu1(T0, d)) + tbndd(cdr(T0), pd(d)) ENDIF
  MEASURE length(T0)
  tinvd_size: LEMMA FORALL T0: FORALL d, TW: tinvd?(T0, d, TW) IMPLIES tsize(TW) <= tbndd(T0, d)

  %% ---- the engine's closure keeps the shape -----------------------------------------------------
  rwtd(T0, d): RECURSIVE Tower =
    IF null?(T0) OR null?(cdr(T0)) THEN null[list[list[mpoly]]]
    ELSE cons(rwalld(tu1(cdr(T0), pd(d)), length(car(cdr(T0))) + length(tu1(cdr(T0), pd(d)))),
              rwtd(cdr(T0), pd(d)))
    ENDIF
  MEASURE length(T0)
  treads_subd: LEMMA FORALL T0: FORALL d, TW, TB, od: tinvd?(T0, d, TW) AND vtb?(TB)
    IMPLIES tsub?(treads_o(u, TW, TB, od), rwtd(T0, d))
  zipadd_invd: LEMMA FORALL T0: FORALL d, TW, TR: tinvd?(T0, d, TW) AND tsub?(TR, rwtd(T0, d))
    IMPLIES tinvd?(T0, d, zipadd(TW, TR))
  tclos_invd: LEMMA FORALL fuel: FORALL TW: tinvd?(T0, d, TW) IMPLIES tinvd?(T0, d, tclos_o(u, fuel, TW, od))
  lvln_invd: LEMMA tinvd?(T0, d, T) IMPLIES tinvd?(T0, d, lvln_o(u, T, s))

  %% ---- so does the augmentation -------------------------------------------------------------------
  taug_invd: LEMMA FORALL d: FORALL T0, T, TW: tinvd?(T0, d, T) AND tinvd?(T0, d, TW)
    IMPLIES tinvd?(T0, d, taug(T, TW, d))
  augall_invd: LEMMA FORALL TWs: FORALL T: tinvd?(T0, d, T) AND (FORALL TW: member(TW, TWs) IMPLIES tinvd?(T0, d, TW))
    IMPLIES tinvd?(T0, d, augall(T, TWs, d))
  aug1_invd: LEMMA tinvd?(T0, d, T) IMPLIES tinvd?(T0, d, aug1(u, d, T))

  %% ---- growth, and the stop -----------------------------------------------------------------------
  tsize_cons: LEMMA tsize(cons(F, TW)) = length(F) + tsize(TW)
  tsize_car: LEMMA cons?(TW) IMPLIES tsize(TW) = length(car(TW)) + tsize(cdr(TW))
  taug_grow: LEMMA FORALL d: FORALL T, TW: tsize(taug(T, TW, d)) >= tsize(T)
  augall_grow: LEMMA FORALL TWs: FORALL T: tsize(augall(T, TWs, d)) >= tsize(T)
  augT_unf: LEMMA augT(u, d, n + 1, T) =
    IF tsize(aug1(u, d, T)) = tsize(T) THEN T ELSE augT(u, d, n, aug1(u, d, T)) ENDIF
  aug1_grow: LEMMA tsize(aug1(u, d, T)) >= tsize(T)
  aug_stop: LEMMA FORALL n: FORALL T: tinvd?(T0, d, T) AND tsize(T) + n > tbndd(T0, d) IMPLIES
    tinvd?(T0, d, augT(u, d, n, T)) AND tsize(aug1(u, d, augT(u, d, n, T))) = tsize(augT(u, d, n, T))
  aug_same: LEMMA FORALL n: FORALL T: tinvd?(T0, d, T) AND tsize(T) + n > tbndd(T0, d) IMPLIES
    FORALL (n2: nat): n2 >= n IMPLIES augT(u, d, n2, T) = augT(u, d, n, T)
END aug_univ
