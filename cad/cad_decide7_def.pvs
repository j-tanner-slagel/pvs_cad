cad_decide7_def: THEORY
%----------------------------------------------------------------------------
% The decision behind (cad :cad-only? t) in a theory that does not import
% cad_decide8 (with it, decide8): the verified CAD engine for two or more
% quantifiers, the sectors of the line for fewer.  Executable.
%
% A sentence with two or more quantifiers goes to decn_u: decn_o, the
% n-level engine whose run is a proved cylindrical algebraic decomposition
% (cad_verified), from u = 0, raising u until its certificate holds
% (decide_u_def).  With one quantifier or none it goes to decq2, which
% with one quantifier decides on the sectors of the real roots of F; that
% these form a CAD of the line adapted to F is col_line's col_cad_line (the
% case k = 0 of col_cells).  Unlike decide5 (cad_decide5_def) there is
% no two-level fast path (decw), and the strategy (cad :cad-only? t) does no
% witness search.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5_def

  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  decq7(qs, F, Psi): [# ok: bool, val: bool #] =
    IF length(qs) >= 2 THEN decn_u(reverse(qs), F, Psi, 0) ELSE decq2(qs, F, Psi) ENDIF

  decide7(qs, F, phi): [# ok: bool, val: bool #] = decq7(qs, F, LAMBDA (v: SV): bfsv(phi, v))
END cad_decide7_def
