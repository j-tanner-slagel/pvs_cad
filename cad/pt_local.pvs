pt_local: THEORY
%----------------------------------------------------------------------------
% Local constancy of the inner fibre set at one cell (FINISH_PLAN stage S5d,
% claim B).
%
%   pt_local    if the inner walk's intrinsic reads at the point
%               (beta0, x0, xs) are members of P (rdin?), then for (beta, x)
%               close to (beta0, x0) at which P has the SAME sign vector, the
%               inner fibre set over (beta, x, xs) is that over (beta0, x0, xs).
%               Intrinsic reads: their signs are read off P's sign vector
%               (rdin_agree).  Entry reads: inner separators are chosen at
%               (beta0, x0) so that none vanishes (wok_exist, wnz_pz), and
%               joint continuity keeps their signs (joint_pers).  walk_same
%               concludes.  With beta = beta0 rational this is a separator
%               cell; with beta the moving section, a section cell.
%   pwalk_local the level's own walk over P: near x0 the oracle agrees with
%               the oracle at x0 on everything that walk reads (the middle of
%               fib_local, kept as wagree? so that vec_det, gap_det, sec_det
%               and walk_det can all be drawn from it)
%   T_same_r    T_same of level_ok from rdin? instead of the executable ptok?
%   sepok_adj   what sepok? says about one pair of consecutive separators
%----------------------------------------------------------------------------
BEGIN
  IMPORTING root_cont

  F, P: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  q3: VAR bool
  xs, ys: VAR list[real]
  S: VAR [real -> bool]
  q, x, x0, y, beta, beta0: VAR real
  y0, lo, hi: VAR rat
  Y: VAR list[rat]
  sg: VAR SG
  v: VAR SV

  pt_local: THEOREM rdin?(F, P, cons(beta0, cons(x0, xs))) IMPLIES
    EXISTS (eta, d: posreal): FORALL x, beta:
      abs(x - x0) < d AND abs(beta - beta0) < eta
      AND svec(P, cons(beta, cons(x, xs))) = svec(P, cons(beta0, cons(x0, xs)))
      IMPLIES FORALL v: fib(F, cons(beta, cons(x, xs)))(v) IFF fib(F, cons(beta0, cons(x0, xs)))(v)

  pwalk_local: THEOREM inv?(P, S, q, xs) AND cert?(P, msg(cons(q, xs))) AND S(x0)
    AND wok?(P, msg(cons(x0, xs)), Y) AND avall?(P, cons(x0, xs), Y)
    IMPLIES EXISTS (d: posreal): FORALL x: S(x) AND abs(x - x0) < d IMPLIES
      wagree?(P, msg(cons(x0, xs)), msg(cons(x, xs)), Y)

  rf_inv_r: LEMMA (FORALL (r: mpoly): member(r, wi_rd(F, msg(cons(y0, ys)))) IMPLIES member(as_list(r), P))
    IMPLIES inv?(F, Srf(P, ys, y0), y0, ys)
  T_same_r: LEMMA rdin?(F, P, cons(y0, ys)) AND P(P, ys)(y0) /= 0 AND rootfree?(P, ys, y0, y)
    IMPLIES (T(q3, F, Psi, ys)(y) IFF T(q3, F, Psi, ys)(y0))

  %% at a general oracle: the head separator is not a root of a live member
  sepok_hd_sg: LEMMA cons?(Y) AND sepok?(P, sg, Y) IMPLIES nzat?(P, sg, car(Y), P)
  sepok_adj: LEMMA FORALL Y: sepok?(P, sg, Y) AND adj?(Y, lo, hi) IMPLIES
    gapok?(P, sg, lo, hi) AND nzat?(P, sg, hi, P)
  %% a gap with a member root means a live member
  gap_lives: LEMMA gap?(P, sg, lo, hi) IMPLIES cons?(lives(P))
  adj_mem: LEMMA FORALL Y: adj?(Y, lo, hi) IMPLIES member(lo, Y) AND member(hi, Y)
END pt_local
