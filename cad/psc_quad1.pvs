psc_quad1: THEORY
%----------------------------------------------------------------------------
% psc_det? HOLDS for a single-member family of degree <= 2.
%
% delin_bridge's dec2_sem is conditional on psc_det?.  fib_quad proved the
% fibre-set determinacy from coefficient and discriminant signs.  What is
% missing between them is entirely bookkeeping:
%
%   svec_eq_sign  equal sign VECTORS give equal signs member by member
%   disc_projc    the discriminant really is in projc (it is the j = 0 entry
%                 of the chain of f against its derivative, by psc0_res)
%
% With those, psc_det_quad1 discharges the hypothesis outright, so for these
% families the two-quantifier projection decision is correct UNCONDITIONALLY.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING projc_mem, fib_quad

  P: VAR list[list[mpoly]]
  c, f: VAR list[mpoly]
  F: VAR list[list[mpoly]]
  u0, u1, u2: VAR mpoly
  x, y: VAR real
  i: VAR nat

  %% equal sign vectors, read off member by member
  svec_eq_sign: LEMMA svec(P, (: x :)) = svec(P, (: y :)) AND i < length(P)
    IMPLIES sign3(meval(mpol(nth(P, i)))((: x :)))
          = sign3(meval(mpol(nth(P, i)))((: y :)))

  %% the chain always contains its j = 0 entry, which psc0_res identifies
  %% with the resultant -- and disc(f) is res(f, f')
  g: VAR list[mpoly]
  pscs_zero: LEMMA FORALL (j: nat): 2 * j <= dg(f) + dg(g)
    IMPLIES member(psc(f, g, 0), pscs(f, g, j))

  %% the discriminant is the j = 0 entry of the chain against the derivative
  disc_projc: LEMMA cons?(F) AND live?(car(F))
    IMPLIES member(as_list(disc(car(F))), projc(F))
END psc_quad1
