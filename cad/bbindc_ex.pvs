bbindc_ex[T, U: TYPE]: THEORY
%----------------------------------------------------------------------------
% The value a context-aware bind selects (Phase 5).
%
% select_bbindc of branch_ctx is the universal form: it needs the value known
% in advance. The enumeration of realized sign vectors needs the existential
% form: at a valuation admitted by the context, bbindc selects what the
% continuation's tree selects at the selected leaf, under some context that
% the valuation admits.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING branch_ctx[T, U]

  t: VAR btree[T]
  cx: VAR Cx
  ys: VAR list[real]
  g: VAR [T, Cx -> btree[U]]

  select_bbindc_ex: THEOREM branch_tree[bool].conds_hold(cx, ys) IMPLIES
    EXISTS (cx2: Cx): branch_tree[bool].conds_hold(cx2, ys) AND
      select(bbindc(t, cx, g), ys) = select(g(select(t, ys), cx2), ys)
END bbindc_ex
