cover: THEORY
%----------------------------------------------------------------------------
% The cells of a level cover the line (FINISH_PLAN stage S5d, used by claim B).
%
% level_ok proves this inside cv_gap/cv_all for the truth value of the inner
% sentence.  Claim B needs it for other quantities, so here it is on its own:
% with separators Y that pass wok? for the family P at ys, every real y either
%
%   sees a separator y0 of Y with no root of P's product between them, or
%   is THE root of a gap of Y that holds one  (lvl?, which carries gapf?)
%
% adj?(Y, lo, hi) says lo, hi are consecutive in Y.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING level_ok

  ys: VAR list[real]
  P: VAR list[list[mpoly]]
  Y: VAR list[rat]
  lo, hi, y0: VAR rat
  y: VAR real

  adj?(Y, lo, hi): RECURSIVE bool =
    cons?(Y) AND cons?(cdr(Y)) AND
    ((car(Y) = lo AND car(cdr(Y)) = hi) OR adj?(cdr(Y), lo, hi))
  MEASURE length(Y)

  %% what a y sees
  atsep?(P, ys, Y, y): bool =
    EXISTS y0: member(y0, Y) AND P(P, ys)(y0) /= 0 AND rootfree?(P, ys, y0, y)
  atsec?(P, ys, Y, y): bool =
    EXISTS lo, hi: adj?(Y, lo, hi) AND gap?(P, msg(ys), lo, hi) AND lvl?(P, ys, lo, hi, y)

  adj_cdr: LEMMA cons?(Y) AND adj?(cdr(Y), lo, hi) IMPLIES adj?(Y, lo, hi)
  atsep_cdr: LEMMA cons?(Y) AND atsep?(P, ys, cdr(Y), y) IMPLIES atsep?(P, ys, Y, y)
  atsec_cdr: LEMMA cons?(Y) AND atsec?(P, ys, cdr(Y), y) IMPLIES atsec?(P, ys, Y, y)

  cover_gap: LEMMA cons?(Y) AND cons?(cdr(Y)) AND yok?(P, ys, Y) AND cons?(lives(P))
    AND slc?(bk(P), msg(ys), bprod(P)) AND car(Y) <= y AND y <= car(cdr(Y))
    IMPLIES atsep?(P, ys, Y, y) OR atsec?(P, ys, Y, y)

  cover_mid: LEMMA FORALL Y: cons?(Y) AND yok?(P, ys, Y) AND cons?(lives(P))
    AND slc?(bk(P), msg(ys), bprod(P)) AND car(Y) <= y AND y <= rlast(Y)
    IMPLIES atsep?(P, ys, Y, y) OR atsec?(P, ys, Y, y)

  cover: THEOREM wok?(P, msg(ys), Y) IMPLIES atsep?(P, ys, Y, y) OR atsec?(P, ys, Y, y)

  %% the certificate at what a y sees
  F: VAR list[list[mpoly]]
  cellok_mem: LEMMA FORALL Y: cellok?(F, P, msg(ys), Y) AND member(y0, Y)
    IMPLIES ptok?(F, msg(ys), P, y0)
  cellok_adj: LEMMA FORALL Y: cellok?(F, P, msg(ys), Y) AND adj?(Y, lo, hi)
    AND gap?(P, msg(ys), lo, hi) IMPLIES secok?(F, msg(ys), P, lo, hi)
END cover
