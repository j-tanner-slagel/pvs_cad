cad_meas: THEORY
%----------------------------------------------------------------------------
% A measurement theory: top does not import it directly, but alg_dec_ex and
% cad_pdec_ex do (alg_dec_ex uses its sgn), so it is in top's import closure
% and its lemmas are replayed with the library.  Measures the
% projection against the read closure on the worked examples.  Family members
% are polynomials in the INNERMOST quantified variable (the head of the point
% list), with coefficients in the remaining variables.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_proj

  %% coefficients in x
  xm1:  mpoly = mpol((: mconst(-1), mconst(1) :))          % x - 1
  x2m1: mpoly = mpol((: mconst(-1), mconst(0), mconst(1) :)) % x^2 - 1

  %% ex_line:   FORALL x: EXISTS y: x + 2y = 1 AND y*y >= 0
  f_line: list[list[mpoly]] =
    (: (: xm1, mconst(2) :),                 % (x-1) + 2y
       (: mconst(0), mconst(0), mconst(1) :) % y^2
     :)

  %% ex_circle: FORALL x: EXISTS y: x^2 + y^2 = 1 OR x^2 > 1
  f_circle: list[list[mpoly]] =
    (: (: x2m1, mconst(0), mconst(1) :),     % (x^2-1) + y^2
       (: x2m1 :)                            % x^2-1, no y
     :)

  %% ex_disc:   FORALL x: FORALL y: x^2 + y^2 < 1 IMPLIES x < 1
  f_disc: list[list[mpoly]] =
    (: (: x2m1, mconst(0), mconst(1) :),     % (x^2-1) + y^2
       (: xm1 :)                             % x-1, no y
     :)

  F, P: VAR list[list[mpoly]]

  %% the projection side
  np(F):   nat  = length(proj(F))
  nsp(F):  nat  = length(sects(rts(proj(F))))
  okp(F):  bool = inv1?(F, proj(F))
  gapp(F): bool = gaps_ok(rts(proj(F)))

  %% the read-closure side, for comparison
  cl(F):   list[list[mpoly]] = clos1(cfuel, F, null[list[mpoly]])
  nc(F):   nat  = length(cl(F))
  nsc(F):  nat  = length(sects(rts(cl(F))))
  okc(F):  bool = inv1?(F, cl(F))

  %% read-closure SEEDED by the projection: read-closed by construction, so
  %% inv1? holds and qfoldS_sem applies with no new mathematics, but it starts
  %% from a family that should already be sufficient
  cs(F):  list[list[mpoly]] = clos1(cfuel, F, proj(F))
  ns(F):  nat  = length(cs(F))
  nss(F): nat  = length(sects(rts(cs(F))))
  oks(F): bool = inv1?(F, cs(F))
  gaps(F): bool = gaps_ok(rts(cs(F)))


  %% NOTE: a direct sampled-delineability check (compare the fibre vector set
  %% at each finer closure sector against the projection sector containing it)
  %% is NOT ground-evaluable: sector containment in?(s,x) compares against
  %% value(h), the real an algebraic number denotes, which is not computable.
  %% The end-to-end comparison below tests the same thing through the answer.

  %%-------------------------------------------------------------------------
  %% END TO END: does the projection-based decision give the RIGHT ANSWER?
  %% Sign3 is {-1,0,1}, so each formula reads off the sign vector directly.
  %% qfoldS(q,..)/qfold(q,..) take q = TRUE for FORALL, FALSE for EXISTS; the
  %% inner (fibre) variable is the head of the point list.
  %%-------------------------------------------------------------------------
  v: VAR SV
  i: VAR nat

  %% total, so the sign functions below generate no unprovable TCC
  sgn(v, i): Sign3 = IF i < length(v) THEN nth(v, i) ELSE 0 ENDIF

  %% ex_line:   FORALL x: EXISTS y: x + 2y = 1 AND y*y >= 0
  psi_line(v):   bool = sgn(v, 0) = 0 AND sgn(v, 1) >= 0
  %% ex_circle: FORALL x: EXISTS y: x^2 + y^2 = 1 OR x^2 > 1
  psi_circle(v): bool = sgn(v, 0) = 0 OR sgn(v, 1) > 0
  %% ex_disc:   FORALL x: FORALL y: x^2 + y^2 < 1 IMPLIES x < 1
  psi_disc(v):   bool = NOT sgn(v, 0) < 0 OR sgn(v, 1) < 0

  %% the two routes: same lifting (svsec), different level-below family
  route(F, (P: list[list[mpoly]]), (qo: bool), (qi: bool), (Psi: [SV -> bool])): bool =
    qfoldS(qo, sects(rts(P)), LAMBDA (sd: Sect): qfold(qi, svsec(F, sd), Psi))

  pv_line:   bool = route(f_line,   proj(f_line),   TRUE, FALSE, psi_line)
  cv_line:   bool = route(f_line,   cl(f_line),     TRUE, FALSE, psi_line)
  pv_circle: bool = route(f_circle, proj(f_circle), TRUE, FALSE, psi_circle)
  cv_circle: bool = route(f_circle, cl(f_circle),   TRUE, FALSE, psi_circle)
  pv_disc:   bool = route(f_disc,   proj(f_disc),   TRUE, TRUE,  psi_disc)
  cv_disc:   bool = route(f_disc,   cl(f_disc),     TRUE, TRUE,  psi_disc)

  %%-------------------------------------------------------------------------
  %% THREE QUANTIFIERS.  The two-quantifier route folds over sign vectors; a
  %% third level needs actual SAMPLE POINTS, because svs_pt lifts by
  %% specializing the family at a point.  Q = proj(F) is the family in y,
  %% R = proj(Q) the family in x; over a rational x the y-level is
  %% evalF(Q, (: xs :)), univariate, so its sectors come from root isolation.
  %%
  %% A section coordinate is an ALGEBRAIC number in general, and svs_pt needs
  %% a computable real.  But root isolation collapses the interval to a point
  %% when the root is rational, so rsv0 is exact exactly when ratsampm? holds,
  %% and ok3 checks that over every sector actually used.  ok3 = TRUE means
  %% the answer below used no approximation anywhere.
  %%-------------------------------------------------------------------------
  sc: VAR Sect
  ss: VAR list[Sect]

  %% alg? demands lb < ub STRICTLY, so an exact rational is never signalled by
  %% a collapsed interval.  rat_alg(r) encodes r as the linear polynomial
  %% x - r, so a sample is exactly rational precisely when its defining
  %% polynomial is linear, and then the root is -c0/c1 exactly.
  cf(a: alg, (i: nat)): rat = IF i < length(a`p) THEN nth(a`p, i) ELSE 0 ENDIF
  lin?(a: alg): bool = length(a`p) = 2 AND cf(a, 1) /= 0

  ratsampm?(sc): bool = IF at?(sc) THEN lin?(pt(sc)) ELSE TRUE ENDIF
  rsv0(sc): rat =
    IF at?(sc) THEN (IF lin?(pt(sc)) THEN -cf(pt(sc), 0) / cf(pt(sc), 1) ELSE 0 ENDIF)
    ELSE sval(sc) ENDIF

  allratm(ss): RECURSIVE bool =
    IF null?(ss) THEN TRUE ELSE ratsampm?(car(ss)) AND allratm(cdr(ss)) ENDIF
  MEASURE length(ss)

  %% the y-sectors over a rational x
  ysects(P, (xs: rat)): list[Sect] = sects(rts(evalF(P, (: xs :))))

  okY(P, ss): RECURSIVE bool =
    IF null?(ss) THEN TRUE
    ELSE allratm(ysects(P, rsv0(car(ss)))) AND okY(P, cdr(ss))
    ENDIF
  MEASURE length(ss)

  %% every sample point the route uses is exactly a rational
  ok3(P, (R: list[list[mpoly]])): bool =
    allratm(sects(rts(R))) AND okY(P, sects(rts(R)))

  route3(F, (P: list[list[mpoly]]), (R: list[list[mpoly]]),
         (qx: bool), (qy: bool), (qz: bool), (Psi: [SV -> bool])): bool =
    qfoldS(qx, sects(rts(R)),
      LAMBDA (sx: Sect):
        qfoldS(qy, ysects(P, rsv0(sx)),
          LAMBDA (sy: Sect): qfold(qz, svs_pt(F, (: rsv0(sy), rsv0(sx) :)), Psi)))

  %% ex_three: FORALL x: FORALL y: EXISTS z: z > x AND z > y
  %% members are polynomials in z; coefficients are polynomials in (y, x)
  ngx: mpoly = mpol((: mpol((: mconst(0), mconst(-1) :)) :))  % -x
  ngy: mpoly = mpol((: mconst(0), mconst(-1) :))              % -y
  f_three: list[list[mpoly]] =
    (: (: ngx, mconst(1) :),      % z - x
       (: ngy, mconst(1) :)       % z - y
     :)
  psi_three(v): bool = sgn(v, 0) > 0 AND sgn(v, 1) > 0

  q3: list[list[mpoly]] = proj(f_three)
  r3: list[list[mpoly]] = proj(q3)
  n_q3: nat = length(q3)
  n_r3: nat = length(r3)
  n_sx: nat = length(sects(rts(r3)))
  ok_three: bool = ok3(q3, r3)
  pv_three: bool = route3(f_three, q3, r3, TRUE, TRUE, FALSE, psi_three)

  %%-------------------------------------------------------------------------
  %% NEGATIVE CONTROLS.  A route that always answered TRUE would look exactly
  %% like a correct one on three true examples, so each route is also run on
  %% a FALSE formula over the same family and must answer FALSE.
  %%-------------------------------------------------------------------------
  %% FORALL x: FORALL y: EXISTS z: z > x AND z < y   -- false (take y = x)
  psi_three_f(v): bool = sgn(v, 0) > 0 AND sgn(v, 1) < 0
  pv_three_f: bool = route3(f_three, q3, r3, TRUE, TRUE, FALSE, psi_three_f)

  %% FORALL x: EXISTS y: x^2 + y^2 = 1            -- false (take x = 2)
  psi_circle_f(v): bool = sgn(v, 0) = 0
  pv_circle_f: bool = route(f_circle, proj(f_circle), TRUE, FALSE, psi_circle_f)
  cv_circle_f: bool = route(f_circle, cl(f_circle),   TRUE, FALSE, psi_circle_f)

  %%-------------------------------------------------------------------------
  %% WHAT WAS MEASURED (all by ground evaluation; see PROGRESS.md)
  %%
  %%                 members  sectors   inv1?     route     time
  %%   closure          47      43      TRUE      TRUE     68.89 s
  %%   projection        8       3      FALSE     TRUE      1.25 s
  %%   proj-seeded      20      43      TRUE        -          -
  %%
  %%   ex_three: projection route TRUE in 0.39 s with ok_three = TRUE (every
  %%   sample point exactly rational); the closure route does not finish.
  %%
  %% The projection FAILS inv1? yet decides every example correctly, because
  %% inv1? is a sufficient condition tailored to the read closure: it demands
  %% that reads1 -- what the Sturm sign-chain implementation consults -- be
  %% sign-invariant on each sector.  Seeding the closure with the projection
  %% restores inv1? (and halves the family) but leaves the sector count and
  %% the cost unchanged, so it buys nothing.  A fast AND proved decision
  %% therefore needs delineability, not inv1?.
  %%-------------------------------------------------------------------------

  %% the projection does not satisfy the read-closure invariance check
  proj_not_inv1: LEMMA NOT okp(f_line)

  %% seeding the closure with the projection does satisfy it
  seeded_inv1: LEMMA oks(f_line) AND gaps(f_line)

  %% and both routes decide all three examples the same way, correctly
  routes_agree: LEMMA pv_line   AND cv_line   AND
                      pv_circle AND cv_circle AND
                      pv_disc   AND cv_disc

  %% THREE QUANTIFIERS: the right answer, every sample point exactly rational
  three_works: LEMMA ok_three AND pv_three

  %% negative controls: both routes answer FALSE on false formulas, so the
  %% agreement above is not the artefact of a route that always says TRUE
  controls: LEMMA NOT pv_three_f AND NOT pv_circle_f AND NOT cv_circle_f

END cad_meas
