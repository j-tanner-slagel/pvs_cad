mpoly_cst: THEORY
%----------------------------------------------------------------------------
% Terms that denote a constant (Phase 3).
%
% A branch tree asks for the sign of a coefficient at the parameters, and most
% of the coefficients the symbolic Sturm-Tarski construction produces do not
% depend on the parameters at all: they are numbers.  The sign of a number is
% decided once and for all, so the node can be replaced by the child it
% selects, which is what btree_prune does.  mcst? recognizes a term that
% denotes a constant and cst_val is that constant.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING mpoly_def, structures@more_list_props[mpoly]

  p, h: VAR mpoly
  l: VAR list[mpoly]
  xs: VAR list[real]
  c: VAR rat

  mcst?(p): RECURSIVE bool =
    CASES p OF
      mconst(c): TRUE,
      mpol(l): length(l) = 0 OR (length(l) = 1 AND mcst?(car(l)))
    ENDCASES
  MEASURE msize(p)

  cst_val(p): RECURSIVE rat =
    CASES p OF
      mconst(c): c,
      mpol(l): IF length(l) = 0 THEN 0 ELSE cst_val(car(l)) ENDIF
    ENDCASES
  MEASURE msize(p)

  %% the two recursions peeled, so that the induction below never has to
  %% unfold them inside its own hypothesis
  len_cons1: LEMMA length(cons(h, l)) = 1 + length(l)
  cst_mconst: LEMMA cst_val(mconst(c)) = c
  cst_nil: LEMMA cst_val(mpol(null[mpoly])) = 0
  cst_cons: LEMMA cst_val(mpol(cons(h, l))) = cst_val(h)
  mcst_cons: LEMMA mcst?(mpol(cons(h, l))) IFF (length(l) = 0 AND mcst?(h))

  mcst_eval: THEOREM mcst?(p) IMPLIES meval(p)(xs) = cst_val(p)
END mpoly_cst
