qe2c_ok: THEORY
%----------------------------------------------------------------------------
% QE from a derivative-closed run is correct and quantifier-free
% (QE_PLAN.md section 11, 2C).
%
% The augmentation touches only the first d families, so for d < length(T)
% it keeps the tower's length and last family (aug_shape): the run from
% qe2c_T(u, m, qb, F) is a run over F with m - 1 + length(qb) levels.  Over
% each sector the proof of qe2_ok's sect_sem goes through with runT_ok's
% facts (sectc_sem), and qe2c_c_sem follows as qe2_c_sem does.  With dclok
% the closed free families are derivative-closed (dclx_dcl), so every
% sector's entries separate (qe2_sep's ents_sep) and every part of the
% answer is quantifier-free (qe2c_c_qf).  qe2c_correct: when qe2c_o
% succeeds, its output is quantifier-free and holds at a point iff the
% prenex formula does.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe2c_def, runT_ok, qe2_sep, qe1_full, map_member[Sect, Fm]

  u, d, n: VAR nat
  m: VAR posnat
  qb: VAR list[bool]
  F, G: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  T, TW: VAR Tower
  TWs: VAR list[Tower]
  s: VAR Sect
  pt: VAR list[real]

  %% ---- the augmentation keeps the shape -------------------------------------------------------
  twl_cons: LEMMA length(TW) >= 1 IMPLIES cons?(TW)
  taug_shape: LEMMA FORALL d: FORALL T, TW: d < length(T) IMPLIES
    length(taug(T, TW, d)) = length(T) AND tlast(taug(T, TW, d)) = tlast(T)
  augall_shape: LEMMA FORALL TWs: FORALL T: d < length(T) IMPLIES
    length(augall(T, TWs, d)) = length(T) AND tlast(augall(T, TWs, d)) = tlast(T)
  aug_shape: LEMMA FORALL n: FORALL T: d < length(T) IMPLIES
    length(augT(u, d, n, T)) = length(T) AND tlast(augT(u, d, n, T)) = tlast(T)
  qe2c_T_shape: LEMMA m >= 2 AND cons?(qb) IMPLIES
    cons?(qe2c_T(u, m, qb, F)) AND length(qe2c_T(u, m, qb, F)) = m - 1 + length(qb)
      AND tlast(qe2c_T(u, m, qb, F)) = F

  %% ---- the check --------------------------------------------------------------------------------
  pr: VAR [list[mpoly] -> bool]
  g: VAR list[mpoly]
  every_mem_l: LEMMA FORALL G: every(pr)(G) AND member(g, G) IMPLIES pr(g)
  dclx_dcl: LEMMA dclx?(G) IMPLIES dcl?(G)
  every_dclx: LEMMA FORALL TW: every(dclx?)(TW) IMPLIES every(dcl?)(TW)

  %% ---- correct --------------------------------------------------------------------------------
  sectc_sem: LEMMA m >= 2 AND cons?(qb) AND runokT(u, T) AND cons?(T) AND tlast(T) = F
    AND length(T) = m - 1 + length(qb) AND length(pt) = m
    AND member(s, runsectsT(u, T)) AND in?(s, car(dropn(m - 1, pt)))
    IMPLIES (qfsem(secout(m, qb, Psi, s, runtwT(u, T)(s), secr(s, cad_outT(u, T, F))))(pt)
             IFF sem(qb, F, Psi, pt))
  qe2c_c_sem: LEMMA m >= 2 AND cons?(qb) AND runokT(u, T) AND cons?(T)
    AND length(T) = m - 1 + length(qb) AND length(pt) = m IMPLIES
    (qfsem(qe2c_c(u, m, qb, T, Psi)`out)(pt) IFF sem(qb, tlast(T), Psi, pt))

  %% ---- quantifier-free --------------------------------------------------------------------------
  sectc_qf: LEMMA m >= 2 AND cons?(qb) AND runokT(u, T) AND cons?(T)
    AND length(T) = m - 1 + length(qb) AND member(s, runsectsT(u, T))
    AND every(dclx?)(ttake(runtwT(u, T)(s), m - 1))
    IMPLIES qf?(secout(m, qb, Psi, s, runtwT(u, T)(s), secr(s, cad_outT(u, T, tlast(T)))))
  ps: VAR [Sect -> bool]
  ss: VAR list[Sect]
  every_mem_s: LEMMA FORALL ss: every(ps)(ss) AND member(s, ss) IMPLIES ps(s)
  qe2c_c_qf: LEMMA m >= 2 AND cons?(qb) AND runokT(u, T) AND cons?(T)
    AND length(T) = m - 1 + length(qb) AND dclok(u, m - 1, T)
    IMPLIES qf?(qe2c_c(u, m, qb, T, Psi)`out)

  qe2c_correct: THEOREM qe2c_o(u, m, qb, F, Psi)`ok AND length(pt) = m IMPLIES
    qf?(qe2c_o(u, m, qb, F, Psi)`out)
    AND (qfsem(qe2c_o(u, m, qb, F, Psi)`out)(pt) IFF sem(qb, F, Psi, pt))
END qe2c_ok
