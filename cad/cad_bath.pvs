cad_bath: THEORY
%----------------------------------------------------------------------------
% A problem of the Bath CAD example bank decided by (cad) (FINISH_PLAN 3i,
% stage N11).  Source: Bradford, Davenport and Wilson, "A repository for CAD
% examples", ACM Communications in Computer Algebra 46(3) 67-69; dataset
% maintained by David Wilson, University of Bath Research Data Archive,
% version 4 (2013), doi 10.15125/BATH-00069, CC-BY-SA 4.0 (bench_pdec has
% all twelve closed problems as PVS formulas).
%
% "Random B Grobner from Buchberger-Hong" (bath_08) is FALSE -- no z makes
% y^2 equal a fixed value for EVERY y -- and (cad -1) refutes it through the
% n-level decision decn_o (ok TRUE, 280 s for the decision alone).  The other
% nine closed problems of the bank run past 300 s in decn_o (PROGRESS.md,
% benchmark table).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  bath_08_false: LEMMA
    (EXISTS (z: real): FORALL (y: real): EXISTS (x: real): (((z^7 - 1/2 * z^6 + 1/16 * z^5 + 13/4 * z^4 + 75/16 * z^3 - 171/8 * z^2 + 133/8 * z - 15/4 = 0) AND (y^2 - 19188/497 * z^6 + 318/497 * z^5 - 4197/1988 * z^4 - 251555/1988 * z^3 - 481837/1988 * z^2 + 1407741/1988 * z - 297833/994 = 0) AND (x + 4638/497 * z^6 - 75/497 * z^5 + 2111/3976 * z^4 + 61031/1988 * z^3 + 232833/3976 * z^2 - 85042/497 * z + 144407/1988 = 0))))
    IMPLIES FALSE
END cad_bath
