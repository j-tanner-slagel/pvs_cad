cad_bath: THEORY
%----------------------------------------------------------------------------
% A problem of the Bath CAD example bank decided by (cad) (FINISH_PLAN 3i,
% stage N11).  Source: Bradford, Davenport and Wilson, "A repository for CAD
% examples", ACM Communications in Computer Algebra 46(3) 67-69; dataset
% maintained by David Wilson, University of Bath Research Data Archive,
% version 4 (2013), doi 10.15125/BATH-00069, CC-BY-SA 4.0 (bench_pdec has
% the ten usable closed problems as PVS formulas; bath_06 and bath_11 are
% excluded for defects in the source).
%
% "Random B Grobner from Buchberger-Hong" (bath_08) is FALSE -- no z makes
% y^2 equal a fixed value for EVERY y -- and (cad -1) refutes it: the whole
% proof takes about 9.5 s, and about 10 s with cad_decide8 imported
% (1 October 2026; it took 280 s for the decision alone when this theory was
% made).  Of the other nine closed problems, (cad) settles Bath 01, 03 and 04
% by a model search, and Bath 02 -- and 05 and 07, refuted as hypotheses --
% by fixing one variable to a constant and deciding the smaller sentence, in
% under 13 s each (PROGRESS.md, 27 September 2026; the same with IMPORTING
% pvs_cad, 1 October 2026); the decision alone,
% without the witness search, does not finish in 90 s on bath_02-05, 07, 09,
% 10 and 12 with either engine (bath_01: 0.2 s with the Collins run;
% docs/collins_cad.pdf).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  bath_08_false: LEMMA
    (EXISTS (z: real): FORALL (y: real): EXISTS (x: real): (((z^7 - 1/2 * z^6 + 1/16 * z^5 + 13/4 * z^4 + 75/16 * z^3 - 171/8 * z^2 + 133/8 * z - 15/4 = 0) AND (y^2 - 19188/497 * z^6 + 318/497 * z^5 - 4197/1988 * z^4 - 251555/1988 * z^3 - 481837/1988 * z^2 + 1407741/1988 * z - 297833/994 = 0) AND (x + 4638/497 * z^6 - 75/497 * z^5 + 2111/3976 * z^4 + 61031/1988 * z^3 + 232833/3976 * z^2 - 85042/497 * z + 144407/1988 = 0))))
    IMPLIES FALSE
END cad_bath
