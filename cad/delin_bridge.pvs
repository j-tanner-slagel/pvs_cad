delin_bridge: THEORY
%----------------------------------------------------------------------------
% From the psc statement to delineability (Phase 6).
%
% cad_delin proved dec2_sem: the projection decision agrees with the semantics
% for any family satisfying delin?.  sect_svec proved the decomposition half:
% on a sector every member of the projection keeps its sign.  This theory
% joins them, so that the ONLY thing left unproved is a statement about two
% UNIVARIATE families with no CAD machinery around it:
%
%   psc_det?(F):  two points where projc(F) has the same signs have the same
%                 fibre set
%
% delin_from_psc then gives delin? on every sector, which is exactly what
% dec2_sem consumes.  Chaining the two: psc_det?(F) alone implies the
% two-quantifier projection decision is correct.
%
% [Corrected 2026-09-29: psc_det? is FALSE for some two-member families
% (psc_det_ce: y^2-3y+2 and y-x at x = 1/2 and x = 3), so it is not the one
% thing left to prove.  delin_from_psc stays a valid implication; the open
% obligation of this route is the sector-local delin_projc.]
%
% The route through the sector's RATIONAL sample is forced: cell1's
% svec_between, and hence sect_svec, compares an arbitrary real against a
% rational, so two arbitrary points of a sector are compared by going through
% sval(s) twice.  At an at sector both points collapse to the root and there
% is nothing to prove.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_delin, cad_projc, sect_svec

  F: VAR list[list[mpoly]]
  s: VAR Sect
  x, y: VAR real
  v: VAR SV

  %% THE REMAINING OBLIGATION, as a predicate rather than an assumption
  %% [2026-09-29: false for some F, psc_det_ce.psc_det_false]
  psc_det?(F): bool =
    FORALL x, y: svec(projc(F), (: x :)) = svec(projc(F), (: y :))
      IMPLIES (FORALL v: fib(F, (: x :))(v) IFF fib(F, (: y :))(v))

  %% a non-root sector has a rational point in it
  sval_in: LEMMA NOT at?(s) AND sect_ok(s) AND (mid?(s) IMPLIES value(lo(s)) < value(hi(s)))
    IMPLIES in?(s, sval(s))

  %% delineability on every sector of the Collins projection
  delin_from_psc: LEMMA psc_det?(F)
    AND incr?(sortu(allroots(projc(F)))) AND gaps_ok(sortu(allroots(projc(F))))
    AND member(s, sects(sortu(allroots(projc(F)))))
    IMPLIES delin?(F, s)
END delin_bridge
