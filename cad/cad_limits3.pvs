cad_limits3: THEORY
%----------------------------------------------------------------------------
% Graded families for (cad): one parameter changed at a time.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  %% x^4 + y^4 >= 2 x^2 y^2, degree 4, two variables -- TRUE
  %% [proved 1.1 s]
  g_amgm4: LEMMA FORALL (x: real): FORALL (y: real): x^4 + y^4 >= 2*x^2*y^2

  %% x^6 + y^6 >= 2 x^3 y^3, degree 6, two variables -- TRUE
  %% [proved 32 s (the decision takes 31 s)]
  g_amgm6: LEMMA FORALL (x: real): FORALL (y: real): x^6 + y^6 >= 2*x^3*y^3

  %% x^8 + y^8 >= 2 x^4 y^4, degree 8, two variables -- TRUE
  %% [not done in 90 s]
  g_amgm8: LEMMA FORALL (x: real): FORALL (y: real): x^8 + y^8 >= 2*x^4*y^4

  %% x^10 + y^10 >= 2 x^5 y^5, degree 10, two variables -- TRUE
  %% [not run (degree 8 already fails)]
  g_amgm10: LEMMA FORALL (x: real): FORALL (y: real): x^10 + y^10 >= 2*x^5*y^5

  %% y^3 + x y + 1 = 0 is solvable in y for every x, degree 3 -- TRUE
  %% [proved 1.0 s]
  g_root3: LEMMA FORALL (x: real): EXISTS (y: real): y^3 + x*y + 1 = 0

  %% y^5 + x y + 1 = 0 is solvable in y for every x, degree 5 -- TRUE
  %% [proved 1.2 s]
  g_root5: LEMMA FORALL (x: real): EXISTS (y: real): y^5 + x*y + 1 = 0

  %% y^7 + x y + 1 = 0 is solvable in y for every x, degree 7 -- TRUE
  %% [not done in 90 s]
  g_root7: LEMMA FORALL (x: real): EXISTS (y: real): y^7 + x*y + 1 = 0

  %% y^9 + x y + 1 = 0 is solvable in y for every x, degree 9 -- TRUE
  %% [not done in 90 s]
  g_root9: LEMMA FORALL (x: real): EXISTS (y: real): y^9 + x*y + 1 = 0

  %% x^2 + y^2 = 1 meets y = x^2, degree 2 -- TRUE
  %% [proved 1.4 s]
  g_meet2: LEMMA EXISTS (x: real): EXISTS (y: real): x^2 + y^2 = 1 AND y = x^2

  %% x^4 + y^4 = 1 meets y = x^2, degree 4 -- TRUE
  %% [proved 1.6 s]
  g_meet4: LEMMA EXISTS (x: real): EXISTS (y: real): x^4 + y^4 = 1 AND y = x^2

  %% x^6 + y^6 = 1 meets y = x^2, degree 6 -- TRUE
  %% [proved 28.5 s]
  g_meet6: LEMMA EXISTS (x: real): EXISTS (y: real): x^6 + y^6 = 1 AND y = x^2

  %% x^8 + y^8 = 1 meets y = x^2, degree 8 -- TRUE
  %% [not done in 90 s]
  g_meet8: LEMMA EXISTS (x: real): EXISTS (y: real): x^8 + y^8 = 1 AND y = x^2

  %% one variable: x^10 = 2 (100 x - 1)^2 has a root within 10^-5 below 1/100 -- TRUE
  %% [proved 1.7 s]
  g_mignotte1: LEMMA EXISTS (x: real): 999/100000 < x AND x < 1/100 AND x^10 = 2*(100*x - 1)^2

  %% ... and two roots in (0, 1/50) (separated by about 10^-7) -- TRUE
  %% [proved 1.7 s]
  g_mignotte1_two: LEMMA FORALL (x: real): 0 < x AND x < 1/50 IMPLIES (x^10 - 2*(100*x - 1)^2 < 0 OR x^10 - 2*(100*x - 1)^2 > 0 OR x^10 = 2*(100*x - 1)^2)
END cad_limits3
