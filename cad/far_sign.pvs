far_sign: THEORY
%----------------------------------------------------------------------------
% Sign vectors at +oo and -oo (Phase 5).
%
% A normalized polynomial (an SL of branch_sgn: the coefficient list with
% its vanishing leading coefficients dropped, and the sign of the leading
% one) has, far to the right, the sign of its leading coefficient (lcp of
% ineq_ok), far to the left the sign lca. inf_sgn reads that sign off the
% SL, infv does it for a family, and far_vec_right/left say the family
% realizes exactly these vectors beyond some bound.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING ineq_ok, sign_oracle, sign_vec

  l: VAR list[mpoly]
  F: VAR list[list[mpoly]]
  ps: VAR list[SL]
  p: VAR SL
  ys: VAR list[real]
  x, M: VAR real
  right: VAR bool

  inf_sgn(p, right): Sign3 =
    IF null?(p`slist) THEN 0
    ELSIF right THEN IF lcp(p) THEN 1 ELSE -1 ENDIF
    ELSE IF lca(p) THEN 1 ELSE -1 ENDIF
    ENDIF
  infv(ps, right): list[Sign3] = map(LAMBDA (q: SL): inf_sgn(q, right))(ps)

  infv_null: LEMMA infv(null[SL], right) = null[Sign3]
  infv_cons: LEMMA infv(cons(p, ps), right) = cons(inf_sgn(p, right), infv(ps, right))

  %% the negated list
  len_pos: LEMMA cons?(l) IMPLIES length(l) >= 1
  lneg_len: LEMMA length(lneg(l)) = length(l)
  lneg_cons?: LEMMA cons?(lneg(l)) IFF cons?(l)
  dg_lneg: LEMMA dg(lneg(l)) = dg(l)
  llast_lneg: LEMMA cons?(l) IMPLIES llast(lneg(l)) = mscal(-1, llast(l))
  lcpos_lneg: LEMMA lcpos(lneg(l), ys) IFF (cons?(l) AND meval(llast(l))(ys) < 0)
  lcalt_lneg: LEMMA lcalt(lneg(l), ys) IFF (cons?(l) AND (-1) ^ dg(l) * meval(llast(l))(ys) < 0)

  %% one polynomial: its sign far right and far left
  far_sign_right: LEMMA EXISTS M: FORALL x: x >= M IMPLIES
    sign3(meval(mpol(l))(cons(x, ys))) = inf_sgn(sl_of(select(snorm(l), ys), ys), TRUE)
  far_sign_left: LEMMA EXISTS M: FORALL x: x <= M IMPLIES
    sign3(meval(mpol(l))(cons(x, ys))) = inf_sgn(sl_of(select(snorm(l), ys), ys), FALSE)

  %% the family
  far_vec_right: LEMMA EXISTS M: FORALL x: x >= M IMPLIES
    svec(F, cons(x, ys)) = infv(slofs(F, ys), TRUE)
  far_vec_left: LEMMA EXISTS M: FORALL x: x <= M IMPLIES
    svec(F, cons(x, ys)) = infv(slofs(F, ys), FALSE)
END far_sign
