cad_examples2: THEORY
%----------------------------------------------------------------------------
% Larger two-variable problems through (cad) (FINISH_PLAN S4).
%
% None of these was within reach of decide2's read closure in reasonable
% time; all go through the fast decision decw inside decide5 (via decide4).  Times are wall
% clock for the whole proof through the pvs-cli server, session start
% included, on the 8 GB machine.
%
%   ex_cubic    every x is the value of 3y - y^3             3 s
%   ex_quad     some x makes y^2 + x y + 1 positive          2 s
%   ex_amgm     x^2 + y^2 >= 2 x y                           3 s
%   ex_disc2    on the unit disc x + y <= 2                  12 s
%   ex_meet     the circle meets the parabola y = x^2        11 s
%   ex_quartic  x^4 + y^4 + 1 > x y                          3 s
%   ex_ell      three sign conditions, an ellipse and a line 6 s
%   ex_two      a hyperbola branch                           4 s
%   ex_hyp      NOT (ALL x EX y: x y = 1), refuted by (cad -1) 7 s
%
% ex_hyp is a FALSE sentence sitting in the antecedent: the strategy refutes
% it where it stands, which closes the goal.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  ex_cubic: LEMMA FORALL (x: real): EXISTS (y: real): y^3 - 3 * y + x = 0
  ex_quad: LEMMA EXISTS (x: real): FORALL (y: real): y^2 + x * y + 1 > 0
  ex_amgm: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 >= 2 * x * y
  ex_disc2: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 <= 1 IMPLIES x + y <= 2
  ex_meet: LEMMA EXISTS (x: real): EXISTS (y: real): x^2 + y^2 = 1 AND y = x^2
  ex_quartic: LEMMA FORALL (x: real): FORALL (y: real): x^4 + y^4 + 1 > x * y
  ex_ell: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + x * y + y^2 >= 3 AND y > x
  ex_two: LEMMA FORALL (x: real): EXISTS (y: real): y^2 = x^2 + 1 AND y > 0 AND y^2 - x^2 <= 1
  ex_hyp: LEMMA NOT FORALL (x: real): EXISTS (y: real): x * y = 1
END cad_examples2
