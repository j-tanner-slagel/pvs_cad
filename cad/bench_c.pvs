bench_c: THEORY
%----------------------------------------------------------------------------
% Benchmarks comparing the Collins decision decc_o with the read-closure
% decision decn_o (COLLINS_PLAN.md M-I, M-K; not in top.pvs, like bench_n).
% Measure one with (cad-mx 1 "decc_o" 0) or (cad-mx 1 "decn_o" 0): it prints
% the record and the wall-clock time and changes nothing.
%
% bath_01 to bath_04 are problems of the Bath CAD example bank (Wilson,
% Bradford and Davenport, "A repository for CAD examples", ACM Communications
% in Computer Algebra 46(3/4) 67-69, doi 10.1145/2429135.2429137; dataset
% maintained by David Wilson, University of Bath Research Data Archive,
% version 4 (2013), doi 10.15125/BATH-00069, CC-BY-SA 4.0), as translated in
% bench_n; this file is distributed under CC BY-SA 4.0 (NOTICE.md).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING decc_def, cad_decide8_def, mpoly_embed

  %% linear and quadratic boxes against a moving half-space (the QE benchmark, c quantified)
  k2_lin: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real):
    (x1 >= -1 AND x1 <= 1 AND x2 >= -1 AND x2 <= 1 AND x1 + x2 >= c) OR c > 2
  l2_quad: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real):
    (x1^2 <= 1 AND x2^2 <= 1 AND x1 + x2 >= c) OR c > 2
  k3_lin: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real): EXISTS (x3: real):
    (x1 >= -1 AND x1 <= 1 AND x2 >= -1 AND x2 <= 1 AND x3 >= -1 AND x3 <= 1 AND x1 + x2 + x3 >= c) OR c > 3
  l3_quad: LEMMA FORALL (c: real): EXISTS (x1: real): EXISTS (x2: real): EXISTS (x3: real):
    (x1^2 <= 1 AND x2^2 <= 1 AND x3^2 <= 1 AND x1 + x2 + x3 >= c) OR c > 3

  %% linear, where decc_o returned no value (2026-10-01)
  e4_above: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w > z
  e4_between: LEMMA FORALL (x: real): FORALL (y: real): FORALL (z: real): EXISTS (w: real):
    w > x AND w > y AND w < z

  %% Bath problems (bench_n) that time out at 90 s with both decisions before the fast psc
  bath_02: LEMMA
    EXISTS (r: real): FORALL (x: real): FORALL (y: real): ((((x - r > 0) AND (y - r > 0)) IMPLIES (x^2 * (1 + 2 * y)^2 - y^2 * (1 + 2 * x^2) > 0)))
  bath_03: LEMMA
    EXISTS (y: real): EXISTS (x: real): EXISTS (t: real): (((17 * t - 96 >= 0) AND (17 * t - 160 <= 0) AND (16 * x - 17 * t + 16 >= 0) AND (16 * x - 17 * t - 16 <= 0) AND (16 * y - 17 * t + 144 >= 0) AND (16 * y - 17 * t + 112 <= 0) AND ((x - t)^2 + y^2 - 1 <= 0)))
  bath_04: LEMMA
    EXISTS (x: real): EXISTS (y: real): EXISTS (z: real): (((y - 1) * z^4 + x * z^3 + x * (1 - y) * z^2 + (y - x - 1) * z + y = 0))

  %% small ones
  t_circle: LEMMA FORALL (x: real): EXISTS (y: real): x^2 + y^2 = 1 OR x^2 > 1
  t_sphere: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real):
    x^2 + y^2 + z^2 = 1 OR x^2 + y^2 > 1
  bath_01: LEMMA
    EXISTS (z: real): EXISTS (x: real): EXISTS (y: real): (((x^2 + y^2 + z^2 - 1 < 0) AND (x^2 + (y + z - 2)^2 - 1 < 0)))
END bench_c
