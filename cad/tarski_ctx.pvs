tarski_ctx: THEORY
%----------------------------------------------------------------------------
% The many-condition recursion with the conditions of the path (Phase 3).
%
% mtreec, snormpsc, mcountc and mcorec are mtree of tarski_tree and the
% three trees of many_tree built with snormc, ctreec and bbindc: every
% normalization consults the path before it branches, and the chains of the
% recursion are nested with their contexts, so a sign decided by one chain is
% not asked again by the next.  The theorems are those of the originals under
% the path's conditions.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING prsp_ctx, many_tree, branch_ctx[SL, int], branch_ctx[int, int],
      branch_ctx[list[SL], bool]

  l0, l, g: VAR list[mpoly]
  Q: VAR list[list[mpoly]]
  ys: VAR list[real]
  k: VAR nat
  x: VAR real
  p0: VAR SL
  ps: VAR list[SL]
  cx: VAR snorm_ctx.Cx

  mtreec(k, p0, Q, g, cx): RECURSIVE btree[int] =
    IF null?(Q) THEN bmap(tqf, ctreec(k, p0, g, cx))
    ELSE bbindc(snormc(lmul(car(Q), g), cx), cx, LAMBDA (g1: SL, cx1: snorm_ctx.Cx):
           bbindc(mtreec(k, p0, cdr(Q), g1`slist, cx1), cx1, LAMBDA (n1: int, cx2: snorm_ctx.Cx):
             bbindc(snormc(lmul(car(Q), g1`slist), cx2), cx2, LAMBDA (g2: SL, cx3: snorm_ctx.Cx):
               bmap(LAMBDA (n2: int): n1 + n2,
                    mtreec(k, p0, cdr(Q), g2`slist, cx3)))))
    ENDIF
  MEASURE length(Q)

  mtreec_null: LEMMA mtreec(k, p0, null[list[mpoly]], g, cx) = bmap(tqf, ctreec(k, p0, g, cx))
  mtreec_cons: LEMMA mtreec(k, p0, cons(l, Q), g, cx) =
    bbindc(snormc(lmul(l, g), cx), cx, LAMBDA (g1: SL, cx1: snorm_ctx.Cx):
      bbindc(mtreec(k, p0, Q, g1`slist, cx1), cx1, LAMBDA (n1: int, cx2: snorm_ctx.Cx):
        bbindc(snormc(lmul(l, g1`slist), cx2), cx2, LAMBDA (g2: SL, cx3: snorm_ctx.Cx):
          bmap(LAMBDA (n2: int): n1 + n2, mtreec(k, p0, Q, g2`slist, cx3)))))

  snormc_lmul: LEMMA branch_tree[bool].conds_hold(cx, ys) IMPLIES
    select(snormc(lmul(l, g), cx), ys)`slist = lmn(l, g, ys)

  select_mtreec: THEOREM FORALL (Q: list[list[mpoly]]):
    FORALL (k: nat, l0, g: list[mpoly], cx: snorm_ctx.Cx, ys: list[real]):
      branch_tree[bool].conds_hold(cx, ys) IMPLIES
      select(mtreec(k, sl_of(l0, ys), Q, g, cx), ys) = mts(k, l0, Q, g, ys)

  %% normalize every condition, with the path
  snormpsc(Q, cx): RECURSIVE btree[list[SL]] =
    IF null?(Q) THEN bleaf(null[SL])
    ELSE bbindc(snormc(car(Q), cx), cx, LAMBDA (p: SL, cx1: snorm_ctx.Cx):
           bmap(LAMBDA (qs: list[SL]): cons(p, qs), snormpsc(cdr(Q), cx1)))
    ENDIF
  MEASURE length(Q)
  snormpsc_null: LEMMA snormpsc(null[list[mpoly]], cx) = bleaf(null[SL])
  snormpsc_cons: LEMMA snormpsc(cons(l, Q), cx) =
    bbindc(snormc(l, cx), cx, LAMBDA (p: SL, cx1: snorm_ctx.Cx):
      bmap(LAMBDA (qs: list[SL]): cons(p, qs), snormpsc(Q, cx1)))
  select_snormpsc: THEOREM FORALL (Q: list[list[mpoly]]): FORALL (cx: snorm_ctx.Cx, ys: list[real]):
    branch_tree[bool].conds_hold(cx, ys) IMPLIES select(snormpsc(Q, cx), ys) = slofs(Q, ys)

  %% the count, and the decision
  mcountc(k, p0, ps, cx): btree[bool] =
    bmap(LAMBDA (n: int): n > 0, mtreec(k, p0, slists(ps), one_list, cx))
  mcountc_sound: THEOREM branch_tree[bool].conds_hold(cx, ys) AND
    length(l0) >= 2 AND lok(l0, ys) AND allok(slists(ps), ys) AND
    length(l0) + 1 + mlen(slists(ps)) <= k IMPLIES
    (select(mcountc(k, sl_of(l0, ys), ps, cx), ys) IFF
     (EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0 AND allgt(slists(ps), ys, x)))

  mcorec(k, p0, Q, cx): btree[bool] =
    bbindc(snormpsc(Q, cx), cx, LAMBDA (ps: list[SL], cx1: snorm_ctx.Cx):
      IF allcons(slists(ps)) THEN mcountc(k, p0, ps, cx1) ELSE bleaf(FALSE) ENDIF)
  mcorec_sound: THEOREM branch_tree[bool].conds_hold(cx, ys) AND
    length(l0) >= 2 AND lok(l0, ys) AND length(l0) + 1 + mlen(Q) <= k IMPLIES
    (select(mcorec(k, sl_of(l0, ys), Q, cx), ys) IFF
     (EXISTS (x: real): meval(mpol(l0))(cons(x, ys)) = 0 AND allgt(Q, ys, x)))
END tarski_ctx
