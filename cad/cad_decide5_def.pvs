cad_decide5_def: THEORY
%----------------------------------------------------------------------------
% The decision (cad) runs in a theory that does not import cad_decide8,
% executable part (FINISH_PLAN 3i, stage N10;
% dispatch revised 2026-09-27).  With THREE or more quantifiers it is the
% n-level decision decn_o of towern_od alone.  With TWO it is the fast
% two-level decision decw, and decn_o when decw's certificate does not come
% back TRUE (decw has no treatment of members that vanish at a cell; decn_o
% has).  With fewer it is decide2.  There is no exponential fallback any
% more: decide2's read closure costs 3^|F| and turned every certificate
% failure at two or more quantifiers into an apparent hang; now such a
% failure comes back at once with ok = FALSE.  qs is innermost first, as
% everywhere below decide; decn_o takes the quantifiers outermost first,
% hence the reverse.  Since 2026-09-28 (COMPLETENESS_PLAN C8) the n-level
% decision is decide_u_def's decn_u: decn_o from u = 0, raising u while the
% certificate fails, which always ends with the certificate holding
% (decide_u's decn_u_complete); at u = 0 it is the old decn_o(0, ...).
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide4_def, decide_u_def

  qs: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  decq5(qs, F, Psi): [# ok: bool, val: bool #] =
    IF length(qs) >= 3 THEN decn_u(reverse(qs), F, Psi, 0)
    ELSIF length(qs) = 2 THEN
      LET d = decw(car(cdr(qs)), car(qs), F, Psi) IN
      IF d`ok THEN d ELSE decn_u(reverse(qs), F, Psi, 0) ENDIF
    ELSE decq2(qs, F, Psi)
    ENDIF

  decide5(qs, F, phi): [# ok: bool, val: bool #] = decq5(qs, F, LAMBDA (v: SV): bfsv(phi, v))

  %% which route answered, for reports
  fastn?(qs, F, phi): bool =
    length(qs) >= 2 AND decn_o(0, reverse(qs), F, LAMBDA (v: SV): bfsv(phi, v))`ok
END cad_decide5_def
