alg_sturm: THEORY
%----------------------------------------------------------------------------
% STURM COUNTING AT AN ALGEBRAIC PARAMETER (item A, the section case).
%
% alg_lift decides whether a member vanishes at a candidate by a SIGN CHANGE
% between the two rational neighbours.  That is exact only while every root is
% simple, so it refuses a section sitting at a DISCRIMINANT root -- where the
% fibre has a repeated root, the member does not change sign, and the rule is
% silent.  A discriminant root is a section of every CAD, so that residual
% case is the generic critical point, not an exotic one.
%
% Sturm counting does not care about multiplicity, and everything it needs is
% already proved here:
%
%   chain_sturm's fchain_sturm   the symbolic pseudo-remainder chain, READ AT
%                                ANY REAL VALUATION ys, is a
%                                constructed_sturm_sequence? -- so Sturm@sturm
%                                applies at ys = (: value(a) :)
%   sg_chain's rchain_sg_at      the same chain built from a SIGN FUNCTION
%                                rather than a valuation, and equal to it at
%                                msg(ys) -- which is what makes it EXECUTABLE
%                                at an algebraic point, through alg_sign2
%   nsc_scale                    sign-change counting is blind to positive
%                                rescaling, so counting the SIGNS is counting
%                                the values
%   earr_eval_dg                 a chain entry read at a rational y0 and at
%                                x = value(a) is a rational univariate at
%                                value(a), which is again alg_sign2
%
% So the condition drops from "leading coefficient and discriminant nonzero"
% to just the LEADING COEFFICIENT -- alc? below -- and multiple roots are
% counted rather than refused.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_lift, nsc_scale

  a: VAR Alg
  f, c: VAR list[mpoly]
  k, i: VAR nat
  y0, y1: VAR rat
  u: VAR mpoly

  %% ---- the sign function of an algebraic point ------------------------
  algsg(a): SG = LAMBDA (u: mpoly): alg_sign2(a, cpl(u))
  algsg_msg: LEMMA algsg(a) = msg((: value(a) :))

  %% ---- the Sturm chain at x = value(a), built by the sign function ----
  achain(k, a, f): list[list[mpoly]] =
    cons(f, rchain_sg(k, f, lderiv(f), algsg(a)))
  achain_at: LEMMA achain(k, a, f) = fchain(k, f, (: value(a) :))

  %% ---- the chain read at a RATIONAL point ------------------------------
  asgn_sign: LEMMA asgn(a, c, y0) = sign3(meval(mpol(c))((: y0, value(a) :)))

  avarf(k, a, f, y0): [nat -> real] =
    LAMBDA (i: nat): asgn(a, nthl(achain(k, a, f), i), y0)

  %% the index bound, guarded: length(achain) - 2 is NOT a nat in general
  %% (a chain of one element makes it -1), and PVS is right to ask.  Under
  %% alc? the chain has at least three entries and alen_at unwraps it
  alen(k, a, f): nat =
    IF length(achain(k, a, f)) >= 2 THEN length(achain(k, a, f)) - 2 ELSE 0 ENDIF

  avar(k, a, f, y0): nat =
    number_sign_changes(avarf(k, a, f, y0), alen(k, a, f))`num

  %% only the leading coefficient, and only at alpha
  alc?(k, a, f): bool =
    length(f) >= 2 AND alg_sign2(a, cpl(llast(f))) /= 0 AND length(f) <= k

  %% alc? is fok, read through alg_sign2 instead of through the valuation
  alc_fok: LEMMA alc?(k, a, f) IMPLIES fok(k, f, (: value(a) :))

  %% the chain has at least three entries, so the index bound is a nat
  achain_len3: LEMMA alc?(k, a, f) IMPLIES length(achain(k, a, f)) >= 3

  %% every real is a POSITIVE multiple of its own sign, which is what lets
  %% nsc_scale turn counting the signs into counting the values
  sign3_scale: LEMMA FORALL (v: real): EXISTS (cp: posreal): sign3(v) = cp * v

  %% one chain entry, read at a rational y0, is the sign of the Sturm
  %% sequence's own entry there
  achain_entry: LEMMA alc?(k, a, f) IMPLIES
    asgn(a, nthl(achain(k, a, f), i), y0)
      = sign3(polynomial(carr(fchain(k, f, (: value(a) :)), (: value(a) :))(i),
                         cdeg(fchain(k, f, (: value(a) :)))(i))(y0))

  alen_at: LEMMA alc?(k, a, f)
    IMPLIES alen(k, a, f) = length(fchain(k, f, (: value(a) :))) - 2

  avar_nsc: LEMMA alc?(k, a, f) IMPLIES avar(k, a, f, y0) =
    number_sign_changes(LAMBDA (i: nat):
        polynomial(carr(fchain(k, f, (: value(a) :)), (: value(a) :))(i),
                   cdeg(fchain(k, f, (: value(a) :)))(i))(y0),
      length(fchain(k, f, (: value(a) :))) - 2)`num

  %% ---- THE COUNT --------------------------------------------------------
  acount(k, a, f, y0, y1): int = avar(k, a, f, y0) - avar(k, a, f, y1)

  %% the roots being counted, as a predicate, so that the bijection Sturm
  %% hands back can be reused rather than rebuilt: its codomain IS this
  %% predicate once aroot_char has rewritten the chain's first entry
  aroot?(a, f, y0, y1)(z: real): bool =
    y0 < z AND z <= y1 AND meval(mpol(f))((: z, value(a) :)) = 0

  aroot_char: LEMMA
    (LAMBDA (z: real): y0 < z AND z <= y1
       AND polynomial(carr(fchain(k, f, (: value(a) :)), (: value(a) :))(0),
                      cdeg(fchain(k, f, (: value(a) :)))(0))(z) = 0)
    = aroot?(a, f, y0, y1)

  %% the endpoints are not roots, which is what Sturm counting needs
  aends?(a, f, y0, y1): bool = y0 < y1
    AND meval(mpol(f))((: y0, value(a) :)) /= 0
    AND meval(mpol(f))((: y1, value(a) :)) /= 0

  %% Stated as a count and an existence rather than as a bijection into a
  %% subtype: bisection needs exactly these two, and a bijection whose
  %% codomain and domain types both have to be rewritten is friction with
  %% nothing on the other side of it.
  acount_nneg: THEOREM alc?(k, a, f) AND aends?(a, f, y0, y1)
    IMPLIES acount(k, a, f, y0, y1) >= 0

  acount_zero: THEOREM alc?(k, a, f) AND aends?(a, f, y0, y1)
    AND acount(k, a, f, y0, y1) = 0
    IMPLIES FORALL (z: real): y0 < z AND z <= y1
      IMPLIES meval(mpol(f))((: z, value(a) :)) /= 0

  acount_pos: THEOREM alc?(k, a, f) AND aends?(a, f, y0, y1)
    AND acount(k, a, f, y0, y1) > 0
    IMPLIES EXISTS (z: real): y0 < z AND z <= y1
      AND meval(mpol(f))((: z, value(a) :)) = 0
END alg_sturm
