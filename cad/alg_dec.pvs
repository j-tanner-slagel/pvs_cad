alg_dec: THEORY
%----------------------------------------------------------------------------
% The two-quantifier decision with ALGEBRAIC sample points (item A, step A6).
%
% What made the rational route refuse real problems was rsv: a sector whose
% sample is not exactly rational made it fall back to 0, and ratsamp? caught
% that as ok = FALSE.  There is nothing to fall back from here.  sample(s) is
% an Alg for EVERY sector -- rat_alg encodes a rational one as the linear
% polynomial x - r -- so svs_alg covers open sectors and sections alike, with
% no dispatch and no approximation.
%
% ok2a is still a real check, but it is now about the GEOMETRY (does a
% leading coefficient or a discriminant vanish at this sample) rather than
% about whether a coordinate happened to come out rational.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING alg_lift, cad_proj

  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  q1, q2: VAR bool
  s: VAR Sect

  dec2a(q1, q2, F, Psi): bool =
    qfoldS(q1, sects(rts(proj(F))),
           LAMBDA (s: Sect): qfold(q2, svs_alg(F, sample(s)), Psi))

  ok2a(F): bool =
    every(LAMBDA (s: Sect): aok?(sample(s), F))(sects(rts(proj(F))))

  %% ok2a read one sector at a time, which is the form the correctness
  %% argument needs: it walks the sector list and wants the check at each
  ok2a_mem: LEMMA ok2a(F) AND member(s, sects(rts(proj(F))))
    IMPLIES aok?(sample(s), F)
END alg_dec
