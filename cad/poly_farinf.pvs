poly_farinf: THEORY
%----------------------------------------------------------------------------
% A list of polynomials far out on either side (Phase 3).
%
% A conjunction of strict inequalities with no equation is decided by three
% cases: it holds far to the right, or far to the left, or at a critical point
% of the product (poly_rolle).  The first two are conditions on the leading
% coefficients alone --- all positive for the right, all positive after the
% sign (-1)^deg for the left --- and this theory proves both directions of
% that, for one polynomial and then for a list with a common bound.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING tarski_many

  l: VAR list[mpoly]
  Q: VAR list[list[mpoly]]
  ys: VAR list[real]
  x, M, M1, M2: VAR real
  i: VAR nat

  %% the two leading-coefficient conditions
  lcpos(l, ys): bool = cons?(l) AND meval(llast(l))(ys) > 0
  lcalt(l, ys): bool = cons?(l) AND (-1) ^ dg(l) * meval(llast(l))(ys) > 0
  posinf(Q, ys): bool = every(LAMBDA (u: list[mpoly]): lcpos(u, ys))(Q)
  neginf(Q, ys): bool = every(LAMBDA (u: list[mpoly]): lcalt(u, ys))(Q)

  %% one polynomial
  far_right: LEMMA lcpos(l, ys) IMPLIES
    EXISTS (M: real): FORALL (x: real): x >= M IMPLIES pf(l, ys)(x) > 0
  far_left: LEMMA lcalt(l, ys) IMPLIES
    EXISTS (M: real): FORALL (x: real): x <= M IMPLIES pf(l, ys)(x) > 0
  far_right_inv: LEMMA (FORALL (x: real): x >= M IMPLIES pf(l, ys)(x) > 0)
    AND lok(l, ys) IMPLIES lcpos(l, ys)
  far_left_inv: LEMMA (FORALL (x: real): x <= M IMPLIES pf(l, ys)(x) > 0)
    AND lok(l, ys) IMPLIES lcalt(l, ys)

  %% the list, with one bound for all of it
  allpf(Q, ys, x): bool = every(LAMBDA (u: list[mpoly]): pf(u, ys)(x) > 0)(Q)
  allpf_null: LEMMA allpf(null[list[mpoly]], ys, x)
  allpf_cons: LEMMA allpf(cons(l, Q), ys, x) IFF (pf(l, ys)(x) > 0 AND allpf(Q, ys, x))
  posinf_cons: LEMMA posinf(cons(l, Q), ys) IFF (lcpos(l, ys) AND posinf(Q, ys))
  neginf_cons: LEMMA neginf(cons(l, Q), ys) IFF (lcalt(l, ys) AND neginf(Q, ys))

  far_right_list: LEMMA posinf(Q, ys) IMPLIES
    EXISTS (M: real): FORALL (x: real): x >= M IMPLIES allpf(Q, ys, x)
  far_left_list: LEMMA neginf(Q, ys) IMPLIES
    EXISTS (M: real): FORALL (x: real): x <= M IMPLIES allpf(Q, ys, x)
END poly_farinf
