cad_demo: THEORY
%----------------------------------------------------------------------------
% A playground for (cad).  Each lemma is a closed prenex formula over the
% reals: quantifiers first, then a Boolean combination of polynomial sign
% conditions.  Prove one with M-x prove and the command (cad), or from a
% shell, in the checkout's cad/ directory, after running ../tools/setup.sh
% once: start a server with ../tools/cli/srv.sh cad_demo, then
% ../tools/cli/pv.sh cad_demo d_amgm '(cad)'.  This theory imports
% cad_decide5 (the read-closure decision); IMPORTING pvs_cad gives the
% default, decide8.  Add your own lemmas at the end and try them.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5, mpoly_embed

  %% AM-GM for two numbers
  d_amgm: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 >= 2 * x * y

  %% every cubic x^3 - 3x + c has a real root
  d_cubic: LEMMA FORALL (c: real): EXISTS (x: real): x^3 - 3 * x + c = 0

  %% the parabola y = x^2 meets the unit circle
  d_meet: LEMMA EXISTS (x: real): EXISTS (y: real): x^2 + y^2 = 1 AND y = x^2

  %% FALSE: 0 has no inverse -- (cad) says so and does not prove it
  d_inverse: LEMMA FORALL (x: real): EXISTS (y: real): x * y = 1

  %% ... and it proves the negation
  d_no_inverse: LEMMA NOT (FORALL (x: real): EXISTS (y: real): x * y = 1)

  %% three quantifiers: between two different numbers there is a third
  d_between: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real):
    x < y IMPLIES (x < z AND z < y)

  %% three quantifiers: the cone z^2 = x^2 + y^2 has a point over every (x, y)
  d_cone: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): z^2 = x^2 + y^2

  %% four quantifiers, alternating
  d_square: LEMMA FORALL (x: real): FORALL (y: real): EXISTS (z: real): FORALL (w: real):
    w^2 + z > x + y

  %% ---- try these yourself ----------------------------------------------------------------
  %% a square root of 2 exists (the witness is irrational: (cad) works with
  %% algebraic numbers, not just rationals)
  t_sqrt2: LEMMA EXISTS (x: real): x^2 = 2

  %% FALSE (x = y = 1): change 3 to 2 and it becomes d_amgm
  t_amgm3: LEMMA FORALL (x: real): FORALL (y: real): x^2 + y^2 >= 3 * x * y

  %% ---- sequents --------------------------------------------------------------------------
  s_pos: LEMMA FORALL (x: real): FORALL (y: real): x > 0 AND y > 0 IMPLIES x * y > 0
END cad_demo
