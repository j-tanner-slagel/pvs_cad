rsc_tree: THEORY
%----------------------------------------------------------------------------
% Realized sign vectors at the roots of one polynomial (Phase 5).
%
% rsc(k, g, L, E, Q, acc, cx) is a branch tree over the parameters whose
% leaf lists the sign vectors of L realized at the real roots x of g that
% satisfy E = 0 and Q > 0 (acc holds, reversed, the signs already fixed).
% It is the adaptive enumeration: one parametric existence question
% (cjtreec of Phase 3) prunes a prefix nobody realizes, otherwise the first
% polynomial of L is sent to Q (> 0), to E (= 0) or negated to Q (< 0) and
% the three lists are concatenated. The tree's conditions are the projection
% polynomials; its leaf is the same wherever they keep their signs.
%
% rsc_sound: every root with the conditions realizes a listed vector;
% rsc_complete: every listed vector is realized by such a root.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING qe_ctx, sign_vec, bbindc_ex[bool, list[list[Sign3]]],
            bbindc_ex[list[list[Sign3]], list[list[Sign3]]],
            branch_map[list[list[Sign3]], list[list[Sign3]]],
            structures@more_list_props[list[Sign3]]

  SV: TYPE = list[Sign3]
  SVL: TYPE = list[SV]

  k: VAR nat
  g, l, l1, l2: VAR list[mpoly]
  L, E, Q: VAR list[list[mpoly]]
  acc, v: VAR SV
  s: VAR Sign3
  cx: VAR snorm_ctx.Cx
  ys: VAR list[real]
  x: VAR real
  a, b, c: VAR SVL

  %% a root of g with the side conditions
  at(g, E, Q, ys, x): bool =
    meval(mpol(g))(cons(x, ys)) = 0 AND eqs_at(E, ys, x) AND allgt(Q, ys, x)

  eqs_at_cons: LEMMA eqs_at(cons(l, E), ys, x) IFF
    (meval(mpol(l))(cons(x, ys)) = 0 AND eqs_at(E, ys, x))
  allgt_cons: LEMMA allgt(cons(l, Q), ys, x) IFF
    (meval(mpol(l))(cons(x, ys)) > 0 AND allgt(Q, ys, x))
  at_cjt: LEMMA (EXISTS x: eqs_at(cons(g, E), ys, x) AND allgt(Q, ys, x)) IFF
    (EXISTS x: at(g, E, Q, ys, x))

  %% the fuel: what cjtreec needs now plus what the extensions can add
  lsum(L): RECURSIVE nat =
    IF null?(L) THEN 0
    ELSE length(lmul(car(L), car(L))) + 4 * length(car(L)) + lsum(cdr(L))
    ENDIF
  MEASURE length(L)
  rfuel(g, L, E, Q): nat = length(sqsum(cons(g, E))) + 2 * mlen(Q) + 1 + lsum(L)

  ladd_length: LEMMA FORALL l1: FORALL l2: length(ladd(l1, l2)) = max(length(l1), length(l2))
  sqsum_len_cons: LEMMA length(sqsum(cons(l, E))) = max(length(lmul(l, l)), length(sqsum(E)))
  lneg_length: LEMMA length(lneg(l)) = length(l)
  rfuel_now: LEMMA length(sqsum(cons(g, E))) + 2 * mlen(Q) + 1 <= rfuel(g, L, E, Q)
  lsum_cons: LEMMA lsum(cons(l, L)) = length(lmul(l, l)) + 4 * length(l) + lsum(L)
  rfuel_gt: LEMMA rfuel(g, L, E, cons(l, Q)) <= rfuel(g, cons(l, L), E, Q)
  rfuel_eq: LEMMA rfuel(g, L, cons(l, E), Q) <= rfuel(g, cons(l, L), E, Q)
  rfuel_lt: LEMMA rfuel(g, L, E, cons(lneg(l), Q)) <= rfuel(g, cons(l, L), E, Q)

  %% the enumeration
  rsc(k, g, L, E, Q, acc, cx): RECURSIVE btree[SVL] =
    bbindc(cjtreec(k, cons(g, E), Q, cx), cx,
      LAMBDA (b0: bool, cx1: snorm_ctx.Cx):
        IF NOT b0 THEN bleaf(null[SV])
        ELSIF null?(L) THEN bleaf((: reverse(acc) :))
        ELSE bbindc(rsc(k, g, cdr(L), E, cons(car(L), Q), cons(1, acc), cx1), cx1,
               LAMBDA (v1: SVL, cx2: snorm_ctx.Cx):
                 bbindc(rsc(k, g, cdr(L), cons(car(L), E), Q, cons(0, acc), cx2), cx2,
                   LAMBDA (v2: SVL, cx3: snorm_ctx.Cx):
                     bmap(LAMBDA (v3: SVL): append(v1, append(v2, v3)),
                          rsc(k, g, cdr(L), E, cons(lneg(car(L)), Q), cons(-1, acc), cx3))))
        ENDIF)
  MEASURE length(L)

  %% list facts
  rev_cons_app: LEMMA append(reverse(cons(s, acc)), v) = append(reverse(acc), cons(s, v))
  mem_app3: LEMMA member(v, append(a, append(b, c))) IFF
    (member(v, a) OR member(v, b) OR member(v, c))

  %% the sign of the first polynomial decides the branch
  svec_cons_sign: LEMMA cons?(L) IMPLIES
    svec(L, cons(x, ys)) = cons(sign3(meval(mpol(car(L)))(cons(x, ys))), svec(cdr(L), cons(x, ys)))

  rsc_sound: THEOREM FORALL L: FORALL (k, g, E, Q, acc, cx, ys, x):
    branch_tree[bool].conds_hold(cx, ys) AND rfuel(g, L, E, Q) <= k AND at(g, E, Q, ys, x) IMPLIES
    member(append(reverse(acc), svec(L, cons(x, ys))), select(rsc(k, g, L, E, Q, acc, cx), ys))

  rsc_complete: THEOREM FORALL L: FORALL (k, g, E, Q, acc, cx, ys, v):
    branch_tree[bool].conds_hold(cx, ys) AND rfuel(g, L, E, Q) <= k AND
    member(v, select(rsc(k, g, L, E, Q, acc, cx), ys)) IMPLIES
    EXISTS x: at(g, E, Q, ys, x) AND v = append(reverse(acc), svec(L, cons(x, ys)))
END rsc_tree
