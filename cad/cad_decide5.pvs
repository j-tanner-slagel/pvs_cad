cad_decide5: THEORY
%----------------------------------------------------------------------------
% decide5 is correct (FINISH_PLAN 3i, stage N10; dispatch revised
% 2026-09-27): decn_u_correct at three or more quantifiers, decw_correct or
% decn_u_correct at two, decq2_correct below.
%----------------------------------------------------------------------------
BEGIN
  IMPORTING cad_decide5_def, cad_decide4, decide_u, cad_endgame

  qs, os: VAR list[bool]
  F: VAR list[list[mpoly]]
  Psi: VAR [SV -> bool]
  phi: VAR BF

  decq5_correct: THEOREM decq5(qs, F, Psi)`ok IMPLIES
    (decq5(qs, F, Psi)`val IFF sem(reverse(qs), F, Psi, null))

  decide5_correct: THEOREM decide5(reverse(os), F, phi)`ok IMPLIES
    (decide5(reverse(os), F, phi)`val IFF fsem(os, F, phi, null))
END cad_decide5
